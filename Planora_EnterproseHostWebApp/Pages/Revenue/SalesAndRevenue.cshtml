@page
@model Planora_EnterproseHostWebApp.Pages.Revenue.RevenueModel
@{
    Layout = "_Layout";
    ViewData["PageName"] = "Sales &amp; Revenue";
    ViewData["PageDesc"] = "Portfolio &amp; per-event revenue";
}

<main class="shell__main" data-page-roles="admin finance viewer">

    <div class="page__head">
        <div>
            <h1 class="page__title">Sales &amp; Revenue</h1>
            <p class="page__subtitle">
                Every ticketed event &middot; commission billed monthly in arrears
            </p>
        </div>
        <div class="page__actions">
            <div class="toolbar__field">
                <label class="u-visually-hidden" for="sales-range">Period</label>
                <select class="field__select" id="sales-range" name="sales-range">
                    <option>This contract year</option>
                    <option>Last 30 days</option>
                    <option>Last 90 days</option>
                    <option>Year to date</option>
                </select>
            </div>
            <button class="btn btn--outline" type="button"
                    data-action="Revenue export queued as CSV">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export
            </button>
            <a class="btn btn--primary" href="my-plan.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /></svg> Billing &amp; invoices</a>
        </div>
    </div>

