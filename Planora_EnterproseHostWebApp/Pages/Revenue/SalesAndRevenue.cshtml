@page
@model Planora_EnterproseHostWebApp.Pages.Revenue.RevenueModel
@{
    Layout = "_Layout";
    ViewData["PageName"] = "Sales &amp; Revenue";
    ViewData["PageDesc"] = "Portfolio &amp; per-event revenue";
}

<main class="shell__main" data-page-roles="admin finance viewer">

    <div class="page__head">
        <div>
            <h1 class="page__title">Sales &amp; Revenue</h1>
            <p class="page__subtitle">
                Every ticketed event &middot; commission billed monthly in arrears
            </p>
        </div>
        <div class="page__actions">
            <div class="toolbar__field">
                <label class="u-visually-hidden" for="sales-range">Period</label>
                <select class="field__select" id="sales-range" name="sales-range">
                    <option>This contract year</option>
                    <option>Last 30 days</option>
                    <option>Last 90 days</option>
                    <option>Year to date</option>
                </select>
            </div>
            <button class="btn btn--outline" type="button"
                    data-action="Revenue export queued as CSV">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export
            </button>
            <a class="btn btn--primary" href="my-plan.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /></svg> Billing &amp; invoices</a>
        </div>
    </div>


    @if (!string.IsNullOrEmpty(Model.ApiError))
    {
        <div class="alert alert-danger mb-4" role="alert">
            @Model.ApiError
        </div>
    }

    <section class="reportstats u-mb-6" aria-label="Revenue totals">
        <span class="reportstat">
            <span class="reportstat__value">&#8358;@Model.SalesData.GrossRev</span>
            <span class="reportstat__label">Gross collected</span>
            <span class="reportstat__note">Across @Model.SalesData.TotalEventsForGrossRev ticketed event@(Model.SalesData.TotalEventsForGrossRev == 1 ? "" : "s")</span>
        </span>
        <span class="reportstat">
            <span class="reportstat__value">&minus;&#8358;@Model.SalesData.Refunded</span>
            <span class="reportstat__label">Refunded</span>
            <span class="reportstat__note">@Model.SalesData.TotalRefunds refund@(Model.SalesData.TotalRefunds == 1 ? "" : "s"), @Model.SalesData.TotalCancelled cancellation@(Model.SalesData.TotalCancelled == 1 ? "" : "s")</span>
        </span>
        <span class="reportstat">
            <span class="reportstat__value">&minus;&#8358;@Model.SalesData.Commission</span>
            <span class="reportstat__label">Commission at @Model.SalesData.CommissionPer</span>
            <span class="reportstat__note">Billed monthly in arrears</span>
        </span>
        <span class="reportstat">
            <span class="reportstat__value">&#8358;@Model.SalesData.NetToHost</span>
            <span class="reportstat__label">Net to your account</span>
            <span class="reportstat__note">Settled plus escrow</span>
        </span>
    </section>

    <section class="panel" aria-labelledby="byevent-title">
        <div class="panel__head panel__head--plain">
            <div>
                <h2 class="panel__title" id="byevent-title">By event</h2>
                <p class="panel__meta">
                    Cancelled events show what went back out, not what came in
                </p>
            </div>
            <div class="toolbar__field">
                <label class="u-visually-hidden" for="sales-status">Filter by status</label>
                <select class="field__select" id="sales-status" name="sales-status"
                        data-tablefilter-col="sales-table">
                    <option value="">All statuses</option>
                    <option>Live</option>
                    <option>Upcoming</option>
                    <option>Completed</option>
                    <option>Cancelled</option>
                </select>
            </div>
        </div>
        <div class="panel__body">
            <div class="tablewrap">
                <table class="table table--narrow" id="sales-table">
                    <caption class="u-visually-hidden">
                        Revenue per event with refunds, commission and net
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Event</th>
                            <th scope="col">Status</th>
                            <th scope="col">Tickets</th>
                            <th scope="col">Gross</th>
                            <th scope="col">Refunds</th>
                            <th scope="col">Commission</th>
                            <th scope="col">Net</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SalesData.Events != null && Model.SalesData.Events.Any())
                        {
                            @foreach (var ev in Model.SalesData.Events)
                            {
                                string badgeCss = (ev.EventStatus ?? "").ToLower() switch
                                {
                                    "live" => "badge--live",
                                    "upcoming" => "badge--paused",
                                    "completed" => "badge--nodot badge--role",
                                    "cancelled" => "badge--out",
                                    _ => "badge--default"
                                };

                                <tr data-status="@ev.EventStatus">
                                    <td><span class="cellstack__name">@ev.EventName</span></td>
                                    <td><span class="badge @badgeCss">@ev.EventStatus</span></td>
                                    <td>@ev.SoldTickets / @ev.TotalTickets</td>
                                    <td><span class="u-nowrap">&#8358;@ev.GrossRev</span></td>
                                    <td><span class="u-nowrap">@(string.IsNullOrEmpty(ev.Refunds) || ev.Refunds == "0" ? "\u2014" : "\u2212\u20A6" + ev.Refunds)</span></td>
                                    <td><span class="u-nowrap">@(string.IsNullOrEmpty(ev.Commission) || ev.Commission == "0" ? "\u2014" : "\u20A6" + ev.Commission)</span></td>
                                    <td><b><span class="u-nowrap">&#8358;@ev.NetToHost</span></b></td>
                                    <td>
                                        <div class="rowactions">
                                            <a class="iconbtn" asp-page="/Events/EventHub" asp-route-eventId="@ev.EventId">
                                                <span class="u-visually-hidden">Open hub for @ev.EventName</span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 3 7.5l9 4.5 9-4.5L12 3zM3 12.5 12 17l9-4.5M3 17 12 21.5 21 17" /></svg>
                                            </a>
                                            <button class="iconbtn" type="button"
                                                    data-action="Revenue statement for @ev.EventName downloaded">
                                                <span class="u-visually-hidden">Statement for @ev.EventName</span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else if (string.IsNullOrEmpty(Model.ApiError))
                        {
                            <tr>
                                <td colspan="8" class="u-muted">No ticketed events yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="tablefilter__empty" data-tablefilter-empty="sales-table" hidden>
                No event matches that status.
            </p>
        </div>
    </section>

    <div class="hubhead u-mt-6">
        <div class="hubhead__body">
            <h2 class="hubhead__title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg> @(Model.SalesData.Events.FirstOrDefault(e => e.EventId == Model.EventId)?.EventName ?? "Select an event")</h2>
            <p class="hubhead__text">
                The breakdown behind one event &mdash; switch event to see another
            </p>
        </div>
        <div class="hubhead__actions">
            <form method="get" class="toolbar__field">
                <label class="u-visually-hidden" for="sales-event">Event</label>
                <select class="field__select" id="sales-event" name="EventId" onchange="this.form.submit()">
                    @foreach (var ev in Model.SalesData.Events)
                    {
                        <option value="@ev.EventId" selected="@(ev.EventId == Model.EventId)">@ev.EventName</option>
                    }
                </select>
            </form>
            <a class="btn btn--outline btn--sm" asp-page="/Events/EventHub" asp-route-eventId="@Model.EventId">Open Event Hub</a>
        </div>
    </div>

    <div class="grid grid--2 u-mt-5">
        <section class="panel" aria-labelledby="bytier-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h3 class="panel__title" id="bytier-title">By ticket tier</h3>
                    <p class="panel__meta">Standard oversold by 47 before it closed</p>
                </div>
            </div>
            <div class="panel__body">
                <div class="tablewrap">
                    <table class="table table--narrow">
                        <caption class="u-visually-hidden">Revenue by ticket tier</caption>
                        <thead>
                            <tr>
                                <th scope="col">Tier</th>
                                <th scope="col">Sold</th>
                                <th scope="col">Gross</th>
                                <th scope="col">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.EventSalesData.TicketTypesRev != null && Model.EventSalesData.TicketTypesRev.Any())
                            {
                                @foreach (var tier in Model.EventSalesData.TicketTypesRev)
                                {
                                    <tr>
                                        <th scope="row">@tier.TypeName</th>
                                        <td>@tier.SoldTickets <span class="cellsub">/ @tier.TotalTickets</span></td>
                                        <td><span class="u-nowrap">&#8358;@tier.GrossRev</span></td>
                                        <td>
                                            <span class="reportbar">
                                                <span class="reportbar__fill" data-fill="@tier.SharePer?.Replace("%", "").Trim()"></span>
                                            </span>
                                            <span class="reportbar__label">@tier.SharePer</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="u-muted">No ticket tier data for this event.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="panel" aria-labelledby="bymethod-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h3 class="panel__title" id="bymethod-title">How guests paid</h3>
                    <p class="panel__meta">Card clears same day; transfers take up to 48 hours</p>
                </div>
            </div>
            <div class="panel__body">
                <div class="reportsplits">
                    <span class="reportsplit">
                        <span class="reportsplit__name">Card</span>
                        <span class="reportsplit__value">&#8358;@Model.EventSalesData.CardRev</span>
                        <span class="reportsplit__meta">@Model.EventSalesData.CardPayments payments &middot; @Model.EventSalesData.CardPer</span>
                    </span>
                    <span class="reportsplit">
                        <span class="reportsplit__name">Bank transfer</span>
                        <span class="reportsplit__value">&#8358;@Model.EventSalesData.BankTransferRev</span>
                        <span class="reportsplit__meta">@Model.EventSalesData.BankTransferPayments payments &middot; @Model.EventSalesData.BankTransferPer</span>
                    </span>
                    <span class="reportsplit">
                        <span class="reportsplit__name">USSD</span>
                        <span class="reportsplit__value">&#8358;@Model.EventSalesData.UUSDRev</span>
                        <span class="reportsplit__meta">@Model.EventSalesData.UUSDPayments payments &middot; @Model.EventSalesData.UUSDPer</span>
                    </span>
                    <span class="reportsplit">
                        <span class="reportsplit__name">Complimentary</span>
                        <span class="reportsplit__value">&#8358;@Model.EventSalesData.ComplimentaryRev</span>
                        <span class="reportsplit__meta">@Model.EventSalesData.ComplimentoryPayments payments &middot; @Model.EventSalesData.ComplimentoryPer</span>
                    </span>
                </div>

                <div class="payoutstate u-mt-5">
                    <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12.5 9 17.5 20 6.5" /></svg></span>
                    <span class="payoutstate__body">
                        <span class="payoutstate__title">
                            &#8358;6.1M settled &middot; &#8358;3.09M in escrow
                        </span>
                        <span class="payoutstate__meta">
                            Escrow releases 3 working days after the event ends, to
                            First Bank &bull;&bull;&bull;&bull; 4471
                        </span>
                    </span>
                    <button class="btn btn--outline btn--sm" type="button"
                            data-action="Payout statement downloaded">
                        Statement
                    </button>
                </div>
            </div>
        </section>
    </div>

    <section class="panel u-mt-6" aria-labelledby="byslot-title">
        <div class="panel__head panel__head--plain">
            <div>
                <h3 class="panel__title" id="byslot-title">By day and slot</h3>
                <p class="panel__meta">
                    Commission is itemised per day and slot on your invoice
                </p>
            </div>
            <button class="btn btn--outline btn--sm" type="button"
                    data-action="Day and slot breakdown exported">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export breakdown
            </button>
        </div>
        <div class="panel__body">
            <div class="tablewrap">
                <table class="table table--narrow">
                    <caption class="u-visually-hidden">
                        Tickets and revenue per day and slot
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Day</th>
                            <th scope="col">Slot</th>
                            <th scope="col">Tickets</th>
                            <th scope="col">Gross</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EventDaysData.EventDays != null && Model.EventDaysData.EventDays.Any())
                        {
                            @foreach (var slot in Model.EventDaysData.EventDays)
                            {
                                <tr>
                                    <td>@slot.DayName</td>
                                    <th scope="row">@slot.SlotName</th>
                                    <td>@slot.SoldTickets</td>
                                    <td><span class="u-nowrap">&#8358;@slot.GrossRev</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="u-muted">No day/slot data for this event.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="panel u-mt-6" aria-labelledby="refunds-title">
        <div class="panel__head panel__head--plain">
            <div>
                <h3 class="panel__title" id="refunds-title">Refunds</h3>
                <p class="panel__meta">
                    Guest-initiated and host-initiated, with the reason on record
                </p>
            </div>
            <button class="btn btn--outline btn--sm" type="button"
                    data-action="Refund report exported">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export refunds
            </button>
        </div>
        <div class="panel__body">
            <div class="tablewrap">
                <table class="table table--narrow">
                    <caption class="u-visually-hidden">
                        Refunds with guest, event, amount, reason and state
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Reference</th>
                            <th scope="col">Guest</th>
                            <th scope="col">Event</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Reason</th>
                            <th scope="col">State</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EventRefundsData.Refunds != null && Model.EventRefundsData.Refunds.Any())
                        {
                            @foreach (var rf in Model.EventRefundsData.Refunds)
                            {
                                string refundBadgeCss = (rf.Status ?? "").ToLower() switch
                                {
                                    "settled" => "badge--live",
                                    "processing" => "badge--paused",
                                    _ => "badge--default"
                                };

                                <tr>
                                    <td><span class="order__ref">@rf.Reference</span></td>
                                    <td><span class="cellstack__name">@rf.GuestName</span></td>
                                    <td class="u-muted">@rf.EventName</td>
                                    <td><span class="u-nowrap">\u2212&#8358;@rf.Revenue</span></td>
                                    <td>@rf.Reason</td>
                                    <td><span class="badge @refundBadgeCss">@rf.Status</span></td>
                                    <td>
                                        <div class="rowactions">
                                            <a class="iconbtn" href="receipt.html?ref=@rf.Reference">
                                                <span class="u-visually-hidden">Receipt for @rf.Reference</span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="u-muted">No refunds for this event.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="notice notice--info notice--flat u-mt-5">
                <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                Commission is reversed on a refund, so a refunded ticket costs you nothing in
                platform fees.
            </p>
        </div>
    </section>

</main>