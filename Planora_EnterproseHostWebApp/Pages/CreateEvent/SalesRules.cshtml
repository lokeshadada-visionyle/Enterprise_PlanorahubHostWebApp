@page
@model Planora_EnterproseHostWebApp.Pages.CreateEvent.SalesRulesModel
@{
    Layout = "_CreateEventLayout";
    ViewData["StepIndex"] = 6;
    ViewData["StepTotal"] = 12;
    ViewData["StepName"] = "Sale Rules & Pricing";
    ViewData["StepHint"] = "Set prices, allocations, audiences and sale windows for each rule";
}
<div class="wizard__body">
      <main class="wizard__content" data-page-roles="admin manager">
        <div class="wizard__inner">
         @* <form class="stack" action="sales-rules.html" method="get"> *@

            <section class="panel" aria-labelledby="rulesintro-title">
              <div class="panel__head">
                <span class="tile tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 5 5 19"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg></span>
                <div class="panel__headbody">
                  <h2 class="panel__title panel__title--lg" id="rulesintro-title">
                    Sale rules
                  </h2>
                  <p class="panel__meta">
                    A sale rule is how a ticket gets a price. Each one sets its own
                    allocation, the tiers it covers and what each of those costs, who
                    may buy and when it is live. Tickets with no rule covering them
                    cannot be sold.
                  </p>
                </div>
              </div>
              <div class="panel__body">
                <p class="rulesbar">
                  <span class="rulesbar__figures">
                    <span class="rulesbar__figure">
                      <b data-rules-count>0</b><span>Sale rules</span>
                    </span>
                    <span class="rulesbar__figure">
                      <b data-rules-alloc>0</b><span>Tickets across all rules</span>
                    </span>
                    <span class="rulesbar__figure rulesbar__figure--warn">
                      <b data-rules-uncovered>0</b><span>Tiers with no rule</span>
                    </span>
                  </span>
                  <span class="rulesbar__body" data-rules-summary>&mdash;</span>
                  <button class="btn btn--primary btn--sm" type="button" data-rule-add>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg> Add sale rule
                  </button>
                </p>

                <p class="notice notice--warn notice--flat u-mt-5" data-rules-none hidden>
                  <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"/><path d="M12 12h.01"/></svg>
                  <span>
                    There are no sale rules, so none of these tickets can be sold. Add
                    at least one rule covering the tiers you intend to sell.
                  </span>
                </p>
              </div>
            </section>

            <div class="salerules u-mt-6" id="rule-list" data-rulelist
                 data-repeat-min="0">
            <article class="salerule" data-salerule="r1" data-repeat-row>
              <div class="salerule__head">
                <span class="salerule__no" aria-hidden="true">1</span>
                <span class="salerule__title">
                  <label class="u-visually-hidden" for="rn-r1">Sale rule name</label>
                  <input class="salerule__name field__input" id="rn-r1"
                         name="rn-r1" type="text" value="Early Bird"
                         placeholder="Name this rule">
                  <span class="salerule__recap" data-rule-recap>&mdash;</span>
                </span>
                <span class="salerule__tools">
                  <button class="iconbtn" type="button" data-rule-duplicate="r1">
                    <span class="u-visually-hidden">Duplicate this sale rule</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                  </button>
                  <button class="iconbtn iconbtn--danger" type="button"
                          data-repeat-remove>
                    <span class="u-visually-hidden">Delete this sale rule</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg>
                  </button>
                </span>
              </div>

              <div class="salerule__body">

                <!-- ---- how many this rule may sell ---- -->
                <div class="rulefield">
                  <label class="field__label" for="ra-r1">
                    Total allocation<span class="field__required" aria-hidden="true">*</span>
                    <span class="u-visually-hidden">(required)</span>
                  </label>
                  <input class="field__input field__input--short" id="ra-r1"
                         name="ra-r1" type="text" inputmode="numeric"
                         value="100" data-rule-alloc>
                  <span class="field__hint">
                    Tickets this rule may sell in total, across every tier it covers.
                    This is not the tier&rsquo;s own capacity.
                  </span>
                  <span class="field__error" data-error="alloc" hidden></span>
                </div>
  <fieldset class="fieldset">
                  <legend class="fieldset__legend">
                    Sale period
                    <span class="fieldset__note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/></svg> All times in WAT (UTC+1)</span>
                  </legend>
                  <div class="formgrid formgrid--4">
                    <p class="field">
                      <label class="field__label" for="rsd-__NEW__">Sale start date</label>
                      <input class="field__input" id="rsd-__NEW__" name="rsd-__NEW__"
                             type="date" value="" data-rule-start>
                    </p>
                    <p class="field">
                      <label class="field__label" for="rst-__NEW__">Sale start time</label>
                      <input class="field__input" id="rst-__NEW__" name="rst-__NEW__"
                             type="time" value="09:00" data-rule-starttime>
                    </p>
                    <p class="field">
                      <label class="field__label" for="red-__NEW__">Sale end date</label>
                      <input class="field__input" id="red-__NEW__" name="red-__NEW__"
                             type="date" value="" data-rule-end>
                    </p>
                    <p class="field">
                      <label class="field__label" for="ret-__NEW__">Sale end time</label>
                      <input class="field__input" id="ret-__NEW__" name="ret-__NEW__"
                             type="time" value="23:59" data-rule-endtime>
                    </p>
                  </div>
                  <span class="field__error" data-error="period" hidden></span>
                  <p class="field__hint" data-period-recap></p>
                </fieldset>
                <!-- ---- which tiers, and what each costs ---- -->
                <div class="rulefield">
                  <p class="rulefield__head">
                    <span class="field__label">
                      Ticket tiers<span class="field__required" aria-hidden="true">*</span>
                      <span class="u-visually-hidden">(required)</span>
                    </span>
                    <span class="rulefield__count" data-tier-count>&mdash;</span>
                  </p>

                  <div class="tierpick" data-tierpick-scope>
                    <div class="searchbox searchbox--sm">
                      <svg class="searchbox__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                      <label class="u-visually-hidden" for="rts-r1">
                        Search ticket tiers
                      </label>
                      <input class="searchbox__input" id="rts-r1" name="rts-r1"
                             type="search" placeholder="Search tiers"
                             data-tierpick-filter>
                    </div>
                    <div class="tierpick__opts">
                      <label class="tierpick__opt" data-tierpick-opt="general"
                             data-tierpick-search="general 500">
                        <input type="checkbox" name="rt-r1-general" value="general"
                               data-tierpick="general" checked>
                        <span class="tierpick__body">
                          <span class="tierpick__name">General</span>
                          <span class="tierpick__cap">
                            500 configured
                          </span>
                        </span>
                      </label>
                      <label class="tierpick__opt" data-tierpick-opt="premium"
                             data-tierpick-search="premium 100">
                        <input type="checkbox" name="rt-r1-premium" value="premium"
                               data-tierpick="premium">
                        <span class="tierpick__body">
                          <span class="tierpick__name">Premium</span>
                          <span class="tierpick__cap">
                            100 configured
                          </span>
                        </span>
                      </label>
                      <label class="tierpick__opt" data-tierpick-opt="vip"
                             data-tierpick-search="vip 50">
                        <input type="checkbox" name="rt-r1-vip" value="vip"
                               data-tierpick="vip" checked>
                        <span class="tierpick__body">
                          <span class="tierpick__name">VIP</span>
                          <span class="tierpick__cap">
                            50 configured
                          </span>
                        </span>
                      </label>
                    </div>
                    <p class="tierpick__none" data-tierpick-none hidden>
                      No tier matches that search.
                    </p>
                  </div>
                  <span class="field__error" data-error="tiers" hidden></span>
                </div>

                <div class="rulefield" data-pricing-block>
                  <p class="rulefield__head">
                    <span class="field__label">Pricing</span>
                    <span class="rulefield__count">
                      A price for each tier you ticked
                    </span>
                  </p>
                  <div class="tablewrap">
                    <table class="table table--narrow pricetable">
                      <caption class="u-visually-hidden">
                        The sale price of each ticket tier under this rule
                      </caption>
                      <thead>
                        <tr>
                          <th scope="col">Ticket tier</th>
                          <th scope="col">Tier capacity</th>
                          <th scope="col">Sale price</th>
                        </tr>
                      </thead>
                      <tbody>
                    <tr data-pricerow="general">
                      <th scope="row">General</th>
                      <td class="u-muted">500 configured</td>
                      <td>
                        <span class="pricefield">
                          <span class="pricefield__unit" aria-hidden="true">&#8358;</span>
                          <label class="u-visually-hidden" for="rp-r1-general">
                            Sale price for General
                          </label>
                          <input class="field__input pricefield__input"
                                 id="rp-r1-general" name="rp-r1-general"
                                 type="text" inputmode="numeric" value="10000"
                                 data-tierprice="general">
                        </span>
                      </td>
                    </tr>
                    <tr data-pricerow="premium" hidden>
                      <th scope="row">Premium</th>
                      <td class="u-muted">100 configured</td>
                      <td>
                        <span class="pricefield">
                          <span class="pricefield__unit" aria-hidden="true">&#8358;</span>
                          <label class="u-visually-hidden" for="rp-r1-premium">
                            Sale price for Premium
                          </label>
                          <input class="field__input pricefield__input"
                                 id="rp-r1-premium" name="rp-r1-premium"
                                 type="text" inputmode="numeric" value=""
                                 data-tierprice="premium">
                        </span>
                      </td>
                    </tr>
                    <tr data-pricerow="vip">
                      <th scope="row">VIP</th>
                      <td class="u-muted">50 configured</td>
                      <td>
                        <span class="pricefield">
                          <span class="pricefield__unit" aria-hidden="true">&#8358;</span>
                          <label class="u-visually-hidden" for="rp-r1-vip">
                            Sale price for VIP
                          </label>
                          <input class="field__input pricefield__input"
                                 id="rp-r1-vip" name="rp-r1-vip"
                                 type="text" inputmode="numeric" value="40000"
                                 data-tierprice="vip">
                        </span>
                      </td>
                    </tr>
                      </tbody>
                    </table>
                  </div>
                  <p class="pricetable__empty" data-pricing-empty hidden>
                    Tick a ticket tier above and it appears here for pricing.
                  </p>
                  <span class="field__error" data-error="prices" hidden></span>
                </div>

              <section class="ticketaccess" aria-labelledby="acctitle-free">
                <h3 class="ticketaccess__title" id="acctitle-free">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z"/><path d="M9 9v6"/></svg> Applies to
                </h3>
                <!-- <p class="ticketaccess__text">
                  Choose the sessions the holder can attend, then anything extra that comes
                  with the ticket.
                </p> -->

                <fieldset class="fieldset">
                  <legend class="fieldset__legend">Session access</legend>
                  <div class="radios radios--2">
                    <label class="radio">
                      <input type="radio" name="acc-mode-free" value="all" checked>
                      <span class="radio__body">
                        <span class="radio__title">All standard sessions</span>
                        <span class="radio__text">Every session on every day of the event</span>
                      </span>
                    </label>
                    <label class="radio">
                      <input type="radio" name="acc-mode-free" value="days" data-reveal="accdays-free">
                      <span class="radio__body">
                        <span class="radio__title">Sessions on selected days</span>
                        <span class="radio__text">All standard sessions, but only on the days you tick</span>
                      </span>
                    </label>
                    <label class="radio">
                      <input type="radio" name="acc-mode-free" value="sessions" data-reveal="accsessions-free">
                      <span class="radio__body">
                        <span class="radio__title">Selected sessions</span>
                        <span class="radio__text">Only the sessions you pick, one by one</span>
                      </span>
                    </label>
                    <!-- <label class="radio">
                      <input type="radio" name="acc-mode-free" value="none">
                      <span class="radio__body">
                        <span class="radio__title">No session access</span>
                        <span class="radio__text">The ticket is for the extras below only &mdash; an add-on, a dinner or a lounge pass</span>
                      </span>
                    </label> -->
                  </div>
                </fieldset>

                <div class="scopepicker u-mt-5" id="accdays-free" hidden>
                  <p class="scopepicker__head">
                    Days come from your Schedule Builder &mdash; tick the ones this ticket
                    covers. All standard sessions on a ticked day are included.
                  </p>
                  <div class="scopeday__slots scopeday__slots--flush">
                    <label class="scopeslot">
                      <input type="checkbox" name="acc-free-day-1">
                      <span class="scopeslot__body">
                        <span class="scopeslot__name">Day 1 &mdash; Opening Day</span>
                        <span class="scopeslot__meta">2026-08-06 &middot; 3 sessions</span>
                      </span>
                    </label>
                    <label class="scopeslot">
                      <input type="checkbox" name="acc-free-day-2">
                      <span class="scopeslot__body">
                        <span class="scopeslot__name">Day 2 &mdash; Session 2</span>
                        <span class="scopeslot__meta">2026-08-07 &middot; 2 sessions</span>
                      </span>
                    </label>
                  </div>
                </div>

                <div class="scopepicker u-mt-5" id="accsessions-free" hidden>
                  <p class="scopepicker__head">
                    Pick individual sessions. Narrow the list first if your schedule is long.
                  </p>
                  <div class="sessionfilter" data-session-scope="accsessions-free">
                        <div class="sessionfilter__field sessionfilter__field--wide">
                          <label class="slotcard__label" for="sf-text-free">Search</label>
                          <input class="field__input" id="sf-text-free" name="sf-text-free"
                                 type="search" placeholder="Session, speaker or hall"
                                 data-session-filter="text">
                        </div>
                        <div class="sessionfilter__field">
                          <label class="slotcard__label" for="sf-date-free">Date</label>
                          <select class="field__select" id="sf-date-free" name="sf-date-free"
                                  data-session-filter="date">
                            <option value="">All</option>
                            <option>2026-08-06</option>
                            <option>2026-08-07</option>
                          </select>
                        </div>
                        <div class="sessionfilter__field">
                          <label class="slotcard__label" for="sf-venue-free">Venue</label>
                          <select class="field__select" id="sf-venue-free" name="sf-venue-free"
                                  data-session-filter="venue">
                            <option value="">All</option>
                            <option>Eko Convention Centre</option>
                            <option>Landmark Centre</option>
                          </select>
                        </div>
                        <div class="sessionfilter__field">
                          <label class="slotcard__label" for="sf-hall-free">Hall</label>
                          <select class="field__select" id="sf-hall-free" name="sf-hall-free"
                                  data-session-filter="hall">
                            <option value="">All</option>
                            <option>Main Hall</option>
                            <option>Hall B</option>
                            <option>Breakout Room 1</option>
                            <option>VIP Lounge</option>
                          </select>
                        </div>
                        <div class="sessionfilter__field">
                          <label class="slotcard__label" for="sf-track-free">Track</label>
                          <select class="field__select" id="sf-track-free" name="sf-track-free"
                                  data-session-filter="track">
                            <option value="">All</option>
                            <option>Keynote</option>
                            <option>Panel</option>
                            <option>Workshop</option>
                            <option>Clinic</option>
                          </select>
                        </div>
                  </div>
                  <div class="sessionlist">
                      <label class="sessionpick" data-session
                             data-session-date="2026-08-06" data-session-venue="Eko Convention Centre"
                             data-session-hall="Main Hall" data-session-track="Keynote"
                             data-session-text="Morning Keynote Kofi Asante, Amara Osei Main Hall">
                        <input type="checkbox" name="acc-free-s-1-1">
                        <span class="sessionpick__body">
                          <span class="sessionpick__name">Morning Keynote</span>
                          <span class="sessionpick__meta">
                            Day 1 &middot; 2026-08-06 &middot; 09:00 &ndash; 10:30
                          </span>
                          <span class="sessionpick__meta">
                            Eko Convention Centre &middot; Main Hall &middot; Kofi Asante, Amara Osei
                          </span>
                        </span>
                        <span class="sessionpick__tags">
                          <span class="badge badge--nodot badge--role">Keynote</span>
                          <span class="sessionpick__cap">500 places</span>
                        </span>
                      </label>
                      <label class="sessionpick" data-session
                             data-session-date="2026-08-06" data-session-venue="Eko Convention Centre"
                             data-session-hall="Hall B" data-session-track="Panel"
                             data-session-text="Fintech Panel Dr. Ngozi Eze Hall B">
                        <input type="checkbox" name="acc-free-s-1-2">
                        <span class="sessionpick__body">
                          <span class="sessionpick__name">Fintech Panel</span>
                          <span class="sessionpick__meta">
                            Day 1 &middot; 2026-08-06 &middot; 11:00 &ndash; 12:30
                          </span>
                          <span class="sessionpick__meta">
                            Eko Convention Centre &middot; Hall B &middot; Dr. Ngozi Eze
                          </span>
                        </span>
                        <span class="sessionpick__tags">
                          <span class="badge badge--nodot badge--role">Panel</span>
                          <span class="sessionpick__cap">180 places</span>
                        </span>
                      </label>
                      <label class="sessionpick" data-session
                             data-session-date="2026-08-06" data-session-venue="Eko Convention Centre"
                             data-session-hall="Breakout Room 1" data-session-track="Workshop"
                             data-session-text="Session 3 Femi Bello Breakout Room 1">
                        <input type="checkbox" name="acc-free-s-1-3">
                        <span class="sessionpick__body">
                          <span class="sessionpick__name">Session 3</span>
                          <span class="sessionpick__meta">
                            Day 1 &middot; 2026-08-06 &middot; 11:00 &ndash; 12:30
                          </span>
                          <span class="sessionpick__meta">
                            Eko Convention Centre &middot; Breakout Room 1 &middot; Femi Bello
                          </span>
                        </span>
                        <span class="sessionpick__tags">
                          <span class="badge badge--nodot badge--role">Workshop</span>
                          <span class="sessionpick__cap">60 places</span>
                        </span>
                      </label>
                      <label class="sessionpick" data-session
                             data-session-date="2026-08-07" data-session-venue="Eko Convention Centre"
                             data-session-hall="Main Hall" data-session-track="Workshop"
                             data-session-text="Design Sprint Amara Osei Main Hall">
                        <input type="checkbox" name="acc-free-s-2-1">
                        <span class="sessionpick__body">
                          <span class="sessionpick__name">Design Sprint</span>
                          <span class="sessionpick__meta">
                            Day 2 &middot; 2026-08-07 &middot; 09:30 &ndash; 11:00
                          </span>
                          <span class="sessionpick__meta">
                            Eko Convention Centre &middot; Main Hall &middot; Amara Osei
                          </span>
                        </span>
                        <span class="sessionpick__tags">
                          <span class="badge badge--nodot badge--role">Workshop</span>
                          <span class="sessionpick__cap">500 places</span>
                        </span>
                      </label>
                      <label class="sessionpick" data-session
                             data-session-date="2026-08-07" data-session-venue="Landmark Centre"
                             data-session-hall="VIP Lounge" data-session-track="Clinic"
                             data-session-text="Investor Clinic Panel &mdash; 4 speakers VIP Lounge">
                        <input type="checkbox" name="acc-free-s-2-2">
                        <span class="sessionpick__body">
                          <span class="sessionpick__name">Investor Clinic</span>
                          <span class="sessionpick__meta">
                            Day 2 &middot; 2026-08-07 &middot; 13:00 &ndash; 15:00
                          </span>
                          <span class="sessionpick__meta">
                            Landmark Centre &middot; VIP Lounge &middot; Panel &mdash; 4 speakers
                          </span>
                        </span>
                        <span class="sessionpick__tags">
                          <span class="badge badge--nodot badge--role">Clinic</span>
                          <span class="sessionpick__cap">100 places</span>
                        </span>
                      </label>
                  </div>
                  <p class="sessionlist__empty" data-session-empty hidden>
                    No session matches those filters.
                  </p>
                </div>

                <!-- <fieldset class="fieldset u-mt-5" data-incl-group="free">
                  <legend class="fieldset__legend">
                    <span class="switchcard switchcard--bare">
                      <span class="switchcard__title" id="incllabel-free">
                        Also included with this ticket
                      </span>
                      <button class="switch switch--brand" type="button" role="switch"
                              aria-checked="true" aria-labelledby="incllabel-free"
                              data-switch data-incl-switch="free"></button>
                    </span>
                  </legend>

                  <div data-incl-body="free">
                    <p class="inclhead">
                      What comes with this ticket beyond the sessions &mdash; your list, per
                      ticket type. Untick anything this tier does not get.
                    </p>

                    <div class="inclrows" id="incl-free">
                    <div class="inclrow" data-repeat-row data-incl-row>
                      <label class="inclrow__pick">
                        <input type="checkbox" name="acc-free-vip-lounge" data-incl-box>
                        <span class="inclrow__body">
                          <span class="inclrow__label" data-incl-label>VIP Lounge</span>
                          <span class="inclrow__note" data-incl-note>Private lounge with concierge, both days</span>
                        </span>
                      </label>
                      <span class="inclrow__edit">
                        <label class="u-visually-hidden" for="incl-free-vip-lounge-l">
                          What is included
                        </label>
                        <input class="field__input" id="incl-free-vip-lounge-l"
                               name="incl-free-vip-lounge-l" type="text" value="VIP Lounge"
                               data-incl-labelfield>
                        <label class="u-visually-hidden" for="incl-free-vip-lounge-n">
                          A line of detail
                        </label>
                        <input class="field__input" id="incl-free-vip-lounge-n"
                               name="incl-free-vip-lounge-n" type="text" value="Private lounge with concierge, both days"
                               data-incl-notefield>
                      </span>
