      </main>
      <footer class="wizard__foot">
        <a class="btn btn--outline" href="tickets-pricing.html" data-wizard-link>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 6l-6 6 6 6"/></svg> Back
        </a>
        <div class="wizard__foot-end">
          <a class="btn btn--quiet" href="payout-account.html" data-wizard-link>Skip</a>
          <a class="btn btn--primary" href="payout-account.html" data-wizard-link>Continue
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 6l6 6-6 6"/></svg>
          </a>
        </div>
      </footer>
    </div>
<script>
  (function () {
    'use strict';
    function all(sel, root) {
      return Array.prototype.slice.call((root || document).querySelectorAll(sel));
    }
    function toast(msg, tone) {
      var el = document.createElement('div');
      el.setAttribute('role', 'status');
      el.style.cssText = 'position:fixed;bottom:1.25rem;right:1.25rem;z-index:2000;padding:.75rem 1.1rem;border-radius:10px;font:600 13px/1.4 Inter,system-ui,sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.18);max-width:22rem;';
      if (tone === 'warn') { el.style.background = '#fef3c7'; el.style.color = '#92400e'; }
      else if (tone === 'danger') { el.style.background = '#fee2e2'; el.style.color = '#991b1b'; }
      else { el.style.background = '#ecfdf5'; el.style.color = '#065f46'; }
      el.innerHTML = String(msg);
      document.body.appendChild(el);
      setTimeout(function () { el.remove(); }, 3200);
    }

  'use strict';
  function all(sel, root) {
    return Array.prototype.slice.call((root || document).querySelectorAll(sel));
  }
  function one(sel, root) {
    return (root || document).querySelector(sel);
  }
  function toast(msg, tone) {
    var el = document.createElement('div');
    el.setAttribute('role', 'status');
    el.style.cssText = 'position:fixed;bottom:1.25rem;right:1.25rem;z-index:2000;padding:.75rem 1.1rem;border-radius:10px;font:600 13px/1.4 Inter,system-ui,sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.18);max-width:22rem;';
    if (tone === 'warn') { el.style.background = '#fef3c7'; el.style.color = '#92400e'; }
    else if (tone === 'danger') { el.style.background = '#fee2e2'; el.style.color = '#991b1b'; }
    else { el.style.background = '#ecfdf5'; el.style.color = '#065f46'; }
    el.innerHTML = String(msg);
    document.body.appendChild(el);
    setTimeout(function () { el.remove(); }, 3200);
  }

  document.addEventListener('click', function (e) {
    var open = e.target.closest && e.target.closest('[data-modal-open]');
    if (open) {
      var id = open.getAttribute('data-modal-open');
      var m = document.getElementById(id);
      if (m) { m.hidden = false; document.body.style.overflow = 'hidden'; }
      return;
    }
    var close = e.target.closest && e.target.closest('[data-modal-close]');
    if (close) {
      var modal = close.closest('[data-modal]');
      if (modal) { modal.hidden = true; document.body.style.overflow = ''; }
    }
  });

  document.addEventListener('click', function (e) {
    var opt = e.target.closest && e.target.closest('[data-applies]');
    if (!opt) return;
    var group = opt.closest('[role="radiogroup"]') || opt.parentElement;
    all('[data-applies]', group).forEach(function (b) {
      b.setAttribute('aria-checked', b === opt ? 'true' : 'false');
    });
    var card = opt.closest('[data-salerule]');
    if (card) {
      var val = opt.getAttribute('data-applies');
      all('[data-applies-panel]', card).forEach(function (p) {
        p.hidden = p.getAttribute('data-applies-panel') !== val;
      });
    }
  });

  var sidebar = one('[data-sidebar]');
  var burger = one('[data-sidebar-open]');
  if (burger && sidebar) {
    burger.addEventListener('click', function () { sidebar.classList.add('is-open'); });
  }
  document.addEventListener('click', function (e) {
    if (e.target.closest && e.target.closest('[data-backdrop]')) {
      if (sidebar) sidebar.classList.remove('is-open');
    }
  });

  /* ------------------------------------------------------------------------
     94. Sale rules & pricing
     --------------------------------------------------------------------------
     A sale rule is the only way a ticket gets a price. There is no regular or
     default price and no implicit fallback: a tier with no rule covering it
     cannot be sold, and the screen says so rather than quietly inventing a
     price.

     A rule spans tiers rather than belonging to one, which is what makes a
     single Early Bird rule able to price VIP and General out of one pool of
     100 tickets instead of being written twice. Its allocation is therefore a
     total across every tier it covers, and is deliberately a different number
     from any tier's own capacity — the coverage table exists to keep those two
     apart in the host's head.

     Validation is inline, next to the field that is wrong, and gathered again
     in one list under the preview.
     ------------------------------------------------------------------------ */

  var SR_TIERS = {
    general: { name: 'General', capacity: 500 },
    premium: { name: 'Premium', capacity: 100 },
    vip: { name: 'VIP', capacity: 50 }
  };

  var SR_DATES = {
    d1: 'Thu 6 Aug 2026',
    d2: 'Fri 7 Aug 2026'
  };

  var SR_SLOTS = {
    s1: '6 Aug · Morning Keynote',
    s2: '6 Aug · Fintech Panel',
    s3: '6 Aug · Afternoon Workshop',
    s4: '7 Aug · Design Sprint',
    s5: '7 Aug · Investor Clinic'
  };

  var SR_SLOT_DATE = { s1: 'd1', s2: 'd1', s3: 'd1', s4: 'd2', s5: 'd2' };

  var SR_AUDIENCE = { everyone: 'Everyone', members: 'Members' };

  var SR_TZ = 'WAT';

  function initSaleRules() {
    var list = document.querySelector('[data-rulelist]');
    if (!list) return;

    var template = document.querySelector('[data-rule-template]');
    var seq = 0;

    function money(n) {
      return '₦' + (n || 0).toLocaleString('en-US');
    }

    function num(el) {
      if (!el) return 0;
      var digits = String(el.value).replace(/[^\d]/g, '');
      return digits === '' ? 0 : parseInt(digits, 10);
    }

    function blank(el) {
      return !el || String(el.value).trim() === '';
    }

    function cards() {
      return all('[data-salerule]', list);
    }

    /* ---- reading one card ---- */
    function read(card) {
      var pick = function (hook) { return card.querySelector('[' + hook + ']'); };

      var tiers = all('[data-tierpick]', card)
        .filter(function (box) { return box.checked; })
        .map(function (box) { return box.getAttribute('data-tierpick'); });

      var prices = {};
      tiers.forEach(function (key) {
        var field = card.querySelector('[data-tierprice="' + key + '"]');
        prices[key] = { value: num(field), blank: blank(field), el: field };
      });

      var applies = (card.querySelector('[data-applies][aria-checked="true"]')
        || {}).getAttribute
        ? card.querySelector('[data-applies][aria-checked="true"]')
          .getAttribute('data-applies')
        : 'dates';

      return {
        el: card,
        id: card.getAttribute('data-salerule'),
        name: (card.querySelector('.salerule__name') || {}).value || 'Sale rule',
        allocEl: pick('data-rule-alloc'),
        alloc: num(pick('data-rule-alloc')),
        allocBlank: blank(pick('data-rule-alloc')),
        tiers: tiers,
        prices: prices,
        applies: applies,
        dates: all('[data-ruledate]', card).filter(function (b) { return b.checked; })
          .map(function (b) { return b.getAttribute('data-ruledate'); }),
        slots: all('[data-ruleslot]', card).filter(function (b) { return b.checked; })
          .map(function (b) { return b.getAttribute('data-ruleslot'); }),
        audience: (pick('data-rule-audience') || {}).value || 'everyone',
        start: (pick('data-rule-start') || {}).value || '',
        startTime: (pick('data-rule-starttime') || {}).value || '',
        end: (pick('data-rule-end') || {}).value || '',
        endTime: (pick('data-rule-endtime') || {}).value || ''
      };
    }

    function stamp(date, time) {
      if (!date) return null;
      var made = new Date(date + 'T' + (time || '00:00'));
      return isNaN(made.getTime()) ? null : made;
    }

    function shortDate(value) {
      var made = new Date(value + 'T00:00');
      if (isNaN(made.getTime())) return value;
      return made.toLocaleDateString('en-GB',
        { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function when(rule) {
      if (!rule.start || !rule.end) return 'Period not set';
      return shortDate(rule.start) + ', ' + rule.startTime + ' – '
        + shortDate(rule.end) + ', ' + rule.endTime + ' ' + SR_TZ;
    }

    /* The dates a rule touches, whether it was written as dates or as slots —
       two rules clash only if they can be bought on the same day. */
    function coveredDates(rule) {
      if (rule.applies === 'dates') return rule.dates.slice();

      var out = [];
      rule.slots.forEach(function (slot) {
        var date = SR_SLOT_DATE[slot];
        if (date && out.indexOf(date) === -1) out.push(date);
      });
      return out;
    }

    function scopeWords(rule) {
      if (rule.applies === 'dates') {
        if (!rule.dates.length) return 'No date chosen';
        return rule.dates.map(function (d) { return SR_DATES[d] || d; }).join(', ');
      }
      if (!rule.slots.length) return 'No slot chosen';
      return rule.slots.map(function (s) { return SR_SLOTS[s] || s; }).join(', ');
    }

    /* ---- what is wrong with one rule ---- */
    function problems(rule, others) {
      var found = [];

      if (rule.allocBlank || rule.alloc <= 0) {
        found.push(['alloc', 'Total allocation must be a positive number',
          rule.name + ' has no allocation, so it could never sell a ticket.']);
      }

      if (!rule.tiers.length) {
        found.push(['tiers', 'Choose at least one ticket tier',
          rule.name + ' covers no tier, so it prices nothing.']);
      }

      rule.tiers.forEach(function (key) {
        var price = rule.prices[key];
        if (price.blank) {
          found.push(['prices', 'Every selected tier needs a price',
            rule.name + ' has no price for ' + SR_TIERS[key].name + '.']);
        } else if (price.value <= 0) {
          found.push(['prices', 'A sale price must be more than zero',
            rule.name + ' prices ' + SR_TIERS[key].name + ' at nothing. Use a '
            + 'complimentary ticket tier for free entry.']);
        }
      });

      if (rule.applies === 'dates' && !rule.dates.length) {
        found.push(['scope', 'Select at least one date',
          rule.name + ' applies to dates but none are ticked.']);
      }
      if (rule.applies === 'slots' && !rule.slots.length) {
        found.push(['scope', 'Select at least one slot',
          rule.name + ' applies to slots but none are ticked.']);
      }
      rule.dates.forEach(function (d) {
        if (SR_DATES[d]) return;
        found.push(['scope', 'Selected date is not on this event',
          rule.name + ' points at a date the schedule no longer has.']);
      });
      rule.slots.forEach(function (sl) {
        if (SR_SLOTS[sl]) return;
        found.push(['scope', 'Selected slot is not on this event',
          rule.name + ' points at a slot the schedule no longer has.']);
      });

      var from = stamp(rule.start, rule.startTime);
      var to = stamp(rule.end, rule.endTime);

      if (!from || !to) {
        found.push(['period', 'Set a sale start and a sale end',
          rule.name + ' has no complete sale period, so it would never open.']);
      } else if (to <= from) {
        found.push(['period', 'Sale end must be later than sale start',
          rule.name + ' ends ' + (to < from ? 'before' : 'at')
          + ' the moment it starts. All times are ' + SR_TZ + '.']);
      }

      /* Two rules clash when a buyer could qualify for both at once: the same
         tier, the same audience, an overlapping period and an overlapping day.
         Any one of those differing is a legitimate configuration. */
      others.forEach(function (other) {
        if (other.id === rule.id) return;
        if (other.audience !== rule.audience) return;

        var shared = rule.tiers.filter(function (key) {
          return other.tiers.indexOf(key) !== -1;
        });
        if (!shared.length) return;

        var aFrom = from;
        var aTo = to;
        var bFrom = stamp(other.start, other.startTime);
        var bTo = stamp(other.end, other.endTime);
        if (!aFrom || !aTo || !bFrom || !bTo) return;
        if (aFrom >= bTo || bFrom >= aTo) return;

        var mine = coveredDates(rule);
        var theirs = coveredDates(other);
        var days = mine.filter(function (d) { return theirs.indexOf(d) !== -1; });
        if (!days.length) return;

        found.push(['period', 'Overlapping sale rule',
          rule.name + ' and ' + other.name + ' both offer '
          + shared.map(function (k) { return SR_TIERS[k].name; }).join(' and ')
          + ' to ' + SR_AUDIENCE[rule.audience].toLowerCase()
          + ' at the same time on ' + days.map(function (d) {
            return SR_DATES[d];
          }).join(' and ') + '.']);
      });

      return found;
    }

    /* ---- painting one card ---- */
    function paintCard(card, rule, found) {
      // inline errors, beside the field they belong to
      all('[data-error]', card).forEach(function (slot) {
        var key = slot.getAttribute('data-error');
        var mine = found.filter(function (p) { return p[0] === key; });
        slot.hidden = mine.length === 0;
        if (mine.length) slot.textContent = mine[0][1];
      });

      var count = card.querySelector('[data-tier-count]');
      if (count) {
        count.textContent = rule.tiers.length
          ? rule.tiers.length + ' of ' + Object.keys(SR_TIERS).length + ' selected'
          : 'None selected';
      }

      var scope = card.querySelector('[data-scope-count]');
      if (scope) {
        var n = rule.applies === 'dates' ? rule.dates.length : rule.slots.length;
        scope.textContent = n
          ? n + (rule.applies === 'dates'
            ? (n === 1 ? ' date selected' : ' dates selected')
            : (n === 1 ? ' slot selected' : ' slots selected'))
          : 'None selected';
      }

      var hint = card.querySelector('[data-audience-hint]');
      if (hint) {
        hint.textContent = rule.audience === 'members'
          ? 'Only verified members see this price at checkout.'
          : 'Anyone buying a ticket can use this price.';
      }

      var period = card.querySelector('[data-period-recap]');
      if (period) period.textContent = when(rule);

      var recap = card.querySelector('[data-rule-recap]');
      if (recap) {
        recap.textContent = rule.tiers.length
          ? rule.tiers.map(function (k) {
            return SR_TIERS[k].name + ' ' + money(rule.prices[k].value);
          }).join(' · ') + ' — ' + (rule.alloc || 0) + ' tickets, '
            + SR_AUDIENCE[rule.audience].toLowerCase()
          : 'No tier selected yet';
      }

      // the pricing table shows exactly the tiers that were ticked
      var priced = 0;
      all('[data-pricerow]', card).forEach(function (row) {
        var on = rule.tiers.indexOf(row.getAttribute('data-pricerow')) !== -1;
        row.hidden = !on;
        if (on) priced += 1;
      });
      var empty = card.querySelector('[data-pricing-empty]');
      var table = card.querySelector('[data-pricing-block] .tablewrap');
      if (empty) empty.hidden = priced > 0;
      if (table) table.hidden = priced === 0;

      var bad = found.filter(function (p) { return p[0] !== 'overlap'; });
      card.classList.toggle('is-bad', bad.length > 0);
      if (bad.length) card.classList.remove('is-saved');

      var box = card.querySelector('[data-rule-problems]');
      if (box) {
        box.hidden = found.length === 0;
        box.innerHTML = '';
        found.forEach(function (p) {
          var line = document.createElement('span');
          line.textContent = p[2];
          box.appendChild(line);
        });
      }

      var state = card.querySelector('[data-rule-state]');
      if (state && !card.classList.contains('is-saved')) {
        state.className = 'salerule__state' + (found.length ? ' is-bad' : '');
        state.textContent = found.length
          ? found.length + (found.length === 1 ? ' thing to fix' : ' things to fix')
          : 'Ready to save';
      }
    }

    /* ---- the whole screen ---- */
    function check() {
      var rules = cards().map(read);

      rules.forEach(function (rule) {
        paintCard(rule.el, rule, problems(rule, rules));
      });

      renumber();
      paintSummary(rules);
      paintCoverage(rules);
      paintPreview(rules);
      paintWarnings(rules);
    }

    function renumber() {
      cards().forEach(function (card, i) {
        var no = card.querySelector('.salerule__no');
        if (no) no.textContent = i + 1;
      });
    }

    function paintSummary(rules) {
      var covered = {};
      var total = 0;

      rules.forEach(function (rule) {
        total += rule.alloc;
        rule.tiers.forEach(function (key) { covered[key] = true; });
      });

      var uncovered = Object.keys(SR_TIERS).filter(function (key) {
        return !covered[key];
      });

      var countEl = document.querySelector('[data-rules-count]');
      var allocEl = document.querySelector('[data-rules-alloc]');
      var uncoveredEl = document.querySelector('[data-rules-uncovered]');
      var summary = document.querySelector('[data-rules-summary]');
      var none = document.querySelector('[data-rules-none]');

      if (countEl) countEl.textContent = rules.length;
      if (allocEl) allocEl.textContent = total.toLocaleString('en-US');
      if (uncoveredEl) {
        uncoveredEl.textContent = uncovered.length;
        var figure = uncoveredEl.closest('.rulesbar__figure');
        if (figure) figure.classList.toggle('is-clear', uncovered.length === 0);
      }
      if (none) none.hidden = rules.length > 0;

      if (summary) {
        summary.innerHTML = !rules.length
          ? 'Nothing can be sold until a rule exists.'
          : uncovered.length
            ? '<b>' + uncovered.map(function (k) { return SR_TIERS[k].name; })
              .join(' and ') + '</b> '
              + (uncovered.length === 1 ? 'has' : 'have')
              + ' no rule, so ' + (uncovered.length === 1 ? 'it' : 'they')
              + ' cannot be sold. Every other tier has a price.'
            : 'Every tier is priced by at least one rule.';
      }
    }

    /* A tier's capacity and a rule's allocation are different numbers, and the
       host has to be able to see both without doing the arithmetic. */
    function paintCoverage(rules) {
      Object.keys(SR_TIERS).forEach(function (key) {
        var row = document.querySelector('[data-tiersummary="' + key + '"]');
        if (!row) return;

        var mine = rules.filter(function (rule) {
          return rule.tiers.indexOf(key) !== -1;
        });
        var alloc = mine.reduce(function (sum, rule) { return sum + rule.alloc; }, 0);
        var prices = mine.map(function (rule) { return rule.prices[key].value; })
          .filter(function (v) { return v > 0; });

        var rulesCell = row.querySelector('[data-tiersummary-rules]');
        var allocCell = row.querySelector('[data-tiersummary-alloc]');
        var priceCell = row.querySelector('[data-tiersummary-price]');

        if (rulesCell) {
          rulesCell.textContent = mine.length
            ? mine.map(function (r) { return r.name; }).join(', ')
            : 'No rule — cannot be sold';
          rulesCell.className = mine.length ? '' : 'u-muted';
        }
        if (allocCell) {
          allocCell.textContent = mine.length
            ? 'up to ' + alloc.toLocaleString('en-US')
            : '—';
          // The allocation is shared across the tiers a rule covers, so it is
          // a ceiling rather than a promise — and saying "up to" is the
          // difference between informing and misleading.
          allocCell.className = alloc > SR_TIERS[key].capacity ? 'u-nowrap' : '';
        }
        if (priceCell) {
          if (!prices.length) {
            priceCell.textContent = '—';
          } else {
            var low = Math.min.apply(null, prices);
            var high = Math.max.apply(null, prices);
            priceCell.textContent = low === high
              ? money(low)
              : money(low) + ' – ' + money(high);
          }
        }
      });
    }

    function paintPreview(rules) {
      var host = document.querySelector('[data-preview-body]');
      if (!host) return;

      host.innerHTML = '';

      if (!rules.length) {
        var empty = document.createElement('tr');
        var cell = document.createElement('td');
        cell.colSpan = 7;
        cell.className = 'u-muted';
        cell.textContent = 'No sale rules yet — nothing can be sold.';
        empty.appendChild(cell);
        host.appendChild(empty);
        return;
      }

      rules.forEach(function (rule) {
        if (!rule.tiers.length) {
          host.appendChild(row(rule.name, '—', '—',
            SR_AUDIENCE[rule.audience], scopeWords(rule), when(rule),
            rule.alloc.toLocaleString('en-US'), true));
          return;
        }

        rule.tiers.forEach(function (key, i) {
          host.appendChild(row(
            i === 0 ? rule.name : '',
            SR_TIERS[key].name,
            rule.prices[key].blank ? 'Not set' : money(rule.prices[key].value),
            SR_AUDIENCE[rule.audience],
            scopeWords(rule),
            when(rule),
            i === 0 ? rule.alloc.toLocaleString('en-US') + ' shared' : '↳',
            rule.prices[key].blank));
        });
      });
    }

    function row(rule, tier, price, audience, scope, period, alloc, bad) {
      var tr = document.createElement('tr');
      if (bad) tr.className = 'is-bad';

      var th = document.createElement('th');
      th.setAttribute('scope', 'row');
      th.textContent = rule;
      tr.appendChild(th);

      [tier, price, audience, scope, period, alloc].forEach(function (value, i) {
        var td = document.createElement('td');
        td.textContent = value;
        if (i === 1 || i === 5) td.className = 'u-nowrap';
        tr.appendChild(td);
      });

      return tr;
    }

    function paintWarnings(rules) {
      var host = document.querySelector('[data-rule-warnings]');
      var ok = document.querySelector('[data-rules-ok]');
      if (!host) return;

      host.innerHTML = '';
      var seen = {};

      rules.forEach(function (rule) {
        problems(rule, rules).forEach(function (p) {
          var fingerprint = p[1] + '|' + p[2];
          if (seen[fingerprint]) return;
          seen[fingerprint] = true;

          var line = document.createElement('p');
          line.className = 'rulewarning'
            + (p[0] === 'alloc' || p[0] === 'period' ? ' rulewarning--bad' : '');
          line.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"'
            + ' stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"'
            + ' aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/>'
            + '<path d="M12 8v4.5M12 16h.01"/></svg><span><b></b><span></span></span>';
          line.querySelector('b').textContent = p[1];
          line.querySelector('span span').textContent = p[2];
          host.appendChild(line);
        });
      });

      if (ok) ok.hidden = host.children.length > 0 || !rules.length;
    }

    /* ---- wiring one card ---- */
    function wire(card) {
      // searchable tier picker
      var filter = card.querySelector('[data-tierpick-filter]');
      if (filter) {
        filter.addEventListener('input', function () {
          var want = filter.value.trim().toLowerCase();
          var shown = 0;

          all('[data-tierpick-opt]', card).forEach(function (opt) {
            var hay = opt.getAttribute('data-tierpick-search') || '';
            var match = !want || hay.indexOf(want) !== -1;
            opt.hidden = !match;
            if (match) shown += 1;
          });

          var none = card.querySelector('[data-tierpick-none]');
          if (none) none.hidden = shown > 0;
        });
      }

      // Applies to: dates or slots, never both
      all('[data-applies]', card).forEach(function (button) {
        button.addEventListener('click', function () {
          var want = button.getAttribute('data-applies');

          all('[data-applies]', card).forEach(function (other) {
            other.setAttribute('aria-checked',
              String(other.getAttribute('data-applies') === want));
          });
          all('[data-applies-panel]', card).forEach(function (panel) {
            panel.hidden = panel.getAttribute('data-applies-panel') !== want;
          });

          check();
        });
      });

      all('input, select', card).forEach(function (field) {
        field.addEventListener('input', check);
        field.addEventListener('change', check);
      });

      var save = card.querySelector('[data-rule-save]');
      if (save) {
        save.addEventListener('click', function () {
          var rule = read(card);
          var found = problems(rule, cards().map(read));

          if (found.length) {
            card.classList.add('is-bad');
            toast('<b>' + rule.name + '</b> is not ready — '
              + found[0][1].toLowerCase(), 'warn');

            var firstBad = card.querySelector('[data-error]:not([hidden])');
            if (firstBad) firstBad.scrollIntoView({ block: 'center' });
            return;
          }

          card.classList.add('is-saved');
          snapshot(card);

          var state = card.querySelector('[data-rule-state]');
          if (state) {
            state.className = 'salerule__state is-saved';
            state.textContent = 'Saved';
          }

          toast('<b>' + rule.name + '</b> saved — '
            + rule.tiers.length + (rule.tiers.length === 1 ? ' tier' : ' tiers')
            + ', ' + rule.alloc + ' tickets, ' + SR_AUDIENCE[rule.audience]
            .toLowerCase(), 'success');
        });
      }

      // Cancel puts the card back to the last saved state rather than clearing
      // it — a host who mistypes a price wants the old price back.
      var cancel = card.querySelector('[data-rule-cancel]');
      if (cancel) {
        cancel.addEventListener('click', function () {
          restore(card);
          check();
          toast('Changes to <b>' + read(card).name + '</b> discarded', 'warn');
        });
      }

      var duplicate = card.querySelector('[data-rule-duplicate]');
      if (duplicate) {
        duplicate.addEventListener('click', function () { clone(card); });
      }

      snapshot(card);
    }

    /* ---- save / restore, so Cancel has something to go back to ---- */
    function snapshot(card) {
      var state = { text: {}, checked: {}, applies: '' };

      all('input, select', card).forEach(function (field, i) {
        if (field.type === 'checkbox' || field.type === 'radio') {
          state.checked[i] = field.checked;
        } else {
          state.text[i] = field.value;
        }
      });

      var on = card.querySelector('[data-applies][aria-checked="true"]');
      state.applies = on ? on.getAttribute('data-applies') : 'dates';
      card.__saved = state;
    }

    function restore(card) {
      var state = card.__saved;
      if (!state) return;

      all('input, select', card).forEach(function (field, i) {
        if (field.type === 'checkbox' || field.type === 'radio') {
          if (state.checked[i] !== undefined) field.checked = state.checked[i];
        } else if (state.text[i] !== undefined) {
          field.value = state.text[i];
        }
      });

      all('[data-applies]', card).forEach(function (button) {
        button.setAttribute('aria-checked',
          String(button.getAttribute('data-applies') === state.applies));
      });
      all('[data-applies-panel]', card).forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-applies-panel') !== state.applies;
      });
    }

    /* ---- adding, cloning and removing ---- */
    function freshId() {
      seq += 1;
      return 'r' + (cards().length + 1) + 'n' + seq;
    }

    /* Every id, name and label inside a copied card has to become its own, or
       the new card's labels point back at the one it came from. */
    function rekeyCard(card, oldId, newId) {
      card.setAttribute('data-salerule', newId);

      all('[id]', card).forEach(function (el) {
        var was = el.id;
        var now = was.split(oldId).join(newId);
        if (was === now) return;

        all('label[for="' + was + '"]', card).forEach(function (label) {
          label.setAttribute('for', now);
        });
        ['data-upload', 'data-upload-dropzone'].forEach(function (hook) {
          all('[' + hook + '="' + was + '"]', card).forEach(function (other) {
            other.setAttribute(hook, now);
          });
        });
        el.id = now;
      });

      all('[name]', card).forEach(function (el) {
        el.name = el.name.split(oldId).join(newId);
      });

      var dup = card.querySelector('[data-rule-duplicate]');
      if (dup) dup.setAttribute('data-rule-duplicate', newId);
    }

    function add(source, oldId, named) {
      var id = freshId();
      var card = source.cloneNode(true);

      card.classList.remove('is-saved', 'is-bad');
      rekeyCard(card, oldId, id);

      var name = card.querySelector('.salerule__name');
      if (name) name.value = named;

      list.appendChild(card);
      wire(card);
      check();

      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      var alloc = card.querySelector('[data-rule-alloc]');
      if (alloc) alloc.focus();

      return card;
    }

    function clone(card) {
      var rule = read(card);
      add(card, rule.id, rule.name + ' (copy)');
      toast('<b>' + rule.name + '</b> duplicated — change what differs and save',
        'success');
    }

    all('[data-rule-add]').forEach(function (button) {
      button.addEventListener('click', function () {
        if (!template) return;

        var blankCard = template.content.firstElementChild.cloneNode(true);
        var wrapper = document.createElement('div');
        wrapper.appendChild(blankCard);

        add(blankCard, '__NEW__', 'Sale Rule ' + (cards().length + 1));
        toast('New sale rule added — set its allocation, tiers and prices',
          'success');
      });
    });

    // Removing a rule is delegated, so cloned cards need no extra binding.
    document.addEventListener('click', function (event) {
      var kill = event.target.closest && event.target.closest('[data-repeat-remove]');
      if (!kill || !kill.closest('[data-salerule]')) return;

      window.setTimeout(check, 0);
    });
    document.addEventListener('planora:rowsChanged', check);

    cards().forEach(wire);
    check();
  }



  
    function boot() { if (typeof initSaleRules === 'function') initSaleRules(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else setTimeout(boot, 0);
  })();
  </script>