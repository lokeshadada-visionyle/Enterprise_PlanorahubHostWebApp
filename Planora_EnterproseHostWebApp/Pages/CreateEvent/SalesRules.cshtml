                          <span class="slotpick__when">6 Aug 2026 &middot; 2:00 PM – 4:00 PM</span>
                        </span>
                      </label>
                      <label class="slotpick">
                        <input type="checkbox" name="rs-__NEW__-s4" value="s4"
                               data-ruleslot="s4">
                        <span class="slotpick__body">
                          <span class="slotpick__name">Design Sprint</span>
                          <span class="slotpick__when">7 Aug 2026 &middot; 9:30 AM – 11:00 AM</span>
                        </span>
                      </label>
                      <label class="slotpick">
                        <input type="checkbox" name="rs-__NEW__-s5" value="s5"
                               data-ruleslot="s5">
                        <span class="slotpick__body">
                          <span class="slotpick__name">Investor Clinic</span>
                          <span class="slotpick__when">7 Aug 2026 &middot; 1:00 PM – 3:00 PM</span>
                        </span>
                      </label>
                    </div>
                  </div>
