                </div>

                <!-- ---- who, and when ---- -->
                <div class="formgrid formgrid--2">
                  <div class="rulefield">
                    <label class="field__label" for="rau-__NEW__">Audience</label>
                    <select class="field__select" id="rau-__NEW__" name="rau-__NEW__"
                            data-rule-audience>
                      <option value="everyone" selected>Everyone</option>
                      <option value="members">Members</option>
                    </select>
                    <span class="field__hint" data-audience-hint></span>
                  </div>
