                <div class="rulewarn" data-rule-problems hidden></div>
              </div>

              <div class="salerule__foot">
                <span class="salerule__state" data-rule-state></span>
                <button class="btn btn--quiet btn--sm" type="button" data-rule-cancel>
                  Cancel
                </button>
                <button class="btn btn--primary btn--sm" type="button" data-rule-save>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8"/></svg> Save sale rule
                </button>
