<script>
    document.getElementById('brandingForm').addEventListener('submit', function() {
        var pressed = document.querySelector('#bgmode .bgpick__opt[aria-pressed="true"]');
        var mode = pressed ? pressed.getAttribute('data-pick') : 'light';
        var primary = document.getElementById('primary-colour').value || '#5A1D54';

        var colour = '#FFFFFF';
        if (mode === 'dark') colour = '#111111';
        if (mode === 'brand') colour = primary;

        document.getElementById('background-colour-input').value = colour;
    });

        // Live-sync organiser name into the preview as the field changes
        document.getElementById('brand-name')?.addEventListener('input', function (e) {
            document.querySelectorAll('[data-brand-name-preview]').forEach(function (el) {
                el.textContent = e.target.value || 'Acme Global';
            });
        });
</script>