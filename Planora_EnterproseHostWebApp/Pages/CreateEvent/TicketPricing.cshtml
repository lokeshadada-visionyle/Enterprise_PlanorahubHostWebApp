    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
            (function () {
                function valueOfPressed(container, selector, fallback) {
                    var el = container ? container.querySelector(selector + '[aria-pressed="true"]') : null;
                    return el ? (el.getAttribute('data-seatmode') || el.getAttribute('data-pick') || fallback) : fallback;
                }

                function addHidden(form, name, value) {
                    var existing = form.querySelector('input[type="hidden"][name="' + CSS.escape(name) + '"]');
                    if (existing) existing.value = value == null ? '' : value;
                    else {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = name;
                        input.value = value == null ? '' : value;
                        form.appendChild(input);
                    }
                }

                // Renames every id/name/for/aria-* attribute in a cloned tier that ends
                // with "-{oldSuffix}" to end with "-{newSuffix}" instead, so a cloned
                // tier's inputs, labels and reveal panels all point at each other again.
                function renameTierNode(node, oldSuffix, newSuffix) {
                    // Rename every attribute that contains the tier suffix so cloned
                    // tiers keep their own IDs and internal references.
                    var attrs = [
                        'id',
                        'name',
                        'for',
                        'aria-controls',
                        'aria-labelledby',
                        'data-reveal',
                        'data-upload',
                        'data-upload-dropzone',
                        'data-pick-owner',
                        'data-segment-owner',
                        'data-tier-repeat-add',
                        'data-incl-switch',
                        'data-incl-body',
                        'data-incl-off',
                        'data-includes',
                        'data-incl-group'
                    ];

                    var scoped = node.querySelectorAll(
                        '[id],[name],[for],[aria-controls],[aria-labelledby],' +
                        '[data-reveal],[data-upload],[data-upload-dropzone],' +
                        '[data-pick-owner],[data-segment-owner],[data-tier-repeat-add],' +
                        '[data-incl-switch],[data-incl-body],[data-incl-off],[data-includes]' + 
                        '[data-incl-group]'
                    );

                    var all = [node].concat(Array.prototype.slice.call(scoped));
                    var suffixTail = '-' + oldSuffix;

                    all.forEach(function (el) {
                        attrs.forEach(function (attr) {
                            var v = el.getAttribute && el.getAttribute(attr);
                            if (!v) return;

                            // Example: incl-early -> incl-tier2
                            if (v.slice(-suffixTail.length) === suffixTail) {
                                el.setAttribute(
                                    attr,
                                    v.slice(0, -oldSuffix.length) + newSuffix
                                );
                                return;
                            }

                            // Example: data-incl-switch=early -> tier2
                            if (
                                (attr === 'data-incl-switch' ||
                                    attr === 'data-incl-body' ||
                                    attr === 'data-incl-off' ||
                                    attr === 'data-includes') &&
                                v === oldSuffix
                            ) {
                                el.setAttribute(attr, newSuffix);
                            }
                        });
                    });
                }

                // ============================================================
                // Generic "data-reveal" / "data-reveal-inverse" engine.
                //
                // Several controls across the tier (the accdays/accsessions
                // radios, "Auto-expire", "Members only", "Assign seating for
                // this tier") show/hide a panel based on a radio, checkbox,
                // or role="switch" button. This was previously only wired up
                // for whatever existed in the DOM at initial page load, so
                // tiers added later via "Add Tier" never got the behaviour.
                // These helpers + the delegated listeners below make it
                // work regardless of when the element was created.
                // ============================================================
                function isRevealInputOn(input) {
                    return input.getAttribute('role') === 'switch'
                        ? input.getAttribute('aria-checked') === 'true'
                        : !!input.checked;
                }

                // root defaults to document, but a detached clone can be
                // passed in directly (before it's appended) so ids can
                // still be resolved from inside the clone itself.
                function applyReveal(input, root) {
                    root = root || document;
                    var on = isRevealInputOn(input);
                    var targetId = input.getAttribute('data-reveal');
                    var inverseId = input.getAttribute('data-reveal-inverse');

                    if (targetId) {
                        var target = root.querySelector('#' + CSS.escape(targetId));
                        if (target) target.toggleAttribute ? target.toggleAttribute('hidden', !on) : (on ? target.removeAttribute('hidden') : target.setAttribute('hidden', ''));
                    }
                    if (inverseId) {
                        var inverse = root.querySelector('#' + CSS.escape(inverseId));
                        if (inverse) (!on ? inverse.removeAttribute('hidden') : inverse.setAttribute('hidden', ''));
                    }
                }

                // Applies the current reveal state for every relevant input
                // inside a subtree (used right after a tier is cloned, so
                // its panels match its just-reset checkbox/radio state).
                function syncRevealsIn(root) {
                    root.querySelectorAll(
                        'input[type="radio"][data-reveal], input[type="radio"][data-reveal-inverse],' +
                        'input[type="checkbox"][data-reveal], input[type="checkbox"][data-reveal-inverse],' +
                        '[role="switch"][data-reveal], [role="switch"][data-reveal-inverse]'
                    ).forEach(function (el) { applyReveal(el, root); });
                }

                // Clears a cloned tier back to a blank/default state (no leftover values,
                // files, or "members only"/expanded panel state copied from the template).
                function clearTierValues(node) {
                    node.querySelectorAll('input[type="text"], input[type="date"], input[type="time"]')
                        .forEach(function (inp) { inp.value = ''; });
                    node.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
                        cb.checked = false;
                        cb.removeAttribute('checked');
                    });
                    node.querySelectorAll('input[type="file"]').forEach(function (f) { f.value = ''; });
                    node.querySelectorAll('[data-upload-directory]').forEach(function (d) {
                        d.setAttribute('hidden', '');
                    });
                    node.querySelectorAll('.upload').forEach(function (d) { d.removeAttribute('hidden'); });
                    var revenue = node.querySelector('.tier__revenue b');
                    if (revenue) revenue.textContent = '\u20a60';
                    var nameInput = node.querySelector('.tier__name');
                    if (nameInput) nameInput.value = '';
                    var hideButton = node.querySelector('[data-tier-hide]');
                    if (hideButton) hideButton.setAttribute('aria-pressed', 'false');

                    // Reset seating layout mode to a known default ("Row / Seat")
                    // instead of silently carrying over whatever mode the
                    // template tier happened to be left in.
                    var seatWrap = node.querySelector('[data-seatplan]');
                    if (seatWrap) {
                        seatWrap.querySelectorAll('[data-seatmode]').forEach(function (btn) {
                            btn.setAttribute('aria-pressed', btn.getAttribute('data-seatmode') === 'rows' ? 'true' : 'false');
                        });
                        seatWrap.querySelectorAll('[data-seatmode-panel]').forEach(function (panel) {
                            if (panel.getAttribute('data-seatmode-panel') === 'rows') panel.removeAttribute('hidden');
                            else panel.setAttribute('hidden', '');
                        });
                    }

                    // Any role="switch" controls (e.g. "Assign seating for this
                    // tier") were cloned as-is by cloneNode, so their aria-checked
                    // may not match the reset inputs above. Reset switches to
                    // "off" for a clean starting state, then resync every
                    // data-reveal panel in this tier to match.
                    node.querySelectorAll('[role="switch"][data-reveal], [role="switch"][data-reveal-inverse]')
                        .forEach(function (sw) { sw.setAttribute('aria-checked', 'false'); });
                    syncRevealsIn(node);
                }

                function fileToBase64(file) {
                    return new Promise(function (resolve, reject) {
                        var reader = new FileReader();
                        reader.onload = function () { resolve(String(reader.result).split(',')[1]); };
                        reader.onerror = reject;
                        reader.readAsDataURL(file);
                    });
                }

                document.addEventListener('DOMContentLoaded', function () {
                    // Guards against this whole setup running twice (e.g. if this
                    // step's markup+script is ever re-inserted into the page
                    // without a full reload). Without this guard, every listener
                    // below - including "Add Tier" - gets bound a second time,
                    // which is why one click was adding two tiers.
                    if (window.__tierPricingHandlersBound) return;
                    window.__tierPricingHandlersBound = true;

                    // ---- Session access radios, auto-expire, members-only, ----
                    // ---- seating switch: generic reveal/hide wiring ------------
                    // Delegated on document so it works for every tier,
                    // including ones added later via "Add Tier".
                    document.addEventListener('change', function (e) {
                        var input = e.target;
                        if (!input || (input.tagName !== 'INPUT')) return;

                        if (input.type === 'radio' && (input.hasAttribute('data-reveal') || input.hasAttribute('data-reveal-inverse'))) {
                            // Radios: re-evaluate every radio in the same name
                            // group so switching between "All standard sessions" /
                            // "Sessions on selected days" / "Selected sessions" /
                            // "No session access" is mutually exclusive.
                            if (input.name) {
                                document.querySelectorAll('input[type="radio"][name="' + CSS.escape(input.name) + '"]')
                                    .forEach(function (radio) { applyReveal(radio); });
                            } else {
                                applyReveal(input);
                            }
                            return;
                        }

                        if (input.type === 'checkbox' && (input.hasAttribute('data-reveal') || input.hasAttribute('data-reveal-inverse'))) {
                            applyReveal(input);
                        }
                    });

                    // Custom role="switch" buttons (e.g. "Assign seating for
                    // this tier") use aria-checked instead of a native checkbox.
                    document.addEventListener('click', function (e) {
                        var sw = e.target.closest('[role="switch"][data-reveal], [role="switch"][data-reveal-inverse]');
                        if (!sw) return;
                        var on = sw.getAttribute('aria-checked') === 'true';
                        sw.setAttribute('aria-checked', String(!on));
                        applyReveal(sw);
                    });

                    var form = document.querySelector('[data-ticket-pricing-form]');
                    if (!form) return;

                    var pricingMode = form.querySelector('#PricingMode');
                    var paidMode = document.querySelector('#paidmode');
                    if (paidMode) {
                        paidMode.addEventListener('click', function (e) {
                            var button = e.target.closest('[data-segment-value]');
                            if (button && pricingMode) pricingMode.value = button.getAttribute('data-segment-value') || 'paid';
                        });
                    }

                    // ---- Add Tier / Remove Tier -----------------------------------
                    var tierList = document.getElementById('tier-list');
                    var tierCounter = tierList ? tierList.querySelectorAll('.tier').length : 0;

                    // ---- Rehydrate existing tiers (edit flow) ----------------------
                    // Runs before the Add Tier wiring below so tierCounter/tierList
                    // already reflect any tiers created here.
                    (function rehydrateExistingTiers() {
                        var dataEl = document.getElementById('existing-ticket-data');
                        if (!dataEl || !tierList) return;

                        var items;
                        try {
                            items = JSON.parse(dataEl.textContent || '[]');
                        } catch (err) {
                            console.error('Could not parse existing ticket data:', err);
                            return;
                        }
                        if (!Array.isArray(items) || items.length === 0) return;

                        var isFree = pricingMode && pricingMode.value === 'free';

                        if (isFree) {
                            // Free events only ever have a single synthetic "Free" tier.
                            var freeItem = items[0] || {};
                            setFieldValue('free-tier-id', freeItem.ticketTypeId || 0);
                            setFieldValue('free-qty', freeItem.quantity);
                            setFieldValue('free-cap', freeItem.standingCapacity || freeItem.openSeatingCapacity);
                            setFieldValue('free-desc', freeItem.description);
                            return;
                        }

                        var template = tierList.querySelector('.tier');
                        if (!template) return;

                        // NOTE: only the fields common to every tier type are rehydrated
                        // here (name, price, quantity, description, visibility, sale
                        // window). Seating layout, auto-expiry, member-list file, access
                        // mode (day/slot selection) and inclusions are intentionally left
                        // at their template defaults until the exact TicketTypeTierResp
                        // shape for those is confirmed - wiring them up blind risked
                        // silently mis-mapping fields.
                        var freshTiers = [];
                        items.forEach(function (item) {
                            tierCounter += 1;
                            var suffix = 'existing' + tierCounter;

                            var clone = template.cloneNode(true);
                            renameTierNode(clone, 'early', suffix);
                            clearTierValues(clone);
                            // Marks this tier as an existing one to UPDATE (not add) on submit.
                            clone.setAttribute('data-ticket-type-id', String(item.ticketTypeId || 0));

                            setFieldOn(clone, 'tiername-' + suffix, item.typeName);
                            setFieldOn(clone, 'price-' + suffix, item.price);
                            setFieldOn(clone, 'qty-' + suffix, item.quantity);
                            setFieldOn(clone, 'desc-' + suffix, item.description);
                            setFieldOn(clone, 'salestart-' + suffix, item.saleStart);
                            setFieldOn(clone, 'saleend-' + suffix, item.saleEnd);

                            freshTiers.push(clone);
                        });

                        if (freshTiers.length > 0) {
                            // Replace the shipped placeholder tier(s) with the real ones.
                            tierList.querySelectorAll('.tier').forEach(function (t) { t.remove(); });
                            freshTiers.forEach(function (t) { tierList.appendChild(t); });
                            renumberTiers();
                        }

                        function setFieldValue(id, value) {
                            if (value === undefined || value === null) return;
                            var el = document.getElementById(id);
                            if (el) el.value = value;
                        }

                        function setFieldOn(root, name, value) {
                            if (value === undefined || value === null) return;
                            var el = root.querySelector('[name="' + name + '"]');
                            if (el) el.value = value;
                        }
                    })();

                    function renumberTiers() {
                        if (!tierList) return;
                        tierList.querySelectorAll('.tier').forEach(function (tier, i) {
                            var noEl = tier.querySelector('.tier__no');
                            if (!noEl) return;
                            noEl.textContent = String(i + 1);
                            noEl.className = noEl.className.replace(/tier__no--\d+/, 'tier__no--' + (i + 1));
                        });
                    }

                    var addTierBtn = document.querySelector('[data-tier-repeat-add="tier-list"]');
                    if (addTierBtn && tierList) {
                        addTierBtn.addEventListener('click', function () {
                            // Always clone the FIRST tier as the template: it is guaranteed
                            // to be in the clean/default state (no "members only" data,
                            // no uploaded file) unlike whichever tier happens to be last.
                            var template = tierList.querySelector('.tier');
                            if (!template) return;
                            var nameInput = template.querySelector('.tier__name');
                            var oldSuffix = nameInput ? (nameInput.getAttribute('name') || '').replace('tiername-', '') : '';
                            if (!oldSuffix) return;

                            tierCounter += 1;
                            var newSuffix = 'tier' + tierCounter;

                            var clone = template.cloneNode(true);
                            renameTierNode(clone, oldSuffix, newSuffix);
                            clearTierValues(clone);
                            // Always a brand-new tier, even if cloned from an existing (rehydrated) one.
                            clone.removeAttribute('data-ticket-type-id');

                            tierList.appendChild(clone);
                            renumberTiers();
                        });
                    }

                    if (tierList) {
                        tierList.addEventListener('click', function (e) {
                            var removeBtn = e.target.closest('[data-repeat-remove]');
                            if (!removeBtn) return;
                            var tiers = tierList.querySelectorAll('.tier');
                            if (tiers.length <= 1) return;
                            var tierNode = removeBtn.closest('.tier');
                            if (!tierNode) return;
                            tierNode.remove();
                            renumberTiers();
                        });
                    }
                    async function uploadMemberListsForTiers() {
                        if (!tierList) return;
                        var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                        var token = tokenInput ? tokenInput.value : '';
                        var eventIdInput = form.querySelector('#EventId');
                        var eventId = eventIdInput ? eventIdInput.value : '';

                        var tiers = Array.prototype.slice.call(tierList.querySelectorAll('.tier'));
                        for (var i = 0; i < tiers.length; i++) {
                            var tier = tiers[i];
                            var nameInput = tier.querySelector('.tier__name');
                            if (!nameInput) continue;
                            var suffix = (nameInput.getAttribute('name') || '').replace('tiername-', '');
                            if (!suffix) continue;

                            var membersCheckbox = tier.querySelector('#membersonly-' + CSS.escape(suffix));
                            var fileInput = tier.querySelector('#members-' + CSS.escape(suffix));
                            if (!membersCheckbox || !membersCheckbox.checked || !fileInput || !fileInput.files.length) continue;

                            var file = fileInput.files[0];
                            var base64;
                            try {
                                base64 = await fileToBase64(file);
                            } catch (err) {
                                console.error('Could not read ' + file.name, err);
                                continue;
                            }

                            try {
                                var resp = await fetch(window.location.pathname + '?handler=UploadMembers', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'RequestVerificationToken': token
                                    },
                                    body: JSON.stringify({
                                        eventId: eventId,
                                        tierSuffix: suffix,
                                        fileName: file.name,
                                        fileBase64: base64
                                    })
                                });
                                if (resp.ok) {
                                    var data = await resp.json();
                                    if (data && data.status === 1 && data.fileUrl) {
                                        addHidden(form, 'tier-memberfileurl-' + suffix, data.fileUrl);
                                    } else {
                                        console.error('Member list upload rejected for ' + suffix, data);
                                    }
                                } else {
                                    console.error('Member list upload failed for ' + suffix, resp.status);
                                }
                            } catch (err) {
                                console.error('Member list upload error for ' + suffix, err);
                            }
                        }
                    }

                    var readyToSubmit = false;
                    form.addEventListener('submit', function (e) {
                        if (readyToSubmit) return;

                        e.preventDefault();

                        if (pricingMode && !pricingMode.value) pricingMode.value = 'paid';

                        form.querySelectorAll('#tier-list > .tier').forEach(function (tier) {
                            var nameInput = tier.querySelector('.tier__name');
                            if (!nameInput) return;
                            var nameAttr = nameInput.getAttribute('name') || '';
                            var prefix = 'tiername-';
                            if (nameAttr.indexOf(prefix) !== 0) return;
                            var suffix = nameAttr.substring(prefix.length);
                            if (!suffix) return;

                            var hideButton = tier.querySelector('[data-tier-hide]');
                            var visible = hideButton ? (hideButton.getAttribute('aria-pressed') !== 'true') : true;
                            addHidden(form, 'tier-visible-' + suffix, visible ? 'true' : 'false');

                            // 0 means "new tier" (goes through Add); >0 means "existing tier" (goes through Update).
                            var ticketTypeId = tier.getAttribute('data-ticket-type-id') || '0';
                            addHidden(form, 'tier-id-' + suffix, ticketTypeId);

                            var seatingSwitch = tier.querySelector('[role="switch"][data-switch]');
                            var seatingEnabled = seatingSwitch ? (seatingSwitch.getAttribute('aria-checked') === 'true') : false;
                            addHidden(form, 'tier-seating-' + suffix, seatingEnabled ? 'true' : 'false');

                            var seatPlan = tier.querySelector('[data-seatplan]');
                            var seatMode = valueOfPressed(seatPlan, '[data-seatmode]', 'open');
                            addHidden(form, 'tier-seatmode-' + suffix, seatMode);

                            var expiry = tier.querySelector('[data-pick-group]');
                            var expiryMode = valueOfPressed(expiry, '[data-pick]', 'date');
                            addHidden(form, 'tier-expiry-mode-' + suffix, expiryMode);

                            var inclGroup = tier.querySelector('[data-incl-group="' + CSS.escape(suffix) + '"]');
                            if (inclGroup) {
                                var inclIdx = 0;
                                inclGroup.querySelectorAll('[data-incl-row]').forEach(function (row) {
                                    var box = row.querySelector('[data-incl-box]');
                                    if (!box || !box.checked) return;

                                    var nameField = row.querySelector('[data-incl-labelfield]');
                                    var noteField = row.querySelector('[data-incl-notefield]');
                                    var name = nameField ? nameField.value.trim() : '';
                                    var desc = noteField ? noteField.value.trim() : '';
                                    if (!name) return;

                                    addHidden(form, 'incl-name-' + suffix + '-' + inclIdx, name);
                                    addHidden(form, 'incl-desc-' + suffix + '-' + inclIdx, desc);
                                    inclIdx++;
                                });
                            }
                        });

                        uploadMemberListsForTiers()
                            .catch(function (err) { console.error('Member list upload step failed:', err); })
                            .then(function () {
                                readyToSubmit = true;
                                if (form.requestSubmit) form.requestSubmit();
                                else form.submit();
                            });
                    });
                });
            })();
    </script>
</div>
<script>
    (function () {
        // Prevent duplicate event handlers if this script is loaded more than once.
        if (window.__inclHandlersBound) return;
        window.__inclHandlersBound = true;

        document.addEventListener('click', function (e) {

            // ============================================================
            // Toggle: Seating layout mode (Row/Seat, Table/Chair, Standing,
            // Open seating). Delegated on document so this also works for
            // tiers added later via "Add Tier" (cloned nodes get no
            // listeners of their own, but delegation doesn't need any).
            // ============================================================
            var seatBtn = e.target.closest('[data-seatmode]');
            if (seatBtn) {
                var seatGroup = seatBtn.closest('[data-seatmode-group]');
                var seatPlanWrap = seatBtn.closest('[data-seatplan]');

                if (seatGroup) {
                    seatGroup.querySelectorAll('[data-seatmode]').forEach(function (btn) {
                        btn.setAttribute('aria-pressed', btn === seatBtn ? 'true' : 'false');
                    });
                }

                if (seatPlanWrap) {
                    var mode = seatBtn.getAttribute('data-seatmode');
                    seatPlanWrap.querySelectorAll('[data-seatmode-panel]').forEach(function (panel) {
                        if (panel.getAttribute('data-seatmode-panel') === mode) {
                            panel.removeAttribute('hidden');
                        } else {
                            panel.setAttribute('hidden', '');
                        }
                    });
                }
                return;
            }

            // ============================================================
            // Toggle: "Also included with this ticket"
            // ============================================================
            var sw = e.target.closest('[data-incl-switch]');
            if (sw) {
                var group = sw.getAttribute('data-incl-switch');
                var on = sw.getAttribute('aria-checked') === 'true';

                sw.setAttribute('aria-checked', String(!on));

                var body = document.querySelector(
                    '[data-incl-body="' + CSS.escape(group) + '"]'
                );
                var off = document.querySelector(
                    '[data-incl-off="' + CSS.escape(group) + '"]'
                );

                if (body) body.style.display = on ? 'none' : '';
                if (off) off.style.display = on ? 'block' : 'none';
                return;
            }

            // ============================================================
            // Edit included item
            // ============================================================
            var editBtn = e.target.closest('[data-incl-edit]');
            if (editBtn) {
                var row = editBtn.closest('[data-incl-row]');
                if (!row) return;

                row.classList.add('inclrow--editing');
                editBtn.hidden = true;

                var saveBtn = row.querySelector('[data-incl-save]');
                if (saveBtn) saveBtn.hidden = false;
                return;
            }

            // ============================================================
            // Save included item
            // ============================================================
            var saveBtn2 = e.target.closest('[data-incl-save]');
            if (saveBtn2) {
                var row2 = saveBtn2.closest('[data-incl-row]');
                if (!row2) return;

                var label = row2.querySelector('[data-incl-label]');
                var labelField = row2.querySelector('[data-incl-labelfield]');
                var note = row2.querySelector('[data-incl-note]');
                var noteField = row2.querySelector('[data-incl-notefield]');

                if (label && labelField) label.textContent = labelField.value;
                if (note && noteField) note.textContent = noteField.value;

                row2.classList.remove('inclrow--editing');
                saveBtn2.hidden = true;

                var editButton = row2.querySelector('[data-incl-edit]');
                if (editButton) editButton.hidden = false;
                return;
            }

            // ============================================================
            // Remove included item
            // ============================================================
            var removeBtn = e.target.closest('[data-repeat-remove]');
            if (removeBtn && removeBtn.closest('[data-incl-row]')) {
                var removeRow = removeBtn.closest('[data-incl-row]');
                if (removeRow) removeRow.remove();
                return;
            }

            // ============================================================
            // Add included item
            // ============================================================
            var addBtn = e.target.closest('[data-tier-repeat-add]');
            if (!addBtn) return;

            // IMPORTANT:
            // Never use document.getElementById() here.
            // The Add Item button belongs to a specific .tier.
            // Find that tier first, then find .inclrows INSIDE that tier.
            //
            // This guarantees:
            //   Day 1 Add Item -> Day 1 list
            //   Day 2 Add Item -> Day 2 list
            //   Day 3 Add Item -> Day 3 list
            //
            // It also makes this independent of cloned IDs/data attributes.
            var currentTier = addBtn.closest('#tier-list > .tier');

            // The global "Add Tier" button is not inside a .tier,
            // so it is ignored automatically.
            if (!currentTier) return;

            // Find the included-items list belonging ONLY to this tier.
            var list = currentTier.querySelector('.inclrows');

            if (!list) return;

            // Find the item template ONLY inside this tier.
            var template = list.querySelector('[data-incl-row]');

            if (!template) return;

            var clone = template.cloneNode(true);

            clone.classList.remove('inclrow--editing');

            var checkbox = clone.querySelector('[data-incl-box]');
            if (checkbox) {
                checkbox.checked = false;
                checkbox.removeAttribute('checked');
            }

            var label = clone.querySelector('[data-incl-label]');
            if (label) label.textContent = 'New item';

            var note = clone.querySelector('[data-incl-note]');
            if (note) note.textContent = 'Describe what this includes';

            var labelField = clone.querySelector('[data-incl-labelfield]');
            if (labelField) labelField.value = 'New item';

            var noteField = clone.querySelector('[data-incl-notefield]');
            if (noteField) noteField.value = 'Describe what this includes';

            var editButton = clone.querySelector('[data-incl-edit]');
            if (editButton) editButton.hidden = false;

            var saveButton = clone.querySelector('[data-incl-save]');
            if (saveButton) saveButton.hidden = true;

            // IMPORTANT: append to the exact list that belongs to the clicked button.
            list.appendChild(clone);
        });
    })();
    document.addEventListener('change', function (e) {
        // Check if the changed element is a member-list file input
        // (identified by the data-upload wiring, not by re-checking .accept -
        // the accept attribute is only a picker *hint*; the browser still lets
        // users choose "All Files" or drag-and-drop a non-matching file, so we
        // must branch on the real file below rather than assume CSV).
        if (e.target && e.target.type === 'file' && e.target.hasAttribute('data-upload')) {
            const fileInput = e.target;
            const file = fileInput.files[0];

            if (!file) return;

            // Find associated directory/preview container
            const directoryId = fileInput.getAttribute('data-upload');
            const directoryEl = document.getElementById(directoryId);

            if (!directoryEl) return;

            const extension = file.name.toLowerCase().slice(file.name.lastIndexOf('.'));

            if (extension === '.csv') {
                const reader = new FileReader();
                reader.onload = function (event) {
                    parseAndRenderCSV(event.target.result, directoryEl, file.name);
                };
                reader.onerror = function () {
                    alert('Could not read "' + file.name + '". Please try uploading it again.');
                };
                reader.readAsText(file);
            } else if (extension === '.xlsx') {
                if (typeof XLSX === 'undefined') {
                    alert('Excel file support failed to load. Please upload a CSV instead, or try again in a moment.');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (event) {
                    parseAndRenderXLSX(event.target.result, directoryEl, file.name);
                };
                reader.onerror = function () {
                    alert('Could not read "' + file.name + '". Please try uploading it again.');
                };
                // xlsx is a binary/zip format, not text - must be read as
                // an ArrayBuffer, never as text.
                reader.readAsArrayBuffer(file);
            } else {
                alert('"' + file.name + '" is not a supported file type. Please upload a .csv or .xlsx file.');
                fileInput.value = '';
            }
        }
    });

    function parseAndRenderXLSX(arrayBuffer, container, fileName) {
        let workbook;
        try {
            workbook = XLSX.read(arrayBuffer, { type: 'array' });
        } catch (err) {
            console.error('Error parsing xlsx file:', err);
            alert('"' + fileName + '" could not be read as an Excel file. Please check the file and try again.');
            return;
        }

        const firstSheetName = workbook.SheetNames[0];
        if (!firstSheetName) {
            alert('The uploaded Excel file has no sheets.');
            return;
        }

        const sheet = workbook.Sheets[firstSheetName];

        // header: 1 gives back an array-of-arrays (like the CSV rows below)
        // instead of objects keyed by header text, so both formats can share
        // the same row-shape and the same rendering code.
        const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, blankrows: false, defval: '' })
            .map(row => row.map(cell => String(cell).trim()));

        renderMemberRows(rows, container, fileName);
    }

    function parseAndRenderCSV(csvText, container, fileName) {
        // Split into non-empty lines
        const lines = csvText.split(/\r\n|\n/).map(line => line.trim()).filter(line => line.length > 0);

        if (lines.length === 0) {
            alert("The uploaded CSV file is empty.");
            return;
        }

        // Parse headers and rows
        const rows = lines.map(line => line.split(',').map(cell => cell.replace(/^"(.*)"$/, '$1').trim()));

        renderMemberRows(rows, container, fileName);
    }

    function renderMemberRows(rows, container, fileName) {
        if (!rows.length) {
            alert("The uploaded file has no data rows.");
            return;
        }

        // Assume first row is header or check if header contains 'name'/'email'
        let dataRows = rows;
        const hasHeader = (rows[0][0] || '').toLowerCase().includes("name") || (rows[0][1] || '').toLowerCase().includes("email");
        if (hasHeader) {
            dataRows = rows.slice(1);
        }

        // Locate elements inside directory container
        const scrollContainer = container.querySelector('.directory__scroll');
        const fileNameEl = container.querySelector('[data-upload-name]');
        const headCountEl = container.querySelector('.directory__head span:nth-child(2)');
        const footEl = container.querySelector('.directory__foot');
        const dropzoneEl = document.getElementById(container.getAttribute('data-upload-dropzone'));

        if (fileNameEl) fileNameEl.textContent = fileName;
        if (headCountEl) headCountEl.textContent = `${dataRows.length} members`;

        // Clear static fallback data
        scrollContainer.innerHTML = '';

        // Dynamically generate table rows from parsed CSV
        dataRows.forEach(row => {
            const name = row[0] || 'N/A';
            const email = row[1] || 'N/A';

            const rowDiv = document.createElement('div');
            rowDiv.className = 'directory__row';
            rowDiv.innerHTML = `
                            <span>${escapeHtml(name)}</span>
                            <span class="directory__email">${escapeHtml(email)}</span>
                            <span class="badge badge--live">Verified</span>
                        `;
            scrollContainer.appendChild(rowDiv);
        });

        if (footEl) {
            footEl.textContent = `Showing ${dataRows.length} of ${dataRows.length} · only these addresses can check out on this tier`;
        }

        // Toggle visibility: Hide dropzone and show parsed directory table
        if (dropzoneEl) dropzoneEl.hidden = true;
        container.hidden = false;
    }

    function escapeHtml(text) {
        return text.replace(/[&<>"']/g, function (m) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            }[m];
        });
    }
    async function uploadMemberCsv(fileInput, tierSuffix) {
        const file = fileInput.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async function (e) {
            const base64String = e.target.result.split(',')[1];

            const payload = {
                eventId: parseInt(document.getElementById('EventId').value) || 0,
                tierSuffix: tierSuffix,
                fileName: file.name,
                fileBase64: base64String
            };

            try {
                const response = await fetch('?handler=UploadMembers', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.status === 1) {
                    // Store the returned URL in a hidden input field for the tier
                    let hiddenInput = document.getElementById(`tier-memberfileurl-${tierSuffix}`);
                    if (!hiddenInput) {
                        hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.id = `tier-memberfileurl-${tierSuffix}`;
                        hiddenInput.name = `tier-memberfileurl-${tierSuffix}`;
                        fileInput.form.appendChild(hiddenInput);
                    }
                    hiddenInput.value = result.fileUrl;
                } else {
                    alert('Upload failed: ' + result.message);
                }
            } catch (err) {
                console.error('Error uploading member file:', err);
            }
        };
        reader.readAsDataURL(file);
    }
</script>
