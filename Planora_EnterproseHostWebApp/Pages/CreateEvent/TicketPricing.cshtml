                                    </p>

                                    <div class="sessionlist">
                                        @{
                                            var freeDaySeq = 0;
                                        }
                                        @if (Model.EventDates != null && Model.EventDates.Any())
                                        {
                                            foreach (var eventDate in Model.EventDates)
                                            {
                                                freeDaySeq++;
                                                var dayNumber = freeDaySeq;
                                                if (eventDate.EventSlots != null)
                                                {
                                                    foreach (var slot in eventDate.EventSlots)
                                                    {
                                                        var sessionText = $"{slot.SlotName} {slot.Speakers} Hall {slot.HallId}";
                                                        <label class="sessionpick" data-session
                                                               data-session-date="@eventDate.EventDateValue"
                                                               data-session-hall="Hall @slot.HallId"
                                                               data-session-text="@sessionText">
                                                            <input type="checkbox" name="acc-free-slot-@slot.SlotId" value="@slot.SlotId">
                                                            <span class="sessionpick__body">
                                                                <span class="sessionpick__name">@slot.SlotName</span>
                                                                <span class="sessionpick__meta">
                                                                    Day @dayNumber &middot; @eventDate.EventDateValue &middot; @slot.StartTime &ndash; @slot.EndTime
                                                                </span>
                                                                <span class="sessionpick__meta">
                                                                    Hall @slot.HallId@(string.IsNullOrWhiteSpace(slot.Speakers) ? "" : " &middot; " + slot.Speakers)
