                                <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
                                Guests see the 2% commission as a separate line at checkout. Ticket face
                                value reaches your payout untouched, but conversion typically dips 2&ndash;4%.
                            </p>
                        </div>
                    </div>
                </section>

                <section class="panel" id="capacity-charges" aria-labelledby="capcharge-title">
                    <div class="panel__head">
                        <span class="tile tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg></span>
                        <div>
                            <h2 class="panel__title" id="capcharge-title">Capacity &amp; Charges</h2>
                            <p class="panel__meta">
                                What this event holds, and what it costs if you need more guests after
                                publishing
                            </p>
                        </div>
                    </div>
                    <div class="panel__body">
                        <div class="tablewrap">
                            <table class="table table--narrow">
                                <caption class="u-visually-hidden">
                                    Configured sessions, slots and hall capacity for this event
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Session</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Slot</th>
                                        <th scope="col">Time</th>
                                        <th scope="col">Hall</th>
                                        <th scope="col">Capacity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.EventDates != null && Model.EventDates.Count > 0)
                                    {
                                        @foreach (var eventDate in Model.EventDates)
                                        {
                                            if (eventDate.EventSlots != null && eventDate.EventSlots.Count > 0)
                                            {
                                                @foreach (var slot in eventDate.EventSlots)
                                                {
                                                    <tr>
                                                        <td scope="row">@eventDate.SessionName</td>
                                                        <td>@eventDate.EventDateValue</td>
                                                        <td>@slot.SlotName</td>
                                                        <td>@slot.StartTime &ndash; @slot.EndTime</td>
                                                        <td>Hall @slot.HallId</td>
                                                        <td>@slot.Capacity</td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6">No dates/slots configured for this event yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <p class="capsummary u-mt-5">
                            <span class="capsummary__lead">
                                <b>@eventTotalCapacity</b> seats across @eventHallCount hall@(eventHallCount == 1 ? "" : "s") &middot; seating is enabled, so
                                added guests are turned into rows, tables or headroom automatically
                            </span>
                            <span class="capsummary__note">
                                After publishing, Guests, Seating Layout and ticket management all offer
                                <b>Add guests</b>. You enter a headcount; the layout above decides what
                                gets built.
                            </span>
                        </p>

                        <!-- Private: never commissioned, tickets or not -->
                        <div data-type-only="private" hidden>
                            <p class="notice notice--success notice--flat u-mt-5">
                                <svg class="notice__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                <span>
                                    <b>Private event &mdash; no charge, now or later.</b><br>
                                    Adding guests after publishing costs nothing, and sending them tickets
                                    or invitations costs nothing either. Only WhatsApp and email credits
                                    are used to deliver the passes.
                                </span>
                            </p>
                        </div>

                        <!-- Public: the answer depends on whether tickets are sold -->
                        <div data-type-hide="private">
                            <div data-segment-panel="free" data-segment-owner="paidmode" hidden>
                                <p class="notice notice--success notice--flat u-mt-5">
                                    <svg class="notice__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>
                                        <b>Public, non-ticketed &mdash; no charge.</b><br>
                                        With no tickets on sale there is no gross to commission, so this is
                                        enterprise capacity under your plan. Adding guests after publishing
                                        is free as well.
                                    </span>
                                </p>
                            </div>

                            <div data-segment-panel="paid" data-segment-owner="paidmode">
                                <p class="notice notice--alert notice--flat u-mt-5">
                                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 5 5 19" /><circle cx="7.5" cy="7.5" r="2.5" /><circle cx="16.5" cy="16.5" r="2.5" /></svg>
                                    <span>
                                        <b>Public, ticketed &mdash; 2% commission on gross ticket sales.</b><br>
                                        The same 2% applies to any capacity you add after publishing, taken
                                        only on the seats that actually sell, and settled through this same
                                        ticketing flow. Nothing is owed for seats that go unsold.
                                    </span>
                                </p>

                                @* <div class="invoice u-mt-5">
                                    <p class="invoice__row">
                                        <span>Gross if every seat sells at its tier price</span>
                                        <span>&#8358;7,450,000</span>
                                    </p>
                                    <p class="invoice__row">
                                        <span>Commission at 2%</span><span>&#8358;149,000</span>
                                    </p>
                                    <p class="invoice__row invoice__row--total">
                                        <span>Due to publish</span><span>&#8358;0</span>
                                    </p>
                                </div> *@
                            </div>
                        </div>
                    </div>
                </section>

                <p class="notice notice--info notice--flat" data-segment-panel="paid" data-segment-owner="paidmode">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3"></path></svg>
                    <span>
                        <b>Payout account is the next step.</b><br>
                        Where the money lands is asked separately, because the fields differ by
                        country — and it is optional: skip it here and set it up under
                        <b>Event Hub → Payout</b> before you request a payout.
                    </span>
                </p>
                <!-- Free events need none of the above -->
                <p class="notice notice--info notice--flat" data-segment-panel="free"
                   data-segment-owner="paidmode" hidden>
                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                    Free events have no commission or payout account &mdash; there is nothing
                    to settle. Add-ons and coupons are skipped too.
                </p>

            </form>
        </div>
    </main>

    <footer class="wizard__foot">
        <a class="btn btn--outline" asp-page="/CreateEvent/ContentSection" data-wizard-link><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 6l-6 6 6 6" /></svg> Back</a>
        <div class="wizard__foot-end">
            <!-- <a class="btn btn--quiet" href="addons-coupons.html" data-wizard-link>Skip</a> -->
            <button class="btn btn--primary" form="TicketPriceForm" type="submit" data-wizard-link>Continue <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 6l6 6-6 6" /></svg></button>
        </div>
    </footer>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
            (function() {
                function valueOfPressed(container, selector, fallback) {
                    var el = container ? container.querySelector(selector + '[aria-pressed="true"]') : null;
                    return el ? (el.getAttribute('data-seatmode') || el.getAttribute('data-pick') || fallback) : fallback;
                }

                function addHidden(form, name, value) {
                    var existing = form.querySelector('input[type="hidden"][name="' + CSS.escape(name) + '"]');
                    if (existing) existing.value = value == null ? '' : value;
                    else {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = name;
                        input.value = value == null ? '' : value;
                        form.appendChild(input);
                    }
                }

                // Renames every id/name/for/aria-* attribute in a cloned tier that ends
                // with "-{oldSuffix}" to end with "-{newSuffix}" instead, so a cloned
                // tier's inputs, labels and reveal panels all point at each other again.
                function renameTierNode(node, oldSuffix, newSuffix) {
                    // Rename every attribute that contains the tier suffix so cloned
                    // tiers keep their own IDs and internal references.
                    var attrs = [
                        'id',
                        'name',
                        'for',
                        'aria-controls',
                        'aria-labelledby',
                        'aria-describedby',
                        'data-reveal',
                        'data-upload',
                        'data-upload-dropzone',
                        'data-pick-owner',
                        'data-segment-owner',
                        'data-tier-repeat-add',
                        'data-incl-switch',
                        'data-incl-body',
                        'data-incl-off',
                        'data-includes',
                        'data-incl-group',
                        'data-desc-prev'
                    ];

                    var scoped = node.querySelectorAll(
                        '[id],[name],[for],[aria-controls],[aria-labelledby],[aria-describedby],' +
                        '[data-reveal],[data-upload],[data-upload-dropzone],' +
                        '[data-pick-owner],[data-segment-owner],[data-tier-repeat-add],' +
                        '[data-incl-switch],[data-incl-body],[data-incl-off],[data-includes],' +
                        '[data-incl-group],[data-desc-prev]'
                    );

                    var all = [node].concat(Array.prototype.slice.call(scoped));
                    var suffixTail = '-' + oldSuffix;

                    all.forEach(function(el) {
                        attrs.forEach(function(attr) {
                            var v = el.getAttribute && el.getAttribute(attr);
                            if (!v) return;

                            // Example: incl-early -> incl-tier2
                            if (v.slice(-suffixTail.length) === suffixTail) {
                                el.setAttribute(
                                    attr,
                                    v.slice(0, -oldSuffix.length) + newSuffix
                                );
                                return;
                            }

                            // Example: data-incl-switch=early -> tier2
                            if (
                                (attr === 'data-incl-switch' ||
                                    attr === 'data-incl-body' ||
                                    attr === 'data-incl-off' ||
                                    attr === 'data-includes' ||
                                    attr === 'data-incl-group') &&
                                v === oldSuffix
                            ) {
                                el.setAttribute(attr, newSuffix);
                            }
                        });
                    });
                }

                // ============================================================
                // Generic "data-reveal" / "data-reveal-inverse" engine.
                //
                // Several controls across the tier (the accdays/accsessions
                // radios, "Auto-expire", "Members only", "Assign seating for
                // this tier") show/hide a panel based on a radio, checkbox,
                // or role="switch" button. This was previously only wired up
                // for whatever existed in the DOM at initial page load, so
                // tiers added later via "Add Tier" never got the behaviour.
                // These helpers + the delegated listeners below make it
                // work regardless of when the element was created.
                // ============================================================
                function isRevealInputOn(input) {
                    return input.getAttribute('role') === 'switch'
                        ? input.getAttribute('aria-checked') === 'true'
                        : !!input.checked;
                }

                // root defaults to document, but a detached clone can be
                // passed in directly (before it's appended) so ids can
                // still be resolved from inside the clone itself.
                function applyReveal(input, root) {
                    root = root || document;
                    var on = isRevealInputOn(input);
                    var targetId = input.getAttribute('data-reveal');
                    var inverseId = input.getAttribute('data-reveal-inverse');

                    if (targetId) {
                        var target = root.querySelector('#' + CSS.escape(targetId));
                        if (target) target.toggleAttribute ? target.toggleAttribute('hidden', !on) : (on ? target.removeAttribute('hidden') : target.setAttribute('hidden', ''));
                    }
                    if (inverseId) {
                        var inverse = root.querySelector('#' + CSS.escape(inverseId));
                        if (inverse) (!on ? inverse.removeAttribute('hidden') : inverse.setAttribute('hidden', ''));
                    }
                }

                // Applies the current reveal state for every relevant input
                // inside a subtree (used right after a tier is cloned, so
                // its panels match its just-reset checkbox/radio state).
                function syncRevealsIn(root) {
                    root.querySelectorAll(
                        'input[type="radio"][data-reveal], input[type="radio"][data-reveal-inverse],' +
                        'input[type="checkbox"][data-reveal], input[type="checkbox"][data-reveal-inverse],' +
                        '[role="switch"][data-reveal], [role="switch"][data-reveal-inverse]'
                    ).forEach(function(el) { applyReveal(el, root); });
                }

                // Clears a cloned tier back to a blank/default state (no leftover values,
                // files, or "members only"/expanded panel state copied from the template).
                function clearTierValues(node) {
                    node.querySelectorAll('input[type="text"], input[type="date"], input[type="time"]')
                        .forEach(function(inp) { inp.value = ''; });
                    node.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
                        cb.checked = false;
                        cb.removeAttribute('checked');
                    });
                    node.querySelectorAll('input[type="file"]').forEach(function(f) { f.value = ''; });
                    node.querySelectorAll('[data-upload-directory]').forEach(function(d) {
                        d.setAttribute('hidden', '');
                    });
                    node.querySelectorAll('.upload').forEach(function(d) { d.removeAttribute('hidden'); });
                    var revenue = node.querySelector('.tier__revenue b');
                    if (revenue) revenue.textContent = '\u20a60';
                    var nameInput = node.querySelector('.tier__name');
                    if (nameInput) nameInput.value = '';
                    var hideButton = node.querySelector('[data-tier-hide]');
                    if (hideButton) hideButton.setAttribute('aria-pressed', 'false');

                    // Reset seating layout mode to a known default ("Row / Seat")
                    // instead of silently carrying over whatever mode the
                    // template tier happened to be left in.
                    var seatWrap = node.querySelector('[data-seatplan]');
                    if (seatWrap) {
                        seatWrap.querySelectorAll('[data-seatmode]').forEach(function(btn) {
                            btn.setAttribute('aria-pressed', btn.getAttribute('data-seatmode') === 'rows' ? 'true' : 'false');
                        });
                        seatWrap.querySelectorAll('[data-seatmode-panel]').forEach(function(panel) {
                            if (panel.getAttribute('data-seatmode-panel') === 'rows') panel.removeAttribute('hidden');
                            else panel.setAttribute('hidden', '');
                        });
                    }

                    // Any role="switch" controls (e.g. "Assign seating for this
                    // tier") were cloned as-is by cloneNode, so their aria-checked
                    // may not match the reset inputs above. Reset switches to
                    // "off" for a clean starting state, then resync every
                    // data-reveal panel in this tier to match.
                    node.querySelectorAll('[role="switch"][data-reveal], [role="switch"][data-reveal-inverse]')
                        .forEach(function(sw) { sw.setAttribute('aria-checked', 'false'); });
                    syncRevealsIn(node);
                }

                function fileToBase64(file) {
                    return new Promise(function(resolve, reject) {
                        var reader = new FileReader();
                        reader.onload = function() { resolve(String(reader.result).split(',')[1]); };
                        reader.onerror = reject;
                        reader.readAsDataURL(file);
                    });
                }

                document.addEventListener('DOMContentLoaded', function() {
                    // Guards against this whole setup running twice (e.g. if this
                    // step's markup+script is ever re-inserted into the page
                    // without a full reload). Without this guard, every listener
                    // below - including "Add Tier" - gets bound a second time,
                    // which is why one click was adding two tiers.
                    if (window.__tierPricingHandlersBound) return;
                    window.__tierPricingHandlersBound = true;

                    // ---- Session access radios, auto-expire, members-only, ----
                    // ---- seating switch: generic reveal/hide wiring ------------
                    // Delegated on document so it works for every tier,
                    // including ones added later via "Add Tier".
                    document.addEventListener('change', function(e) {
                        var input = e.target;
                        if (!input || (input.tagName !== 'INPUT')) return;

                        if (input.type === 'radio' && (input.hasAttribute('data-reveal') || input.hasAttribute('data-reveal-inverse'))) {
                            // Radios: re-evaluate every radio in the same name
                            // group so switching between "All standard sessions" /
                            // "Sessions on selected days" / "Selected sessions" /
                            // "No session access" is mutually exclusive.
                            if (input.name) {
                                document.querySelectorAll('input[type="radio"][name="' + CSS.escape(input.name) + '"]')
                                    .forEach(function(radio) { applyReveal(radio); });
                            } else {
                                applyReveal(input);
                            }
                            return;
                        }

                        if (input.type === 'checkbox' && (input.hasAttribute('data-reveal') || input.hasAttribute('data-reveal-inverse'))) {
                            applyReveal(input);
                        }
                    });

                    // Custom role="switch" buttons (e.g. "Assign seating for
                    // this tier") use aria-checked instead of a native checkbox.
                    document.addEventListener('click', function(e) {
                        var sw = e.target.closest('[role="switch"][data-reveal], [role="switch"][data-reveal-inverse]');
                        if (!sw) return;
                        var on = sw.getAttribute('aria-checked') === 'true';
                        sw.setAttribute('aria-checked', String(!on));
                        applyReveal(sw);
                    });

                    var form = document.querySelector('[data-ticket-pricing-form]');
                    if (!form) return;

                    var pricingMode = form.querySelector('#PricingMode');
                    var pricingModeGroup = document.getElementById('paidmode');

                    // ============================================================
                    // Pricing mode
                    // PUBLIC  event -> Free or Paid
                    // PRIVATE event -> Paid only
                    //
                    // PricingMode is a real form field and is the value that is
                    // posted to OnPost(). The selected pricing button is the
                    // client-side source of truth for that hidden field.
                    // ============================================================
                    var isPrivateEvent = @(pageIsPrivateEvent ? "true" : "false");

                    function normalizePricingMode(mode) {
                        mode = (mode || '').toString().trim().toLowerCase();

                        // Private events are paid-only.
                        if (isPrivateEvent) {
                            return 'paid';
                        }

                        // Public events support both modes.
                        return mode === 'free' ? 'free' : 'paid';
                    }

                    function syncPricingMode(mode) {
                        var normalizedMode = normalizePricingMode(mode);

                        // Always update the actual hidden input that ASP.NET binds.
                        var hiddenPricingMode = document.getElementById('PricingMode');
                        if (hiddenPricingMode) {
                            hiddenPricingMode.value = normalizedMode;
                        }

                        // Update the visual selected button.
                        if (pricingModeGroup) {
                            pricingModeGroup.querySelectorAll('[data-segment-value]').forEach(function(button) {
                                var buttonMode = (button.getAttribute('data-segment-value') || '')
                                    .toString()
                                    .trim()
                                    .toLowerCase();

                                button.setAttribute(
                                    'aria-pressed',
                                    buttonMode === normalizedMode ? 'true' : 'false'
                                );
                            });
                        }

                        // Show only the sections belonging to the selected mode.
                        document.querySelectorAll('[data-segment-owner="paidmode"]').forEach(function(panel) {
                            var panelMode = (panel.getAttribute('data-segment-panel') || '')
                                .toString()
                                .trim()
                                .toLowerCase();

                            if (panelMode === normalizedMode &&
                                !(isPrivateEvent && panelMode === 'free')) {
                                panel.removeAttribute('hidden');
                            } else {
                                panel.setAttribute('hidden', '');
                            }
                        });

                        return normalizedMode;
                    }

                    // ------------------------------------------------------------
                    // Initial state.
                    // Do not force a PUBLIC event to Paid when the server already
                    // rendered PricingMode = free.
                    // ------------------------------------------------------------
                    syncPricingMode(
                        pricingMode ? pricingMode.value : 'paid'
                    );

                    // ------------------------------------------------------------
                    // Free / Paid button click.
                    // This directly changes the hidden PricingMode field.
                    // ------------------------------------------------------------
                    if (pricingModeGroup) {
                        pricingModeGroup.addEventListener('click', function(e) {
                            var button = e.target.closest('[data-segment-value]');

                            if (!button || !pricingModeGroup.contains(button)) {
                                return;
                            }

                            var selectedMode = button.getAttribute('data-segment-value') || 'paid';

                            syncPricingMode(selectedMode);

                            console.log(
                                '[TicketPricing] Selected pricing mode:',
                                document.getElementById('PricingMode')
                                    ? document.getElementById('PricingMode').value
                                    : 'PricingMode field not found'
                            );
                        });
                    }

                    // ---- Add Tier / Remove Tier -----------------------------------
                    var tierList = document.getElementById('tier-list');
                    var tierCounter = tierList ? tierList.querySelectorAll('.tier').length : 0;

                    // ---- Rehydrate existing tiers (edit flow) ----------------------
                    // Runs before the Add Tier wiring below so tierCounter/tierList
                    // already reflect any tiers created here.
                    try {
                    (function rehydrateExistingTiers() {
                        var dataEl = document.getElementById('existing-ticket-data');
                        if (!dataEl || !tierList) return;

                        var items;
                        try {
                            items = JSON.parse(dataEl.textContent || '[]');
                        } catch (err) {
                            console.error('Could not parse existing ticket data:', err);
                            return;
                        }
                        if (!Array.isArray(items) || items.length === 0) return;

                        var isFree = pricingMode && pricingMode.value === 'free';

                        if (isFree) {
                            // Free events only ever have a single synthetic "Free" tier.
                            var freeItem = items[0] || {};
                            setFieldValue('free-tier-id', freeItem.ticketTypeId || 0);
                            setFieldValue('free-qty', freeItem.quantity);
                            setFieldValue('free-cap', freeItem.standingCapacity || freeItem.openSeatingCapacity);
                            setFieldValue('free-desc', freeItem.description);
                            return;
                        }

                        var template = tierList.querySelector('.tier');
                        if (!template) return;

                        // NOTE: only the fields common to every tier type are rehydrated
                        // here (name, price, quantity, description, visibility, sale
                        // window) plus Inclusions (checkbox + label/desc, matched against
                        // the saved item.Inclusions by name - see rehydrateInclusions
                        // below). Seating layout, auto-expiry, member-list file, and
                        // access mode (day/slot selection) are still left at their
                        // template defaults until the exact TicketTypeTierResp shape for
                        // those is confirmed - wiring them up blind risked silently
                        // mis-mapping fields.
                        var freshTiers = [];
                        items.forEach(function(item) {
                            tierCounter += 1;
                            var suffix = 'existing' + tierCounter;

                            var clone = template.cloneNode(true);
                            renameTierNode(clone, 'early', suffix);

                            // clearTierValues() wipes every input[type=text] and
                            // input[type=checkbox] in the clone, including the
                            // inclusion rows' checkbox/label/description fields (they
                            // are plain text/checkbox inputs, same as everything
                            // else). Snapshot the template's catalog name/description
                            // for each row BEFORE clearing so they can be restored
                            // afterwards regardless of whether that inclusion was
                            // saved on this ticket type or not.
                            snapshotInclusionCatalog(clone);
                            clearTierValues(clone);
                            // Marks this tier as an existing one to UPDATE (not add) on submit.
                            clone.setAttribute('data-ticket-type-id', String(item.ticketTypeId || 0));

                            setFieldOn(clone, 'tiername-' + suffix, item.typeName);
                            setFieldOn(clone, 'price-' + suffix, item.price);
                            setFieldOn(clone, 'qty-' + suffix, item.quantity);
                            setFieldOn(clone, 'desc-' + suffix, item.description);
                            setFieldOn(clone, 'salestart-' + suffix, item.saleStart);
                            setFieldOn(clone, 'saleend-' + suffix, item.saleEnd);

                            // Seating layout: the API response doesn't say which seat-mode
                            // panel (rows, tables, standing or open) was active for this
                            // tier, so that picker is left at its template default - but
                            // every mode's saved numbers are filled in below so whichever
                            // panel the user opens shows the real saved values instead of
                            // the template's placeholder ones. Also note the API's
                            // "columns" field is misspelled "coulmns" on the wire, so both
                            // spellings are checked here.
                            var isSeatingOn = item.isSeating === true || item.IsSeating === true;
                            var seatingSwitch = clone.querySelector('[role="switch"][data-switch]');
                            if (seatingSwitch) {
                                seatingSwitch.setAttribute('aria-checked', isSeatingOn ? 'true' : 'false');
                                applyReveal(seatingSwitch, clone);
                            }
                            setFieldOn(clone, 'rows-' + suffix, item.rows);
                            setFieldOn(clone, 'seats-' + suffix, item.columns != null ? item.columns : item.coulmns);
                            setFieldOn(clone, 'tables-' + suffix, item.numberOfTables);
                            setFieldOn(clone, 'chairs-' + suffix, item.chairsPerTable);
                            setFieldOn(clone, 'standcap-' + suffix, item.standingCapacity);
                            setFieldOn(clone, 'opencap-' + suffix, item.openSeatingCapacity);

                            rehydrateInclusions(clone, suffix, item.Inclusions || item.inclusions || []);

                            freshTiers.push(clone);
                        });

                        if (freshTiers.length > 0) {
                            // Replace the shipped placeholder tier(s) with the real ones.
                            tierList.querySelectorAll('.tier').forEach(function(t) { t.remove(); });
                            freshTiers.forEach(function(t) { tierList.appendChild(t); });
                            renumberTiers();
                        }

                        function setFieldValue(id, value) {
                            if (value === undefined || value === null) return;
                            var el = document.getElementById(id);
                            if (el) el.value = value;
                        }

                        function setFieldOn(root, name, value) {
                            if (value === undefined || value === null) return;
                            var el = root.querySelector('[name="' + name + '"]');
                            if (el) el.value = value;
                        }

                        // Records each inclusion row's built-in catalog name/description
                        // (e.g. "VIP Lounge" / "Private lounge with concierge, both days")
                        // as data attributes, so they survive clearTierValues() wiping
                        // the visible input values to ''.
                        function snapshotInclusionCatalog(root) {
                            root.querySelectorAll('[data-incl-row]').forEach(function(row) {
                                var labelField = row.querySelector('[data-incl-labelfield]');
                                var noteField = row.querySelector('[data-incl-notefield]');
                                if (labelField) row.setAttribute('data-catalog-name', labelField.value || '');
                                if (noteField) row.setAttribute('data-catalog-desc', noteField.value || '');
                            });
                        }

                        // Restores each inclusion row's label/description from the
                        // snapshot taken above, then checks the row and (optionally)
                        // overwrites the description with the server's saved value if
                        // this inclusion was part of `savedInclusions` for this tier.
                        // Any saved inclusion that doesn't match a catalog row (i.e. a
                        // custom item that was added via "Add Item" on a previous edit)
                        // gets appended as a brand-new row using the same clone pattern
                        // as the "Add included item" handler.
                        function rehydrateInclusions(root, suffix, savedInclusions) {
                            var inclGroup = root.querySelector('[data-incl-group="' + suffix + '"]');
                            if (!inclGroup) return;

                            var byName = {};
                            (savedInclusions || []).forEach(function(inc) {
                                var key = (inc.InclusionName || inc.inclusionName || '').trim().toLowerCase();
                                if (key) byName[key] = inc;
                            });
                            var matchedKeys = {};

                            inclGroup.querySelectorAll('[data-incl-row]').forEach(function(row) {
                                var box = row.querySelector('[data-incl-box]');
                                var labelField = row.querySelector('[data-incl-labelfield]');
                                var noteField = row.querySelector('[data-incl-notefield]');
                                var labelText = row.querySelector('[data-incl-label]');
                                var noteText = row.querySelector('[data-incl-note]');

                                var catalogName = row.getAttribute('data-catalog-name') || '';
                                var catalogDesc = row.getAttribute('data-catalog-desc') || '';
                                var key = catalogName.trim().toLowerCase();
                                var match = key ? byName[key] : null;

                                if (labelField) labelField.value = catalogName;
                                if (labelText) labelText.textContent = catalogName;

                                if (match) {
                                    matchedKeys[key] = true;
                                    if (box) box.checked = true;
                                    var desc = (match.Description || match.description || catalogDesc);
                                    if (noteField) noteField.value = desc;
                                    if (noteText) noteText.textContent = desc;
                                } else {
                                    if (box) box.checked = false;
                                    if (noteField) noteField.value = catalogDesc;
                                    if (noteText) noteText.textContent = catalogDesc;
                                }
                            });

                            // Append any saved inclusion that wasn't one of the fixed
                            // catalog rows (a custom item added on a previous edit).
                            var list = inclGroup.querySelector('.inclrows');
                            var rowTemplate = inclGroup.querySelector('[data-incl-row]');
                            if (!list || !rowTemplate) return;

                            Object.keys(byName).forEach(function(key) {
                                if (matchedKeys[key]) return;
                                var inc = byName[key];
                                var clone = rowTemplate.cloneNode(true);
                                clone.removeAttribute('data-catalog-name');
                                clone.removeAttribute('data-catalog-desc');
                                clone.classList.remove('inclrow--editing');

                                var box = clone.querySelector('[data-incl-box]');
                                if (box) box.checked = true;

                                var name = inc.InclusionName || inc.inclusionName || '';
                                var desc = inc.Description || inc.description || '';

                                var labelField = clone.querySelector('[data-incl-labelfield]');
                                if (labelField) labelField.value = name;
                                var noteField = clone.querySelector('[data-incl-notefield]');
                                if (noteField) noteField.value = desc;
                                var labelText = clone.querySelector('[data-incl-label]');
                                if (labelText) labelText.textContent = name;
                                var noteText = clone.querySelector('[data-incl-note]');
                                if (noteText) noteText.textContent = desc;

                                var editButton = clone.querySelector('[data-incl-edit]');
                                if (editButton) editButton.hidden = false;
                                var saveButton = clone.querySelector('[data-incl-save]');
                                if (saveButton) saveButton.hidden = true;

                                list.appendChild(clone);
                            });
                        }
                    })();
                    } catch (err) {
                        // Rebuilding tiers from existing saved data failed (unexpected
                        // field shape, missing element, etc.). Log it instead of letting
                        // it silently abort the rest of this setup - without this guard,
                        // an error here previously prevented "Add Tier" (wired below)
                        // from ever getting its click listener attached.
                        console.error('Failed to rehydrate existing ticket tiers:', err);
                    }

                    function renumberTiers() {
                        if (!tierList) return;
                        tierList.querySelectorAll('.tier').forEach(function(tier, i) {
                            var noEl = tier.querySelector('.tier__no');
                            if (!noEl) return;
                            noEl.textContent = String(i + 1);
                            noEl.className = noEl.className.replace(/tier__no--\d+/, 'tier__no--' + (i + 1));
                        });
                    }

                    var addTierBtn = document.querySelector('[data-tier-repeat-add="tier-list"]');
                    if (addTierBtn && tierList) {
                        addTierBtn.addEventListener('click', function() {
                            // Always clone the FIRST tier as the template: it is guaranteed
                            // to be in the clean/default state (no "members only" data,
                            // no uploaded file) unlike whichever tier happens to be last.
                            var template = tierList.querySelector('.tier');
                            if (!template) return;
                            var nameInput = template.querySelector('.tier__name');
                            var oldSuffix = nameInput ? (nameInput.getAttribute('name') || '').replace('tiername-', '') : '';
                            if (!oldSuffix) return;

                            tierCounter += 1;
                            var newSuffix = 'tier' + tierCounter;

                            var clone = template.cloneNode(true);
                            renameTierNode(clone, oldSuffix, newSuffix);
                            clearTierValues(clone);
                            // Always a brand-new tier, even if cloned from an existing (rehydrated) one.
                            clone.removeAttribute('data-ticket-type-id');

                            tierList.appendChild(clone);
                            renumberTiers();
                        });
                    }

                    if (tierList) {
                        tierList.addEventListener('click', function(e) {
                            var removeBtn = e.target.closest('[data-repeat-remove]');
                            if (!removeBtn) return;
                            var tiers = tierList.querySelectorAll('.tier');
                            if (tiers.length <= 1) return;
                            var tierNode = removeBtn.closest('.tier');
                            if (!tierNode) return;
                            tierNode.remove();
                            renumberTiers();
                        });
                    }
                    async function uploadMemberListsForTiers() {
                        if (!tierList) return;
                        var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                        var token = tokenInput ? tokenInput.value : '';
                        var eventIdInput = form.querySelector('#EventId');
                        var eventId = eventIdInput ? eventIdInput.value : '';

                        var tiers = Array.prototype.slice.call(tierList.querySelectorAll('.tier'));
                        for (var i = 0; i < tiers.length; i++) {
                            var tier = tiers[i];
                            var nameInput = tier.querySelector('.tier__name');
                            if (!nameInput) continue;
                            var suffix = (nameInput.getAttribute('name') || '').replace('tiername-', '');
                            if (!suffix) continue;

                            var membersCheckbox = tier.querySelector('#membersonly-' + CSS.escape(suffix));
                            var fileInput = tier.querySelector('#members-' + CSS.escape(suffix));
                            if (!membersCheckbox || !membersCheckbox.checked || !fileInput || !fileInput.files.length) continue;

                            var file = fileInput.files[0];
                            var base64;
                            try {
                                base64 = await fileToBase64(file);
                            } catch (err) {
                                console.error('Could not read ' + file.name, err);
                                continue;
                            }

                            try {
                                var resp = await fetch(window.location.pathname + '?handler=UploadMembers', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'RequestVerificationToken': token
                                    },
                                    body: JSON.stringify({
                                        eventId: eventId,
                                        tierSuffix: suffix,
                                        fileName: file.name,
                                        fileBase64: base64
                                    })
                                });
                                if (resp.ok) {
                                    var data = await resp.json();
                                    if (data && data.status === 1 && data.fileUrl) {
                                        addHidden(form, 'tier-memberfileurl-' + suffix, data.fileUrl);
                                    } else {
                                        console.error('Member list upload rejected for ' + suffix, data);
                                    }
                                } else {
                                    console.error('Member list upload failed for ' + suffix, resp.status);
                                }
                            } catch (err) {
                                console.error('Member list upload error for ' + suffix, err);
                            }
                        }
                    }

                    var readyToSubmit = false;
                    form.addEventListener('submit', function(e) {
                        if (readyToSubmit) return;

                        e.preventDefault();

                        // --------------------------------------------------------
                        // FINAL PRICING MODE SYNC BEFORE POST
                        // --------------------------------------------------------
                        // Read the selected button first. This prevents an old/stale
                        // hidden value such as "paid" from overriding a newly
                        // selected "free" mode on a PUBLIC event.
                        var selectedPricingButton = document.querySelector(
                            '#paidmode [data-segment-value][aria-pressed="true"]'
                        );

                        var selectedPricingMode = selectedPricingButton
                            ? selectedPricingButton.getAttribute('data-segment-value')
                            : (pricingMode ? pricingMode.value : 'paid');

                        var finalPricingMode = syncPricingMode(selectedPricingMode);

                        console.log(
                            '[TicketPricing] FINAL PricingMode before POST:',
                            finalPricingMode
                        );

                        // Block submission (and the async member-list upload step below)
                        // until every visible required field passes validation.
                        if (window.__ticketPricingValidateAll && !window.__ticketPricingValidateAll()) {
                            return;
                        }

                        if (pricingMode && pricingMode.value === 'free') {
                            // Free mode: the Ticket Tiers section isn't read server-side
                            // (BuildFreeTier runs instead of BuildPaidTiers), but clear its
                            // fields here too so nothing stale is actually sent in the POST.
                            form.querySelectorAll(
                                '#tier-list input[type="text"], #tier-list input[type="date"], ' +
                                '#tier-list input[type="time"], #tier-list textarea'
                            ).forEach(function(el) {
                                el.value = '';
                            });
                        }

                        form.querySelectorAll('#tier-list > .tier').forEach(function(tier) {
                            var nameInput = tier.querySelector('.tier__name');
                            if (!nameInput) return;
                            var nameAttr = nameInput.getAttribute('name') || '';
                            var prefix = 'tiername-';
                            if (nameAttr.indexOf(prefix) !== 0) return;
                            var suffix = nameAttr.substring(prefix.length);
                            if (!suffix) return;

                            var hideButton = tier.querySelector('[data-tier-hide]');
                            var visible = hideButton ? (hideButton.getAttribute('aria-pressed') !== 'true') : true;
                            addHidden(form, 'tier-visible-' + suffix, visible ? 'true' : 'false');

                            // 0 means "new tier" (goes through Add); >0 means "existing tier" (goes through Update).
                            var ticketTypeId = tier.getAttribute('data-ticket-type-id') || '0';
                            addHidden(form, 'tier-id-' + suffix, ticketTypeId);

                            var seatingSwitch = tier.querySelector('[role="switch"][data-switch]');
                            var seatingEnabled = seatingSwitch ? (seatingSwitch.getAttribute('aria-checked') === 'true') : false;
                            addHidden(form, 'tier-seating-' + suffix, seatingEnabled ? 'true' : 'false');

                            var seatPlan = tier.querySelector('[data-seatplan]');
                            var seatMode = valueOfPressed(seatPlan, '[data-seatmode]', 'open');
                            addHidden(form, 'tier-seatmode-' + suffix, seatMode);

                            var expiry = tier.querySelector('[data-pick-group]');
                            var expiryMode = valueOfPressed(expiry, '[data-pick]', 'date');
                            addHidden(form, 'tier-expiry-mode-' + suffix, expiryMode);

                            var inclGroup = tier.querySelector('[data-incl-group="' + CSS.escape(suffix) + '"]');
                            if (inclGroup) {
                                var inclIdx = 0;
                                inclGroup.querySelectorAll('[data-incl-row]').forEach(function(row) {
                                    var box = row.querySelector('[data-incl-box]');
                                    if (!box || !box.checked) return;

                                    var nameField = row.querySelector('[data-incl-labelfield]');
                                    var noteField = row.querySelector('[data-incl-notefield]');
                                    var name = nameField ? nameField.value.trim() : '';
                                    var desc = noteField ? noteField.value.trim() : '';
                                    if (!name) return;

                                    addHidden(form, 'incl-name-' + suffix + '-' + inclIdx, name);
                                    addHidden(form, 'incl-desc-' + suffix + '-' + inclIdx, desc);
                                    inclIdx++;
                                });
                            }
                        });

                        uploadMemberListsForTiers()
                            .catch(function(err) { console.error('Member list upload step failed:', err); })
                            .then(function() {
                                readyToSubmit = true;
                                if (form.requestSubmit) form.requestSubmit();
                                else form.submit();
                            });
                });
            })();
    </script>
</div>
<script>
    (function() {
        // Prevent duplicate event handlers if this script is loaded more than once.
        if (window.__inclHandlersBound) return;
        window.__inclHandlersBound = true;

        document.addEventListener('click', function(e) {

            // ============================================================
            // Toggle: Seating layout mode (Row/Seat, Table/Chair, Standing,
            // Open seating). Delegated on document so this also works for
            // tiers added later via "Add Tier" (cloned nodes get no
            // listeners of their own, but delegation doesn't need any).
            // ============================================================
            var seatBtn = e.target.closest('[data-seatmode]');
            if (seatBtn) {
                var seatGroup = seatBtn.closest('[data-seatmode-group]');
                var seatPlanWrap = seatBtn.closest('[data-seatplan]');

                if (seatGroup) {
                    seatGroup.querySelectorAll('[data-seatmode]').forEach(function(btn) {
                        btn.setAttribute('aria-pressed', btn === seatBtn ? 'true' : 'false');
                    });
                }

                if (seatPlanWrap) {
                    var mode = seatBtn.getAttribute('data-seatmode');
                    seatPlanWrap.querySelectorAll('[data-seatmode-panel]').forEach(function(panel) {
                        if (panel.getAttribute('data-seatmode-panel') === mode) {
                            panel.removeAttribute('hidden');
                        } else {
                            panel.setAttribute('hidden', '');
                        }
                    });
                }
                return;
            }

            // ============================================================
            // Toggle: "Also included with this ticket"
            // ============================================================
            var sw = e.target.closest('[data-incl-switch]');
            if (sw) {
                var group = sw.getAttribute('data-incl-switch');
                var on = sw.getAttribute('aria-checked') === 'true';

                sw.setAttribute('aria-checked', String(!on));

                var body = document.querySelector(
                    '[data-incl-body="' + CSS.escape(group) + '"]'
                );
                var off = document.querySelector(
                    '[data-incl-off="' + CSS.escape(group) + '"]'
                );

                if (body) body.style.display = on ? 'none' : '';
                if (off) off.style.display = on ? 'block' : 'none';
                return;
            }

            // ============================================================
            // Edit included item
            // ============================================================
            var editBtn = e.target.closest('[data-incl-edit]');
            if (editBtn) {
                var row = editBtn.closest('[data-incl-row]');
                if (!row) return;

                row.classList.add('inclrow--editing');
                editBtn.hidden = true;

                var saveBtn = row.querySelector('[data-incl-save]');
                if (saveBtn) saveBtn.hidden = false;
                return;
            }

            // ============================================================
            // Save included item
            // ============================================================
            var saveBtn2 = e.target.closest('[data-incl-save]');
            if (saveBtn2) {
                var row2 = saveBtn2.closest('[data-incl-row]');
                if (!row2) return;

                var label = row2.querySelector('[data-incl-label]');
                var labelField = row2.querySelector('[data-incl-labelfield]');
                var note = row2.querySelector('[data-incl-note]');
                var noteField = row2.querySelector('[data-incl-notefield]');

                if (label && labelField) label.textContent = labelField.value;
                if (note && noteField) note.textContent = noteField.value;

                row2.classList.remove('inclrow--editing');
                saveBtn2.hidden = true;

                var editButton = row2.querySelector('[data-incl-edit]');
                if (editButton) editButton.hidden = false;
                return;
            }

            // ============================================================
            // Remove included item
            // ============================================================
            var removeBtn = e.target.closest('[data-repeat-remove]');
            if (removeBtn && removeBtn.closest('[data-incl-row]')) {
                var removeRow = removeBtn.closest('[data-incl-row]');
                if (removeRow) removeRow.remove();
                return;
            }

            // ============================================================
            // Add included item
            // ============================================================
            var addBtn = e.target.closest('[data-tier-repeat-add]');
            if (!addBtn) return;

            // IMPORTANT:
            // Never use document.getElementById() here.
            // The Add Item button belongs to a specific .tier.
            // Find that tier first, then find .inclrows INSIDE that tier.
            //
            // This guarantees:
            //   Day 1 Add Item -> Day 1 list
            //   Day 2 Add Item -> Day 2 list
            //   Day 3 Add Item -> Day 3 list
            //
            // It also makes this independent of cloned IDs/data attributes.
            var currentTier = addBtn.closest('#tier-list > .tier');

            // The global "Add Tier" button is not inside a .tier,
            // so it is ignored automatically.
            if (!currentTier) return;

            // Find the included-items list belonging ONLY to this tier.
            var list = currentTier.querySelector('.inclrows');

            if (!list) return;

            // Find the item template ONLY inside this tier.
            var template = list.querySelector('[data-incl-row]');

            if (!template) return;

            var clone = template.cloneNode(true);

            clone.classList.remove('inclrow--editing');

            var checkbox = clone.querySelector('[data-incl-box]');
            if (checkbox) {
                checkbox.checked = false;
                checkbox.removeAttribute('checked');
            }

            var label = clone.querySelector('[data-incl-label]');
            if (label) label.textContent = 'New item';

            var note = clone.querySelector('[data-incl-note]');
            if (note) note.textContent = 'Describe what this includes';

            var labelField = clone.querySelector('[data-incl-labelfield]');
            if (labelField) labelField.value = 'New item';

            var noteField = clone.querySelector('[data-incl-notefield]');
            if (noteField) noteField.value = 'Describe what this includes';

            var editButton = clone.querySelector('[data-incl-edit]');
            if (editButton) editButton.hidden = false;

            var saveButton = clone.querySelector('[data-incl-save]');
            if (saveButton) saveButton.hidden = true;

            // IMPORTANT: append to the exact list that belongs to the clicked button.
            list.appendChild(clone);
        });
    })();
    document.addEventListener('change', function(e) {
        // Check if the changed element is a member-list file input
        // (identified by the data-upload wiring, not by re-checking .accept -
        // the accept attribute is only a picker *hint*; the browser still lets
        // users choose "All Files" or drag-and-drop a non-matching file, so we
        // must branch on the real file below rather than assume CSV).
        if (e.target && e.target.type === 'file' && e.target.hasAttribute('data-upload')) {
            const fileInput = e.target;
            const file = fileInput.files[0];

            if (!file) return;

            // Find associated directory/preview container
            const directoryId = fileInput.getAttribute('data-upload');
            const directoryEl = document.getElementById(directoryId);

            if (!directoryEl) return;

            const extension = file.name.toLowerCase().slice(file.name.lastIndexOf('.'));

            if (extension === '.csv') {
                const reader = new FileReader();
                reader.onload = function(event) {
                    parseAndRenderCSV(event.target.result, directoryEl, file.name);
                };
                reader.onerror = function() {
                    alert('Could not read "' + file.name + '". Please try uploading it again.');
                };
                reader.readAsText(file);
            } else if (extension === '.xlsx') {
                if (typeof XLSX === 'undefined') {
                    alert('Excel file support failed to load. Please upload a CSV instead, or try again in a moment.');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(event) {
                    parseAndRenderXLSX(event.target.result, directoryEl, file.name);
                };
                reader.onerror = function() {
                    alert('Could not read "' + file.name + '". Please try uploading it again.');
                };
                // xlsx is a binary/zip format, not text - must be read as
                // an ArrayBuffer, never as text.
                reader.readAsArrayBuffer(file);
            } else {
                alert('"' + file.name + '" is not a supported file type. Please upload a .csv or .xlsx file.');
                fileInput.value = '';
            }
        }
    });

    function parseAndRenderXLSX(arrayBuffer, container, fileName) {
        let workbook;
        try {
            workbook = XLSX.read(arrayBuffer, { type: 'array' });
        } catch (err) {
            console.error('Error parsing xlsx file:', err);
            alert('"' + fileName + '" could not be read as an Excel file. Please check the file and try again.');
            return;
        }

        const firstSheetName = workbook.SheetNames[0];
        if (!firstSheetName) {
            alert('The uploaded Excel file has no sheets.');
            return;
        }

        const sheet = workbook.Sheets[firstSheetName];

        // header: 1 gives back an array-of-arrays (like the CSV rows below)
        // instead of objects keyed by header text, so both formats can share
        // the same row-shape and the same rendering code.
        const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, blankrows: false, defval: '' })
            .map(row => row.map(cell => String(cell).trim()));

        renderMemberRows(rows, container, fileName);
    }

    function parseAndRenderCSV(csvText, container, fileName) {
        // Split into non-empty lines
        const lines = csvText.split(/\r\n|\n/).map(line => line.trim()).filter(line => line.length > 0);

        if (lines.length === 0) {
            alert("The uploaded CSV file is empty.");
            return;
        }

        // Parse headers and rows
        const rows = lines.map(line => line.split(',').map(cell => cell.replace(/^"(.*)"$/, '$1').trim()));

        renderMemberRows(rows, container, fileName);
    }

    function renderMemberRows(rows, container, fileName) {
        if (!rows.length) {
            alert("The uploaded file has no data rows.");
            return;
        }

        // Assume first row is header or check if header contains 'name'/'email'
        let dataRows = rows;
        const hasHeader = (rows[0][0] || '').toLowerCase().includes("name") || (rows[0][1] || '').toLowerCase().includes("email");
        if (hasHeader) {
            dataRows = rows.slice(1);
        }

        // Locate elements inside directory container
        const scrollContainer = container.querySelector('.directory__scroll');
        const fileNameEl = container.querySelector('[data-upload-name]');
        const headCountEl = container.querySelector('.directory__head span:nth-child(2)');
        const footEl = container.querySelector('.directory__foot');
        const dropzoneEl = document.getElementById(container.getAttribute('data-upload-dropzone'));

        if (fileNameEl) fileNameEl.textContent = fileName;
        if (headCountEl) headCountEl.textContent = `${dataRows.length} members`;

        // Clear static fallback data
        scrollContainer.innerHTML = '';

        // Dynamically generate table rows from parsed CSV
        dataRows.forEach(row => {
            const name = row[0] || 'N/A';
            const email = row[1] || 'N/A';

            const rowDiv = document.createElement('div');
            rowDiv.className = 'directory__row';
            rowDiv.innerHTML = `
                                    <span>${escapeHtml(name)}</span>
                                    <span class="directory__email">${escapeHtml(email)}</span>
                                    <span class="badge badge--live">Verified</span>
                                `;
            scrollContainer.appendChild(rowDiv);
        });

        if (footEl) {
            footEl.textContent = `Showing ${dataRows.length} of ${dataRows.length} · only these addresses can check out on this tier`;
        }

        // Toggle visibility: Hide dropzone and show parsed directory table
        if (dropzoneEl) dropzoneEl.hidden = true;
        container.hidden = false;
    }

    function escapeHtml(text) {
        return text.replace(/[&<>"']/g, function(m) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            }[m];
        });
    }
    async function uploadMemberCsv(fileInput, tierSuffix) {
        const file = fileInput.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async function(e) {
            const base64String = e.target.result.split(',')[1];

            const payload = {
                eventId: parseInt(document.getElementById('EventId').value) || 0,
                tierSuffix: tierSuffix,
                fileName: file.name,
                fileBase64: base64String
            };

            try {
                const response = await fetch('?handler=UploadMembers', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.status === 1) {
                    // Store the returned URL in a hidden input field for the tier
                    let hiddenInput = document.getElementById(`tier-memberfileurl-${tierSuffix}`);
                    if (!hiddenInput) {
                        hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.id = `tier-memberfileurl-${tierSuffix}`;
                        hiddenInput.name = `tier-memberfileurl-${tierSuffix}`;
                        fileInput.form.appendChild(hiddenInput);
                    }
                    hiddenInput.value = result.fileUrl;
                } else {
                    alert('Upload failed: ' + result.message);
                }
            } catch (err) {
                console.error('Error uploading member file:', err);
            }
        };
        reader.readAsDataURL(file);
    }
</script>
<script>
    /* ------------------------------------------------------------
       Field validation — required / format checks, inline red error
       text under each field, live as the user types/selects, and
       re-checked on submit. Mirrors the validation style used on
       the Basic Details step.

       Delegated on `document` (rather than bound per-input) so it
       keeps working for ticket tiers added later via "Add Tier" -
       cloned fields inherit their `data-validate` attribute but get
       no listeners of their own; delegation doesn't need any.
       ------------------------------------------------------------ */
    (function() {
        if (window.__ticketPricingValidateAll) return;

        var NUMBER_PATTERN = /^\d+(\.\d+)?$/;

        function fieldLabelText(input) {
            var label = input.id ? document.querySelector('label[for="' + CSS.escape(input.id) + '"]') : null;
            if (!label) return 'This field';

            var clone = label.cloneNode(true);
            clone.querySelectorAll('span').forEach(function(s) { s.remove(); });
            var text = clone.textContent.trim();
            return text || 'This field';
        }

        function getErrorEl(input) {
            var field = input.closest('.form__field') || input.closest('.tier__head');
            return field ? field.querySelector('.field__error') : null;
        }

        function isVisible(input) {
            // Fields inside a hidden pricing-mode panel, seat-mode panel or
            // collapsed expiry/reveal section shouldn't block submission -
            // only the currently active fields matter.
            return input.offsetParent !== null;
        }

        function showFieldError(input, message) {
            input.classList.add('is-invalid');
            var err = getErrorEl(input);
            if (err) {
                err.textContent = message;
                err.classList.add('is-visible');
            }
        }

        function clearFieldError(input) {
            input.classList.remove('is-invalid');
            var err = getErrorEl(input);
            if (err) {
                err.textContent = '';
                err.classList.remove('is-visible');
            }
        }

        function runValidator(input) {
            var type = input.getAttribute('data-validate');
            if (!type) return true;

            if (!isVisible(input)) {
                clearFieldError(input);
                return true;
            }

            var value = (input.value || '').trim();
            var label = fieldLabelText(input);
            var message = '';

            if (!value) {
                message = label + ' is required.';
            } else if (type === 'number' && !NUMBER_PATTERN.test(value)) {
                message = 'Enter a valid number for ' + label + '.';
            }

            if (message) {
                showFieldError(input, message);
            } else {
                clearFieldError(input);
            }
            return !message;
        }

        ['input', 'change', 'focusout'].forEach(function(eventName) {
            document.addEventListener(eventName, function(e) {
                var input = e.target && e.target.closest && e.target.closest('[data-validate]');
                if (input) runValidator(input);
            });
        });

        // Exposed so the form's submit handler can block submission (and the
        // async member-list upload step) until every visible required field
        // passes validation, without altering that handler's own logic.
        window.__ticketPricingValidateAll = function() {
            var isValid = true;
            var firstInvalid = null;

            document.querySelectorAll('#TicketPriceForm [data-validate]').forEach(function(input) {
                if (!runValidator(input)) {
                    isValid = false;
                    if (!firstInvalid) firstInvalid = input;
                }
            });

            if (firstInvalid) {
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (typeof firstInvalid.focus === 'function') {
                    firstInvalid.focus({ preventScroll: true });
                }
            }

            return isValid;
        };
    })();
</script>
<script>
    (function() {
        var displaySelect = document.getElementById('display-currency');
        var settlementSelect = document.getElementById('settlement-currency');
        if (!displaySelect || !settlementSelect) return;

        function syncSettlement() {
            settlementSelect.value = displaySelect.value;
        }

        function persistCurrency(currency) {
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';

            fetch(window.location.pathname + '?handler=SetCurrency', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ currency: currency })
            })
                .then(function(resp) { return resp.json(); })
                .then(function(data) {
                    if (!data || data.status !== 1) {
                        console.error('Currency update rejected', data);
                    }
                })
                .catch(function(err) {
                    console.error('Currency update failed', err);
                });
        }

        displaySelect.addEventListener('change', function() {
            syncSettlement();
            persistCurrency(displaySelect.value);
        });

        // Make sure settlement reflects display on initial render too.
        syncSettlement();
    })();
    function initSaleDateRange(scope) {
        scope = scope || document;

        var starts = scope.querySelectorAll('[data-role="sale-start"]');
        starts.forEach(function(startInput) {
            var today = new Date().toISOString().split('T')[0];
            startInput.min = today;

            // Find the matching Sale End in the same tier block.
            var field = startInput.closest('.formgrid') || startInput.closest('.form__field').parentElement;
            var endInput = field ? field.querySelector('[data-role="sale-end"]') : null;
            if (!endInput) return;

            endInput.min = startInput.value || today;

            startInput.addEventListener('change', function() {
                endInput.min = startInput.value || today;
                if (endInput.value && endInput.value < startInput.value) {
                    endInput.value = startInput.value;
                }
            });
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        initSaleDateRange();
    });
</script>
<script>
        (function() {
            function renderDescPreview(textarea) {
                var suffix = (textarea.getAttribute('name') || '').replace(/^(free-)?desc-?/, '') || 'free';
                var preview = document.querySelector('.descprev[data-desc-prev="' + CSS.escape(suffix) + '"]');
                if (!preview) return;

                var list = preview.querySelector('[data-desc-list]');
                var singleLine = preview.querySelector('[data-desc-line]');

                var lines = (textarea.value || '')
                    .split(/\r?\n/)
                    .map(function(l) { return l.trim(); })
                    .filter(function(l) { return l.length > 0; });

                if (lines.length === 0) {
                    if (list) { list.innerHTML = ''; list.hidden = true; }
                    if (singleLine) { singleLine.textContent = ''; singleLine.hidden = true; }
                    return;
                }

                if (lines.length === 1) {
                    if (list) { list.innerHTML = ''; list.hidden = true; }
                    if (singleLine) {
                        singleLine.textContent = lines[0];
                        singleLine.hidden = false;
                    }
                    return;
                }

                if (singleLine) { singleLine.textContent = ''; singleLine.hidden = true; }
                if (list) {
                    list.hidden = false;
                    list.innerHTML = lines
                        .map(function(l) {
                            var li = document.createElement('li');
                            li.textContent = l;
                            return li.outerHTML;
                        })
                        .join('');
                }
            }

            document.addEventListener('input', function(e) {
                var el = e.target;
                if (el.tagName === 'TEXTAREA' && /^(free-)?desc-/.test(el.id || '') || el.id === 'free-desc') {
                    renderDescPreview(el);
                }
            });

            // Render once on load for any pre-filled description (existing/rehydrated tiers).
            document.querySelectorAll('textarea[id^="desc-"], #free-desc').forEach(renderDescPreview);
        })();
        document.addEventListener("DOMContentLoaded", function () {
        const pricingModeInput = document.getElementById("PricingMode");
        const segmentButtons = document.querySelectorAll("#paidmode [data-segment-value]");

        segmentButtons.forEach(button => {
            button.addEventListener("click", function () {
                const selectedValue = this.getAttribute("data-segment-value");

                // 1. Update hidden field value for POST request
                if (pricingModeInput) {
                    pricingModeInput.value = selectedValue;
                }

                // 2. Update button UI states
                segmentButtons.forEach(btn => btn.setAttribute("aria-pressed", "false"));
                this.setAttribute("aria-pressed", "true");

                // 3. Toggle free/paid UI panels
                const paidPanels = document.querySelectorAll('[data-segment-panel="paid"]');
                const freePanels = document.querySelectorAll('[data-segment-panel="free"]');

                if (selectedValue === "free") {
                    paidPanels.forEach(panel => panel.hidden = true);
                    freePanels.forEach(panel => panel.hidden = false);
                } else {
                    paidPanels.forEach(panel => panel.hidden = false);
                    freePanels.forEach(panel => panel.hidden = true);
                }
            });
        });
    });
    function syncUIWithPricingMode() {
        const pricingModeInput = document.getElementById("PricingMode");
        if (!pricingModeInput) return;

        const currentMode = pricingModeInput.value.toLowerCase();
        const segmentButtons = document.querySelectorAll("#paidmode [data-segment-value]");

        segmentButtons.forEach(button => {
            const isSelected = button.getAttribute("data-segment-value") === currentMode;
            button.setAttribute("aria-pressed", isSelected ? "true" : "false");
            button.classList.toggle("active", isSelected);
        });

        const paidPanels = document.querySelectorAll('[data-segment-panel="paid"]');
        const freePanels = document.querySelectorAll('[data-segment-panel="free"]');

        if (currentMode === "free") {
            paidPanels.forEach(panel => panel.hidden = true);
            freePanels.forEach(panel => panel.hidden = false);
        } else {
            paidPanels.forEach(panel => panel.hidden = false);
            freePanels.forEach(panel => panel.hidden = true);
        }
    }

    // Ensures correct UI highlight when navigating back via browser cache
    window.addEventListener("pageshow", syncUIWithPricingMode);
</script>