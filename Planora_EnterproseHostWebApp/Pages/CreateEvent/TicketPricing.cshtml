@page
@model Planora_EnterproseHostWebApp.Pages.CreateEvent.TicketPricingModel
@{
    Layout = "_CreateEventLayout";
    ViewData["StepIndex"] = 5;
    ViewData["StepTotal"] = 10;
    ViewData["StepName"] = "Tickets & Pricing";
    ViewData["StepHint"] = "Set pricing, capacity and ticket tiers";

    var allEventSlots = (Model.EventDates ?? new List<Planora_EnterproseHostWebApp.Models.EventDates>())
        .Where(d => d.EventSlots != null)
        .SelectMany(d => d.EventSlots)
        .ToList();
    var eventTotalCapacity = allEventSlots.Sum(s => s.Capacity);
    var eventHallCount = allEventSlots.Select(s => s.HallId).Distinct().Count();
}
<style>
    .field__hint {
        display: block;
        margin-top: 0.375rem;
        font-size: 0.6875rem;
        color: var(--color-text-subtle);
    }

    .descprev {
        margin-top: var(--space-3);
        padding: var(--space-3) 0.875rem;
        background-color: var(--color-surface-alt);
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-sm);
    }

    .descprev__label {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 0.5625rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .descprev__list {
        margin: 0 0 0 1rem;
        font-size: var(--fs-2xs);
        color: var(--color-text-label);
    }

    .descprev__line {
        font-size: var(--fs-2xs);
        color: var(--color-text-label);
    }
</style>
<style>
    :root {
        --brand: #7a1170;
        --brand-dark: #5c0d54;
        --ink: #1f2430;
        --muted: #6b7280;
        --line: #e5e7eb;
        --bg: #ffffff;
        --danger: #b91c1c;
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,sans-serif;
        background: #f6f6f8;
        color: var(--ink);
    }

    .card {
        max-width: 640px;
        margin: 0 auto;
        background: var(--bg);
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    /* ---- header row with toggle switch ---- */
    .switchcard {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .switchcard__title {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .switch {
        appearance: none;
        -webkit-appearance: none;
        width: 44px;
        height: 24px;
        border-radius: 999px;
        background: #d1d5db;
        position: relative;
        border: none;
        cursor: pointer;
        transition: background .18s ease;
        flex-shrink: 0;
    }

        .switch::after {
            content: "";
            position: absolute;
            top: 3px;
            left: 3px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #fff;
            transition: transform .18s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,.25);
        }

        .switch[aria-checked="true"] {
            background: var(--brand);
        }

            .switch[aria-checked="true"]::after {
                transform: translateX(20px);
            }

    .inclhead {
        font-size: 14px;
        color: var(--muted);
        margin: 14px 0 16px;
        line-height: 1.5;
    }

    /* ---- rows ---- */
    .inclrows {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .inclrow {
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 14px 16px;
    }

    .inclrow__pick {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        flex: 1;
        cursor: pointer;
        min-width: 0;
    }

        .inclrow__pick input[type="checkbox"] {
            width: 18px;
            height: 18px;
            margin-top: 2px;
            accent-color: #2563eb;
            flex-shrink: 0;
            cursor: pointer;
        }

    .inclrow__body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .inclrow__label {
        font-weight: 600;
        font-size: 15px;
    }

    .inclrow__note {
        font-size: 13px;
        color: var(--muted);
    }

    /* inline edit fields, hidden until "edit" is clicked */
    .inclrow__edit {
        display: none;
        flex: 1;
        flex-direction: column;
        gap: 6px;
    }

    .inclrow--editing .inclrow__pick {
        display: none;
    }

    .inclrow--editing .inclrow__edit {
        display: flex;
    }

    .inclrow__edit input {
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 14px;
        font-family: inherit;
    }

    .inclrow__acts {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .iconbtn {
        border: none;
        background: transparent;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #374151;
    }

        .iconbtn:hover {
            background: #f3f4f6;
        }

        .iconbtn svg {
            width: 18px;
            height: 18px;
        }

        .iconbtn[data-repeat-remove] {
            color: var(--danger);
        }

    .inclfoot {
        margin-top: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn--outline {
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .btn--outline:hover {
            background: #f9fafb;
        }

    .field__hint {
        font-size: 12px;
        color: var(--muted);
    }

    .notice--off {
        display: none;
        margin-top: 16px;
        font-size: 14px;
        color: var(--muted);
        background: #f3f4f6;
        border-radius: 8px;
        padding: 12px 14px;
    }

    .u-visually-hidden {
        position: absolute !important;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
</style>
<div class="wizard__body">

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="notice notice--warn notice--flat u-mb-5" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="notice notice--success notice--flat u-mb-5" role="status">@Model.SuccessMessage</div>
    }

    <main class="wizard__content">
        <div class="wizard__inner">
            <form class="stack" id="TicketPriceForm" method="post" enctype="multipart/form-data" novalidate data-ticket-pricing-form>
                @Html.AntiForgeryToken()
                <input type="hidden" id="EventId" name="EventId" value="@Model.EventId" />
                <input type="hidden" id="PricingMode" name="PricingMode" value="@Model.PricingMode" />

                @* Existing ticket tiers (if any) for this event, used to rehydrate the
                   form below. type="application/json" means the browser never
                   executes this as script - it's inert data, parsed via
                   JSON.parse, not interpolated into JS source. *@
                <script id="existing-ticket-data" type="application/json">@Html.Raw(Model.ExistingTicketDataJson)</script>

                <!-- Free vs paid -->
                <section class="panel" aria-labelledby="pricing-title">
                    <div class="panel__head panel__head--plain">
                        <div>
                            <h2 class="panel__title" id="pricing-title">Event Pricing</h2>
                            <p class="panel__meta">Toggle to offer free or paid tickets</p>
                        </div>
                        <div class="segment" id="paidmode" role="group" aria-label="Pricing mode" data-segment>
                            <button class="segment__btn" type="button" aria-pressed="@(Model.PricingMode == "free" ? "true" : "false")"
                                    data-segment-value="free">
                                Free
                            </button>
                            <button class="segment__btn" type="button" aria-pressed="@(Model.PricingMode == "free" ? "false" : "true")"
                                    data-segment-value="paid">
                                Paid
                            </button>
                        </div>
                    </div>
                    <div class="panel__body">
                        <div class="formgrid formgrid--3" data-segment-panel="paid"
                             data-segment-owner="paidmode">
                            <div class="form__field">
                                <label class="field__label" for="display-currency">Display Currency</label>
                                <select class="field__select" id="display-currency" name="display-currency">
                                    <option selected="@(Model.Currency == "NGN")">NGN</option>
                                    <option selected="@(Model.Currency == "USD")">USD</option>
                                    <option selected="@(Model.Currency == "GHS")">GHS</option>
                                    <option selected="@(Model.Currency == "KES")">KES</option>
                                    <option selected="@(Model.Currency == "ZAR")">ZAR</option>
                                </select>
                                <span class="field__hint">Prices shown to buyers</span>
                            </div>
                            <div class="form__field">
                                <label class="field__label" for="settlement-currency">Settlement Currency</label>
                                <select class="field__select" id="settlement-currency" name="settlement-currency">
                                    <option selected="@(Model.Currency == "NGN")">NGN</option>
                                    <option selected="@(Model.Currency == "USD")">USD</option>
                                </select>
                                <span class="field__hint">Currency you are paid in</span>
                            </div>
                            <div class="form__field">
                                <label class="field__label" for="total-capacity">Total Capacity</label>
                                <input class="field__input" id="total-capacity" name="total-capacity" type="text" value="@eventTotalCapacity" readonly>
                                <span class="field__hint">Across all tiers &mdash; calculated</span>
                            </div>
                        </div>

                        <div data-segment-panel="free" data-segment-owner="paidmode" hidden>
                            <p class="notice notice--flat notice--info">
                                <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                                Free events need no currency or settlement configuration.
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Capacity now, and what it costs to add more later -->
                @* <section class="panel" id="capacity-charges" aria-labelledby="capcharge-title">
                    <div class="panel__head">
                        <span class="tile tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg></span>
                        <div>
                            <h2 class="panel__title" id="capcharge-title">Capacity &amp; Charges</h2>
                            <p class="panel__meta">
                                What this event holds, and what it costs if you need more guests after
                                publishing
                            </p>
                        </div>
                    </div>
                    <div class="panel__body">
                        <div class="tablewrap">
                            <table class="table table--narrow">
                                <caption class="u-visually-hidden">
                                    Configured sessions, slots and hall capacity for this event
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Session</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Slot</th>
                                        <th scope="col">Time</th>
                                        <th scope="col">Hall</th>
                                        <th scope="col">Capacity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.EventDates != null && Model.EventDates.Count > 0)
                                    {
                                        @foreach (var eventDate in Model.EventDates)
                                        {
                                            if (eventDate.EventSlots != null && eventDate.EventSlots.Count > 0)
                                            {
                                                @foreach (var slot in eventDate.EventSlots)
                                                {
                                                    <tr>
                                                        <th scope="row">@eventDate.SessionName</th>
                                                        <td>@eventDate.EventDateValue</td>
                                                        <td>@slot.SlotName</td>
                                                        <td>@slot.StartTime &ndash; @slot.EndTime</td>
                                                        <td>Hall @slot.HallId</td>
                                                        <td>@slot.Capacity</td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6">No dates/slots configured for this event yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <p class="capsummary u-mt-5">
                            <span class="capsummary__lead">
                                <b>@eventTotalCapacity</b> seats across @eventHallCount hall@(eventHallCount == 1 ? "" : "s") &middot; seating is enabled, so
                                added guests are turned into rows, tables or headroom automatically
                            </span>
                            <span class="capsummary__note">
                                After publishing, Guests, Seating Layout and ticket management all offer
                                <b>Add guests</b>. You enter a headcount; the layout above decides what
                                gets built.
                            </span>
                        </p>

                        <!-- Private: never commissioned, tickets or not -->
                        <div data-type-only="private" hidden>
                            <p class="notice notice--success notice--flat u-mt-5">
                                <svg class="notice__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                <span>
                                    <b>Private event &mdash; no charge, now or later.</b><br>
                                    Adding guests after publishing costs nothing, and sending them tickets
                                    or invitations costs nothing either. Only WhatsApp and email credits
                                    are used to deliver the passes.
                                </span>
                            </p>
                        </div>

                        <!-- Public: the answer depends on whether tickets are sold -->
                        <div data-type-hide="private">
                            <div data-segment-panel="free" data-segment-owner="paidmode" hidden>
                                <p class="notice notice--success notice--flat u-mt-5">
                                    <svg class="notice__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>
                                        <b>Public, non-ticketed &mdash; no charge.</b><br>
                                        With no tickets on sale there is no gross to commission, so this is
                                        enterprise capacity under your plan. Adding guests after publishing
                                        is free as well.
                                    </span>
                                </p>
                            </div>

                            <div data-segment-panel="paid" data-segment-owner="paidmode">
                                <p class="notice notice--alert notice--flat u-mt-5">
                                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 5 5 19" /><circle cx="7.5" cy="7.5" r="2.5" /><circle cx="16.5" cy="16.5" r="2.5" /></svg>
                                    <span>
                                        <b>Public, ticketed &mdash; 2% commission on gross ticket sales.</b><br>
                                        The same 2% applies to any capacity you add after publishing, taken
                                        only on the seats that actually sell, and settled through this same
                                        ticketing flow. Nothing is owed for seats that go unsold.
                                    </span>
                                </p>

                                <div class="invoice u-mt-5">
                                    <p class="invoice__row">
                                        <span>Gross if every seat sells at its tier price</span>
                                        <span>&#8358;7,450,000</span>
                                    </p>
                                    <p class="invoice__row">
                                        <span>Commission at 2%</span><span>&#8358;149,000</span>
                                    </p>
                                    <p class="invoice__row invoice__row--total">
                                        <span>Due to publish</span><span>&#8358;0</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section> *@

                <!-- Free events: exactly one tier -->
                <section class="panel" data-segment-panel="free" data-segment-owner="paidmode"
                         aria-labelledby="freetier-title" hidden>
                    <div class="panel__head">
                        <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg></span>
                        <h2 class="panel__title" id="freetier-title">Free Ticket</h2>
                        <p class="panel__meta">Quantity, description, seating &amp; capacity</p>
                    </div>
                    <div class="panel__body">
                        <div class="freetier">
                            <input type="hidden" id="free-tier-id" name="free-tier-id" value="0">
                            <div class="freetier__head">
                                <span class="freetier__badge">Free</span>
                                <span>
                                    <span class="switchcard__title">Single ticket tier</span>
                                    <span class="freetier__note">
                                        Free events use one tier named &ldquo;Free&rdquo; &mdash; no pricing,
                                        promo codes or add-ons apply.
                                    </span>
                                </span>
                            </div>

                            <div class="formgrid formgrid--2">
                                <div class="form__field">
                                    <label class="field__label" for="free-qty">Quantity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                    <input class="field__input" id="free-qty" name="free-qty" type="text" placeholder="0" value="300" required>
                                    <span class="field__hint">Total free tickets released</span>
                                </div>
                                <div class="form__field">
                                    <label class="field__label" for="free-cap">Maximum Capacity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                    <input class="field__input" id="free-cap" name="free-cap" type="text" placeholder="0" value="300" required>
                                    <span class="field__hint">Hard ceiling across the event</span>
                                </div>
                            </div>

                            <div class="formgrid u-mt-5">
                                <div class="form__field">
                                    <label class="field__label" for="free-desc">Description</label>
                                    <textarea class="field__input" id="free-desc" name="free-desc" type="text" placeholder="Shown on the ticket card" value="General admission"></textarea>
                                </div>
                            </div>

                        </div>

                        <div class="reveal reveal--info u-mt-5" data-seatplan>
                            <span class="reveal__title">Seating layout for this event</span>

                            <div class="seatplan__modes" role="group"
                                 aria-label="Seating layout type" data-seatmode-group>
                                <button class="seatplan__mode" type="button" aria-pressed="true"
                                        data-seatmode="rows">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                                    <strong>Row / Seat</strong>
                                    Numbered seats in rows
                                </button>
                                <button class="seatplan__mode" type="button" aria-pressed="false"
                                        data-seatmode="tables">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                    <strong>Table / Chair</strong>
                                    Round or long tables
                                </button>
                                <button class="seatplan__mode" type="button" aria-pressed="false"
                                        data-seatmode="standing">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9.5" cy="7.5" r="3.5" /><path d="M17 4.2a3.5 3.5 0 0 1 0 6.6M21 20v-1.5a4 4 0 0 0-3-3.8" /></svg>
                                    <strong>Standing</strong>
                                    Capacity only, no seats
                                </button>
                                <button class="seatplan__mode" type="button" aria-pressed="false"
                                        data-seatmode="open">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg>
                                    <strong>Open seating</strong>
                                    First come, no numbering
                                </button>
                            </div>

                            <div data-seatmode-panel="rows">
                                <div class="sizegrid">
                                    <div class="form__field">
                                        <label class="field__label" for="free-rows">Total Rows<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="free-rows" name="free-rows" type="text" placeholder="0" value="12" required>
                                        <span class="field__hint">Rows are labelled A, B, C&hellip;</span>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="free-seats-row">Seats per Row<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="free-seats-row" name="free-seats-row" type="text" placeholder="0" value="20" required>
                                        <span class="field__hint">Numbered 1 upwards within each row</span>
                                    </div>
                                </div>
                                <p class="sizetotal">
                                    <span>Total numbered seats &mdash; rows &times; seats per row</span>
                                    <span class="sizetotal__value">240 seats</span>
                                </p>
                            </div>

                            <div data-seatmode-panel="tables" hidden>
                                <div class="sizegrid">
                                    <div class="form__field">
                                        <label class="field__label" for="free-tables">Total Tables<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="free-tables" name="free-tables" type="text" placeholder="0" value="10" required>
                                        <span class="field__hint">Tables are labelled T1, T2, T3&hellip;</span>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="free-chairs">Chairs per Table<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="free-chairs" name="free-chairs" type="text" placeholder="0" value="10" required>
                                        <span class="field__hint">Seats are assigned per table</span>
