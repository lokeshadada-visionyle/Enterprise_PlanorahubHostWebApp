@page
@model Planora_EnterproseHostWebApp.Pages.CreateEvent.TicketPricingModel
@{
    Layout = "_CreateEventLayout";
    ViewData["StepIndex"] = 5;
    ViewData["StepTotal"] = 10;
    ViewData["StepName"] = "Tickets & Pricing";
    ViewData["StepHint"] = "Set pricing, capacity and ticket tiers";

    var requestedEventType = Request.Query["type"].FirstOrDefault();
    var pageIsPrivateEvent = string.Equals(requestedEventType, "private", StringComparison.OrdinalIgnoreCase)
        ? true
        : string.Equals(requestedEventType, "public", StringComparison.OrdinalIgnoreCase)
            ? false
            : Model.IsPrivateEvent;

    var allEventSlots = (Model.EventDates ?? new List<Planora_EnterproseHostWebApp.Models.EventDates>())
        .Where(d => d.EventSlots != null)
        .SelectMany(d => d.EventSlots)
        .ToList();
    var eventTotalCapacity = allEventSlots.Sum(s => s.Capacity);
    var eventHallCount = allEventSlots.Select(s => s.HallId).Distinct().Count();
}
<style>
    .field__hint {
        display: block;
        margin-top: 0.375rem;
        font-size: 0.6875rem;
        color: var(--color-text-subtle);
    }

    .descprev {
        margin-top: var(--space-3);
        padding: var(--space-3) 0.875rem;
        background-color: var(--color-surface-alt);
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-sm);
    }

    .descprev__label {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 0.5625rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .descprev__list {
        margin: 0 0 0 1rem;
        font-size: var(--fs-2xs);
        color: var(--color-text-label);
    }

    .descprev__line {
        font-size: var(--fs-2xs);
        color: var(--color-text-label);
    }
</style>
<style>
    :root {
        --brand: #7a1170;
        --brand-dark: #5c0d54;
        --ink: #1f2430;
        --muted: #6b7280;
        --line: #e5e7eb;
        --bg: #ffffff;
        --danger: #b91c1c;
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,sans-serif;
        background: #f6f6f8;
        color: var(--ink);
    }

    .card {
        max-width: 640px;
        margin: 0 auto;
        background: var(--bg);
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    /* ---- header row with toggle switch ---- */
    .switchcard {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .switchcard__title {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .switch {
        appearance: none;
        -webkit-appearance: none;
        width: 44px;
        height: 24px;
        border-radius: 999px;
        background: #d1d5db;
        position: relative;
        border: none;
        cursor: pointer;
        transition: background .18s ease;
        flex-shrink: 0;
    }

        .switch::after {
            content: "";
            position: absolute;
            top: 3px;
            left: 3px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #fff;
            transition: transform .18s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,.25);
        }

        .switch[aria-checked="true"] {
            background: var(--brand);
        }

            .switch[aria-checked="true"]::after {
                transform: translateX(20px);
            }

    .inclhead {
        font-size: 14px;
        color: var(--muted);
        margin: 14px 0 16px;
        line-height: 1.5;
    }

    /* ---- rows ---- */
    .inclrows {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .inclrow {
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 14px 16px;
    }

    .inclrow__pick {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        flex: 1;
        cursor: pointer;
        min-width: 0;
    }

        .inclrow__pick input[type="checkbox"] {
            width: 18px;
            height: 18px;
            margin-top: 2px;
            accent-color: #2563eb;
            flex-shrink: 0;
            cursor: pointer;
        }

    .inclrow__body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .inclrow__label {
        font-weight: 600;
        font-size: 15px;
    }

    .inclrow__note {
        font-size: 13px;
        color: var(--muted);
    }

    /* inline edit fields, hidden until "edit" is clicked */
    .inclrow__edit {
        display: none;
        flex: 1;
        flex-direction: column;
        gap: 6px;
    }

    .inclrow--editing .inclrow__pick {
        display: none;
    }

    .inclrow--editing .inclrow__edit {
        display: flex;
    }

    .inclrow__edit input {
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 14px;
        font-family: inherit;
    }

    .inclrow__acts {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .iconbtn {
        border: none;
        background: transparent;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #374151;
    }

        .iconbtn:hover {
            background: #f3f4f6;
        }

        .iconbtn svg {
            width: 18px;
            height: 18px;
        }

        .iconbtn[data-repeat-remove] {
            color: var(--danger);
        }

    .inclfoot {
        margin-top: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn--outline {
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .btn--outline:hover {
            background: #f9fafb;
        }

    .field__hint {
        font-size: 12px;
        color: var(--muted);
    }

    .notice--off {
        display: none;
        margin-top: 16px;
        font-size: 14px;
        color: var(--muted);
        background: #f3f4f6;
        border-radius: 8px;
        padding: 12px 14px;
    }

    .u-visually-hidden {
        position: absolute !important;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }

    /* Inline validation styling for this page only — reuses existing design tokens. */
    .field__error {
        display: none;
        margin-top: 0.375rem;
        font-size: 0.75rem;
        line-height: var(--lh-snug, 1.4);
        color: var(--color-danger);
    }

        .field__error.is-visible {
            display: block;
        }

    .field__input.is-invalid,
    .field__select.is-invalid {
        border-color: var(--color-danger);
    }

        .field__input.is-invalid:focus,
        .field__select.is-invalid:focus {
            border-color: var(--color-danger);
            box-shadow: 0 0 0 3px var(--color-danger-soft);
        }
</style>
<div class="wizard__body">

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="notice notice--warn notice--flat u-mb-5" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="notice notice--success notice--flat u-mb-5" role="status">@Model.SuccessMessage</div>
    }

    <main class="wizard__content">
        <div class="wizard__inner">
            <form class="stack" id="TicketPriceForm" method="post" enctype="multipart/form-data" novalidate data-ticket-pricing-form>
                @Html.AntiForgeryToken()
                <input type="hidden" id="EventId" name="EventId" value="@Model.EventId" />
                <input type="hidden" id="EventType" name="EventType" value="@(pageIsPrivateEvent ? "private" : "public")" />
                <input type="hidden" id="PricingMode" name="PricingMode" value="@(string.Equals(Model.PricingMode, "free", StringComparison.OrdinalIgnoreCase) ? "free" : "paid")" />
                @* Existing ticket tiers (if any) for this event, used to rehydrate the
                   form below. type="application/json" means the browser never
                   executes this as script - it's inert data, parsed via
                   JSON.parse, not interpolated into JS source. *@
                <script id="existing-ticket-data" type="application/json">@Html.Raw(Model.ExistingTicketDataJson)</script>

                <!-- Free vs paid -->
                <section class="panel" aria-labelledby="pricing-title">
                    <div class="panel__head panel__head--plain">
                        <div>
                            <h2 class="panel__title" id="pricing-title">Event Pricing</h2>
                            <p class="panel__meta">
                                @(pageIsPrivateEvent ? "Private events are paid tickets only" : "Toggle to offer free or paid tickets")
                            </p>
                        </div>
                        <div class="segment" id="paidmode" role="group" aria-label="Pricing mode" data-segment>
                            @if (!pageIsPrivateEvent)
                            {
                                <button class="segment__btn" type="button"
                                        aria-pressed="@(string.Equals(Model.PricingMode, "free", StringComparison.OrdinalIgnoreCase) && !pageIsPrivateEvent ? "true" : "false")"
                                        data-segment-value="free">
                                    Free
                                </button>
                            }
                            <button class="segment__btn" type="button"
                                    aria-pressed="@(string.Equals(Model.PricingMode, "free", StringComparison.OrdinalIgnoreCase) && !pageIsPrivateEvent ? "false" : "true")"
                                    data-segment-value="paid">
                                Paid
                            </button>
                        </div>
                    </div>
                    <div class="panel__body">
                        <div class="formgrid formgrid--3" data-segment-panel="paid"
                             data-segment-owner="paidmode">
                            <div class="form__field">
                                <label class="field__label" for="display-currency">Display Currency<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                <select class="field__select" id="display-currency" name="display-currency" aria-describedby="err-display-currency" data-validate="required">
                                    <option selected="@(Model.Currency == "NGN")">NGN</option>
                                    <option selected="@(Model.Currency == "USD")">USD</option>
                                    <option selected="@(Model.Currency == "GHS")">GHS</option>
                                    <option selected="@(Model.Currency == "KES")">KES</option>
                                    <option selected="@(Model.Currency == "ZAR")">ZAR</option>
                                </select>
                                <span class="field__hint">Prices shown to buyers</span>
                                <span class="field__error" id="err-display-currency" role="alert"></span>
                            </div>
                            <div class="form__field">
                                <label class="field__label" for="settlement-currency">Settlement Currency<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                <input class="field__input" id="settlement-currency" name="settlement-currency" type="text" value="@Model.Currency" readonly aria-describedby="err-settlement-currency">
                                <span class="field__hint">Currency you are paid in &mdash; matches Display Currency</span>
                                <span class="field__error" id="err-settlement-currency" role="alert"></span>
                            </div>
                            <div class="form__field">
                                <label class="field__label" for="total-capacity">Total Capacity</label>
                                <input class="field__input" id="total-capacity" name="total-capacity" type="text" value="@eventTotalCapacity" readonly>
                                <span class="field__hint">Across all tiers &mdash; calculated</span>
                            </div>
                        </div>

                        <div data-segment-panel="free" data-segment-owner="paidmode" hidden>
                            <p class="notice notice--flat notice--info">
                                <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                                Free events need no currency or settlement configuration.
                            </p>
                        </div>
                    </div>
                </section>


                <!-- Free events: exactly one tier (public events only; private events are paid-only) -->
                @if (!pageIsPrivateEvent)
                {
                    <section class="panel" data-segment-panel="free" data-segment-owner="paidmode"
                             aria-labelledby="freetier-title" hidden>
                        <div class="panel__head">
                            <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg></span>
                            <h2 class="panel__title" id="freetier-title">Free Ticket</h2>
                            <p class="panel__meta">Quantity, description, seating &amp; capacity</p>
                        </div>
                        <div class="panel__body">
                            <div class="freetier">
                                <input type="hidden" id="free-tier-id" name="free-tier-id" value="0">
                                <div class="freetier__head">
                                    <span class="freetier__badge">Free</span>
                                    <span>
                                        <span class="switchcard__title">Single ticket tier</span>
                                        <span class="freetier__note">
                                            Free events use one tier named &ldquo;Free&rdquo; &mdash; no pricing,
                                            promo codes or add-ons apply.
                                        </span>
                                    </span>
                                </div>

                                <div class="formgrid formgrid--2">
                                    <div class="form__field">
                                        <label class="field__label" for="free-qty">Quantity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="free-qty" name="free-qty" type="text" placeholder="0" value="" aria-describedby="err-free-qty" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                        <span class="field__hint">Total free tickets released</span>
                                        <span class="field__error" id="err-free-qty" role="alert"></span>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="free-cap">Maximum Capacity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="free-cap" name="free-cap" type="text" placeholder="0" value="" aria-describedby="err-free-cap" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                        <span class="field__hint">Hard ceiling across the event</span>
                                        <span class="field__error" id="err-free-cap" role="alert"></span>
                                    </div>
                                </div>

                                <div class="formgrid u-mt-5">
                                    <div class="form__field">
                                        <label class="field__label" for="free-desc">Description<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <textarea class="field__input" id="free-desc" name="free-desc" type="text" placeholder="Shown on the ticket card" value="General admission" aria-describedby="err-free-desc" data-validate="required" style="height:3.5rem;align-content:center"></textarea>
                                        <span class="field__error" id="err-free-desc" role="alert"></span>
                                    </div>
                                </div>
                                <div class="descprev" data-desc-prev="free">
                                    <span class="descprev__label">How the buyer sees it</span>
                                    <ul class="descprev__list" data-desc-list>
                                        <li>General admission</li>
                                        <li>Entry to every standard session</li>
                                        <li>Lunch on both days</li>
                                    </ul>
                                    <p class="descprev__line" data-desc-line hidden></p>
                                </div>

                            </div>

                            <div class="reveal reveal--info u-mt-5" data-seatplan>
                                <span class="reveal__title">Seating layout for this event</span>

                                <div class="seatplan__modes" role="group"
                                     aria-label="Seating layout type" data-seatmode-group>
                                    <button class="seatplan__mode" type="button" aria-pressed="true"
                                            data-seatmode="rows">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                                        <strong>Row / Seat</strong>
                                        Numbered seats in rows
                                    </button>
                                    <button class="seatplan__mode" type="button" aria-pressed="false"
                                            data-seatmode="tables">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                        <strong>Table / Chair</strong>
                                        Round or long tables
                                    </button>
                                    <button class="seatplan__mode" type="button" aria-pressed="false"
                                            data-seatmode="standing">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9.5" cy="7.5" r="3.5" /><path d="M17 4.2a3.5 3.5 0 0 1 0 6.6M21 20v-1.5a4 4 0 0 0-3-3.8" /></svg>
                                        <strong>Standing</strong>
                                        Capacity only, no seats
                                    </button>
                                    <button class="seatplan__mode" type="button" aria-pressed="false"
                                            data-seatmode="open">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg>
                                        <strong>Open seating</strong>
                                        First come, no numbering
                                    </button>
                                </div>

                                <div data-seatmode-panel="rows">
                                    <div class="sizegrid">
                                        <div class="form__field">
                                            <label class="field__label" for="free-rows">Total Rows<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="field__input" id="free-rows" name="free-rows" type="text" placeholder="0" value="" aria-describedby="err-free-rows" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                            <span class="field__hint">Rows are labelled A, B, C&hellip;</span>
                                            <span class="field__error" id="err-free-rows" role="alert"></span>
                                        </div>
                                        <div class="form__field">
                                            <label class="field__label" for="free-seats-row">Seats per Row<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="field__input" id="free-seats-row" name="free-seats-row" type="text" placeholder="0" value="" aria-describedby="err-free-seats-row" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                            <span class="field__hint">Numbered 1 upwards within each row</span>
                                            <span class="field__error" id="err-free-seats-row" role="alert"></span>
                                        </div>
                                    </div>
                                    <p class="sizetotal">
                                        <span>Total numbered seats &mdash; rows &times; seats per row</span>
                                        <span class="sizetotal__value">240 seats</span>
                                    </p>
                                </div>

                                <div data-seatmode-panel="tables" hidden>
                                    <div class="sizegrid">
                                        <div class="form__field">
                                            <label class="field__label" for="free-tables">Total Tables<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="field__input" id="free-tables" name="free-tables" type="text" placeholder="0" value="" aria-describedby="err-free-tables" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                            <span class="field__hint">Tables are labelled T1, T2, T3&hellip;</span>
                                            <span class="field__error" id="err-free-tables" role="alert"></span>
                                        </div>
                                        <div class="form__field">
                                            <label class="field__label" for="free-chairs">Chairs per Table<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="field__input" id="free-chairs" name="free-chairs" type="text" placeholder="0" value="" aria-describedby="err-free-chairs" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                            <span class="field__hint">Seats are assigned per table</span>
                                            <span class="field__error" id="err-free-chairs" role="alert"></span>
                                        </div>
                                    </div>
                                    <p class="sizetotal">
                                        <span>Total seats &mdash; tables &times; chairs per table</span>
                                        <span class="sizetotal__value">100 seats</span>
                                    </p>
                                </div>

                                <div data-seatmode-panel="standing" hidden>
                                    <div class="formgrid">
                                        <div class="form__field">
                                            <label class="field__label" for="free-standing-cap">Maximum Capacity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="field__input" id="free-standing-cap" name="free-standing-cap" type="text" placeholder="0" value="" aria-describedby="err-free-standing-cap" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                            <span class="field__hint">Registration closes at this number</span>
                                            <span class="field__error" id="err-free-standing-cap" role="alert"></span>
                                        </div>
                                    </div>
                                    <p class="sizetotal">
                                        <span>Standing area &mdash; no seats issued, entry capped by capacity</span>
                                        <span class="sizetotal__value">300 places</span>
                                    </p>
                                </div>

                                <div data-seatmode-panel="open" hidden>
                                    <div class="formgrid">
                                        <div class="form__field">
                                            <label class="field__label" for="free-open-cap">Maximum Capacity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="field__input" id="free-open-cap" name="free-open-cap" type="text" placeholder="0" value="" aria-describedby="err-free-open-cap" data-validate="number" oninput="this.value = this.value.replace(/\D/g, '')">
                                            <span class="field__hint">Registration closes at this number</span>
                                            <span class="field__error" id="err-free-open-cap" role="alert"></span>
                                        </div>
                                    </div>
                                    <p class="sizetotal">
                                        <span>Open seating &mdash; counted for capacity, no seat numbers printed</span>
                                        <span class="sizetotal__value">300 seats</span>
                                    </p>
                                </div>
                            </div>


