                                                <label class="scopeslot">
                                                    <input type="checkbox" name="acc-free-day-@date.EventDateId" value="@date.EventDateId">
                                                    <span class="scopeslot__body">
                                                        <span class="scopeslot__name">Day @dayIndex &mdash; @date.SessionName</span>
                                                        <span class="scopeslot__meta">@date.EventDateValue &middot; @(date.EventSlots?.Count ?? 0) sessions</span>
                                                    </span>
                                                </label>
                                                dayIndex++;
                                            }
                                        }
                                        else
                                        {
                                            <p class="field__hint">No event dates found.</p>
                                        }
                                    </div>
                                </div>

