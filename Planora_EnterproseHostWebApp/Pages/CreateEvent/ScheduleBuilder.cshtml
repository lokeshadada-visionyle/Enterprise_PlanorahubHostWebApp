@page
@model Planora_EnterproseHostWebApp.Pages.CreateEvent.ScheduleBuilderModel
@{
    Layout = "_CreateEventLayout";
    ViewData["StepIndex"] = 3;
    ViewData["StepTotal"] = 9;
    ViewData["StepName"] = "Schedule Builder";
    ViewData["StepHint"] = "Set your venue, halls, dates and time slots";
}
<div class="wizard__body">
    <main class="wizard__content">
        <div class="wizard__inner">
            @Html.AntiForgeryToken()
            <form class="stack" id="scheduleForm" action="content-sections.html" method="post">

                <!-- STEP 1: Speakers section -->
                <section class="panel" id="section-speakers" aria-labelledby="speakers-title">
                    <div class="panel__head panel__head--plain">
                        <div>
                            <h2 class="panel__title panel__title--lg" id="speakers-title">Speakers</h2>
                            <p class="panel__meta">Fill a speaker in once, then attach them to any session. Photo, title, organisation and bio all appear on the event page.</p>
                        </div>
                        <button class="btn btn--outline btn--sm" type="button" style="white-space: nowrap;" data-repeat-add="speaker-list">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add speaker
                        </button>
                    </div>
                    <div class="panel__body">
                        <div class="speakers" id="speaker-list">
                            <article class="speaker" data-speaker-row data-repeat-row data-speaker-key="kofi">
                                <div class="speaker__top">
                                    <span class="speakerav" data-speaker-avatar="kofi">
                                        <span class="speakerav__initials">KA</span>
                                    </span>
                                    <span class="speaker__tools">
                                        <button class="iconbtn iconbtn--danger" type="button" data-repeat-remove data-action="Speaker removed from the speaker directory" data-action-tone="warn">
                                            <span class="u-visually-hidden">Remove Speaker</span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg>
                                        </button>
                                    </span>
                                </div>

                                <div class="formgrid formgrid--3">
                                    <div class="form__field">
                                        <label class="field__label" for="sp-1-name">Full name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="sp-1-name" name="sp-1-name" type="text" value="" placeholder="Speaker name" data-speaker-field="name" required>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="sp-1-title">Job title<span class="field__required" aria-hidden="true">*</span></label>
                                        <input class="field__input" id="sp-1-title" name="sp-1-title" type="text" value="" placeholder="e.g. Chief Technology Officer" data-speaker-field="title" required>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="sp-1-org">Organisation<span class="field__required" aria-hidden="true">*</span></label>
                                        <input class="field__input" id="sp-1-org" name="sp-1-org" type="text" value="" placeholder="Company or institution" data-speaker-field="org" required>
                                    </div>
                                </div>

                                <div class="form__field u-mt-5">
                                    <label class="field__label" for="sp-1-bio">Short bio</label>
                                    <textarea class="field__input" id="sp-1-bio" name="sp-1-bio" rows="3" placeholder="Two or three sentences. Shown on the event page and the session detail." data-speaker-field="bio"></textarea>
                                    <span class="field__hint">
                                        <span data-speaker-count="kofi">0</span> characters &middot; about 300 reads best on a session card
                                    </span>
                                </div>

                                <p class="speaker__sessions">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                                    <span data-speaker-sessions="kofi">Not assigned to a session yet</span>
                                </p>
                            </article>
                        </div>

                        <p class="notice notice--info notice--flat u-mt-5">
                            <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                            A speaker with no title or organisation still works &mdash; the event page simply shows their name. Only the name is required.
                        </p>

                        <div class="u-mt-5" style="text-align: right;">
                            <button type="button" class="btn btn--primary btn--sm" id="btnSaveSpeakers">Save Speakers &amp; Continue to Venue</button>
                        </div>
                    </div>
                </section>

                <!-- STEP 2: Venues & halls -->
                <div id="section-venues" data-venue-section hidden>
                    <div class="dashbox" style="margin-bottom: 10px;">
                        <span class="dashbox__tag">Venue mode</span>
                        <div class="optin">
                            <input class="optin__box" id="multivenue" name="multivenue" type="checkbox" data-reveal="multi-venue" data-reveal-inverse="single-venue" aria-controls="multi-venue">
                            <label for="multivenue">
                                <span class="optin__title">Multi-venue, multi-hall event</span>
                                <span class="optin__hint">On: add several venues, each with its own halls, and choose both per time slot. Off: one venue &mdash; slots simply pick a hall.</span>
                            </label>
                        </div>
                    </div>

                    <div class="u-mt-6">
                        <section class="panel" id="single-venue" aria-labelledby="single-venue-title">
                            <div class="panel__head">
                                <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
                                <h2 class="panel__title" id="single-venue-title">Venue &amp; Halls</h2>
                                <p class="panel__meta">One venue &mdash; halls allocated per time slot</p>
                            </div>
                            <div class="panel__body">
                                <div class="formgrid formgrid--2">
                                    <div class="form__field">
                                        <label class="field__label" for="sv-name">Venue Name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="sv-name" name="sv-name" type="text" placeholder="e.g. Eko Hotel Convention Centre" value="" required>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="sv-city">City<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <select class="field__input" id="sv-city" name="sv-city" required>
                                            <option value="">Select City...</option>
                                            @if (Model.Cities != null && Model.Cities.Any())
                                            {
                                                @foreach (var city in Model.Cities)
                                                {
                                                    <option value="@city.CityName">
                                                        @city.CityName@(string.IsNullOrWhiteSpace(city.CountryName) ? "" : $", {city.CountryName}")
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="formgrid u-mt-5">
                                    <div class="form__field">
                                        <label class="field__label" for="sv-address">Address<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="sv-address" name="sv-address" type="text" placeholder="Full street address" value="">
                                    </div>
                                </div>

                                <div class="formgrid u-mt-5">
                                    <div class="form__field">
                                        <label class="field__label" for="sv-map-url">Map URL<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="sv-map-url" name="sv-map-url" type="text" placeholder="Map URL" value="https://www.google.com/maps">
                                    </div>
                                </div>

                                <div class="halls">
                                    <p class="halls__head">
                                        Halls / Rooms &middot; max capacity
                                        <button class="halls__add" type="button" data-repeat-add="sv-halls">+ Add Hall</button>
                                    </p>
                                    <div id="sv-halls">
                                        <div class="hall" data-repeat-row>
                                            <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                            <label class="u-visually-hidden" for="sv-1-hall-name">Hall name</label>
                                            <input class="hall__name" id="sv-1-hall-name" name="sv-1-hall-name" type="text" placeholder="e.g. Main Hall" value="" required>
                                            <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                            <label class="u-visually-hidden" for="sv-1-hall-cap">Maximum capacity</label>
                                            <input class="hall__cap" id="sv-1-hall-cap" name="sv-1-hall-cap" type="text" inputmode="numeric" value="" placeholder="e.g. 200" required>
                                            <button class="hall__remove" type="button" data-repeat-remove>
                                                <span class="u-visually-hidden">Remove hall</span>
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="u-mt-5" style="text-align: right;">
                                <button type="button" class="btn btn--primary btn--sm" id="btnSaveVenues">Save Venue &amp; Load Schedule</button>
                            </div>
                        </section>

                        <section class="panel" id="multi-venue" aria-labelledby="multi-venue-title" hidden>
                            <div class="panel__head">
                                <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 3 3 5.5v15L9 18l6 3 6-2.5v-15L15 6 9 3zM9 3v15M15 6v15" /></svg></span>
                                <h2 class="panel__title" id="multi-venue-title">Venues &amp; Halls</h2>
                                <button class="btn btn--outline btn--sm panel__meta" type="button" data-repeat-add="venue-list">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add Venue
                                </button>
                            </div>
                            <div class="panel__body">
                                <div id="venue-list">
                                    <div class="venue" data-repeat-row>
                                        <div class="venue__head">
                                            <span class="venue__no" aria-hidden="true">1</span>
                                            <h3 class="venue__title">Venue 1</h3>
                                            <button class="venue__remove" type="button" data-repeat-remove>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg> Remove venue
                                            </button>
                                        </div>

                                        <div class="formgrid formgrid--2">
                                            <div class="form__field">
                                                <label class="field__label" for="venue-1-name">Venue Name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="field__input" id="venue-1-name" name="venue-1-name" type="text" placeholder="e.g. Eko Hotel Convention Centre" value="" required>
                                            </div>
                                            <div class="form__field">
                                                <label class="field__label" for="venue-1-city">City<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <select class="field__input" id="venue-1-city" name="venue-1-city" required>
                                                    <option value="">Select City...</option>
                                                    @if (Model.Cities != null && Model.Cities.Any())
                                                    {
                                                        @foreach (var city in Model.Cities)
                                                        {
                                                            <option value="@city.CityName">
                                                                @city.CityName@(string.IsNullOrWhiteSpace(city.CountryName) ? "" : $", {city.CountryName}")
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="formgrid u-mt-5">
                                            <div class="form__field">
                                                <label class="field__label" for="venue-1-address">Address<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="field__input" id="venue-1-address" name="venue-1-address" type="text" placeholder="Full street address" required>
                                            </div>
                                        </div>

                                        <div class="formgrid u-mt-5">
                                            <div class="form__field">
                                                <label class="field__label" for="venue-1-map-url">Map URL<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="field__input" id="venue-1-map-url" name="venue-1-map-url" type="text" placeholder="Map URL" value="https://www.google.com/maps">
                                            </div>
                                        </div>

                                        <div class="halls">
                                            <p class="halls__head">
                                                Halls / Rooms &middot; max capacity
                                                <button class="halls__add" type="button" data-repeat-add="venue-1-halls">+ Add Hall</button>
                                            </p>
                                            <div id="venue-1-halls">
                                                <div class="hall" data-repeat-row>
                                                    <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                                    <label class="u-visually-hidden" for="v1-1-hall-name">Hall name</label>
                                                    <input class="hall__name" id="v1-1-hall-name" name="v1-1-hall-name" type="text" placeholder="e.g. Main Hall" value="" required>
                                                    <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                                    <label class="u-visually-hidden" for="v1-1-hall-cap">Maximum capacity</label>
                                                    <input class="hall__cap" id="v1-1-hall-cap" name="v1-1-hall-cap" type="text" inputmode="numeric" value="" placeholder="e.g. 200" required>
                                                    <button class="hall__remove" type="button" data-repeat-remove>
                                                        <span class="u-visually-hidden">Remove hall</span>
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                <!-- STEP 3: Date & Schedule -->
                <section class="panel" id="section-schedule" aria-labelledby="date-title" data-schedule-section hidden>
                    <div class="panel__head">
                        <span class="tile tile--info" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg></span>
                        <h2 class="panel__title" id="date-title">Date &amp; Schedule</h2>
                        <p class="panel__meta">Date, time slots and hall allocation per slot</p>
                    </div>

                    <div class="panel__body">
                        <div class="options" role="radiogroup" aria-label="Schedule type" id="schedmode" data-pick-group>
                            <button class="option option--selected" type="button" role="radio" aria-checked="true" data-pick="single">
                                <span class="option__icon" aria-hidden="true">&#128197;</span>
                                <span class="option__title">Single Day</span>
                                <span class="option__text">One date with one or more time slots</span>
                                <svg class="option__check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                            </button>
                            <button class="option" type="button" role="radio" aria-checked="false" data-pick="range">
                                <span class="option__icon" aria-hidden="true">&#128197;</span>
                                <span class="option__title">Multi-Day Range</span>
                                <span class="option__text">Consecutive days between two dates</span>
                            </button>
                            <button class="option" type="button" role="radio" aria-checked="false" data-pick="specific">
                                <span class="option__icon" aria-hidden="true">&#128198;</span>
                                <span class="option__title">Specific Dates</span>
                                <span class="option__text">Individual, non-consecutive dates</span>
                            </button>
                        </div>

                        <div class="formgrid formgrid--2" data-pick-panel="range" data-pick-owner="schedmode" hidden>
                            <div class="form__field">
                                <label class="field__label" for="range-start">Start Date<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                <input class="field__input" id="range-start" name="range-start" type="date" value="" required>
                            </div>
                            <div class="form__field">
                                <label class="field__label" for="range-end">End Date<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                <input class="field__input" id="range-end" name="range-end" type="date" value="" required>
                                <span class="field__hint">Up to 10 days from the start date</span>
                            </div>
                        </div>

                        <div id="schedule-day-tabs" class="scopebar" hidden>
                            <span class="scopebar__label">Day</span>
                            <div class="scopebar__row" role="group" aria-label="Choose a day" id="schedule-day-tabs-row"></div>
                        </div>

                        <div id="schedule-days" class="u-mt-5">
                            <div class="day" data-day data-repeat-row>
                                <div class="day__head">
                                    <span class="day__no" aria-hidden="true">1</span>
                                    <span class="day__date">
                                        <label class="slotcard__label" for="day-1-name">Session name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="day-1-name" name="day-1-name" type="text" value="" data-autoname="Session" placeholder="eg:- Session Name" required>
                                    </span>
                                    <span class="day__date">
                                        <label class="slotcard__label" for="day-1-date">Date<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="day-1-date" name="day-1-date" type="date" value="" data-day-date required>
                                    </span>
                                    <button class="hall__remove" type="button" data-day-remove title="Remove this day">
                                        <span class="u-visually-hidden">Remove this day</span>
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>

                                <div class="slots" id="day-1-slots">
                                    <div class="slotcard" data-slot data-repeat-row>
                                        <div class="slotcard__top">
                                            <span class="slotcard__no" aria-hidden="true">1</span>
                                            <label class="u-visually-hidden" for="slot-1-1-name">Slot name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="slotcard__name" id="slot-1-1-name" name="slot-1-1-name" type="text" value="" placeholder="eg:-slotName" data-autoname="Slot" required>
                                            <button class="line__remove" type="button" data-repeat-remove>
                                                <span class="u-visually-hidden">Remove this slot</span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg>
                                            </button>
                                        </div>

                                        <div class="slotcard__grid">
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-start">Start time<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="slot__input" id="slot-1-1-start" name="slot-1-1-start" type="time" value="" data-slot-start disabled required>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-end">End time<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="slot__input" id="slot-1-1-end" name="slot-1-1-end" type="time" value="" data-slot-end disabled required>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-venue">Venues<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <select class="slot__select" id="slot-1-1-venue" name="slot-1-1-venue" data-slot-venue-select required>
                                                    <option value="">Select Venues...</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-hall">Halls<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <select class="slot__select" id="slot-1-1-hall" name="slot-1-1-hall" data-slot-hall disabled required>
                                                    <option value="">Select a venue first...</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-cap">Max capacity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="slot__input" id="slot-1-1-cap" name="slot-1-1-cap" type="text" inputmode="numeric" value="" placeholder="0" data-cap-input required>
                                            </div>
                                            <div class="slotcard__speakers">
                                                <span class="slotcard__label" id="slot-1-1-splabel">Speakers<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></span>
                                                <div class="speakerchips" data-speaker-chips="slot-1-1"></div>
                                                <label class="u-visually-hidden" for="slot-1-1-speakeradd">Add a speaker to this session</label>
                                                <select class="slot__select" id="slot-1-1-speakeradd" data-speaker-add="slot-1-1" aria-describedby="slot-1-1-splabel" required>
                                                    <option value="">Add a speaker&hellip;</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button class="addline" type="button" data-repeat-add="day-1-slots">+ Add time slot</button>
                            </div>
                        </div>

                        <button class="addline" type="button" data-repeat-add="schedule-days">+ Add day</button>

                        <p class="notice notice--warn notice--flat u-mt-5" role="status" data-schedule-conflict hidden>
                            <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
                            <span data-schedule-conflict-text></span>
                        </p>
                    </div>

                    <div class="capbar">
                        <span class="capbar__item">
                            <span class="capbar__label">Total hall capacity</span>
                            <span class="capbar__value" data-cap-limit>0</span>
                        </span>
                        <span class="capbar__item">
                            <span class="capbar__label">Peak concurrent</span>
                            <span class="capbar__value capbar__value--total" data-cap-total>0</span>
                        </span>
                        <span class="capbar__item">
                            <span class="capbar__label">Headroom at peak</span>
                            <span class="capbar__value capbar__value--remaining" data-cap-remaining>0</span>
                        </span>
                        <p class="notice notice--warn notice--flat" data-cap-warning hidden>
                            <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
                            <span data-cap-warning-text></span>
                        </p>
                    </div>
                </section>

                <section class="panel" aria-labelledby="halls-note-title">
                    <div class="panel__head panel__head--plain">
                        <h2 class="panel__title panel__title--lg" id="halls-note-title">Hall allocation rules</h2>
                    </div>
                    <div class="panel__body">
                        <ul class="choice__list">
                            <li>
                                <span style="display:flex; align-items:flex-start; gap:8px;">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0; margin-top:2px;"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>A hall cannot host two overlapping slots on the same day — overlaps are flagged as you type.</span>
                                </span>
                            </li>
                            <li>
                                <span style="display:flex; align-items:flex-start; gap:8px;">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0; margin-top:2px;"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>A slot cannot be allocated more seats than its hall holds.</span>
                                </span>
                            </li>
                            <li>
                                <span style="display:flex; align-items:flex-start; gap:8px;">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0; margin-top:2px;"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>Capacity is measured at peak concurrency, so parallel breakouts are counted once.</span>
                                </span>
                            </li>
                        </ul>
                    </div>
                </section>
            </form>
        </div>
    </main>

    <footer class="wizard__foot">
        <a class="btn btn--outline" asp-page="/CreateEvent/BasicDetails" data-wizard-link><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 6l-6 6 6 6" /></svg> Back</a>
        <div class="wizard__foot-end">
            <button class="btn btn--primary" id="btnContinue" type="button">Continue <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 6l6 6-6 6" /></svg></button>
        </div>
    </footer>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async function() {
        const venueSection = document.getElementById("section-venues");
        const scheduleSection = document.getElementById("section-schedule");
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        let globalVenuesCache = [];
        let globalSpeakersCache = [];

        let hasSavedVenues = false;
        let hasSavedSpeakers = false;
        let hasSavedSchedule = false;

        const blankDayTemplate = document.querySelector("#schedule-days .day").cloneNode(true);
        const blankSlotTemplate = blankDayTemplate.querySelector(".slotcard").cloneNode(true);

        const scheduleDrafts = { single: null, range: null, specific: null };

        function assignSpeakerRowKey(row, key) {
            row.setAttribute("data-speaker-key", key);
            ["data-speaker-avatar", "data-speaker-photo", "data-speaker-count", "data-speaker-sessions"]
                .forEach(attr => {
                    const el = row.querySelector(`[${attr}]`);
                    if (el) el.setAttribute(attr, key);
                });
            return key;
        }

        let speakerKeySeq = 0;
        function nextSpeakerKey() {
            speakerKeySeq += 1;
            return "speaker-new-" + Date.now() + "-" + speakerKeySeq;
        }

        // ===================== SCHEDULE MODE (single / range / specific) =====================

        let scheduleToastHost = null;
        function scheduleToast(message, tone) {
            if (!scheduleToastHost) {
                scheduleToastHost = document.createElement('div');
                scheduleToastHost.className = 'toasts';
                scheduleToastHost.setAttribute('role', 'status');
                scheduleToastHost.setAttribute('aria-live', 'polite');
                document.body.appendChild(scheduleToastHost);
            }
            const note = document.createElement('p');
            note.className = 'toast' + (tone ? ' toast--' + tone : '');
            note.textContent = message;
            scheduleToastHost.appendChild(note);
            setTimeout(() => {
                note.classList.add('toast--out');
                setTimeout(() => note.parentNode && note.parentNode.removeChild(note), 300);
            }, 3200);
        }

        const MAX_SLOTS_PER_DAY = 4;
        const MAX_RANGE_DAYS = 10;
        const MAX_BOOKING_WINDOW_DAYS = 30;

        let previousScheduleMode = 'single';
        let savedScheduleMode = null;

        function getScheduleMode() {
            const active = document.querySelector('#schedmode .option[aria-checked="true"]');
            return active ? active.getAttribute('data-pick') : 'single';
        }

        function combineDateTime(dateStr, timeStr) {
            if (!dateStr || !timeStr) return "";
            return `${dateStr}T${timeStr}`;
        }

        function extractTimePart(value) {
            if (!value) return "";
            const match = value.match(/T(\d{2}:\d{2})/);
            return match ? match[1] : "";
        }

        function updateDayNo(dayRow, index) {
            const noEl = dayRow.querySelector(".day__no");
            if (noEl) noEl.textContent = index + 1;
        }

        function renumberDays() {
            document.querySelectorAll("#schedule-days .day").forEach((dayRow, idx) => updateDayNo(dayRow, idx));
        }

        let dayIdSeq = 0;
        function reindexDayRow(dayRow, index) {
            if (!dayRow) return;
            const slotsContainer = dayRow.querySelector(".slots");
            if (!slotsContainer) return;

            dayIdSeq += 1;
            const uid = `day-${index + 1}-${dayIdSeq}-slots`;
            slotsContainer.id = uid;

            const addBtn = dayRow.querySelector('.addline[data-repeat-add]');
            if (addBtn) addBtn.setAttribute("data-repeat-add", uid);
        }

        function reindexAllDayRows() {
            document.querySelectorAll("#schedule-days .day").forEach((row, idx) => {
                reindexDayRow(row, idx);
                renumberSlots(row);
            });
        }

        function renumberSlots(dayRow) {
            if (!dayRow) return;
            dayRow.querySelectorAll(".slotcard").forEach((slot, idx) => {
                const noEl = slot.querySelector(".slotcard__no");
                if (noEl) noEl.textContent = idx + 1;
            });
        }

        function blankSlotCard(slotCard) {
            if (!slotCard) return;
            delete slotCard.dataset.slotId;

            slotCard.querySelectorAll("input").forEach(inp => { inp.value = ""; });

            const venueSelect = slotCard.querySelector("[data-slot-venue-select]");
            const hallSelect = slotCard.querySelector("[data-slot-hall]");
            const speakerSelect = slotCard.querySelector("[data-speaker-add]");

            if (venueSelect) venueSelect.value = "";
            if (hallSelect) {
                hallSelect.innerHTML = '<option value="">Select a venue first...</option>';
                hallSelect.disabled = true;
            }
            if (speakerSelect) speakerSelect.value = "";

            const chipsContainer = slotCard.querySelector("[data-speaker-chips]");
            if (chipsContainer) chipsContainer.innerHTML = "";

            markConflict(slotCard, false);

            const startInput = slotCard.querySelector("[data-slot-start]");
            const endInput = slotCard.querySelector("[data-slot-end]");
            if (startInput) startInput.disabled = true;
            if (endInput) endInput.disabled = true;
        }

        function syncSlotTimeAvailability(dayRow) {
            const dateVal = dayRow.querySelector("[data-day-date]")?.value;
            dayRow.querySelectorAll(".slotcard").forEach(slotCard => {
                const startInput = slotCard.querySelector("[data-slot-start]");
                const endInput = slotCard.querySelector("[data-slot-end]");
                [startInput, endInput].forEach(input => {
                    if (!input) return;
                    input.disabled = !dateVal;
                });
            });
        }

        function refreshSlotDropdowns() {
            if (globalVenuesCache.length) populateVenueDropdowns(globalVenuesCache);
            if (globalSpeakersCache.length) populateSpeakerDropdowns(globalSpeakersCache);
        }

        // ===================== NEW: hall-overlap + capacity-vs-hall validation =====================

            function markConflict(slotCard, on) {
        // Visual red highlight disabled — client-side validation handled separately.
        return;
    }

        function timesOverlap(aStart, aEnd, bStart, bEnd) {
            return aStart < bEnd && bStart < aEnd;
        }

        // A hall cannot host two overlapping slots on the same day.
        function checkHallOverlaps() {
            const messages = [];
            document.querySelectorAll("#schedule-days .day").forEach(dayRow => {
                const dateVal = dayRow.querySelector("[data-day-date]")?.value;
                if (!dateVal) return;

                const bookings = [];
                dayRow.querySelectorAll(".slotcard").forEach(slotCard => {
                    const hallSelect = slotCard.querySelector("[data-slot-hall]");
                    const hallId = hallSelect?.value;
                    if (!hallId) return;
                    const hallName = hallSelect.options[hallSelect.selectedIndex]?.text || "the same hall";

                    const startTime = slotCard.querySelector("[data-slot-start]")?.value;
                    const endTime = slotCard.querySelector("[data-slot-end]")?.value;
                    if (!startTime || !endTime) return;

                    const start = new Date(combineDateTime(dateVal, startTime)).getTime();
                    const end = new Date(combineDateTime(dateVal, endTime)).getTime();
                    if (isNaN(start) || isNaN(end) || end <= start) return;

                    const slotName = slotCard.querySelector(".slotcard__name")?.value || "This slot";
                    bookings.push({ hallId, hallName, start, end, slotName, slotCard });
                });

                for (let i = 0; i < bookings.length; i++) {
                    for (let j = i + 1; j < bookings.length; j++) {
                        const a = bookings[i], b = bookings[j];
                        if (a.hallId === b.hallId && timesOverlap(a.start, a.end, b.start, b.end)) {
                            messages.push(`"${a.slotName}" and "${b.slotName}" both use ${a.hallName} at overlapping times.`);
                            markConflict(a.slotCard, true);
                            markConflict(b.slotCard, true);
                        }
                    }
                }
            });
            return messages;
        }

        // A slot cannot be allocated more seats than its hall holds.
        function checkCapacityOverflows() {
            const messages = [];
            document.querySelectorAll("#schedule-days .day .slotcard").forEach(slotCard => {
                const hallSelect = slotCard.querySelector("[data-slot-hall]");
                const hallId = hallSelect?.value;
                if (!hallId) return;

                const capInput = slotCard.querySelector("[data-cap-input]");
                const capacity = parseInt(capInput?.value, 10) || 0;
                if (!capacity) return;

                let hallMax = null;
                const hallName = hallSelect.options[hallSelect.selectedIndex]?.text || "its hall";
                for (const v of globalVenuesCache) {
                    const halls = v.Halls ?? v.halls ?? [];
                    const match = halls.find(h => String(h.HallId ?? h.hallId) === String(hallId));
                    if (match) { hallMax = parseInt(match.Capacity ?? match.capacity, 10) || 0; break; }
                }
                if (hallMax === null) return;

                if (capacity > hallMax) {
                    const slotName = slotCard.querySelector(".slotcard__name")?.value || "This slot";
                    messages.push(`"${slotName}" requests ${capacity} seats but ${hallName} only holds ${hallMax}.`);
                    markConflict(slotCard, true);
                }
            });
            return messages;
        }

        function validateScheduleAndRenderWarnings() {
            document.querySelectorAll(".slotcard--conflict").forEach(el => markConflict(el, false));

            const messages = [...checkHallOverlaps(), ...checkCapacityOverflows()];

            const banner = document.querySelector("[data-schedule-conflict]");
            const textEl = document.querySelector("[data-schedule-conflict-text]");
            if (banner && textEl) {
                if (messages.length) {
                    banner.hidden = false;
                    textEl.textContent = messages.join(" ");
                } else {
                    banner.hidden = true;
                    textEl.textContent = "";
                }
            }
            return messages.length === 0;
        }

        function refreshScheduleMetrics() {
            recalculateCapacityBar();
            validateScheduleAndRenderWarnings();
        }

        // ===================== END NEW VALIDATION =====================

        function setScheduleMode(mode) {
            document.querySelectorAll('#schedmode .option').forEach(b => {
                const active = b.getAttribute('data-pick') === mode;
                b.classList.toggle('option--selected', active);
                b.setAttribute('aria-checked', active ? 'true' : 'false');
            });
            document.querySelectorAll('[data-pick-owner="schedmode"]').forEach(panel => {
                panel.hidden = panel.getAttribute('data-pick-panel') !== mode;
            });
            previousScheduleMode = mode;
            updateModeHintBanner(mode);
        }

        function modeLabel(m) {
            return m === 'single' ? 'Single Day' : m === 'range' ? 'Multi-Day Range' : 'Specific Dates';
        }

        function updateModeHintBanner(mode) {
            let hint = document.getElementById('schedule-mode-hint');
            if (!hint) {
                hint = document.createElement('p');
                hint.id = 'schedule-mode-hint';
                hint.className = 'notice notice--info notice--flat u-mt-5';
                document.getElementById('schedmode')?.insertAdjacentElement('afterend', hint);
            }
            if (hasSavedSchedule && savedScheduleMode && mode !== savedScheduleMode) {
                hint.hidden = false;
                hint.textContent = `This event's schedule is currently saved as "${modeLabel(savedScheduleMode)}". `
                    + `You're editing "${modeLabel(mode)}" now — saving here updates the same schedule, `
                    + `but the days saved under "${modeLabel(savedScheduleMode)}" stay on the server unless you `
                    + `switch back and remove them yourself.`;
            } else if (hasSavedSchedule && savedScheduleMode) {
                hint.hidden = false;
                hint.textContent = `This event's schedule is saved as "${modeLabel(savedScheduleMode)}".`;
            } else {
                hint.hidden = true;
            }
        }

        function inferScheduleModeFromDates(isoDates) {
            const dates = [...new Set(isoDates.filter(Boolean))].sort();
            if (dates.length <= 1) return 'single';
            for (let i = 1; i < dates.length; i++) {
                const prev = new Date(dates[i - 1] + 'T00:00:00');
                const cur = new Date(dates[i] + 'T00:00:00');
                if (Math.round((cur - prev) / 86400000) !== 1) return 'specific';
            }
            return 'range';
        }

        function buildDayTabsFromExistingDays() {
            const tabsWrap = document.getElementById("schedule-day-tabs");
            const tabsRow = document.getElementById("schedule-day-tabs-row");
            const rows = document.querySelectorAll("#schedule-days .day");
            if (!tabsRow) return;

            tabsRow.innerHTML = "";
            rows.forEach((row, i) => {
                const dateInput = row.querySelector("[data-day-date]");
                const iso = dateInput?.value || "";
                if (dateInput) dateInput.disabled = true;
                row.hidden = i !== 0;
                updateDayNo(row, i);

                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "scopetab";
                btn.setAttribute("aria-pressed", i === 0 ? "true" : "false");
                btn.dataset.dayIndex = i;
                btn.innerHTML = `Day ${i + 1} <span class="scopetab__date">${iso}</span>`;
                tabsRow.appendChild(btn);
            });
            if (tabsWrap) tabsWrap.hidden = rows.length === 0;
        }

        // ---------- Per-mode draft capture / rebuild ----------
        function captureDayData(dayRow) {
            const sessionName = dayRow.querySelector("input[name*='name']")?.value || "";
            const eventDate = dayRow.querySelector("[data-day-date]")?.value || "";
            const eventDateId = parseInt(dayRow.dataset.eventDateId, 10) || 0;

            const slots = [];
            dayRow.querySelectorAll(".slotcard").forEach(slotCard => {
                const slotId = parseInt(slotCard.dataset.slotId, 10) || 0;
                const slotName = slotCard.querySelector(".slotcard__name")?.value || "";
                const start = slotCard.querySelector("[data-slot-start]")?.value || "";
                const end = slotCard.querySelector("[data-slot-end]")?.value || "";
                const venueId = slotCard.querySelector("[data-slot-venue-select]")?.value || "";
                const hallId = slotCard.querySelector("[data-slot-hall]")?.value || "";
                const capacity = slotCard.querySelector("[data-cap-input]")?.value || "";
                const chips = [...slotCard.querySelectorAll("[data-speaker-chips] .chip")].map(chip => ({
                    id: chip.dataset.chipSpeakerId || "",
                    text: chip.querySelector("span")?.textContent || ""
                }));
                slots.push({ slotId, slotName, start, end, venueId, hallId, capacity, chips });
            });

            return { eventDateId, sessionName, eventDate, slots };
        }

        function captureScheduleDays() {
            return [...document.querySelectorAll("#schedule-days .day")].map(captureDayData);
        }

        function captureCurrentDraft(mode) {
            const draft = { days: captureScheduleDays() };
            if (mode === 'range') {
                draft.start = document.getElementById("range-start")?.value || "";
                draft.end = document.getElementById("range-end")?.value || "";
            }
            return draft;
        }

        async function buildSlotCardFromData(slotData) {
            const slotCard = blankSlotTemplate.cloneNode(true);
            if (slotData.slotId) slotCard.dataset.slotId = slotData.slotId;

            const nameInput = slotCard.querySelector(".slotcard__name");
            const startInput = slotCard.querySelector("[data-slot-start]");
            const endInput = slotCard.querySelector("[data-slot-end]");
            const venueSelect = slotCard.querySelector("[data-slot-venue-select]");
            const hallSelect = slotCard.querySelector("[data-slot-hall]");
            const capInput = slotCard.querySelector("[data-cap-input]");
            const speakerSelect = slotCard.querySelector("[data-speaker-add]");
            const chipsContainer = slotCard.querySelector("[data-speaker-chips]");

            if (nameInput) nameInput.value = slotData.slotName || "";
            if (startInput) startInput.value = slotData.start || "";
            if (endInput) endInput.value = slotData.end || "";
            if (capInput) capInput.value = slotData.capacity || "";
            if (speakerSelect) speakerSelect.value = "";

            if (chipsContainer) {
                chipsContainer.innerHTML = "";
                (slotData.chips || []).forEach(c => {
                    const chip = document.createElement("span");
                    chip.className = "chip";
                    chip.dataset.chipSpeakerId = c.id;
                    chip.innerHTML = `<span>${c.text}</span><button type="button" class="chip__remove" aria-label="Remove speaker">&times;</button>`;
                    chip.querySelector(".chip__remove").addEventListener("click", () => chip.remove());
                    chipsContainer.appendChild(chip);
                });
            }

                if (venueSelect && slotData.venueId) {
        if (globalVenuesCache.length) {
            venueSelect.innerHTML = '<option value="">Select Venues...</option>';
            globalVenuesCache.forEach(v => {
                const id = v.VenueId ?? v.venueId ?? v.Id;
                const name = v.VenueName ?? v.venueName ?? "Unnamed Venue";
                const option = document.createElement("option");
                option.value = id;
                option.textContent = name;
                venueSelect.appendChild(option);
            });
        }
        venueSelect.value = slotData.venueId;
        await loadHallsForVenue(hallSelect, slotData.venueId);
        if (hallSelect) hallSelect.value = slotData.hallId || "";
    } else if (hallSelect) {
        hallSelect.innerHTML = '<option value="">Select a venue first...</option>';
        hallSelect.disabled = true;
    }

            return slotCard;
        }

        async function buildDayRowFromData(dayData, index) {
            const dayRow = blankDayTemplate.cloneNode(true);
            if (dayData.eventDateId) dayRow.dataset.eventDateId = dayData.eventDateId;
            else delete dayRow.dataset.eventDateId;

            const nameInput = dayRow.querySelector("input[name*='name']");
            const dateInput = dayRow.querySelector("[data-day-date]");
            if (nameInput) nameInput.value = dayData.sessionName || "";
            if (dateInput) dateInput.value = dayData.eventDate || "";

            const slotsContainer = dayRow.querySelector(".slots");
            slotsContainer.innerHTML = "";
            const slotsData = (dayData.slots && dayData.slots.length) ? dayData.slots : [{}];
            for (const slotData of slotsData) {
                slotsContainer.appendChild(await buildSlotCardFromData(slotData));
            }

            updateDayNo(dayRow, index);
            syncSlotTimeAvailability(dayRow);
            return dayRow;
        }

        async function renderScheduleDays(daysData) {
            const daysContainer = document.getElementById("schedule-days");
            daysContainer.innerHTML = "";
            const data = (daysData && daysData.length) ? daysData : [{}];
            for (let i = 0; i < data.length; i++) {
                daysContainer.appendChild(await buildDayRowFromData(data[i], i));
            }
            reindexAllDayRows();
            refreshSlotDropdowns();
        }

        async function renderDraftForMode(mode, draft) {
            if (mode === 'range') {
                const rs = document.getElementById("range-start");
                const re = document.getElementById("range-end");
                if (rs) rs.value = draft?.start || "";
                if (re) re.value = draft?.end || "";
            }

            if (draft && draft.days && draft.days.length) {
                await renderScheduleDays(draft.days);
                await applyScheduleModeUI(mode, true);
            } else {
                await renderScheduleDays([{}]);
                if (mode === 'range') {
                    const tabsWrap = document.getElementById("schedule-day-tabs");
                    if (tabsWrap) tabsWrap.hidden = true;
                }
                await applyScheduleModeUI(mode, false);
            }
            refreshScheduleMetrics();
        }
        // ---------- End per-mode draft helpers ----------

        async function applyScheduleModeUI(mode, preserve) {
            const addDayBtn = document.querySelector('[data-repeat-add="schedule-days"]');
            const dayTabsWrap = document.getElementById("schedule-day-tabs");
            const daysContainer = document.getElementById("schedule-days");

            if (!preserve) {
                document.querySelectorAll("[data-day-date]").forEach(applyDateBounds);
            }

            if (mode === "single") {
                if (addDayBtn) addDayBtn.hidden = true;
                if (dayTabsWrap) dayTabsWrap.hidden = true;
                if (daysContainer) daysContainer.querySelectorAll(".day").forEach(d => d.hidden = false);
                document.querySelectorAll("#schedule-days .day [data-day-remove]").forEach(btn => btn.hidden = true);

                document.querySelectorAll("#schedule-days .day").forEach((row, idx) => { if (idx > 0) row.remove(); });
                renumberDays();
            } else if (mode === "range") {
                if (addDayBtn) addDayBtn.hidden = true;
                document.querySelectorAll("#schedule-days .day [data-day-remove]").forEach(btn => btn.hidden = true);
                if (preserve) {
                    buildDayTabsFromExistingDays();
                } else {
                    await regenerateRangeDays();
                }
            } else {
                if (addDayBtn) addDayBtn.hidden = false;
                if (dayTabsWrap) dayTabsWrap.hidden = true;
                if (daysContainer) daysContainer.querySelectorAll(".day").forEach(d => d.hidden = false);
                document.querySelectorAll("#schedule-days .day [data-day-remove]").forEach(btn => btn.hidden = false);
            }

            refreshSlotDropdowns();
        }

        function toISODate(d) {
            return d.toISOString().slice(0, 10);
        }
        function getTomorrowISO() {
            const d = new Date();
            d.setDate(d.getDate() + 1);
            return toISODate(d);
        }

        function getBookingWindowMaxISO() {
            const d = new Date();
            d.setDate(d.getDate() + MAX_BOOKING_WINDOW_DAYS);
            return toISODate(d);
        }

        function applyDateBounds(input) {
            if (!input) return;
            const tomorrow = getTomorrowISO();
            const maxDate = getBookingWindowMaxISO();
            input.min = tomorrow;
            input.max = maxDate;
            if (input.value && (input.value < tomorrow || input.value > maxDate)) {
                input.value = "";
            }
        }

        function resetDayRow(dayRow) {
            if (!dayRow) return;
            delete dayRow.dataset.eventDateId;

            const nameInput = dayRow.querySelector("input[name*='name']");
            if (nameInput) nameInput.value = "";

            const slotsContainer = dayRow.querySelector(".slots");
            if (slotsContainer) {
                const slotRows = slotsContainer.querySelectorAll(".slotcard");
                slotRows.forEach((slot, idx) => { if (idx > 0) slot.remove(); });
                blankSlotCard(slotsContainer.querySelector(".slotcard"));
            }
        }

        function clampRangeDates() {
            const startInput = document.getElementById("range-start");
            const endInput = document.getElementById("range-end");
            if (!startInput || !endInput) return;

            const tomorrow = getTomorrowISO();
            const windowMax = getBookingWindowMaxISO();

            startInput.min = tomorrow;
            startInput.max = windowMax;

            if (startInput.value && (startInput.value < tomorrow || startInput.value > windowMax)) {
                scheduleToast(`Please choose a start date within the next ${MAX_BOOKING_WINDOW_DAYS} days.`, "warn");
                startInput.value = "";
            }

            if (startInput.value) {
                const start = new Date(startInput.value + "T00:00:00");
                const maxEnd = new Date(start);
                maxEnd.setDate(maxEnd.getDate() + (MAX_RANGE_DAYS - 1));
                const cappedMaxEnd = toISODate(maxEnd) > windowMax ? windowMax : toISODate(maxEnd);

                endInput.min = startInput.value;
                endInput.max = cappedMaxEnd;

                if (endInput.value) {
                    const end = new Date(endInput.value + "T00:00:00");
                    if (end < start || toISODate(end) > cappedMaxEnd) {
                        scheduleToast(`Please choose an end date within ${MAX_RANGE_DAYS} days of the start date.`, "warn");
                        endInput.value = "";
                    }
                }
            } else {
                endInput.min = tomorrow;
                endInput.max = windowMax;
            }
        }

        // FIXED: previously wiped every day except Day 1 whenever the range
        // dates changed at all. Now preserves any day (and its slots/hall/
        // speaker selections, and real EventDateId/SlotId) that still falls
        // inside the new range, matched by date, instead of rebuilding blind.
        async function regenerateRangeDays() {
            const startInput = document.getElementById("range-start");
            const endInput = document.getElementById("range-end");
            const daysContainer = document.getElementById("schedule-days");
            const tabsWrap = document.getElementById("schedule-day-tabs");
            const tabsRow = document.getElementById("schedule-day-tabs-row");
            if (!startInput?.value || !endInput?.value || !daysContainer) {
                if (tabsWrap) tabsWrap.hidden = true;
                return;
            }

            const start = new Date(startInput.value + "T00:00:00");
            const end = new Date(endInput.value + "T00:00:00");
            const dayCount = Math.round((end - start) / 86400000) + 1;

            if (dayCount < 1 || dayCount > MAX_RANGE_DAYS) {
                scheduleToast(`A range can span at most ${MAX_RANGE_DAYS} days.`, "warn");
                if (tabsWrap) tabsWrap.hidden = true;
                return;
            }

            const existingByDate = new Map();
            daysContainer.querySelectorAll(".day").forEach(dayRow => {
                const iso = dayRow.querySelector("[data-day-date]")?.value;
                if (iso) existingByDate.set(iso, captureDayData(dayRow));
            });

            daysContainer.innerHTML = "";
            tabsRow.innerHTML = "";

            for (let i = 0; i < dayCount; i++) {
                const dayDate = new Date(start);
                dayDate.setDate(dayDate.getDate() + i);
                const iso = toISODate(dayDate);

                const preserved = existingByDate.get(iso);
                const dayData = preserved
                    ? { ...preserved, sessionName: preserved.sessionName || `Day ${i + 1}`, eventDate: iso }
                    : { sessionName: `Day ${i + 1}`, eventDate: iso, slots: [{}] };

                const dayRow = await buildDayRowFromData(dayData, i);
                const dateInput = dayRow.querySelector("[data-day-date]");
                if (dateInput) dateInput.disabled = true;
                dayRow.hidden = i !== 0;
                syncSlotTimeAvailability(dayRow);

                daysContainer.appendChild(dayRow);

                const tabBtn = document.createElement("button");
                tabBtn.type = "button";
                tabBtn.className = "scopetab";
                tabBtn.setAttribute("aria-pressed", i === 0 ? "true" : "false");
                tabBtn.dataset.dayIndex = i;
                tabBtn.innerHTML = `Day ${i + 1} <span class="scopetab__date">${iso}</span>`;
                tabsRow.appendChild(tabBtn);
            }

            if (tabsWrap) tabsWrap.hidden = false;

            reindexAllDayRows();
            refreshSlotDropdowns();
            refreshScheduleMetrics();
        }

        document.getElementById("schedule-day-tabs-row")?.addEventListener("click", function(e) {
            const btn = e.target.closest("[data-day-index]");
            if (!btn) return;
            const idx = parseInt(btn.dataset.dayIndex, 10);
            document.querySelectorAll("#schedule-day-tabs-row .scopetab").forEach((b, i) => {
                b.setAttribute("aria-pressed", i === idx ? "true" : "false");
            });
            document.querySelectorAll("#schedule-days .day").forEach((row, i) => {
