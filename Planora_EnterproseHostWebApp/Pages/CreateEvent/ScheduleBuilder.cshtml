        // 2. LOAD & BIND VENUES
        async function loadAndBindVenues() {
            try {
                const response = await fetch('?handler=GetVenues', { method: 'GET' });
                const result = await response.json();

                if (result && result.success && Array.isArray(result.data) && result.data.length > 0) {
                    globalVenuesCache = result.data;
                    hasSavedVenues = true;

                    const isMultiVenue = result.data.length > 1;
                    const multivenueCheckbox = document.getElementById("multivenue");
                    if (multivenueCheckbox) {
                        multivenueCheckbox.checked = isMultiVenue;
