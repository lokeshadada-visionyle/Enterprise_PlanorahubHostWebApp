@page
@model Planora_EnterproseHostWebApp.Pages.CreateEvent.ScheduleBuilderModel
@{
    Layout = "_CreateEventLayout";
    ViewData["StepIndex"] = 3;
    ViewData["StepTotal"] = 9;
    ViewData["StepName"] = "Schedule Builder";
    ViewData["StepHint"] = "Set your venue, halls, dates and time slots";
}
<div class="wizard__body">
    <main class="wizard__content">
        <div class="wizard__inner">
            @Html.AntiForgeryToken()
            <form class="stack" id="scheduleForm" action="content-sections.html" method="post">

                <!-- STEP 1: Speakers section: visible by default. Fill a speaker in once, then attach them to any session later. -->
                <section class="panel" id="section-speakers" aria-labelledby="speakers-title">
                    <div class="panel__head panel__head--plain">
                        <div>
                            <h2 class="panel__title panel__title--lg" id="speakers-title">
                                Speakers
                            </h2>
                            <p class="panel__meta">
                                Fill a speaker in once, then attach them to any session. Photo, title,
                                organisation and bio all appear on the event page.
                            </p>
                        </div>
                        <button class="btn btn--outline btn--sm" type="button" style="white-space: nowrap;"
                                data-repeat-add="speaker-list">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add speaker
                        </button>
                    </div>
                    <div class="panel__body">
                        <div class="speakers" id="speaker-list">
                            <article class="speaker" data-speaker-row data-repeat-row
                                     data-speaker-key="kofi">
                                <div class="speaker__top">
                                    <span class="speakerav" data-speaker-avatar="kofi">
                                        <span class="speakerav__initials">KA</span>
                                    </span>
                                    @* <span class="speaker__photoact">
                                        <label class="btn btn--outline btn--sm" for="sp-1-photo">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9.5" r="1.6" /><path d="M21 16l-5-5-9 9" /></svg> Photo
                                        </label>
                                        <input class="u-visually-hidden" id="sp-1-photo" name="sp-1-photo"
                                               type="file" accept="image/*"
                                               data-speaker-photo="kofi">
                                        <span class="speaker__photohint">Square, at least 400&times;400</span>
                                    </span> *@
                                    <span class="speaker__tools">
                                        <button class="iconbtn" type="button"
                                                data-speaker-preview="kofi"
                                                data-modal-open="speakerpreview-modal">
                                            <span class="u-visually-hidden">Preview Kofi Asante as guests see it</span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.8-6.5 10-6.5S22 12 22 12s-3.8 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                                        </button>
                                        <button class="iconbtn iconbtn--danger" type="button"
                                                data-repeat-remove
                                                data-action="Kofi Asante removed from the speaker directory"
                                                data-action-tone="warn">
                                            <span class="u-visually-hidden">Remove Kofi Asante</span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg>
                                        </button>
                                    </span>
                                </div>

                                <div class="formgrid formgrid--3">
                                    <div class="form__field">
                                        <label class="field__label" for="sp-1-name">
                                            Full name<span class="field__required" aria-hidden="true">*</span>
                                            <span class="u-visually-hidden">(required)</span>
                                        </label>
                                        <input class="field__input" id="sp-1-name" name="sp-1-name"
                                               type="text" value="" placeholder="Speaker name"
                                               data-speaker-field="name" required>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="sp-1-title">Job title<span class="field__required" aria-hidden="true">*</span></label>
                                        <input class="field__input" id="sp-1-title" name="sp-1-title"
                                               type="text" value=""
                                               placeholder="e.g. Chief Technology Officer"
                                               data-speaker-field="title" required>
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="sp-1-org">Organisation<span class="field__required" aria-hidden="true">*</span></label>
                                        <input class="field__input" id="sp-1-org" name="sp-1-org"
                                               type="text" value="" placeholder="Company or institution"
                                               data-speaker-field="org" required>
                                    </div>
                                </div>

                                <div class="form__field u-mt-5">
                                    <label class="field__label" for="sp-1-bio">Short bio</label>
                                    <textarea class="field__input" id="sp-1-bio" name="sp-1-bio" rows="3"
                                              placeholder="Two or three sentences. Shown on the event page and the session detail."
                                              data-speaker-field="bio"></textarea>
                                    <span class="field__hint">
                                        <span data-speaker-count="kofi">0</span> characters &middot; about 300
                                        reads best on a session card
                                    </span>
                                </div>

                                <p class="speaker__sessions">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                                    <span data-speaker-sessions="kofi">Not assigned to a session yet</span>
                                </p>
                            </article>
                        </div>

                        <p class="notice notice--info notice--flat u-mt-5">
                            <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                            A speaker with no title or organisation still works &mdash; the event page
                            simply shows their name. Only the name is required.
                        </p>

                        <div class="u-mt-5" style="text-align: right;">
                            <button type="button" class="btn btn--primary btn--sm" id="btnSaveSpeakers">
                                Save Speakers &amp; Continue to Venue
                            </button>
                        </div>
                    </div>
                </section>

                <!-- STEP 2: Venues & halls: hidden until Speakers are saved. One venue by default, several on request -->
                <div id="section-venues" data-venue-section hidden>
                    <div class="dashbox" style="margin-bottom: 10px;">
                        <span class="dashbox__tag">Venue mode</span>
                        <div class="optin">
                            <input class="optin__box" id="multivenue" name="multivenue" type="checkbox"
                                   data-reveal="multi-venue" data-reveal-inverse="single-venue"
                                   aria-controls="multi-venue">
                            <label for="multivenue">
                                <span class="optin__title">Multi-venue, multi-hall event</span>
                                <span class="optin__hint">
                                    On: add several venues, each with its own halls, and choose both per
                                    time slot. Off: one venue &mdash; slots simply pick a hall.
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="u-mt-6">
                        <section class="panel" id="single-venue" aria-labelledby="single-venue-title">
                            <div class="panel__head">
                                <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
                                <h2 class="panel__title" id="single-venue-title">Venue &amp; Halls</h2>
                                <p class="panel__meta">One venue &mdash; halls allocated per time slot</p>
                            </div>
                            <div class="panel__body">
                                <div class="formgrid formgrid--2">
                                    <div class="form__field">
                                        <label class="field__label" for="sv-name">Venue Name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="sv-name" name="sv-name" type="text" placeholder="e.g. Eko Hotel Convention Centre" value="" required oninput="this.value = this.value.replace(/[^A-Za-z0-9]/g, '')">
                                    </div>
                                    <div class="form__field">
                                        <label class="field__label" for="sv-city">City<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <select class="field__input" id="sv-city" name="sv-city" required>
                                            <option value="">Select City...</option>
                                            @if (Model.Cities != null && Model.Cities.Any())
                                            {
                                                @foreach (var city in Model.Cities)
                                                {
                                                    <option value="@city.CityName">
                                                        @city.CityName@(string.IsNullOrWhiteSpace(city.CountryName) ? "" : $", {city.CountryName}")
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="formgrid u-mt-5">
                                    <div class="form__field">
                                        <label class="field__label" for="sv-address">Address<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="sv-address" name="sv-address" type="text" placeholder="Full street address" value="">
                                    </div>
                                </div>

                                <div class="formgrid u-mt-5">
                                    <div class="form__field">
                                        <label class="field__label" for="sv-map-url">Map URL<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="sv-map-url" name="sv-map-url" type="text" placeholder="Map URL" value="https://www.google.com/maps">
                                    </div>
                                </div>

                                <div class="halls">
                                    <p class="halls__head">
                                        Halls / Rooms &middot; max capacity
                                        <button class="halls__add" type="button" data-repeat-add="sv-halls">
                                            + Add Hall
                                        </button>
                                    </p>
                                    <div id="sv-halls">
                                        <div class="hall" data-repeat-row>
                                            <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                            <label class="u-visually-hidden" for="sv-1-hall-name">Hall name</label>
                                            <input class="hall__name" id="sv-1-hall-name" name="sv-1-hall-name"
                                                   type="text" placeholder="Hall name" value="Main Hall">
                                            <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                            <label class="u-visually-hidden" for="sv-1-hall-cap">Maximum capacity</label>
                                            <input class="hall__cap" id="sv-1-hall-cap" name="sv-1-hall-cap"
                                                   type="text" inputmode="numeric" value="500">
                                            <button class="hall__remove" type="button" data-repeat-remove>
                                                <span class="u-visually-hidden">Remove hall</span>
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="hall" data-repeat-row>
                                            <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                            <label class="u-visually-hidden" for="sv-2-hall-name">Hall name</label>
                                            <input class="hall__name" id="sv-2-hall-name" name="sv-2-hall-name"
                                                   type="text" placeholder="Hall name" value="Hall B">
                                            <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                            <label class="u-visually-hidden" for="sv-2-hall-cap">Maximum capacity</label>
                                            <input class="hall__cap" id="sv-2-hall-cap" name="sv-2-hall-cap"
                                                   type="text" inputmode="numeric" value="180">
                                            <button class="hall__remove" type="button" data-repeat-remove>
                                                <span class="u-visually-hidden">Remove hall</span>
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="hall" data-repeat-row>
                                            <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                            <label class="u-visually-hidden" for="sv-3-hall-name">Hall name</label>
                                            <input class="hall__name" id="sv-3-hall-name" name="sv-3-hall-name"
                                                   type="text" placeholder="Hall name" value="Breakout Room 1">
                                            <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                            <label class="u-visually-hidden" for="sv-3-hall-cap">Maximum capacity</label>
                                            <input class="hall__cap" id="sv-3-hall-cap" name="sv-3-hall-cap"
                                                   type="text" inputmode="numeric" value="60">
                                            <button class="hall__remove" type="button" data-repeat-remove>
                                                <span class="u-visually-hidden">Remove hall</span>
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Single "home" for the Save Venue action, regardless of single/multi mode -->
                            <div class="u-mt-5" style="text-align: right;">
                                <button type="button" class="btn btn--primary btn--sm" id="btnSaveVenues">
                                    Save Venue &amp; Load Schedule
                                </button>
                            </div>
                        </section>

                        <section class="panel" id="multi-venue" aria-labelledby="multi-venue-title" hidden>
                            <div class="panel__head">
                                <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 3 3 5.5v15L9 18l6 3 6-2.5v-15L15 6 9 3zM9 3v15M15 6v15" /></svg></span>
                                <h2 class="panel__title" id="multi-venue-title">Venues &amp; Halls</h2>
                                <button class="btn btn--outline btn--sm panel__meta" type="button"
                                        data-repeat-add="venue-list">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add Venue
                                </button>
                            </div>
                            <div class="panel__body">
                                <div id="venue-list">
                                    <div class="venue" data-repeat-row>
                                        <div class="venue__head">
                                            <span class="venue__no" aria-hidden="true">1</span>
                                            <h3 class="venue__title">Venue 1</h3>
                                        </div>

                                        <div class="formgrid formgrid--2">
                                            <div class="form__field">
                                                <label class="field__label" for="venue-1-name">Venue Name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="field__input" id="venue-1-name" name="venue-1-name" type="text" placeholder="e.g. Eko Hotel Convention Centre" value="Eko Hotel Convention Centre" required>
                                            </div>
                                            <div class="form__field">
                                                <label class="field__label" for="venue-1-city">City<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="field__input" id="venue-1-city" name="venue-1-city" type="text" placeholder="Lagos" value="Lagos" required>
                                            </div>
                                        </div>

                                        <div class="formgrid u-mt-5">
                                            <div class="form__field">
                                                <label class="field__label" for="venue-1-address">Address</label>
                                                <input class="field__input" id="venue-1-address" name="venue-1-address" type="text" placeholder="Full street address">
                                            </div>
                                        </div>

                                        <div class="halls">
                                            <p class="halls__head">
                                                Halls / Rooms &middot; max capacity
                                                <button class="halls__add" type="button" data-repeat-add="venue-1-halls">
                                                    + Add Hall
                                                </button>
                                            </p>
                                            <div id="venue-1-halls">
                                                <div class="hall" data-repeat-row>
                                                    <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                                    <label class="u-visually-hidden" for="v1-1-hall-name">Hall name</label>
                                                    <input class="hall__name" id="v1-1-hall-name" name="v1-1-hall-name"
                                                           type="text" placeholder="Hall name" value="Main Hall">
                                                    <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                                    <label class="u-visually-hidden" for="v1-1-hall-cap">Maximum capacity</label>
                                                    <input class="hall__cap" id="v1-1-hall-cap" name="v1-1-hall-cap"
                                                           type="text" inputmode="numeric" value="500">
                                                    <button class="hall__remove" type="button" data-repeat-remove>
                                                        <span class="u-visually-hidden">Remove hall</span>
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="hall" data-repeat-row>
                                                    <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                                    <label class="u-visually-hidden" for="v1-2-hall-name">Hall name</label>
                                                    <input class="hall__name" id="v1-2-hall-name" name="v1-2-hall-name"
                                                           type="text" placeholder="Hall name" value="Hall B">
                                                    <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                                    <label class="u-visually-hidden" for="v1-2-hall-cap">Maximum capacity</label>
                                                    <input class="hall__cap" id="v1-2-hall-cap" name="v1-2-hall-cap"
                                                           type="text" inputmode="numeric" value="180">
                                                    <button class="hall__remove" type="button" data-repeat-remove>
                                                        <span class="u-visually-hidden">Remove hall</span>
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="venue" data-repeat-row>
                                        <div class="venue__head">
                                            <span class="venue__no" aria-hidden="true">2</span>
                                            <h3 class="venue__title">Venue 2</h3>
                                            <button class="venue__remove" type="button" data-repeat-remove>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg> Remove venue
                                            </button>
                                        </div>

                                        <div class="formgrid formgrid--2">
                                            <div class="form__field">
                                                <label class="field__label" for="venue-2-name">Venue Name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="field__input" id="venue-2-name" name="venue-2-name" type="text" placeholder="e.g. Eko Hotel Convention Centre" value="Landmark Events Centre" required>
                                            </div>
                                            <div class="form__field">
                                                <label class="field__label" for="venue-2-city">City<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="field__input" id="venue-2-city" name="venue-2-city" type="text" placeholder="Lagos" value="Lagos" required>
                                            </div>
                                        </div>

                                        <div class="formgrid u-mt-5">
                                            <div class="form__field">
                                                <label class="field__label" for="venue-2-address">Address</label>
                                                <input class="field__input" id="venue-2-address" name="venue-2-address" type="text" placeholder="Full street address">
                                            </div>
                                        </div>

                                        <div class="halls">
                                            <p class="halls__head">
                                                Halls / Rooms &middot; max capacity
                                                <button class="halls__add" type="button" data-repeat-add="venue-2-halls">
                                                    + Add Hall
                                                </button>
                                            </p>
                                            <div id="venue-2-halls">
                                                <div class="hall" data-repeat-row>
                                                    <svg class="hall__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg>
                                                    <label class="u-visually-hidden" for="v2-1-hall-name">Hall name</label>
                                                    <input class="hall__name" id="v2-1-hall-name" name="v2-1-hall-name"
                                                           type="text" placeholder="Hall name" value="VIP Lounge">
                                                    <svg class="hall__people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg>
                                                    <label class="u-visually-hidden" for="v2-1-hall-cap">Maximum capacity</label>
                                                    <input class="hall__cap" id="v2-1-hall-cap" name="v2-1-hall-cap"
                                                           type="text" inputmode="numeric" value="100">
                                                    <button class="hall__remove" type="button" data-repeat-remove>
                                                        <span class="u-visually-hidden">Remove hall</span>
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>

                </div>

                <!-- STEP 3: Date & Schedule: hidden until venues/halls have been saved (or already exist) -->
                <section class="panel" id="section-schedule" aria-labelledby="date-title" data-schedule-section hidden>
                    <div class="panel__head">
                        <span class="tile tile--info" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg></span>
                        <h2 class="panel__title" id="date-title">Date &amp; Schedule</h2>
                        <p class="panel__meta">Date, time slots and hall allocation per slot</p>
                    </div>

                    <div class="panel__body">
                        <div class="options" role="radiogroup" aria-label="Schedule type"
                             id="schedmode" data-pick-group>
                            <button class="option option--selected" type="button" role="radio"
                                    aria-checked="true" data-pick="single">
                                <span class="option__icon" aria-hidden="true">&#128197;</span>
                                <span class="option__title">Single Day</span>
                                <span class="option__text">One date with one or more time slots</span>
                                <svg class="option__check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                            </button>
                            <button class="option" type="button" role="radio" aria-checked="false"
                                    data-pick="range">
                                <span class="option__icon" aria-hidden="true">&#128197;</span>
                                <span class="option__title">Multi-Day Range</span>
                                <span class="option__text">Consecutive days between two dates</span>
                            </button>
                            <button class="option" type="button" role="radio" aria-checked="false"
                                    data-pick="specific">
                                <span class="option__icon" aria-hidden="true">&#128198;</span>
                                <span class="option__title">Specific Dates</span>
                                <span class="option__text">Individual, non-consecutive dates</span>
                            </button>
                        </div>

                        <div class="formgrid formgrid--2" data-pick-panel="range"
                             data-pick-owner="schedmode" hidden>
                            <div class="form__field">
                                <label class="field__label" for="range-start">Start Date<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                <input class="field__input" id="range-start" name="range-start" type="date" value="" required>
                            </div>
                            <div class="form__field">
                                <label class="field__label" for="range-end">End Date<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                <input class="field__input" id="range-end" name="range-end" type="date" value="" required>
                            </div>
                        </div>

                        <div id="schedule-days" class="u-mt-5">
                            <div class="day" data-day data-repeat-row>
                                <div class="day__head"> 
                                    <span class="day__no" aria-hidden="true">1</span>
                                    <span class="day__date">
                                        <label class="slotcard__label" for="day-1-name">Session name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="day-1-name" name="day-1-name"
                                               type="text" value="" data-autoname="Session" placeholder="eg:- Session Name" required>
                                    </span>
                                    <span class="day__date">
                                        <label class="slotcard__label" for="day-1-date">Date<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                        <input class="field__input" id="day-1-date" name="day-1-date"
                                               type="date" value="" data-day-date required>
                                    </span>
                                </div>

                                <div class="slots" id="day-1-slots">
                                    <div class="slotcard" data-slot data-repeat-row>
                                        <div class="slotcard__top">
                                            <span class="slotcard__no" aria-hidden="true">1</span>
                                            <label class="u-visually-hidden" for="slot-1-1-name">Slot name<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                            <input class="slotcard__name" id="slot-1-1-name" name="slot-1-1-name"
                                                   type="text" value="" placeholder="eg:-slotName" data-autoname="Slot" required>
                                            <button class="line__remove" type="button" data-repeat-remove>
                                                <span class="u-visually-hidden">Remove this slot</span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg>
                                            </button>
                                        </div>

                                        <div class="slotcard__grid">
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-start">Start<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="slot__input" id="slot-1-1-start" name="slot-1-1-start"
                                                       type="datetime-local" value="" data-slot-start required>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-end">End<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="slot__input" id="slot-1-1-end" name="slot-1-1-end"
                                                       type="datetime-local" value="" data-slot-end required>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-venue">Venues<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <select class="slot__select" id="slot-1-1-venue" name="slot-1-1-venue" data-slot-venue-select required>
                                                    <option value="">Select Venues...</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-hall">Halls<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <select class="slot__select" id="slot-1-1-hall" name="slot-1-1-hall"
                                                        data-slot-hall disabled required>
                                                    <option value="">Select a venue first...</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="slotcard__label" for="slot-1-1-cap">Max capacity<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></label>
                                                <input class="slot__input" id="slot-1-1-cap" name="slot-1-1-cap"
                                                       type="text" inputmode="numeric" value=""
                                                       placeholder="0" data-cap-input required>
                                            </div>
                                            <div class="slotcard__speakers">
                                                <span class="slotcard__label" id="slot-1-1-splabel">Speakers<span class="field__required" aria-hidden="true">*</span><span class="u-visually-hidden">(required)</span></span>
                                                <div class="speakerchips" data-speaker-chips="slot-1-1"></div>
                                                <label class="u-visually-hidden" for="slot-1-1-speakeradd">
                                                    Add a speaker to this session
                                                </label>
                                                <select class="slot__select" id="slot-1-1-speakeradd"
                                                        data-speaker-add="slot-1-1"
                                                        aria-describedby="slot-1-1-splabel" required>
                                                    <option value="">Add a speaker&hellip;</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button class="addline" type="button" data-repeat-add="day-1-slots">
                                    + Add time slot
                                </button>
                            </div>
                        </div>

                        <button class="addline" type="button" data-repeat-add="schedule-days">
                            + Add day
                        </button>

                        <p class="notice notice--warn notice--flat u-mt-5"
                           role="status" data-schedule-conflict hidden>
                            <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
                            <span data-schedule-conflict-text></span>
                        </p>
                    </div>

                    <div class="capbar">
                        <span class="capbar__item">
                            <span class="capbar__label">Total hall capacity</span>
                            <span class="capbar__value" data-cap-limit>0</span>
                        </span>
                        <span class="capbar__item">
                            <span class="capbar__label">Peak concurrent</span>
                            <span class="capbar__value capbar__value--total" data-cap-total>0</span>
                        </span>
                        <span class="capbar__item">
                            <span class="capbar__label">Headroom at peak</span>
                            <span class="capbar__value capbar__value--remaining" data-cap-remaining>0</span>
                        </span>
                        <p class="notice notice--warn notice--flat" data-cap-warning hidden>
                            <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
                            <span data-cap-warning-text></span>
                        </p>
                    </div>
                </section>

                <section class="panel" aria-labelledby="halls-note-title">
                    <div class="panel__head panel__head--plain">
                        <h2 class="panel__title panel__title--lg" id="halls-note-title">
                            Hall allocation rules
                        </h2>
                    </div>
                    <div class="panel__body">
                        <ul class="choice__list">
                            <li>
                                <span style="display:flex; align-items:flex-start; gap:8px;">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0; margin-top:2px;"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>A hall cannot host two overlapping slots on the same day — overlaps are flagged as you type.</span>
                                </span>
                            </li>
                            <li>
                                <span style="display:flex; align-items:flex-start; gap:8px;">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0; margin-top:2px;"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>A slot cannot be allocated more seats than its hall holds.</span>
                                </span>
                            </li>
                            <li>
                                <span style="display:flex; align-items:flex-start; gap:8px;">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0; margin-top:2px;"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                                    <span>Capacity is measured at peak concurrency, so parallel breakouts are counted once.</span>
                                </span>
                            </li>
                        </ul>
                    </div>
                </section>
            </form>
        </div>
    </main>

    <footer class="wizard__foot">
        <a class="btn btn--outline" asp-page="/CreateEvent/BasicDetails" data-wizard-link><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 6l-6 6 6 6" /></svg> Back</a>
        <div class="wizard__foot-end">
            <button class="btn btn--primary" id="btnContinue" type="button">Continue <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 6l6 6-6 6" /></svg></button>
        </div>
    </footer>
</div>

<div class="modal" id="speakerpreview-modal" role="dialog" aria-modal="true"
     aria-labelledby="speakerpreview-title" data-modal hidden>
    <div class="modal__scrim" data-modal-close></div>
    <div class="modal__dialog modal__dialog--sm">
        <div class="modal__head">
            <h2 class="modal__title" id="speakerpreview-title">How guests see this speaker</h2>
            <button class="iconbtn" type="button" data-modal-close>
                <span class="u-visually-hidden">Close</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>

        <div class="modal__body">
            <div class="speakercard" data-speaker-card>
                <span class="speakerav speakerav--lg" data-speakercard-avatar>
                    <span class="speakerav__initials" data-speakercard-initials></span>
                </span>
                <div class="speakercard__body">
                    <p class="speakercard__name" data-speakercard-name></p>
                    <p class="speakercard__role" data-speakercard-role></p>
                    <p class="speakercard__bio" data-speakercard-bio></p>
                    <p class="speakercard__sessions" data-speakercard-sessions></p>
                </div>
            </div>

            <p class="modal__note">
                This is the speaker block on the public event page and inside each session
                they are attached to.
            </p>
        </div>

        <div class="modal__foot">
            <button class="btn btn--primary" type="button" data-modal-close>Close</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async function() {
        const venueSection = document.getElementById("section-venues");
        const scheduleSection = document.getElementById("section-schedule");
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        let globalVenuesCache = [];
        let globalSpeakersCache = [];

        // Edit-mode tracking: once GetVenues/GetSpeakers/GetSchedule come back with
        // existing records for this event, further "Save" clicks must go through the
        // Update APIs (Ent_UpdateVenueAndHall / Ent_UpdateSpeaker / Ent_UpdateEventDateAndSlots)
        // instead of re-adding (Ent_AddVenueAndHall / Ent_AddSpeaker / Ent_AddEventDateAndSlots),
        // otherwise the host would end up with duplicate records every time they revisit this step.
        let hasSavedVenues = false;
        let hasSavedSpeakers = false;
        let hasSavedSchedule = false;

        function revealVenueSection() {
            if (venueSection) {
                venueSection.removeAttribute("hidden");
                venueSection.hidden = false;
            }
        }

        function revealScheduleSection() {
            if (scheduleSection) {
                scheduleSection.removeAttribute("hidden");
                scheduleSection.hidden = false;
            }
        }

        function populateSpeakerDropdowns(speakers) {
            const speakerSelects = document.querySelectorAll("[data-speaker-add]");
            speakerSelects.forEach(select => {
                const currentVal = select.value;
                select.innerHTML = '<option value="">Add a speaker&hellip;</option>';
                speakers.forEach(sp => {
                    const id = sp.SpeakerId ?? sp.speakerId ?? sp.Id;
                    const name = sp.Name ?? sp.name ?? "Unknown Speaker";
                    const option = document.createElement("option");
                    option.value = id;
                    option.textContent = name;
                    select.appendChild(option);
                });
                if (currentVal) select.value = currentVal;
            });
        }

        function populateVenueDropdowns(venues) {
            const venueSelects = document.querySelectorAll("[data-slot-venue-select]");
            venueSelects.forEach(select => {
                const currentVal = select.value;
                select.innerHTML = '<option value="">Select Venues...</option>';
                venues.forEach(v => {
                    const id = v.VenueId ?? v.venueId ?? v.Id;
                    const name = v.VenueName ?? v.venueName ?? "Unnamed Venue";
                    const option = document.createElement("option");
                    option.value = id;
                    option.textContent = name;
                    select.appendChild(option);
                });
                if (currentVal) select.value = currentVal;
            });
        }

        async function loadHallsForVenue(hallSelectElement, venueId) {
            if (!hallSelectElement || !venueId) return;
            try {
                const response = await fetch(`?handler=GetHallsByVenue&venueId=${venueId}`, { method: 'GET' });
                const result = await response.json();

                hallSelectElement.innerHTML = '<option value="">Select Hall...</option>';
                if (result && result.success && Array.isArray(result.data)) {
                    result.data.forEach(h => {
                        const hId = h.HallId ?? h.hallId ?? h.Id;
                        const hName = h.HallName ?? h.hallName;
                        const option = document.createElement("option");
                        option.value = hId;
                        option.textContent = hName;
                        hallSelectElement.appendChild(option);
                    });
                    hallSelectElement.removeAttribute("disabled");
                }
            } catch (err) {
                console.error("Failed to load halls:", err);
            }
        }

        // 1. LOAD & BIND SPEAKERS
        async function loadAndBindSpeakers() {
            try {
                const response = await fetch('?handler=GetSpeakers', { method: 'GET' });
                const result = await response.json();

                if (result && result.success && Array.isArray(result.data) && result.data.length > 0) {
                    globalSpeakersCache = result.data;
                    hasSavedSpeakers = true;
                    const speakerListContainer = document.getElementById("speaker-list");
                    const templateRow = speakerListContainer.querySelector(".speaker")?.cloneNode(true);

                    if (templateRow) {
                        speakerListContainer.innerHTML = "";
                        result.data.forEach(sp => {
                            const row = templateRow.cloneNode(true);
                            row.dataset.speakerId = sp.SpeakerId ?? sp.speakerId ?? "0";
                            // FIX: mark this row as a real, previously-saved speaker.
                            // Only rows carrying this flag are eligible to be sent to
                            // the Update endpoint. Rows created later via "Add speaker"
                            // (cloned from this one) must NOT keep this flag or the id,
                            // otherwise they'll be mistaken for an existing speaker and
                            // silently overwrite it instead of creating a new record.
                            row.dataset.loadedFromServer = "true";

                            const nameInput = row.querySelector("[data-speaker-field='name']");
                            const titleInput = row.querySelector("[data-speaker-field='title']");
                            const orgInput = row.querySelector("[data-speaker-field='org']");
                            const bioInput = row.querySelector("[data-speaker-field='bio']");

                            if (nameInput) nameInput.value = sp.Name ?? sp.name ?? "";
                            if (titleInput) titleInput.value = sp.JobTitle ?? sp.jobTitle ?? "";
                            if (orgInput) orgInput.value = sp.Organization ?? sp.organization ?? "";
                            if (bioInput) bioInput.value = sp.Bio ?? sp.bio ?? "";

                            speakerListContainer.appendChild(row);
                        });
                    }

                    populateSpeakerDropdowns(result.data);
                    revealVenueSection();
                    return true;
                }
            } catch (err) {
                console.error("Failed to load speakers:", err);
            }
            return false;
        }

        // 2. LOAD & BIND VENUES
        async function loadAndBindVenues() {
            try {
                const response = await fetch('?handler=GetVenues', { method: 'GET' });
                const result = await response.json();

                if (result && result.success && Array.isArray(result.data) && result.data.length > 0) {
                    globalVenuesCache = result.data;
                    hasSavedVenues = true;
                    const firstVenue = result.data[0];
                    const firstVenueId = firstVenue.VenueId ?? firstVenue.venueId ?? 0;

                    const nameInput = document.getElementById("sv-name");
                    const citySelect = document.getElementById("sv-city");
                    const addressInput = document.getElementById("sv-address");
                    const singleVenuePanel = document.getElementById("single-venue");
                    if (singleVenuePanel) singleVenuePanel.dataset.venueId = firstVenueId;

                    if (nameInput) nameInput.value = firstVenue.VenueName ?? firstVenue.venueName ?? "";
                    if (citySelect) citySelect.value = firstVenue.City ?? firstVenue.cityName ?? "";
                    if (addressInput) addressInput.value = firstVenue.Address ?? firstVenue.address ?? "";

                    const halls = firstVenue.Halls ?? firstVenue.halls;
                    if (Array.isArray(halls) && halls.length > 0) {
                        const hallContainer = document.getElementById("sv-halls");
                        const templateHall = hallContainer.querySelector(".hall")?.cloneNode(true);

                        if (templateHall) {
                            hallContainer.innerHTML = "";
                            halls.forEach(h => {
                                const hRow = templateHall.cloneNode(true);
                                const hNameInput = hRow.querySelector(".hall__name");
                                const hCapInput = hRow.querySelector(".hall__cap");

                                hRow.dataset.hallId = h.HallId ?? h.hallId ?? 0;
                                if (hNameInput) hNameInput.value = h.HallName ?? h.hallName ?? "";
                                if (hCapInput) hCapInput.value = h.Capacity ?? h.capacity ?? 0;

                                hallContainer.appendChild(hRow);
                            });
                        }
                    }

                    populateVenueDropdowns(result.data);
                    revealScheduleSection();
                    return true;
                }
            } catch (err) {
                console.error("Failed to load venues:", err);
            }
            return false;
        }

        // 3. LOAD & BIND SCHEDULE
        async function loadAndBindSchedule() {
            try {
                const response = await fetch('?handler=GetSchedule', { method: 'GET' });
                const result = await response.json();

                if (result && result.success && Array.isArray(result.data) && result.data.length > 0) {
                    hasSavedSchedule = true;
                    const daysContainer = document.getElementById("schedule-days");
                    const dayTemplate = daysContainer.querySelector(".day")?.cloneNode(true);

                    if (!dayTemplate) return;
                    daysContainer.innerHTML = "";

                    for (const day of result.data) {
                        const dayRow = dayTemplate.cloneNode(true);
                        const nameInput = dayRow.querySelector("input[name*='name']");
                        const dateInput = dayRow.querySelector("[data-day-date]");

                        dayRow.dataset.eventDateId = day.EventDateId ?? day.eventDateId ?? 0;
                        if (nameInput) nameInput.value = day.SessionName ?? day.sessionName ?? "";
                        if (dateInput && day.EventDate) {
                            dateInput.value = day.EventDate.split('T')[0];
                        }

                        const slotsContainer = dayRow.querySelector(".slots");
                        const slotTemplate = slotsContainer.querySelector(".slotcard")?.cloneNode(true);

                        if (slotTemplate) {
                            slotsContainer.innerHTML = "";
                            const slots = day.EventSlots ?? day.eventSlots ?? [];

                            for (const slot of slots) {
                                const slotRow = slotTemplate.cloneNode(true);

                                slotRow.dataset.slotId = slot.SlotId ?? slot.slotId ?? 0;
                                const slotNameInput = slotRow.querySelector(".slotcard__name");
                                const startInput = slotRow.querySelector("[data-slot-start]");
                                const endInput = slotRow.querySelector("[data-slot-end]");
                                const venueSelect = slotRow.querySelector("[data-slot-venue-select]");
                                const hallSelect = slotRow.querySelector("[data-slot-hall]");
                                const capInput = slotRow.querySelector("[data-cap-input]");
                                const speakerSelect = slotRow.querySelector("[data-speaker-add]");

                                if (slotNameInput) slotNameInput.value = slot.SlotName ?? slot.slotName ?? "";
                                if (startInput) startInput.value = slot.StartTime ?? slot.startTime ?? "";
                                if (endInput) endInput.value = slot.EndTime ?? slot.endTime ?? "";
                                if (capInput) capInput.value = slot.Capacity ?? slot.capacity ?? "";

                                populateVenueDropdowns(globalVenuesCache);

                                const selectedVenueId = slot.VenueId ?? slot.venueId;
                                if (venueSelect && selectedVenueId) {
                                    venueSelect.value = selectedVenueId;
                                    await loadHallsForVenue(hallSelect, selectedVenueId);
                                    if (hallSelect) hallSelect.value = slot.HallId ?? slot.hallId ?? "";
                                }

                                populateSpeakerDropdowns(globalSpeakersCache);
                                if (speakerSelect) {
                                    // NOTE (fix for API #8 naming mismatch): Ent_GetEventDateAndSlots
                                    // returns the speaker on a slot as "Speakers" (a name string), not
                                    // "SpeakersId" like the Add/Update request shapes use. Resolve the
                                    // dropdown selection by matching that name back to a SpeakerId.
                                    const rawSpeaker = slot.SpeakersId ?? slot.speakersId ?? slot.Speakers ?? slot.speakers ?? "";
                                    let resolvedSpeakerId = rawSpeaker;
                                    if (rawSpeaker && isNaN(rawSpeaker)) {
                                        const match = globalSpeakersCache.find(sp => (sp.Name ?? sp.name ?? "").trim().toLowerCase() === String(rawSpeaker).trim().toLowerCase());
                                        resolvedSpeakerId = match ? (match.SpeakerId ?? match.speakerId ?? "") : "";
                                    }
                                    speakerSelect.value = resolvedSpeakerId ?? "";
                                }

                                slotsContainer.appendChild(slotRow);
                            }
                        }

                        daysContainer.appendChild(dayRow);
                    }
                }
            } catch (err) {
                console.error("Failed to load schedule:", err);
            }
        }

        // DYNAMIC EVENT LISTENERS
        document.addEventListener("change", async function(e) {
            if (e.target && e.target.matches("[data-slot-venue-select]")) {
                const venueId = e.target.value;
                const slotCard = e.target.closest(".slotcard");
                const hallSelect = slotCard?.querySelector("[data-slot-hall]");
                if (hallSelect) {
                    await loadHallsForVenue(hallSelect, venueId);
                }
            }
        });

        // FIX: cleanup for newly-cloned speaker rows added via the "Add speaker" button.
        // The generic data-repeat-add handler (shared across speakers/venues/halls/slots,
        // defined elsewhere) clones the last row in the container -- including whatever
        // data-speaker-id / data-loaded-from-server attributes and input values that row
        // already had. For speakers this is wrong: a freshly added row is a brand-new
        // speaker, not a copy of an existing one, so its id/flag/values must be reset.
        // This listener runs after the generic handler has appended the clone, and wipes
        // those inherited values so btnSaveSpeakers below can tell new rows apart from
        // real, previously-saved ones.
        const addSpeakerBtn = document.querySelector('[data-repeat-add="speaker-list"]');
        if (addSpeakerBtn) {
            addSpeakerBtn.addEventListener("click", function() {
                setTimeout(() => {
                    const rows = document.querySelectorAll("#speaker-list [data-speaker-row]");
                    const newRow = rows[rows.length - 1];
                    if (!newRow) return;

                    // Only touch it if it isn't itself a genuine server-loaded row
                    // (guards against this running before any row has ever loaded).
                    newRow.dataset.speakerId = "0";
                    newRow.removeAttribute("data-loaded-from-server");
                    newRow.querySelectorAll("input, textarea").forEach(el => el.value = "");
                    const countEl = newRow.querySelector("[data-speaker-count]");
                    if (countEl) countEl.textContent = "0";
                }, 0);
            });
        }

        // SAVE BUTTON HANDLERS
        const saveSpeakersBtn = document.getElementById("btnSaveSpeakers");
        if (saveSpeakersBtn) {
            saveSpeakersBtn.addEventListener("click", async function() {
                const speakerRows = document.querySelectorAll("#speaker-list [data-speaker-row]");

                // FIX: split rows into "existing" (really loaded from the server, has a
                // real SpeakerId) vs "new" (added via the Add speaker button, no real id
                // yet). Each group now goes to the endpoint that actually supports it --
                // sending a brand-new row to UpdateSpeakers has no insert path on the
                // backend and previously caused it to silently overwrite the first speaker.
                const existingSpeakers = [];
                const newSpeakers = [];

                speakerRows.forEach(row => {
                    const name = row.querySelector("[data-speaker-field='name']")?.value;
                    const title = row.querySelector("[data-speaker-field='title']")?.value;
                    const org = row.querySelector("[data-speaker-field='org']")?.value;
                    const bio = row.querySelector("[data-speaker-field='bio']")?.value;

                    if (!name || name.trim() === "") return;

                    const isExistingRow = row.dataset.loadedFromServer === "true";
                    const speakerId = parseInt(row.dataset.speakerId, 10) || 0;

                    if (isExistingRow && speakerId > 0) {
                        existingSpeakers.push({ SpeakerId: speakerId, Name: name, JobTitle: title, Organization: org, Bio: bio });
                    } else {
                        newSpeakers.push({ Name: name, JobTitle: title, Organization: org, Bio: bio });
                    }
                });

                if (existingSpeakers.length === 0 && newSpeakers.length === 0) {
                    alert("Please add at least one speaker with a name.");
                    return;
                }

                try {
                    // Update speakers that already exist for this event.
                    if (existingSpeakers.length > 0) {
                        const updateResponse = await fetch(`?handler=UpdateSpeakers`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                            body: JSON.stringify({ Speakers: existingSpeakers })
                        });
                        const updateResult = await updateResponse.json();
                        if (!updateResult || !updateResult.success) {
                            alert(updateResult?.message || "Failed to update speakers.");
                            return;
                        }
                    }

                    // Add speakers that were newly typed in this visit.
                    if (newSpeakers.length > 0) {
                        const saveResponse = await fetch(`?handler=SaveSpeakers`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                            body: JSON.stringify({ Speakers: newSpeakers })
                        });
                        const saveResult = await saveResponse.json();
                        if (!saveResult || !saveResult.success) {
                            alert(saveResult?.message || "Failed to save new speakers.");
                            return;
                        }
                    }

                    await loadAndBindSpeakers();
                    revealVenueSection();
                    venueSection.scrollIntoView({ behavior: 'smooth' });
                } catch (err) {
                    console.error("Error saving speakers:", err);
                }
            });
        }

        const saveVenuesBtn = document.getElementById("btnSaveVenues");
        if (saveVenuesBtn) {
            saveVenuesBtn.addEventListener("click", async function() {
                const isMulti = document.getElementById("multivenue")?.checked;
                const venues = [];

                if (!isMulti) {
                    const name = document.getElementById("sv-name")?.value;
                    const city = document.getElementById("sv-city")?.value;
                    const address = document.getElementById("sv-address")?.value;
                    const halls = [];

                    document.querySelectorAll("#sv-halls .hall").forEach(hRow => {
                        const hName = hRow.querySelector(".hall__name")?.value;
                        const hCap = hRow.querySelector(".hall__cap")?.value;
                        const hallId = parseInt(hRow.dataset.hallId, 10) || 0;
                        if (hName) {
                            if (hasSavedVenues) {
                                halls.push({ HallId: hallId, HallName: hName, Capacity: parseInt(hCap) || 0 });
                            } else {
                                halls.push({ HallName: hName, Capacity: parseInt(hCap) || 0 });
                            }
                        }
                    });

                    if (name) {
                        if (hasSavedVenues) {
                            const venueId = parseInt(document.getElementById("single-venue")?.dataset.venueId, 10) || 0;
                            venues.push({ VenueId: venueId, VenueName: name, City: city, Address: address, Halls: halls });
                        } else {
                            venues.push({ VenueName: name, City: city, Address: address, Halls: halls });
                        }
                    }
                }

                if (venues.length === 0) {
                    alert("Please fill in valid venue and hall details.");
                    return;
                }

                // If venues were already loaded for this event, update the existing
                // records (Ent_UpdateVenueAndHall) instead of re-adding them (Ent_AddVenueAndHall).
                const venueHandlerName = hasSavedVenues ? "UpdateVenue" : "SaveVenue";

                try {
                    const response = await fetch(`?handler=${venueHandlerName}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({ Venues: venues })
                    });

                    const result = await response.json();
                    if (result && result.success) {
                        await loadAndBindVenues();
                        revealScheduleSection();
                        scheduleSection.scrollIntoView({ behavior: 'smooth' });
                    } else {
                        alert(result.message || "Failed to save venue details.");
                    }
                } catch (err) {
                    console.error("Error saving venue:", err);
                }
            });
        }
        // HANDLER FOR CONTINUE BUTTON
        // Inside document.addEventListener("DOMContentLoaded", async function() { ... })

        const btnContinue = document.getElementById("btnContinue");
        if (btnContinue) {
            btnContinue.addEventListener("click", async function(e) {
                e.preventDefault();

                const dayRows = document.querySelectorAll("#schedule-days .day");
                const slotsPayload = [];

                dayRows.forEach(dayRow => {
                    const sessionName = dayRow.querySelector("input[name*='name']")?.value;
                    const eventDate = dayRow.querySelector("[data-day-date]")?.value;
                    const eventDateId = parseInt(dayRow.dataset.eventDateId, 10) || 0;
                    const slotCards = dayRow.querySelectorAll(".slotcard");

                    const slots = [];
                    slotCards.forEach(slotCard => {
                        // Check if slot name field exists, or fallback to an empty string / default title
                        const nameInput = slotCard.querySelector(".slotcard__name") || slotCard.querySelector("input[name*='slot']");
                        const slotName = nameInput ? nameInput.value.trim() : "";

                        const startTime = slotCard.querySelector("[data-slot-start]")?.value;
                        const endTime = slotCard.querySelector("[data-slot-end]")?.value;
                        const hallId = slotCard.querySelector("[data-slot-hall]")?.value;
                        const capacity = slotCard.querySelector("[data-cap-input]")?.value;
                        const speakerId = slotCard.querySelector("[data-speaker-add]")?.value;
                        const slotId = parseInt(slotCard.dataset.slotId, 10) || 0;

                        // Push slot object if at least a name OR time is provided
                        if (slotName || startTime || endTime) {
                            if (hasSavedSchedule) {
                                // Update shape: SlotId is required, and the speaker is sent as the
                                // resolved name string (Ent_UpdateEventDateAndSlots takes "Speakers",
                                // not "SpeakerId" like the Add call does).
                                const speakerMatch = globalSpeakersCache.find(sp => String(sp.SpeakerId ?? sp.speakerId) === String(speakerId));
                                const speakerName = speakerMatch ? (speakerMatch.Name ?? speakerMatch.name ?? "") : "";
                                slots.push({
                                    SlotId: slotId,
                                    SlotName: slotName || "Slot",
                                    StartTime: startTime ? new Date(startTime).toISOString() : "",
                                    EndTime: endTime ? new Date(endTime).toISOString() : "",
                                    HallId: hallId ? parseInt(hallId) : 0,
                                    Capacity: capacity ? parseInt(capacity) : 0,
                                    Speakers: speakerName
                                });
                            } else {
                                slots.push({
                                    SlotName: slotName || "Slot",
                                    StartTime: startTime ? new Date(startTime).toISOString() : "",
                                    EndTime: endTime ? new Date(endTime).toISOString() : "",
                                    HallId: hallId ? parseInt(hallId) : 0,
                                    Capacity: capacity ? parseInt(capacity) : 0,
                                    SpeakersId: speakerId ? parseInt(speakerId) : 0
                                });
                            }
                        }
                    });

                    if (sessionName || eventDate) {
                        if (hasSavedSchedule) {
                            slotsPayload.push({
                                EventDateId: eventDateId,
                                SessionName: sessionName ?? "",
                                EventDate: eventDate ?? "",
                                EventSlots: slots
                            });
                        } else {
                            slotsPayload.push({
                                SessionName: sessionName ?? "",
                                EventDate: eventDate ?? "",
                                EventSlots: slots
                            });
                        }
                    }
                });

                if (slotsPayload.length === 0) {
                    alert("Please complete the schedule details before continuing.");
                    return;
                }

                // If a schedule was already loaded for this event, update the existing
                // records (Ent_UpdateEventDateAndSlots) instead of re-adding them (Ent_AddEventDateAndSlots).
                const scheduleHandlerName = hasSavedSchedule ? "UpdateSchedule" : "SaveSchedule";

                try {
                    const response = await fetch(`?handler=${scheduleHandlerName}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ Slots: slotsPayload })
                    });

                    const result = await response.json();
                    if (result && result.success) {
                        window.location.href = '/CreateEvent/ContentSection';
                    } else {
                        alert(result.message || "Failed to save schedule.");
                    }
                } catch (err) {
                    console.error("Error saving schedule on continue:", err);
                    alert("An error occurred while attempting to save and continue.");
                }
            });
        }
        // INITIALIZATION
        async function init() {
            const hasSpeakers = await loadAndBindSpeakers();
            if (hasSpeakers) {
                const hasVenues = await loadAndBindVenues();
                if (hasVenues) {
                    await loadAndBindSchedule();
                }
            }
        }

        init();
    });
</script>
