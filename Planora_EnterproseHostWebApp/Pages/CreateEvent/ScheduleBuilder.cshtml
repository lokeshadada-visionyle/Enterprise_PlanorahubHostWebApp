        document.addEventListener("click", function(e) {
            const addSlotBtn = e.target.closest(".addline[data-repeat-add]");
            if (!addSlotBtn) return;

            const dayRow = addSlotBtn.closest("#schedule-days .day");
            if (!dayRow) return;

            e.preventDefault();
            e.stopImmediatePropagation();

            const slotsContainer = dayRow.querySelector(".slots");
            if (!slotsContainer) return;

            const existingSlots = slotsContainer.querySelectorAll(".slotcard");
            if (existingSlots.length >= MAX_SLOTS_PER_DAY) {
                scheduleToast(`You can add up to ${MAX_SLOTS_PER_DAY} time slots per day.`, "warn");
                return;
