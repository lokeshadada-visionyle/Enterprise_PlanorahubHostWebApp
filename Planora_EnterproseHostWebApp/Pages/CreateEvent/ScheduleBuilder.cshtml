            if (existingSlots.length === 0) return;

            const newSlot = existingSlots[existingSlots.length - 1].cloneNode(true);
            blankSlotCard(newSlot);
            slotsContainer.appendChild(newSlot);

            renumberSlots(dayRow);
            refreshSlotDropdowns();
            syncSlotTimeAvailability(dayRow);
            refreshScheduleMetrics();
        }, true);

        const addDayBtn = document.querySelector('[data-repeat-add="schedule-days"]');
        if (addDayBtn) {
            addDayBtn.addEventListener("click", function() {
                setTimeout(() => {
                    const rows = document.querySelectorAll("#schedule-days .day");
                    const newRow = rows[rows.length - 1];
                    resetDayRow(newRow);
                    const dateInput = newRow?.querySelector("[data-day-date]");
                    if (dateInput) {
                        dateInput.value = "";
                        dateInput.disabled = false;
                        applyDateBounds(dateInput);
                    }
                    renumberDays();
                    reindexAllDayRows();
                    refreshSlotDropdowns();
                    syncSlotTimeAvailability(newRow);
                    refreshScheduleMetrics();
