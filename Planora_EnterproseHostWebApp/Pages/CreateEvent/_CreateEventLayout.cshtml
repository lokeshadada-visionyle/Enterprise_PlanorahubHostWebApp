@using Planora_EnterproseHostWebApp.Extensions
@using Microsoft.AspNetCore.Http
@{
    int currentStep = ViewData["StepIndex"] as int? ?? 1;
    int stepTotal = ViewData["StepTotal"] as int? ?? 11;
    string stepName = ViewData["StepName"] as string ?? "";
    string stepHint = ViewData["StepHint"] as string ?? "";

    string eventType = Context.Session.GetEventType();

    // 1. Fetch highest reached progress step from session (default to Step 1)
    int maxCompletedStep = Context.Session.GetInt32("StepProgress") ?? 1;

    // 2. Ensure calculation works even if user goes back to earlier steps
    int highestVisitedStep = Math.Max(maxCompletedStep, currentStep);

    // 3. Dynamic percentage calculation based on furthest reached step
    int progress = ViewData["ProgressPercent"] as int?
        ?? (int)Math.Min(100, Math.Round((double)(highestVisitedStep - 1) / (stepTotal - 1) * 100));

    // Determine Step CSS Class
    string StepClass(int stepNumber)
    {
        if (stepNumber == currentStep)
            return "wizard__step wizard__step--active";

        if (stepNumber <= highestVisitedStep)
            return "wizard__step wizard__step--done";

        return "wizard__step wizard__step--disabled";
    }

    // Determine if Step should be non-interactive
    bool IsStepDisabled(int stepNumber)
    {
        if (stepNumber == currentStep) return false;

        // Allow navigation to Step 1 and any step previously visited or unlocked
        return stepNumber > highestVisitedStep;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Step @currentStep of the Planorahub create-event wizard.">
    <meta name="theme-color" content="#240a26">
    <meta name="robots" content="noindex, follow">

    <title>Create event — @stepName | Planorahub</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/styles.css">

    <style>
            /* Sidebar disabled step styling & click prevention */
            .wizard__step--disabled {
                opacity: 0.45;
                cursor: not-allowed !important;
                filter: grayscale(1);
                pointer-events: none;
            }
    </style>
</head>
<body data-event-type="@eventType">
    <div class="wizard">

        <nav class="wizard__side" id="wizard-steps" aria-label="Create event steps" data-sidebar>
            <div class="wizard__head">
                <span class="sidenav__logo" aria-hidden="true"><img src="~/assets/images/App.png" /></span>
                <div class="sidenav__identity">
                    <p class="wizard__name">Create Event</p>
                    <p class="wizard__saved"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg> Saved</p>
                </div>
                <a class="iconbtn" asp-page="/Dashboard/HostDashboard">
                    <span class="u-visually-hidden">Close the wizard</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </a>
            </div>

            <ol class="wizard__steps">
                <li>
                    <a class="@StepClass(1)" asp-page="/CreateEvent/EventType" data-wizard-link aria-current="@(currentStep == 1 ? "step" : null)" aria-disabled="@(IsStepDisabled(1) ? "true" : "false")" tabindex="@(IsStepDisabled(1) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 3 7.5l9 4.5 9-4.5L12 3zM3 12.5 12 17l9-4.5M3 17 12 21.5 21 17" /></svg></span>
                        <span>Event Type</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(2)" asp-page="/CreateEvent/BasicDetails" data-wizard-link aria-current="@(currentStep == 2 ? "step" : null)" aria-disabled="@(IsStepDisabled(2) ? "true" : "false")" tabindex="@(IsStepDisabled(2) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg></span>
                        <span>Basic Details</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(3)" asp-page="/CreateEvent/ScheduleBuilder" data-wizard-link aria-current="@(currentStep == 3 ? "step" : null)" aria-disabled="@(IsStepDisabled(3) ? "true" : "false")" tabindex="@(IsStepDisabled(3) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg></span>
                        <span>Schedule Builder</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(4)" asp-page="/CreateEvent/ContentSection" data-wizard-link aria-current="@(currentStep == 4 ? "step" : null)" aria-disabled="@(IsStepDisabled(4) ? "true" : "false")" tabindex="@(IsStepDisabled(4) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9.5" r="1.6" /><path d="M21 16l-5-5-9 9" /></svg></span>
                        <span>Content Sections</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(5)" asp-page="/CreateEvent/TicketPricing" data-wizard-link aria-current="@(currentStep == 5 ? "step" : null)" aria-disabled="@(IsStepDisabled(5) ? "true" : "false")" tabindex="@(IsStepDisabled(5) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg></span>
                        <span>Tickets &amp; Pricing</span>
                    </a>
                </li>
                <li data-type-only="public">
                    <a class="@StepClass(6)" asp-page="/CreateEvent/PayoutAccount" data-wizard-link aria-current="@(currentStep == 6 ? "step" : null)" aria-disabled="@(IsStepDisabled(6) ? "true" : "false")" tabindex="@(IsStepDisabled(6) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg></span>
                        <span>Payout Account</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(7)" asp-page="/CreateEvent/AddonsCoupons" data-wizard-link aria-current="@(currentStep == 7 ? "step" : null)" aria-disabled="@(IsStepDisabled(7) ? "true" : "false")" tabindex="@(IsStepDisabled(7) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /></svg></span>
                        <span>Add-ons &amp; Coupons</span>
                    </a>
                </li>
                <li data-type-only="private">
                    <a class="@StepClass(8)" asp-page="/CreateEvent/FoodBeverage" data-wizard-link aria-current="@(currentStep == 8 ? "step" : null)" aria-disabled="@(IsStepDisabled(8) ? "true" : "false")" tabindex="@(IsStepDisabled(8) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8zM17 9h1.5a2.5 2.5 0 0 1 0 5H17" /></svg></span>
                        <span>Food &amp; Beverage</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(9)" asp-page="/CreateEvent/AccessControl" data-wizard-link aria-current="@(currentStep == 9 ? "step" : null)" aria-disabled="@(IsStepDisabled(9) ? "true" : "false")" tabindex="@(IsStepDisabled(9) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9" cy="7.5" r="3.5" /><path d="M16.5 11.5l2 2 3.5-3.5" /></svg></span>
                        <span>Access Control</span>
                    </a>
                </li>
                <li data-type-only="private">
                    <a class="@StepClass(10)" asp-page="/CreateEvent/RSVP" data-wizard-link aria-current="@(currentStep == 10 ? "step" : null)" aria-disabled="@(IsStepDisabled(10) ? "true" : "false")" tabindex="@(IsStepDisabled(10) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6 8.5-6" /></svg></span>
                        <span>RSVP Setup</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(11)" asp-page="/CreateEvent/BrandingPage" data-wizard-link aria-current="@(currentStep == 11 ? "step" : null)" aria-disabled="@(IsStepDisabled(11) ? "true" : "false")" tabindex="@(IsStepDisabled(11) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /></svg></span>
                        <span>Branding &amp; Page</span>
                    </a>
                </li>
                <li>
                    <a class="@StepClass(12)" asp-page="/CreateEvent/ReviewAndPublish" data-wizard-link aria-current="@(currentStep == 12 ? "step" : null)" aria-disabled="@(IsStepDisabled(12) ? "true" : "false")" tabindex="@(IsStepDisabled(12) ? "-1" : "0")">
                        <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 2 4 13.2h5.6L8.9 22 19 10.6h-5.8L13.5 2z" /></svg></span>
                        <span>Review &amp; Publish</span>
                    </a>
                </li>
            </ol>

            <div class="wizard__progress">
                <p class="wizard__progress-top">
                    <span>Progress</span>
                    <span class="wizard__progress-value">@progress%</span>
                </p>
                <span class="meter"><span class="meter__fill" data-fill="@progress" style="width:@(progress)%"></span></span>
            </div>
        </nav>

        <div class="wizard__body">

            <header class="wizard__topbar">
                <button class="topbar__burger" type="button" aria-expanded="false"
                        aria-controls="wizard-steps" data-sidebar-open>
                    <span class="u-visually-hidden">Open step list</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <a class="iconbtn" asp-page="/Events/MyEvents" data-wizard-link>
                    <span class="u-visually-hidden">Previous step</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 6l-6 6 6 6" /></svg>
                </a>
                <div class="wizard__crumb">
                    <p class="wizard__stepno">
                        Step <span data-step-index>@currentStep</span> of <span data-step-total>@stepTotal</span>
                        &mdash; <span class="wizard__stepname">@stepName</span>
                    </p>
                    <p class="wizard__hint">@stepHint</p>
                </div>
                <div class="wizard__topactions">
                    <span class="wizard__saved"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg> Saved</span>
                    <button class="btn btn--quiet btn--sm" type="button" data-modal-open="discard-modal">Discard</button>
                </div>
            </header>

            @RenderBody()

        </div>
    </div>

    <div class="backdrop" data-backdrop></div>

    <div class="wizard-loading" id="wizard-loading" aria-hidden="true" aria-live="polite">
        <div class="wizard-loading__panel">
            <span class="shimmer shimmer--title"></span>
            <span class="shimmer shimmer--line"></span>
            <span class="shimmer shimmer--line shimmer--short"></span>
            <span class="shimmer shimmer--block"></span>
        </div>
    </div>

    <div class="modal" id="discard-modal" role="dialog" aria-modal="true" aria-labelledby="discard-title" data-modal hidden>
        <div class="modal__scrim" data-modal-close></div>
        <div class="modal__dialog">
            <div class="modal__head">
                <h2 class="modal__title" id="discard-title">Discard this draft?</h2>
                <button class="iconbtn" type="button" data-modal-close>
                    <span class="u-visually-hidden">Close</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
            <div class="modal__body">
                <p class="confirmbox">
                    <span class="confirmbox__name">@(ViewData["EventName"] as string ?? "This draft")</span>
                    <span class="confirmbox__meta">Everything entered so far is removed &mdash; this cannot be undone</span>
                </p>
                <p class="modal__note">
                    Leaving the wizard without discarding keeps the draft, so you can pick it up from My Events whenever you like.
                </p>
            </div>
            <div class="modal__foot">
                <a class="btn btn--outline" asp-page="/Events/MyEvents">Keep the draft</a>
                <button class="btn btn--danger" type="button" data-modal-close data-action="Draft discarded" data-action-tone="warn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg> Discard draft
                </button>
            </div>
        </div>
    </div>

    <script src="~/assets/js/script.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>