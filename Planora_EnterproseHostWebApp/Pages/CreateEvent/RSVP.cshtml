<script>
    document.addEventListener("DOMContentLoaded", function() {

        const yesRadio = document.querySelector(
            'input[name="rsvp-required"][value="yes"]'
        );

        const noRadio = document.querySelector(
            'input[name="rsvp-required"][value="no"]'
        );

        const rsvpForm = document.getElementById("rsvp-form");
        const rsvpOff = document.getElementById("rsvp-off");
        const continueBtn = document.getElementById("rsvpContinueBtn");

        function updateRsvpVisibility() {

            if (noRadio && noRadio.checked) {

                if (rsvpForm) {
                    rsvpForm.hidden = true;
                }

                if (rsvpOff) {
                    rsvpOff.hidden = false;
                }

            } else {

                if (rsvpForm) {
                    rsvpForm.hidden = false;
                }

                if (rsvpOff) {
                    rsvpOff.hidden = true;
                }
            }
        }

        if (yesRadio) {
            yesRadio.addEventListener("change", updateRsvpVisibility);
        }

        if (noRadio) {
            noRadio.addEventListener("change", updateRsvpVisibility);
        }

        if (continueBtn) {
            continueBtn.addEventListener("click", function() {

                if (noRadio && noRadio.checked) {

                    window.location.href = '@Url.Page("/CreateEvent/BrandingPage")';

                    return;
                }

                document.getElementById("RsvpForm").submit();
            });
        }

        updateRsvpVisibility();
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const loadBtn = document.getElementById("btnLoadTemplate");
        const templateSelect = document.getElementById("tplpick-rq-list");
        const container = document.getElementById("rq-list");

        function renderFields(fields) {
            // Keep the first 2 default locked rows (Full Name & Email) and remove custom rows
            const rows = container.querySelectorAll('.fieldrow');
            rows.forEach((row, idx) => {
                if (idx >= 2) row.remove();
            });

            // Filter out Full Name and Email from the server response so they aren't duplicated
            const customFields = fields.filter(field => {
                const name = (field.label || field.Label || field.CustomName || '').trim().toLowerCase();
                return name !== 'full name' && name !== 'email' && name !== 'email address';
            });

            // Render only the remaining custom fields
            customFields.forEach((field, i) => {
                const idx = i + 3;
                const label = field.label || field.Label || field.CustomName || '';
                const type = field.fieldType || field.FieldType || 'Short Text';
                const isReq = (field.isRequired || field.IsRequired) ? 'checked' : '';

                const rowHtml = `
                <div class="fieldrow" data-repeat-row>
                    <span class="fieldrow__grip" aria-hidden="true">#</span>
                    <span class="fieldrow__no" aria-hidden="true">${idx}</span>
                    <span>
                        <input class="fieldrow__input" id="rq-${idx}-label" name="rq-${idx}-label"
                               type="text" value="${label}" placeholder="What do you want to ask?">
                    </span>
                    <span>
                        <select class="fieldrow__select" id="rq-${idx}-type" name="rq-${idx}-type">
                            <option ${type === 'Short Text' ? 'selected' : ''}>Short Text</option>
                            <option ${type === 'Email' ? 'selected' : ''}>Email</option>
                            <option ${type === 'Phone' ? 'selected' : ''}>Phone</option>
                            <option ${type === 'Long Text' ? 'selected' : ''}>Long Text</option>
                            <option ${type === 'Dropdown' ? 'selected' : ''}>Dropdown</option>
                            <option ${type === 'Checkbox' ? 'selected' : ''}>Checkbox</option>
                            <option ${type === 'Date' ? 'selected' : ''}>Date</option>
                            <option ${type === 'Number' ? 'selected' : ''}>Number</option>
                            <option ${type === 'File Upload' ? 'selected' : ''}>File Upload</option>
                        </select>
                    </span>
                    <label class="fieldrow__req" for="rq-${idx}-req">
                        <input id="rq-${idx}-req" name="rq-${idx}-req" type="checkbox" ${isReq}>
                        Req
                    </label>
                    <button class="fieldrow__icon fieldrow__icon--danger" type="button" onclick="this.closest('.fieldrow').remove()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                </div>`;
                container.insertAdjacentHTML('beforeend', rowHtml);
            });
        }

        function loadTemplateByTitle(title) {
            if (!title) return;

            // Decode HTML entities if any were picked up from DOM values
            const txt = document.createElement("textarea");
            txt.innerHTML = title;
            const cleanTitle = txt.value.trim();

            if (!cleanTitle) return;

            const encodedTitle = encodeURIComponent(cleanTitle);

            // Pass both formTitle and FormTitle to satisfy both Razor Page Handler and internal API model binder
            fetch(`?handler=LoadTemplate&formTitle=${encodedTitle}&FormTitle=${encodedTitle}`, {
                method: "GET",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 1 && data.fields) {
                        renderFields(data.fields);
                    } else {
                        // Display exact error message returned by server or fallback
                        alert(data.message || "Failed to load template.");
                    }
                })
                .catch(() => alert("An error occurred while loading the template."));
        }

        if (templateSelect) {
            templateSelect.addEventListener("change", function() {
                if (this.value) {
                    loadTemplateByTitle(this.value);
                }
            });
        }

        // 2. Load button fallback trigger
        if (loadBtn) {
            loadBtn.addEventListener("click", function() {
                if (!templateSelect.value) {
                    alert("Please select a template first.");
                    return;
                }
                loadTemplateByTitle(templateSelect.value);
            });
        }

        // 3. Handle "Use this template" button inside modal
        document.querySelectorAll("[data-tpluse]").forEach(button => {
            button.addEventListener("click", function() {
                const templateKey = this.getAttribute("data-tpluse");
                const templateEl = document.querySelector(`template[data-formtemplate="${templateKey}"]`);

                if (templateEl) {
                    const fields = [];
                    templateEl.content.querySelectorAll("[data-tplfield]").forEach(item => {
                        fields.push({
                            Label: item.getAttribute("data-label"),
                            FieldType: item.getAttribute("data-type") || "Short Text",
                            IsRequired: item.getAttribute("data-required") === "true"
                        });
                    });

                    renderFields(fields);
                }

                // Close the modal
                const modal = document.getElementById("tpllibrary-modal");
                if (modal) modal.hidden = true;
            });
        });

        // 4. Modal Open/Close handling for Manage Modal
        document.querySelectorAll("[data-modal-open]").forEach(btn => {
            btn.addEventListener("click", function() {
                const targetId = this.getAttribute("data-modal-open");
                const targetModal = document.getElementById(targetId);
                if (targetModal) targetModal.hidden = false;
            });
        });

        document.querySelectorAll("[data-modal-close]").forEach(btn => {
            btn.addEventListener("click", function() {
                const modal = this.closest(".modal");
                if (modal) modal.hidden = true;
            });
        });
    });
</script>