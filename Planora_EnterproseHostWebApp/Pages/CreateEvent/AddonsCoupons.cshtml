@page
@model Planora_EnterproseHostWebApp.Pages.CreateEvent.AddonsCouponsModel
@{
    Layout = "_CreateEventLayout";
    ViewData["StepIndex"] = 7;
    ViewData["StepTotal"] = Model.IsPrivateEvent ? 12 : 10;
    ViewData["StepName"] = "Add-ons & Coupons";
    ViewData["StepHint"] = "Add optional extras and discount codes for paid tickets";
}
<style>
    .addonline + .addonline {
        margin-top: var(--space-3);
    }

    .addonline {
        padding: var(--space-4);
        background-color: var(--color-white);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
    }

    .addonline__top {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
    }

    .addonline__desc {
        margin-top: var(--space-4);
    }

    .addonline__fields {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: var(--space-3);
        flex: 1 1 auto;
        min-width: 0;
    }

    .field__hint {
        display: block;
        margin-top: 0.375rem;
        font-size: 0.6875rem;
        color: var(--color-text-subtle);
    }

    .descprev {
        margin-top: var(--space-3);
        padding: var(--space-3) 0.875rem;
        background-color: var(--color-surface-alt);
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-sm);
    }

    .descprev__label {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 0.5625rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .descprev__list {
        margin: 0 0 0 1rem;
        font-size: var(--fs-2xs);
        color: var(--color-text-label);
    }
</style>
<div class="wizard__body">

    <main class="wizard__content">
        <div class="wizard__inner">
            <form class="stack" id="addons-coupons-form" method="post">
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrWhiteSpace(Model.ApiError))
                {
                    <p class="notice notice--error notice--flat">
                        <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 8v5M12 16h.01" /></svg>
                        @Model.ApiError
                    </p>
                }

                <p class="notice notice--info notice--flat">
                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                    Add-ons and coupons apply to <b>paid</b> events only. On a free event this
                    step is skipped automatically.
                </p>

                <section class="panel" aria-labelledby="addons-title">
                    <div class="panel__head">
                        <span class="tile tile--accent" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 3 7.5l9 4.5 9-4.5L12 3zM3 12.5 12 17l9-4.5M3 17 12 21.5 21 17" /></svg></span>
                        <h2 class="panel__title" id="addons-title">Add-ons</h2>
                        <p class="panel__meta">Optional extras sold alongside a ticket</p>
                    </div>
                    <div class="panel__body">
                        <div class="lines lines--addon">
                            <div class="lines__head" aria-hidden="true">
                                <span>Name</span><span>Price (₦)</span><span>Stock</span><span></span>
                            </div>
                            <div id="addon-list">
                                <div class="addonline" data-repeat-row="">
                                    <div class="addonline__top">
                                        <span class="addonline__fields">
                                            <label class="u-visually-hidden" for="addon-name-1">Add-on name</label>
                                            <input class="line__input" id="addon-name-1" name="addon-name-1" type="text" placeholder="e.g. Conference Tote Bag" value="Conference Tote Bag">
                                            <label class="u-visually-hidden" for="addon-price-1">Price</label>
                                            <input class="line__input" id="addon-price-1" name="addon-price-1" type="text" inputmode="numeric" placeholder="0" value="2500">
                                            <label class="u-visually-hidden" for="addon-stock-1">Stock count</label>
                                            <input class="line__input" id="addon-stock-1" name="addon-stock-1" type="text" inputmode="numeric" placeholder="0" value="150">
                                        </span>
                                        <button class="line__remove" type="button" data-repeat-remove="">
                                            <span class="u-visually-hidden">Remove add-on</span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6"></path></svg>
                                        </button>
                                    </div>

                                    <div class="form__field addonline__desc">
                                        <label class="field__label" for="addon-desc-1">Description</label>
                                        <textarea class="field__input" id="addon-desc-1" name="addon-desc-1" rows="3" placeholder="One line per thing the buyer gets" data-desc-src="addon-1" style=" height: 128px;">Canvas tote with the event print
                                            Notebook and pen inside
                                            Collect at the registration desk</textarea>
                                        <span class="field__hint">
                                            Start a new line for each point — the buyer sees them as bullets
                                        </span>
                                        <div class="descprev" data-desc-prev="addon-1">
                                            <span class="descprev__label">How the buyer sees it</span>
                                            <ul class="descprev__list" data-desc-list=""><li>Canvas tote with the event print</li><li>Notebook and pen inside</li><li>Collect at the registration desk</li></ul>
                                            <p class="descprev__line" data-desc-line="" hidden=""></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="addonline" data-repeat-row="">
                                    <div class="addonline__top">
                                        <span class="addonline__fields">
                                            <label class="u-visually-hidden" for="addon-name-2">Add-on name</label>
                                            <input class="line__input" id="addon-name-2" name="addon-name-2" type="text" placeholder="e.g. Conference Tote Bag" value="Workshop Pass">
                                            <label class="u-visually-hidden" for="addon-price-2">Price</label>
                                            <input class="line__input" id="addon-price-2" name="addon-price-2" type="text" inputmode="numeric" placeholder="0" value="8000">
                                            <label class="u-visually-hidden" for="addon-stock-2">Stock count</label>
                                            <input class="line__input" id="addon-stock-2" name="addon-stock-2" type="text" inputmode="numeric" placeholder="0" value="60">
                                        </span>
                                        <button class="line__remove" type="button" data-repeat-remove="">
                                            <span class="u-visually-hidden">Remove add-on</span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6"></path></svg>
                                        </button>
                                    </div>

                                    <div class="form__field addonline__desc">
                                        <label class="field__label" for="addon-desc-2">Description</label>
                                        <textarea class="field__input" id="addon-desc-2" name="addon-desc-2" rows="3" placeholder="One line per thing the buyer gets" data-desc-src="addon-2">Entry to the Fintech Panel workshop
Workbook and materials
Certificate of attendance</textarea>
                                        <span class="field__hint">
                                            Start a new line for each point — the buyer sees them as bullets
                                        </span>
                                        <div class="descprev" data-desc-prev="addon-2">
                                            <span class="descprev__label">How the buyer sees it</span>
                                            <ul class="descprev__list" data-desc-list=""><li>Entry to the Fintech Panel workshop</li><li>Workbook and materials</li><li>Certificate of attendance</li></ul>
                                            <p class="descprev__line" data-desc-line="" hidden=""></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button class="addline" type="button" data-repeat-add="addon-list">
                            + Add add-on
                        </button>

                        <p class="notice notice--info notice--flat u-mt-5">
                            <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"></circle><path d="M12 12h.01"></path></svg>
