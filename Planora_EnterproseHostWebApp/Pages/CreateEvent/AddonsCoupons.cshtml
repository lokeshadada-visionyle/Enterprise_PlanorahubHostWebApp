<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Generic handler function for list items deletion
        function setupListDeletion(containerId, itemSelector, lastItemMessage) {
            const container = document.getElementById(containerId);
            if (!container) return;

            container.addEventListener('click', function (event) {
                // Find remove button by class or data attribute
                const deleteBtn = event.target.closest('.line__remove, [data-repeat-remove]');
                if (!deleteBtn) return;

                // Select all items currently in this container
                const allItems = container.querySelectorAll(itemSelector);

                // Prevent deletion if only one item remains
                if (allItems.length <= 1) {
                    showToast(lastItemMessage);
                    return;
                }

                // Remove targeted row item
                const itemToRemove = deleteBtn.closest(itemSelector);
                if (itemToRemove) {
                    itemToRemove.remove();
                }
            });
        }

        // Initialize deletion logic for Promo Codes
        setupListDeletion(
            'promo-list',
            '.promo',
            'This is the last promo code — there has to be at least one'
        );
    });

    function showToast(message) {
        const toast = document.createElement('div');
        toast.className = 'toast-message';
        toast.textContent = message;

        Object.assign(toast.style, {
            position: 'fixed',
            bottom: '20px',
            right: '20px',
            backgroundColor: 'rgb(90, 42, 6)',
            color: 'rgb(255, 255, 255)',
            padding: '12px 20px',
            borderRadius: '8px',
            fontSize: '14px',
            fontWeight: 'bold',
            boxShadow: '0 4px 12px rgba(0, 0, 0, 0.15)',
            zIndex: '9999',
            opacity: '1',
            transition: 'opacity 0.3s'
        });

        document.body.appendChild(toast);

        setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }
</script>