@page
@model Planora_EnterproseHostWebApp.Pages.Dashboard.HostDashboardModel
@{
    Layout = "_Layout";
    ViewData["PageName"] = "Dashboard";
    ViewData["PageDesc"] = "TechSphere Corp \u00B7 Enterprise";
}
<main class="shell__main">

    <!-- Page Head Header -->
    <div class="page__head">
        <div>
            <h1 class="page__title">
                Good day, @(string.IsNullOrEmpty(Model.Dashboard.EnterpriseName) ? "Host" : Model.Dashboard.EnterpriseName) 
                <span aria-hidden="true">&#128075;</span>
            </h1>
            <p class="page__subtitle">
                @Model.Dashboard.CompanyName &middot; Enterprise &middot; @DateTime.Now.ToString("ddd MMM dd, yyyy")
            </p>
        </div>
        <a class="btn btn--primary" asp-page="/CreateEvent/EventType">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 5v14M5 12h14" />
            </svg> Create Event
        </a>
    </div>

    <!-- API Error Banner -->
    @if (!string.IsNullOrEmpty(Model.ApiError))
    {
        <div class="alert alert-danger mb-4" role="alert">
            @Model.ApiError
        </div>
    }

    <div class="stack">

        <!-- Live event banner -->
        @if (!string.IsNullOrEmpty(Model.Dashboard.LiveEventName))
        {
            <section class="live" aria-labelledby="live-title">
                <div class="live__body">
                    <p class="live__flag">
                        <span class="live__pulse" aria-hidden="true"></span> Live now
                    </p>
                    <h2 class="live__title" id="live-title">@Model.Dashboard.LiveEventName</h2>
                    <p class="live__meta">
                        <span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                <path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11z" />
                                <circle cx="12" cy="10" r="2.5" />
                            </svg>
                            @(Model.LiveEventsData.FirstOrDefault()?.Location ?? "Main Venue")
                        </span>
                        <span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                <rect x="3" y="5" width="18" height="16" rx="2" />
                                <path d="M3 10h18M8 3v4M16 3v4" />
                            </svg>
                            @(Model.LiveEventsData.FirstOrDefault()?.EventDate ?? "Today")
                        </span>
                    </p>
                </div>

                <div class="live__stats">
                    <p class="live__figure live__figure--tracked">
                        <span class="live__value">@Model.Dashboard.LiveCheckIns.ToString("N0")</span>
                        <span class="live__caption">Checked In</span>
                    </p>
                    <p class="live__figure">
                        <span class="live__value">@Model.Dashboard.Currency @Model.Dashboard.GrossRevenue</span>
                        <span class="live__caption">Revenue</span>
                    </p>
                    <a class="btn btn--translucent" asp-page="/Events/EventHub">
                        Manage Hub
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d="M4 12h16m0 0-6-6m6 6-6 6" />
                        </svg>
                    </a>
                </div>
            </section>
        }

        <!-- KPI row -->
        <section class="grid grid--4" aria-label="Key metrics">
            <!-- KPI 1: Total Events -->
            <article class="kpi">
                <div class="kpi__top">
                    <h3 class="kpi__label">Total Events</h3>
                    <span class="tile tile--brand" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path d="M3 10h18M8 3v4M16 3v4" />
                        </svg>
                    </span>
                </div>
                <p class="kpi__value">@Model.Dashboard.TotalEvents</p>
                <p class="kpi__foot">
                    <span>@Model.Dashboard.LiveEvents live &middot; @Model.Dashboard.UpcomingEvents upcoming</span>
                    <span class="kpi__delta">+@Model.Dashboard.EventsThisMonth this month</span>
                </p>
            </article>

            <!-- KPI 2: Tickets Sold -->
            <article class="kpi">
                <div class="kpi__top">
                    <h3 class="kpi__label">Tickets Sold</h3>
                    <span class="tile tile--info" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" />
                            <path d="M9 9v6" />
                        </svg>
                    </span>
                </div>
                <p class="kpi__value">@Model.Dashboard.TotalTicketSold.ToString("N0")</p>
                <p class="kpi__foot">
                    <span>+@Model.Dashboard.TicketssoldThisMonth.ToString("N0") this month</span>
                    <span class="kpi__delta">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M8 13V3m0 0 4 4M8 3 4 7" />
                        </svg> @Model.Dashboard.TicketPerThisMonth
                    </span>
                </p>
            </article>

            <!-- KPI 3: Gross Revenue -->
            <article class="kpi">
                <div class="kpi__top">
                    <h3 class="kpi__label">Gross Revenue</h3>
                    <span class="tile tile--success" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d="M12 3v18M16.5 7.5A3.5 3.5 0 0 0 13 5h-2a3 3 0 0 0 0 6h2.5a3 3 0 0 1 0 6H11a3.5 3.5 0 0 1-3.5-2.5" />
                        </svg>
                    </span>
                </div>
                <p class="kpi__value">@Model.Dashboard.Currency @Model.Dashboard.GrossRevenue</p>
                <p class="kpi__foot">
                    <span>Base: @Model.Dashboard.Currency</span>
                    <span class="kpi__delta">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M8 13V3m0 0 4 4M8 3 4 7" />
                        </svg> @Model.Dashboard.GrossRevenuePerThisMonth MTD
                    </span>
                </p>
            </article>

            <!-- KPI 4: Live Check-ins -->
            <article class="kpi">
                <div class="kpi__top">
                    <h3 class="kpi__label">Live Check-ins</h3>
                    <span class="tile tile--accent" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d="M15 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" />
                            <circle cx="9" cy="7.5" r="3.5" />
                            <path d="M16.5 11.5l2 2 3.5-3.5" />
                        </svg>
                    </span>
                </div>
                <p class="kpi__value">@Model.Dashboard.LiveCheckIns.ToString("N0")</p>
                <p class="kpi__foot">
                    <span>@(string.IsNullOrEmpty(Model.Dashboard.LiveEventName) ? "No active event" : Model.Dashboard.LiveEventName)</span>
                    <span class="kpi__delta">@Model.Dashboard.LiveEventCapacityPer capacity</span>
                </p>
            </article>
        </section>

        <!-- Revenue Chart + Event Shortlist -->
        <div class="grid grid--main">
            <!-- Weekly Chart Panel -->
            <section class="panel" aria-labelledby="revenue-title">
                <div class="panel__head panel__head--plain">
                    <div>
                        <h2 class="panel__title panel__title--lg" id="revenue-title">Weekly Revenue</h2>
                        <p class="panel__meta">All events &middot; @Model.Dashboard.Currency</p>
                    </div>
                    <p class="trend">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M3 17l6-6 4 4 8-8m0 0h-5m5 0v5" />
                        </svg> @Model.WeeklyPer vs last week
                    </p>
                </div>
                <div class="panel__body">
                    <div class="chart" role="img" aria-label="Weekly revenue visualization">
                        @if (Model.WeeklyEventsData.Any())
                        {
                            var maxEvents = Model.WeeklyEventsData.Max(x => x.Events);
                            maxEvents = maxEvents == 0 ? 1 : maxEvents;

                            foreach (var item in Model.WeeklyEventsData)
                            {
                                var barHeight = (int)Math.Round((double)item.Events / maxEvents * 100);
                                <div class="chart__col">
                                    <span class="chart__track"><span class="chart__bar" style="height: @(barHeight)%;"></span></span>
                                    <span class="chart__label">@item.Day</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted p-3">No weekly revenue data available.</p>
                        }
                    </div>
                </div>
            </section>

            <!-- Events List Panel -->
            <section class="panel" aria-labelledby="events-title">
                <div class="panel__head panel__head--plain">
                    <h2 class="panel__title panel__title--lg" id="events-title">Live Events</h2>
                    <a class="linkmore" asp-page="/Events/MyEvents">
                        View all
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d="M4 12h16m0 0-6-6m6 6-6 6" />
                        </svg>
                    </a>
                </div>
                <div class="panel__body">
                    <ul class="evlist">
                        @if (Model.LiveEventsData.Any())
                        {
                            int index = 1;
                            foreach (var ev in Model.LiveEventsData)
                            {
                                <li class="evlist__item">
                                    <span class="numbadge numbadge--live" aria-hidden="true">@index</span>
                                    <span class="evlist__body">
                                        <a class="evlist__name" asp-page="/Events/Details" asp-route-id="@ev.EventId">@ev.EventName</a>
                                        <span class="evlist__date">@ev.EventDate &middot; @ev.Location</span>
                                    </span>
                                    <span class="badge badge--live">Live</span>
                                </li>
                                index++;
                            }
                        }
                        else
                        {
                            <li class="evlist__item">
                                <span class="evlist__body">
                                    <span class="evlist__name">No live events currently active</span>
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        </div>

    </div>
</main>