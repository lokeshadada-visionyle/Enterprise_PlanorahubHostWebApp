                <div class="form__field">
                    <label class="field__label" for="nu-email">
                        Work email<span class="field__required" aria-hidden="true">*</span>
                        <span class="u-visually-hidden">(required)</span>
                    </label>
                    <input class="field__input" id="nu-email" name="nu-email" type="email"
                           placeholder="amara@company.com" required>
                </div>
            </div>

            <fieldset class="fieldset u-mt-5">
                <legend class="fieldset__legend">Role &mdash; one per user</legend>
                <div class="radios radios--2">
                    <label class="radio">
                        <input type="radio" name="nu-role" value="admin">
                        <span class="radio__body">
                            <span class="radio__title">Admin</span>
                            <span class="radio__text">Owns the account &mdash; billing, users and every event</span>
                        </span>
                    </label>
                    <label class="radio">
                        <input type="radio" name="nu-role" value="manager" checked>
                        <span class="radio__body">
                            <span class="radio__title">Event Manager</span>
                            <span class="radio__text">Builds and runs events, but never touches billing or users</span>
                        </span>
                    </label>
                    <label class="radio">
                        <input type="radio" name="nu-role" value="finance">
                        <span class="radio__body">
                            <span class="radio__title">Finance</span>
                            <span class="radio__text">Sees revenue, payouts, invoices and plan usage</span>
                        </span>
                    </label>
                    <label class="radio">
                        <input type="radio" name="nu-role" value="viewer">
                        <span class="radio__body">
                            <span class="radio__title">Viewer</span>
                            <span class="radio__text">Can look at events and reports, and change nothing</span>
                        </span>
                    </label>
                </div>
            </fieldset>

            <div class="optin u-mt-5">
                <input class="optin__box" id="nu-invite" name="nu-invite" type="checkbox" checked>
                <label for="nu-invite">
                    <span class="optin__title">Email them a sign-in invitation now</span>
                    <span class="optin__hint">
                        They set their own password &mdash; you never see or hold it
                    </span>
                </label>
            </div>
        </form>

        <div class="modal__foot">
            <button class="btn btn--outline" type="button" data-modal-close>Cancel</button>
            <button class="btn btn--primary" type="submit" form="adduser-form">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add user
            </button>
        </div>
    </div>
</div>