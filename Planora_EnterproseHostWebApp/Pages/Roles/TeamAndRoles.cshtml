@page
@model Planora_EnterproseHostWebApp.Pages.Roles.TeamAndRollsModel
@{
    Layout = "_Layout";
    ViewData["PageName"] = "Team &amp; Roles";
    ViewData["PageDesc"] = "5 users";
}

<main class="shell__main" data-page-roles="admin">

    <div class="page__head">
        <div>
            <h1 class="page__title">Team &amp; Roles</h1>
            <p class="page__subtitle">
                5 users &middot; 4 predefined roles &middot; one role per user
            </p>
        </div>
        <button class="btn btn--primary" type="button" data-modal-open="adduser-modal"
                data-role-only="admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add user
        </button>
    </div>

    <section class="orgcard">
        <span class="tile tile--lg tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" /></svg></span>
        <div class="orgcard__body">
            <p class="orgcard__kicker">One enterprise account</p>
            <h2 class="orgcard__name">Acme Global Enterprises</h2>
            <p class="orgcard__text">
                Every event, user, guest list and payout on this account belongs to this
                organisation. Users sign in with their own credentials and can all work at the
                same time &mdash; there is no single-session limit.
            </p>
        </div>
        <dl class="orgcard__stats">
            <div>
                <dt>Users</dt>
                <dd>5 of 50 seats</dd>
            </div>
            <div>
                <dt>Signed in now</dt>
                <dd>2 users</dd>
            </div>
            <div>
                <dt>Events owned</dt>
                <dd>8</dd>
            </div>
        </dl>
    </section>

    <section class="grid grid--4 u-mt-6" aria-label="Roles in this organisation">
        <article class="rolecard">
            <div class="rolecard__top">
                <span class="badge badge--nodot badge--role badge--owner">Admin</span>
                <span class="rolecard__count">1</span>
            </div>
            <p class="rolecard__headline">Full access</p>
            <p class="rolecard__perms">Owns the account &mdash; billing, users and every event</p>
        </article>
        <article class="rolecard">
            <div class="rolecard__top">
                <span class="badge badge--nodot badge--role badge--editor">Event Manager</span>
                <span class="rolecard__count">2</span>
            </div>
            <p class="rolecard__headline">Create &amp; manage events</p>
            <p class="rolecard__perms">Builds and runs events, but never touches billing or users</p>
        </article>
        <article class="rolecard">
            <div class="rolecard__top">
                <span class="badge badge--nodot badge--role badge--finance">Finance</span>
                <span class="rolecard__count">1</span>
            </div>
            <p class="rolecard__headline">Payments &amp; reports</p>
            <p class="rolecard__perms">Sees revenue, payouts, invoices and plan usage</p>
        </article>
        <article class="rolecard">
            <div class="rolecard__top">
                <span class="badge badge--nodot badge--role badge--scanner">Viewer</span>
                <span class="rolecard__count">1</span>
            </div>
            <p class="rolecard__headline">Read-only</p>
            <p class="rolecard__perms">Can look at events and reports, and change nothing</p>
        </article>
    </section>

    <section class="panel u-mt-6" aria-labelledby="asrole-title">
        <div class="panel__head panel__head--plain">
            <div>
                <h2 class="panel__title" id="asrole-title">See the app as a role</h2>
                <p class="panel__meta">
                    Switch role to check what that user can reach. The sidebar and every gated
                    action update straight away &mdash; this is exactly how permissions are
                    applied across the app.
                </p>
            </div>
            <span class="pill pill--brand">Viewing as <b data-role-label>Admin</b></span>
        </div>
        <div class="panel__body">
            <div class="roleswitch">
                <button class="roleswitch__opt" type="button"
                        aria-pressed="true" data-role-view="admin">
                    <span class="roleswitch__name">Admin</span>
                    <span class="roleswitch__text">Full access</span>
                </button>
                <button class="roleswitch__opt" type="button"
                        aria-pressed="false" data-role-view="manager">
                    <span class="roleswitch__name">Event Manager</span>
                    <span class="roleswitch__text">Create &amp; manage events</span>
                </button>
                <button class="roleswitch__opt" type="button"
                        aria-pressed="false" data-role-view="finance">
                    <span class="roleswitch__name">Finance</span>
                    <span class="roleswitch__text">Payments &amp; reports</span>
                </button>
                <button class="roleswitch__opt" type="button"
                        aria-pressed="false" data-role-view="viewer">
                    <span class="roleswitch__name">Viewer</span>
                    <span class="roleswitch__text">Read-only</span>
                </button>
            </div>
            <p class="notice notice--info notice--flat u-mt-5">
                <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                Roles are predefined in this version and a user holds exactly one. Anything a
                role should not see carries a single attribute, so hiding a menu or a button
                needs no extra wiring.
            </p>
        </div>
    </section>

