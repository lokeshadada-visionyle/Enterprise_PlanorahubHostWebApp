@page
@using System.Linq
@using Planora_EnterproseHostWebApp.Models
@model Planora_EnterproseHostWebApp.Pages.Events.EventHub.EventHubSeatingModel
@{
    Layout = "_Layout";
    Layout = "_EventHubLayout";
    ViewData["PageName"] = "Event Hub";
    ViewData["PageDesc"] = "Tech Summit Africa 2025 &middot; Live";

}

<div data-view-panel="seating" data-role-only="admin manager viewer">
    @if (!string.IsNullOrEmpty(Model.ApiError))
    {
        <div class="notice notice--error u-mb-4">
            <p>@Model.ApiError</p>
        </div>
    }
    <div class="hubhead">
        <div class="hubhead__body">
            <h2 class="hubhead__title">Seating by Ticket Type</h2>
            <p class="hubhead__text">
                <span data-scope-label>Day 1</span> &middot; each tier shows the price it
                sells for and the layout it was configured with &mdash; select a seat to
                reassign, release or check in
            </p>
        </div>
        <div class="hubhead__actions">
            <button class="btn btn--outline btn--sm" type="button" data-action="Seat map exported as a printable sheet">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export map
            </button>
            <button class="btn btn--outline btn--sm" type="button" data-action="Seat hold mode on &mdash; selected seats are held, not sold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg> Hold seats
            </button>
            <button class="btn btn--primary btn--sm" type="button" data-action="Check-in mode on &mdash; a tap now checks the guest in">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M7 12h10" /></svg> Check-in mode
            </button>
        </div>
    </div>

    <p class="capbar" data-capbar="Seating Layout">
        <span class="capbar__figures">
            <span class="capbar__figure">
                <b data-cap-total>@Model.seatingDataResp.TotalSeats</b>
                <span>Seats configured</span>
            </span>
            <span class="capbar__figure">
                <b>@Model.seatingDataResp.SeatsSold</b>
                <span>Taken</span>
            </span>
            <span class="capbar__figure capbar__figure--tight">
                <b data-cap-remaining>@Model.seatingDataResp.SeatsLeft</b>
                <span>Left</span>
            </span>
        </span>
        <span class="capbar__body">
            Filling up. Adding guests keeps the layout you already configured and
            tells you the charge before anything is committed.
        </span>
        <span class="capbar__acts">
            <a class="btn btn--quiet btn--sm" href="capacity-flow.html">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg> How this works
            </a>
            <button class="btn btn--primary btn--sm" type="button"
                    data-modal-open="addcap-modal" data-cap-from="Seating Layout" data-role-only="admin manager">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add guests
            </button>
        </span>
    </p>

    <section class="grid grid--4" aria-label="Seating by ticket type">
        @if (Model.seatingDataResp.TicketTypes != null && Model.seatingDataResp.TicketTypes.Any())
        {
            foreach (var ticket in Model.seatingDataResp.TicketTypes)
            {
                var percentage = ticket.TotalSeats > 0
                    ? Math.Round((double)ticket.SeatsSold / ticket.TotalSeats * 100)
                    : 0;

                <article class="tiercard" data-tiercard="@ticket.TypeName.ToLower()">
                    <div class="tiercard__top">
                        <span class="tiercard__name">@ticket.TypeName</span>
                        <span class="tiercard__price">&#8358;@ticket.Price</span>
                    </div>
                    <p class="tiercard__kind">@ticket.LayoutType</p>
                    <p class="tiercard__where">@ticket.HallName</p>

                    @if (ticket.TotalSeats > 0)
                    {
                        <span class="meter">
                            <span class="meter__fill meter__fill--live" style="width: @percentage%;"></span>
                        </span>
                        <p class="tiercard__split">
                            <span>@ticket.SeatsSold of @ticket.TotalSeats seated</span>
                            <span>@ticket.HeldSeats held</span>
                        </p>
                        <button class="btn btn--quiet btn--sm" type="button" data-seatjump="@ticket.LayoutType.ToLower()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 3 3 5.5v15L9 18l6 3 6-2.5v-15L15 6 9 3zM9 3v15M15 6v15" /></svg> View layout
                        </button>
                    }
                    else
                    {
                        <p class="tiercard__note">
                            @ticket.SeatsSold sold &middot; no seat block configured, so no seat is issued
                        </p>
                    }
                </article>
            }
        }
        else
        {
            <p class="u-text-muted">No ticket tiers found for this event.</p>
        }
    </section>

    <div class="hubhead u-mt-6">
        <div class="hubhead__body">
            <h3 class="hubhead__title">Layouts</h3>
            <p class="hubhead__text">
                This event books the hall in rows and the gala in tables, so both are
                configured &mdash; switch between them
            </p>
        </div>
        <div class="hubhead__actions">
            <span class="segment" id="seatlayout" role="group"
                  aria-label="Choose a layout" data-pick-group>
                <button class="segment__opt" type="button" aria-pressed="true"
                        data-pick="rows">
                    Rows &amp; seats
                </button>
                <button class="segment__opt" type="button" aria-pressed="false"
                        data-pick="tables">
                    Tables &amp; chairs
                </button>
            </span>
        </div>
    </div>

    @{
        var seats = Model.seatingLayoutData.Seats ?? new List<SeatModel>();

        // The tier whose seats were actually loaded for this page view (OnGet
        // currently always requests ticketTypeId 1 — swap this lookup if that changes).
        var activeTicket = Model.seatingDataResp.TicketTypes?.FirstOrDefault(t => t.TotalSeats > 0);
        var tierName = activeTicket?.TypeName ?? "Seating";
        var tierPrice = activeTicket?.Price ?? "0";
        var isTableLayout = activeTicket != null
            && activeTicket.LayoutType != null
            && activeTicket.LayoutType.Contains("Table", StringComparison.OrdinalIgnoreCase);

        // SeatNo is expected as "<group>-<seatNumber>", e.g. "A-01" for a row seat
        // or "T9-1" for a table chair. Everything before the last "-" is the group.
        var seatGroups = seats
            .Select(s =>
            {
                var idx = s.SeatNo.LastIndexOf('-');
                var groupKey = idx > 0 ? s.SeatNo.Substring(0, idx) : s.SeatNo;
                var label = idx > 0 ? s.SeatNo.Substring(idx + 1) : s.SeatNo;
                return new { Seat = s, GroupKey = groupKey, Label = label };
            })
            .GroupBy(x => x.GroupKey)
            .OrderBy(g => g.Key)
            .ToList();

        Func<SeatModel, string> seatState = s =>
            s.IsCheckIn ? "checked" : s.IsReserved ? "reserved" : s.IsAvailable ? "available" : "taken";
    }

    <section class="panel" data-pick-panel="rows" data-pick-owner="seatlayout" hidden="@isTableLayout">
        <div class="panel__head panel__head--plain">
            <div>
                <h3 class="panel__title">@(activeTicket?.HallName ?? "Seating") &mdash; rows &amp; seats</h3>
                <p class="panel__meta">
                    @tierName &middot; &#8358;@tierPrice a seat &middot; @seatGroups.Count row(s)
                </p>
            </div>
        </div>
        <div class="panel__body">
            @if (isTableLayout)
            {
                <p class="u-text-muted">This ticket tier uses a tables layout &mdash; switch to &ldquo;Tables &amp; chairs&rdquo; to view it.</p>
            }
            else if (!seatGroups.Any())
            {
                <p class="u-text-muted">No seat map is configured for this tier yet.</p>
            }
            else
            {
                <div class="seatgrid">
                    <p class="seatgrid__stage">Stage</p>
                    @foreach (var row in seatGroups)
                    {
                        <div class="seatgrid__row">
                            <span class="seatgrid__rowhead">
                                <span class="seatgrid__letter" aria-hidden="true">@row.Key</span>
                                <span class="seatgrid__tier">@tierName &middot; &#8358;@tierPrice</span>
                            </span>
                            @foreach (var item in row.OrderBy(x => x.Label))
                            {
                                var state = seatState(item.Seat);
                                var stateClass = state == "available" ? "" : " seatbtn--" + state;
                                <button class="seatbtn@(stateClass)" type="button" aria-pressed="false"
                                        data-seat="@item.Seat.SeatNo" data-seat-id="@item.Seat.SeatId"
                                        data-seat-state="@state" data-seat-tier="@tierName"
                                        data-seat-price="@tierPrice">
                                    <span class="u-visually-hidden">
                                        Seat @item.Seat.SeatNo, @tierName, &#8358;@tierPrice, @state
                                    </span>@item.Label
                                </button>
                            }
                        </div>
                    }
                </div>

                <p class="seatlegend">
                    <span><span class="seatkey" aria-hidden="true"></span> Available</span>
                    <span><span class="seatkey seatkey--checked" aria-hidden="true"></span> Checked-in</span>
                    <span><span class="seatkey seatkey--taken" aria-hidden="true"></span> Taken</span>
                    <span><span class="seatkey seatkey--reserved" aria-hidden="true"></span> Reserved</span>
                </p>
            }
        </div>
    </section>

    <section class="panel" data-pick-panel="tables" data-pick-owner="seatlayout" hidden="@(!isTableLayout)">
        <div class="panel__head panel__head--plain">
            <div>
                <h3 class="panel__title">@(activeTicket?.HallName ?? "Seating") &mdash; tables &amp; chairs</h3>
                <p class="panel__meta">
                    @tierName &middot; &#8358;@tierPrice a seat &middot; @seatGroups.Count table(s)
                </p>
            </div>
        </div>
        <div class="panel__body">
            @if (!isTableLayout)
            {
                <p class="u-text-muted">This ticket tier uses a rows &amp; seats layout &mdash; switch to &ldquo;Rows &amp; seats&rdquo; to view it.</p>
            }
            else if (!seatGroups.Any())
            {
                <p class="u-text-muted">No seat map is configured for this tier yet.</p>
            }
            else
            {
                <div class="banquet">
                    @foreach (var table in seatGroups)
                    {
                        var chairs = table.OrderBy(x => x.Label).ToList();
                        var takenCount = chairs.Count(x => !x.Seat.IsAvailable);
                        var isFull = takenCount == chairs.Count;
                        <article class="tablecard@(isFull ? " is-full" : "")" data-table="@table.Key">
                            <p class="tablecard__head">
                                <span class="tablecard__name">@table.Key</span>
                                <span class="tablecard__count">@takenCount/@chairs.Count</span>
                            </p>
                            <div class="tablecard__chairs">
                                @foreach (var item in chairs)
                                {
                                    var state = seatState(item.Seat);
                                    var takenClass = state == "available" ? "" : " chairbtn--taken";
                                    <button class="chairbtn@(takenClass)" type="button" aria-pressed="false"
                                            data-seat="@item.Seat.SeatNo" data-seat-id="@item.Seat.SeatId"
                                            data-seat-state="@state" data-seat-tier="@tierName"
                                            data-seat-price="@tierPrice">
                                        <span class="u-visually-hidden">
                                            @table.Key chair @item.Label, @tierName, &#8358;@tierPrice, @state
                                        </span>@item.Label
                                    </button>
                                }
                            </div>
                            <p class="tablecard__note">@(chairs.Count - takenCount) free</p>
                        </article>
                    }
                </div>

                <p class="seatlegend">
                    <span><span class="seatkey" aria-hidden="true"></span> Free chair</span>
                    <span><span class="seatkey seatkey--checked" aria-hidden="true"></span> Taken</span>
                    <span>A full table is outlined &mdash; seat a late guest elsewhere</span>
                </p>
            }
        </div>
    </section>

    <p class="notice notice--info notice--flat u-mt-6">
        <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
        Only tiers with a seat block configured appear on a layout. A general-admission
        tier still sells and still checks in &mdash; it simply issues no seat number.
    </p>
</div>