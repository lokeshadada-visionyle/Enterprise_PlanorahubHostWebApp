           data-role-only="admin manager"
           asp-page="/Events/EventHub/EventHubPolls" asp-route-eventId="@eventId" asp-route-slotId="@slotId">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9.5" r="1.6" /><path d="M21 16l-5-5-9 9" /></svg> Polls
        </a>
        <a class="subtabs__tab @(IsActiveTab("/Broadcast") ? "active" : "")"
           role="tab" aria-selected="@(IsActiveTab("/Broadcast") ? "true" : "false")"
