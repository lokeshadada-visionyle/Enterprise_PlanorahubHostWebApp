            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9.5" r="1.6" /><path d="M21 16l-5-5-9 9" /></svg> Branding
        </a>
        <a class="subtabs__tab @(IsActiveTab("/Payout") ? "active" : "")"
           role="tab" aria-selected="@(IsActiveTab("/Payout") ? "true" : "false")"
           data-role-only="admin finance"
           asp-page="/Events/EventHub/EventHubPayout" asp-route-eventId="@eventId" asp-route-slotId="@slotId">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /></svg> Payout
        </a>
        <a class="subtabs__tab @(IsActiveTab("/Insights") ? "active" : "")"
