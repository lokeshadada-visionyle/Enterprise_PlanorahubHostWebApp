           asp-page="/Events/EventHub/EventHubSettings" asp-route-eventId="@eventId" asp-route-slotId="@slotId">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2 2 2 0 1 1-4 0 1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 15a2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.4-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 4a2 2 0 1 1 4 0 1.7 1.7 0 0 0 2.9 1.4l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 11a2 2 0 1 1 0 4z" /></svg> Settings
        </a>
    </nav>

    <div class="scopebar" data-scope-group id="scopeBar">
        <div class="scopebar__row" role="tablist" aria-label="Event day">
            <span class="scopebar__label">Date</span>
            @for (int i = 0; i < eventDates.Count; i++)
            {
                var day = eventDates[i];
                var dayKey = "day" + day.EventDateId;
                var firstSlotOfDay = day.Slots?.FirstOrDefault();
                <button class="scopetab" type="button" role="tab"
                        aria-selected="@(dayKey == currentDayKey ? "true" : "false")"
                        data-day-scope="@dayKey"
                        data-day-first-slot="@(firstSlotOfDay?.SlotId ?? 0)"
                        data-scope-name="@day.SessionName">
                    @day.SessionName
                    <span class="scopetab__date">@day.Date</span>
                </button>
            }
            <span class="scopebar__meta">
                @eventDates.Count days &middot; @totalSlots slots
            </span>
        </div>

        @for (int i = 0; i < eventDates.Count; i++)
        {
            var day = eventDates[i];
            var dayKey = "day" + day.EventDateId;
            <div class="scopebar__row" data-slot-scope-for="@dayKey" hidden="@(dayKey != currentDayKey)">
                <span class="scopebar__label">Slot</span>
                @for (int j = 0; j < day.Slots.Count; j++)
                {
                    var slot = day.Slots[j];
                    <button class="scopetab scopetab--chip" type="button"
                            aria-pressed="@(slot.SlotId == slotId ? "true" : "false")"
                            data-slot-scope="slot@(slot.SlotId)" data-scope-name="@slot.SessionName">
                        @slot.SessionName <span class="scopetab__date">@slot.SessionTIme</span>
                    </button>
                }
                <span class="scopebar__meta">
                    @day.Slots.Count slot@(day.Slots.Count == 1 ? "" : "s") on this day
                </span>
            </div>
        }

        @if (eventDates.Count == 0 && scopeData.Status != 1)
        {
            <p class="scopebar__error">@(scopeData.Message ?? "Unable to load dates and slots.")</p>
        }
    </div>

    <div class="section">
        @RenderBody()
    </div>
</main>

<script>
    (function() {
        'use strict';

        var main = document.querySelector('[data-eventhub]');
        if (!main) return;

        var EVENT_ID = main.getAttribute('data-event-id');

        // Navigates to the SAME page (whichever panel is currently open),
        // just with an updated slotId — this keeps the URL as the single
        // source of truth, so the selection survives switching panels.
        function navigateToSlot(newSlotId) {
            var url = new URL(window.location.href);
            url.searchParams.set('eventId', EVENT_ID);
            url.searchParams.set('slotId', newSlotId);
            window.location.href = url.toString();
        }

        document.addEventListener('click', function(event) {
            var dayBtn = event.target.closest('[data-day-scope]');
            if (dayBtn) {
                var firstSlotId = dayBtn.getAttribute('data-day-first-slot');
                if (firstSlotId && firstSlotId !== '0') {
                    navigateToSlot(firstSlotId);
                }
                return;
            }

            var slotBtn = event.target.closest('[data-slot-scope]');
            if (slotBtn) {
                var newSlotId = slotBtn.getAttribute('data-slot-scope').replace('slot', '');
                navigateToSlot(newSlotId);
            }
        });
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)