@using Planora_EnterproseHostWebApp.Models
@{
    Layout = "_Layout";

    var eventId = ViewData["EventId"] as int? ?? 0;
    var slotId = ViewData["SlotId"] as int? ?? 0;
    var userId = Context.Session.GetInt32("UserId") ?? 0;

    ViewData["PageName"] = ViewData["PageName"] as string ?? "Event Hub";
    ViewData["PageDesc"] = ViewData["PageDesc"] as string ?? "Tech Summit Africa 2025 &middot; Live";

    var activePanel = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    Func<string, bool> IsActiveTab = pagePath =>
        activePanel.EndsWith(pagePath, StringComparison.OrdinalIgnoreCase);

    var helper = new CommonHelper();
    EventHubDatesAndSlotsResp scopeData;
    try
    {
        scopeData = helper.GetEventHubDateAndSlot(userId, eventId);
    }
    catch (Exception ex)
    {
        scopeData = new EventHubDatesAndSlotsResp { Status = 0, Message = ex.Message };
    }

    var eventDates = scopeData?.EventDates ?? new List<EventHubDates>();
    var totalSlots = eventDates.Sum(d => d.Slots?.Count ?? 0);

    var currentDay = eventDates.FirstOrDefault(d => d.Slots != null && d.Slots.Any(s => s.SlotId == slotId))
                      ?? eventDates.FirstOrDefault();
    var currentDayKey = currentDay != null ? "day" + currentDay.EventDateId : null;
}
<main class="shell__main shell__main--flush" data-page-roles="admin manager viewer finance"
      data-eventhub data-event-id="@eventId" data-slot-id="@slotId">

    <section class="hero" aria-labelledby="hub-title">
        <div class="hero__body">
            <p class="hero__flag">
                <span class="live__pulse" aria-hidden="true"></span> Live
            </p>
            <h1 class="hero__title" id="hub-title">Event Hub &mdash; Tech Summit 2025</h1>
            <p class="hero__meta">Aug 15&ndash;17, 2025 &middot; Eko Hotel, Lagos</p>
        </div>
        <div class="hero__stats">
            <p class="hero__figure">
                <span class="hero__value" data-count="checkedin">847</span>
                <span class="hero__caption">Checked In</span>
            </p>
            <p class="hero__figure">
                <span class="hero__value" data-count="remaining">153</span>
                <span class="hero__caption">Remaining</span>
            </p>
            <p class="hero__figure">
                <span class="hero__value">&#8358;127M</span>
                <span class="hero__caption">Revenue</span>
            </p>
        </div>
    </section>

