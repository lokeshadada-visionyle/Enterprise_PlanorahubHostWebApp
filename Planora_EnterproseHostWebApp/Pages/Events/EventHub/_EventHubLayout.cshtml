            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg> Sales
        </a>
        <a class="subtabs__tab @(IsActiveTab("/Extras") ? "active" : "")"
           role="tab" aria-selected="@(IsActiveTab("/Extras") ? "true" : "false")"
           data-role-only="admin finance viewer"
           asp-page="/Events/EventHub/EventHubPromosAddons" asp-route-eventId="@eventId" asp-route-slotId="@slotId">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /></svg> Add-ons &amp; Promo
        </a>
        <a class="subtabs__tab @(IsActiveTab("/Brand") ? "active" : "")"
