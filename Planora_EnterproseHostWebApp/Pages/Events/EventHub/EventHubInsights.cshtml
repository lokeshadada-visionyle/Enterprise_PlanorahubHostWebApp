@page
@model Planora_EnterproseHostWebApp.Pages.Events.EventHub.EventHubInsightsModel
@{
    Layout = "_Layout";
    Layout = "_EventHubLayout";
    ViewData["PageName"] = "Event Hub";
    ViewData["PageDesc"] = "Tech Summit Africa 2025 &middot; Live";
}

<div data-view-panel="insights" hidden>
    <div class="hubhead">
        <div class="hubhead__body">
            <h2 class="hubhead__title">Insights</h2>
            <p class="hubhead__text">
                <span data-scope-label>Day 1</span> &middot; per day and slot, updated live
            </p>
        </div>
        <div class="hubhead__actions">
            <button class="btn btn--outline btn--sm" type="button"
                    data-action="Insights report downloaded">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Download report
            </button>
            <button class="btn btn--outline btn--sm" type="button"
                    data-action="Insights report emailed to your team">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3z" /><path d="M10 13 21 3" /></svg> Email to team
            </button>
        </div>
    </div>

    <section class="panel">
        <div class="insight" data-scope="all">
            <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg></span>
            <span class="insight__body">
                <span class="insight__name">Attendance</span>
                <span class="insight__meta">Checked in vs registered</span>
            </span>
            <span class="insight__figure">
                <span class="insight__value">847 / 1,000</span>
                <span class="insight__meta">84.7%</span>
            </span>
        </div>
        <div class="insight" data-scope="day1:slot1">
            <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg></span>
            <span class="insight__body">
                <span class="insight__name">Peak arrival</span>
                <span class="insight__meta">Busiest 15-minute window</span>
            </span>
            <span class="insight__figure">
                <span class="insight__value">09:15</span>
                <span class="insight__meta">218 scans</span>
            </span>
        </div>
        <div class="insight" data-scope="day1:slot1">
            <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg></span>
            <span class="insight__body">
                <span class="insight__name">Session rating</span>
                <span class="insight__meta">Average of 4 live polls</span>
            </span>
            <span class="insight__figure">
                <span class="insight__value">4.6 / 5</span>
                <span class="insight__meta">738 votes</span>
            </span>
        </div>
        <div class="insight" data-scope="day1:slot2">
            <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg></span>
            <span class="insight__body">
                <span class="insight__name">Meals served</span>
                <span class="insight__meta">Against 1 base + extras</span>
            </span>
            <span class="insight__figure">
                <span class="insight__value">1,204</span>
                <span class="insight__meta">92% of allowance</span>
            </span>
        </div>
        <div class="insight" data-scope="day2:slot1">
            <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg></span>
            <span class="insight__body">
                <span class="insight__name">No-shows</span>
                <span class="insight__meta">Paid but never scanned</span>
            </span>
            <span class="insight__figure">
                <span class="insight__value">153</span>
                <span class="insight__meta">15.3%</span>
            </span>
        </div>
        <div class="insight" data-scope="all">
            <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg></span>
            <span class="insight__body">
                <span class="insight__name">Add-on take-up</span>
                <span class="insight__meta">Tote bags &amp; workshop passes</span>
            </span>
            <span class="insight__figure">
                <span class="insight__value">210</span>
                <span class="insight__meta">&#8358;855,000</span>
            </span>
        </div>
    </section>

    <!-- Three reports, one at a time. Stacked they were four screens of
               scrolling to reach the payment summary. -->
    <nav class="subtabs subtabs--inner u-mt-6" role="tablist"
         aria-label="Insight reports" data-pick-group id="insighttabs">
        <button class="subtabs__tab" type="button" role="tab" aria-selected="true"
                aria-pressed="true" data-pick="polls">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg> Polls
        </button>
        <button class="subtabs__tab" type="button" role="tab" aria-selected="false"
                aria-pressed="false" data-pick="food">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8zM17 9h1.5a2.5 2.5 0 0 1 0 5H17" /></svg> Food Orders
        </button>
        <button class="subtabs__tab" type="button" role="tab" aria-selected="false"
                aria-pressed="false" data-pick="pay">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /></svg> Payments
        </button>
    </nav>

    <div data-pick-panel="polls" data-pick-owner="insighttabs">
        <section class="panel u-mt-6" aria-labelledby="pollreport-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h3 class="panel__title" id="pollreport-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 20V10M12 20V4M19 20v-7" /></svg> Polls Summary
                    </h3>
                    <p class="panel__meta">
                        Every poll run at this event, with its winning answer
                    </p>
                </div>
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Polls report downloaded as CSV">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export polls
                </button>
            </div>
            <div class="panel__body">
                <div class="reportstats">
                    <span class="reportstat">
                        <span class="reportstat__value">4</span>
                        <span class="reportstat__label">Polls run</span>
                    </span>
                    <span class="reportstat">
                        <span class="reportstat__value">2,632</span>
                        <span class="reportstat__label">Total responses</span>
                    </span>
                    <span class="reportstat">
                        <span class="reportstat__value">78%</span>
                        <span class="reportstat__label">Of checked-in guests voted</span>
                    </span>
                    <span class="reportstat">
                        <span class="reportstat__value">4.6<span class="reportstat__unit">/5</span></span>
                        <span class="reportstat__label">Average rating</span>
                    </span>
                </div>

                <div class="tablewrap u-mt-5">
                    <table class="table table--narrow">
                        <caption class="u-visually-hidden">
                            Polls with responses, winning answer and status
                        </caption>
                        <thead>
                            <tr>
                                <th scope="col">Question</th>
                                <th scope="col">Responses</th>
                                <th scope="col">Top answer</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Which session topic was most valuable?</th>
                                <td>738</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill" data-fill="42"></span>
                                    </span>
                                    <span class="reportbar__label">AI &amp; Machine Learning &middot; 42%</span>
                                </td>
                                <td><span class="badge badge--draft">Closed</span></td>
                            </tr>
                            <tr>
                                <th scope="row">How did you hear about Tech Summit?</th>
                                <td>694</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill" data-fill="52"></span>
                                    </span>
                                    <span class="reportbar__label">Social media &middot; 52%</span>
                                </td>
                                <td><span class="badge badge--draft">Closed</span></td>
                            </tr>
                            <tr>
                                <th scope="row">Rate the venue and facilities</th>
                                <td>612</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill" data-fill="61"></span>
                                    </span>
                                    <span class="reportbar__label">5 stars &middot; 61%</span>
                                </td>
                                <td><span class="badge badge--draft">Closed</span></td>
                            </tr>
                            <tr>
                                <th scope="row">Would you attend next year?</th>
                                <td>588</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill" data-fill="74"></span>
                                    </span>
                                    <span class="reportbar__label">Definitely &middot; 74%</span>
                                </td>
                                <td><span class="badge badge--live">Live</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <div data-pick-panel="food" data-pick-owner="insighttabs" hidden>
        <section class="panel u-mt-6" aria-labelledby="foodreport-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h3 class="panel__title" id="foodreport-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8zM17 9h1.5a2.5 2.5 0 0 1 0 5H17" /></svg> Food Orders Summary
                    </h3>
                    <p class="panel__meta">
                        What was served, against the allowance you set
                    </p>
                </div>
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Food orders summary downloaded as CSV">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export food report
                </button>
            </div>
            <div class="panel__body">
                <div class="reportstats">
                    <span class="reportstat">
                        <span class="reportstat__value">1,204</span>
                        <span class="reportstat__label">Meals served</span>
                    </span>
                    <span class="reportstat">
                        <span class="reportstat__value">92%</span>
                        <span class="reportstat__label">Of allowance used</span>
                    </span>
                    <span class="reportstat">
                        <span class="reportstat__value">1.4</span>
                        <span class="reportstat__label">Average serves per guest</span>
                    </span>
                    <span class="reportstat">
                        <span class="reportstat__value">2</span>
                        <span class="reportstat__label">Items that ran out</span>
                    </span>
                </div>

                <div class="reportsplits u-mt-5">
                    <span class="reportsplit">
                        <span class="reportsplit__name">Day 1 &middot; Opening Day</span>
                        <span class="reportsplit__value">742 served</span>
                        <span class="reportsplit__meta">96% of allowance &middot; 2 items ran out</span>
                    </span>
                    <span class="reportsplit">
                        <span class="reportsplit__name">Day 2 &middot; Workshops</span>
                        <span class="reportsplit__value">462 served</span>
                        <span class="reportsplit__meta">87% of allowance &middot; No shortages</span>
                    </span>
                </div>

                <div class="tablewrap u-mt-5">
                    <table class="table table--narrow">
                        <caption class="u-visually-hidden">
                            Menu items with servings, share of orders and shortages
                        </caption>
                        <thead>
                            <tr>
                                <th scope="col">Item</th>
                                <th scope="col">Category</th>
                                <th scope="col">Served</th>
                                <th scope="col">Share of orders</th>
                                <th scope="col">Shortage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Jollof Rice</th>
                                <td>Rice &amp; Biryani</td>
                                <td>318</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill reportbar__fill--warm"
                                              data-fill="26"></span>
                                    </span>
                                    <span class="reportbar__label">26%</span>
                                </td>
                                <td>Ran out 13:40</td>
                            </tr>
                            <tr>
                                <th scope="row">Chicken Suya Skewers</th>
                                <td>Starters</td>
                                <td>287</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill reportbar__fill--warm"
                                              data-fill="24"></span>
                                    </span>
                                    <span class="reportbar__label">24%</span>
                                </td>
                                <td>&mdash;</td>
                            </tr>
                            <tr>
                                <th scope="row">Puff Puff</th>
                                <td>Snacks</td>
                                <td>196</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill reportbar__fill--warm"
                                              data-fill="16"></span>
                                    </span>
                                    <span class="reportbar__label">16%</span>
                                </td>
                                <td>&mdash;</td>
                            </tr>
                            <tr>
                                <th scope="row">Zobo Drink</th>
                                <td>Beverages</td>
                                <td>181</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill reportbar__fill--warm"
                                              data-fill="15"></span>
                                    </span>
                                    <span class="reportbar__label">15%</span>
                                </td>
                                <td>&mdash;</td>
                            </tr>
                            <tr>
                                <th scope="row">Coconut Rice</th>
                                <td>Rice &amp; Biryani</td>
                                <td>132</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill reportbar__fill--warm"
                                              data-fill="11"></span>
                                    </span>
                                    <span class="reportbar__label">11%</span>
                                </td>
                                <td>&mdash;</td>
                            </tr>
                            <tr>
                                <th scope="row">Moi Moi</th>
                                <td>Sides</td>
                                <td>90</td>
                                <td>
                                    <span class="reportbar">
                                        <span class="reportbar__fill reportbar__fill--warm"
                                              data-fill="8"></span>
                                    </span>
                                    <span class="reportbar__label">8%</span>
                                </td>
                                <td>Marked out of stock 14:05</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <p class="notice notice--warn notice--flat u-mt-5">
                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
                    Jollof Rice ran out 50 minutes before the window closed and Moi Moi was
                    marked out of stock. Both were the most-ordered items in their category
                    &mdash; worth raising the counts next time.
                </p>
            </div>
        </section>
    </div>

    <div data-pick-panel="pay" data-pick-owner="insighttabs" hidden>
        <section class="panel u-mt-6" aria-labelledby="payreport-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h3 class="panel__title" id="payreport-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /></svg> Payment Summary
                    </h3>
                    <p class="panel__meta">
                        Gross, refunds, commission and what is actually being paid out
                    </p>
                </div>
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Payment summary downloaded as PDF">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export payment summary
                </button>
            </div>
            <div class="panel__body">
                <div class="reportstats">
                    <span class="reportstat">
                        <span class="reportstat__value">&#8358;9.83M</span>
                        <span class="reportstat__label">Gross collected</span>
                    </span>
                    <span class="reportstat reportstat--warn">
                        <span class="reportstat__value">&minus;&#8358;450K</span>
                        <span class="reportstat__label">Refunded</span>
                    </span>
                    <span class="reportstat reportstat--warn">
                        <span class="reportstat__value">&minus;&#8358;187K</span>
                        <span class="reportstat__label">Commission at 2%</span>
                    </span>
                    <span class="reportstat reportstat--good">
                        <span class="reportstat__value">&#8358;9.19M</span>
                        <span class="reportstat__label">Net to your account</span>
                    </span>
                </div>

                <div class="tablewrap u-mt-5">
                    <table class="table table--narrow">
                        <caption class="u-visually-hidden">
                            Revenue by ticket tier, with refunds and net
                        </caption>
                        <thead>
                            <tr>
                                <th scope="col">Tier</th>
                                <th scope="col">Sold</th>
                                <th scope="col">Gross</th>
                                <th scope="col">Refunded</th>
                                <th scope="col">Net</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Early Bird</th>
                                <td>200</td>
                                <td>&#8358;1,000,000</td>
                                <td>&mdash;</td>
                                <td><b>&#8358;1,000,000</b></td>
                            </tr>
                            <tr>
                                <th scope="row">Standard</th>
                                <td>547</td>
                                <td>&#8358;5,470,000</td>
                                <td>&minus;&#8358;450,000</td>
                                <td><b>&#8358;5,020,000</b></td>
                            </tr>
                            <tr>
                                <th scope="row">VIP</th>
                                <td>100</td>
                                <td>&#8358;2,500,000</td>
                                <td>&mdash;</td>
                                <td><b>&#8358;2,500,000</b></td>
                            </tr>
                            <tr>
                                <th scope="row">Add-ons</th>
                                <td>210</td>
                                <td>&#8358;855,000</td>
                                <td>&mdash;</td>
                                <td><b>&#8358;855,000</b></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <p class="reportsub u-mt-5">How guests paid</p>
                <div class="reportsplits">
                    <span class="reportsplit">
                        <span class="reportsplit__name">Card</span>
                        <span class="reportsplit__value">&#8358;6,940,000</span>
                        <span class="reportsplit__meta">681 payments &middot; 76%</span>
                    </span>
                    <span class="reportsplit">
                        <span class="reportsplit__name">Bank transfer</span>
                        <span class="reportsplit__value">&#8358;2,180,000</span>
                        <span class="reportsplit__meta">142 payments &middot; 16%</span>
                    </span>
                    <span class="reportsplit">
                        <span class="reportsplit__name">USSD</span>
                        <span class="reportsplit__value">&#8358;520,000</span>
                        <span class="reportsplit__meta">48 payments &middot; 5%</span>
                    </span>
                    <span class="reportsplit">
                        <span class="reportsplit__name">Complimentary</span>
                        <span class="reportsplit__value">&#8358;0</span>
                        <span class="reportsplit__meta">22 payments &middot; 3%</span>
                    </span>
                </div>

                <div class="payoutstate u-mt-5">
                    <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12.5 9 17.5 20 6.5" /></svg></span>
                    <span class="payoutstate__body">
                        <span class="payoutstate__title">
                            &#8358;6.1M settled &middot; &#8358;3.09M in escrow
                        </span>
                        <span class="payoutstate__meta">
                            Escrow releases 3 working days after the event ends, to
                            First Bank &bull;&bull;&bull;&bull; 4471
                        </span>
                    </span>
                    <button class="btn btn--outline btn--sm" type="button"
                            data-action="Payout statement downloaded">
                        Statement
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>