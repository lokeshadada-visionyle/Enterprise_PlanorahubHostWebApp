                                <td class="u-right"><b data-badge-count>3</b></td>
                                <td class="u-muted"><span class="u-nowrap">10:12</span></td>
                                <td class="u-muted">Speaker Counter</td>
                                <td class="u-muted">Chika Eze</td>
                                <td>
                                    <div class="rowactions">
                                        <button class="iconbtn" type="button"
                                                data-modal-open="badgedetail-modal"
                                                data-badge-open="g3">
                                            <span class="u-visually-hidden">
                                                Badge details for Dr. Ngozi Eze
                                            </span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.8-6.5 10-6.5S22 12 22 12s-3.8 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
