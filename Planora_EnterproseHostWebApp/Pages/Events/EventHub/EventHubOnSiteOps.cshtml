                                            </span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 2" /></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr data-badge-row data-badge="g2"
                                data-badge-state="printed" data-badge-cat="delegate">
