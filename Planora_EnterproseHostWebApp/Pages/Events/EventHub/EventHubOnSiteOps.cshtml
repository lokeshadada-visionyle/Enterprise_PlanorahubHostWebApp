@page
@model Planora_EnterproseHostWebApp.Pages.Events.EventHub.EventHubOnSiteOpsModel
@{
    Layout = "_Layout";
    Layout = "_EventHubLayout";
    ViewData["PageName"] = "Event Hub";
    ViewData["PageDesc"] = "Tech Summit Africa 2025 &middot; Live";
}

<div data-view-panel="onsite" data-role-only="admin manager viewer" hidden>
    <div class="hubhead">
        <div class="hubhead__body">
            <h2 class="hubhead__title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M7 12h10" /></svg> On-Site Operations</h2>
            <p class="hubhead__text">
                Registration desk and badge printing. The Entry Staff app does the
                checking in and the printing &mdash; this configures it and watches it.
            </p>
        </div>
        <div class="hubhead__actions">
            <a class="btn btn--quiet btn--sm" href="badge-flow.html">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg> How badge printing works
            </a>
            <a class="btn btn--outline btn--sm" href="check-in.html">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9" cy="7.5" r="3.5" /><path d="M16.5 11.5l2 2 3.5-3.5" /></svg> Check-in desk
            </a>
        </div>
    </div>

    <nav class="subtabs subtabs--inner" role="tablist"
         aria-label="On-site operations" data-pick-group id="onsitetabs">
        <button class="subtabs__tab" type="button" role="tab" aria-selected="true"
                aria-pressed="true" data-pick="activity">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v3h6V3" /><path d="M9 12h6M9 16h4" /></svg> Badge Activity
        </button>
        <button class="subtabs__tab" type="button" role="tab" aria-selected="false"
                aria-pressed="false" data-pick="config" data-role-only="admin manager">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="7" rx="2" /><path d="M7 16h10v5H7z" /></svg> Badge Printing
        </button>
        <button class="subtabs__tab" type="button" role="tab" aria-selected="false"
                aria-pressed="false" data-pick="counters" data-role-only="admin manager">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9.5" cy="7.5" r="3.5" /><path d="M17 4.2a3.5 3.5 0 0 1 0 6.6M21 20v-1.5a4 4 0 0 0-3-3.8" /></svg> Counters
        </button>
    </nav>

    <div data-pick-panel="activity" data-pick-owner="onsitetabs">
        <div class="hubhead">
            <div class="hubhead__body">
                <h3 class="hubhead__title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v3h6V3" /><path d="M9 12h6M9 16h4" /></svg> Badge Activity</h3>
                <p class="hubhead__text">
                    Every checked-in guest and the state of their badge. Check-in time is
                    first, because a failed badge is still a guest who is inside.
                </p>
            </div>
            <div class="hubhead__actions">
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Badge activity exported as CSV">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export activity
                </button>
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Activity refreshed from the counters">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-3-6.2" /><path d="M20 4v5h-5" /></svg> Refresh
                </button>
            </div>
        </div>

        <section class="grid grid--6 u-mb-6" aria-label="Badge summary">
            <article class="metric metric--tight">
                <span class="tile tile--info" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9" cy="7.5" r="3.5" /><path d="M16.5 11.5l2 2 3.5-3.5" /></svg></span>
                <span>
                    <span class="metric__value" data-badge-kpi="checked-in">10</span>
                    <span class="metric__label">Checked in</span>
                    <span class="metric__meta">Every guest through a counter</span>
                </span>
            </article>
            <article class="metric metric--tight">
                <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v3h6V3" /><path d="M9 12h6M9 16h4" /></svg></span>
                <span>
                    <span class="metric__value" data-badge-kpi="badges-required">10</span>
                    <span class="metric__label">Badges required</span>
                    <span class="metric__meta">Printing is on for this event</span>
                </span>
            </article>
            <article class="metric metric--tight">
                <span class="tile tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="7" rx="2" /><path d="M7 16h10v5H7z" /></svg></span>
                <span>
                    <span class="metric__value" data-badge-kpi="printed">6</span>
                    <span class="metric__label">Printed</span>
                    <span class="metric__meta">6 of 10 checked-in guests</span>
                </span>
            </article>
            <article class="metric metric--tight">
                <span class="tile tile--accent" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 2" /></svg></span>
                <span>
                    <span class="metric__value" data-badge-kpi="pending">2</span>
                    <span class="metric__label">Pending</span>
                    <span class="metric__meta">Checked in, not printed yet</span>
                </span>
            </article>
            <article class="metric metric--tight">
                <span class="tile tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg></span>
                <span>
                    <span class="metric__value" data-badge-kpi="failed">2</span>
                    <span class="metric__label">Failed</span>
                    <span class="metric__meta">Guests are inside &mdash; retry at the counter</span>
                </span>
            </article>
            <article class="metric metric--tight">
                <span class="tile tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-3-6.2" /><path d="M20 4v5h-5" /></svg></span>
                <span>
                    <span class="metric__value" data-badge-kpi="reprints">3</span>
                    <span class="metric__label">Reprints</span>
                    <span class="metric__meta">Extra prints beyond the first</span>
                </span>
            </article>
        </section>


        <section class="panel" data-badge-live>
            <div class="panel__head panel__head--plain">
                <div>
                    <h4 class="panel__title">Guests and badges</h4>
                    <p class="panel__meta">
                        Updated as each counter reports in &mdash; the web app watches, the
                        Entry Staff app prints
                    </p>
                </div>
            </div>
            <div class="panel__body">
                <div class="toolbar">
                    <div class="searchbox">
                        <svg class="searchbox__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                        <label class="u-visually-hidden" for="badge-search">
                            Search by guest name, guest ID, ticket number or email
                        </label>
                        <input class="searchbox__input" id="badge-search" name="badge-search"
                               type="search"
                               placeholder="Guest name, guest ID, ticket number or email"
                               data-badge-search>
                    </div>
                    <span class="segment" id="badgefilter" role="group"
                          aria-label="Filter by badge status" data-pick-group>
                        <button class="segment__opt" type="button"
                                aria-pressed="true" data-pick="all"
                                data-badge-filter="">
                            All
                        </button>
                        <button class="segment__opt" type="button"
                                aria-pressed="false" data-pick="printed"
                                data-badge-filter="printed">
                            Printed
                        </button>
                        <button class="segment__opt" type="button"
                                aria-pressed="false" data-pick="pending"
                                data-badge-filter="pending">
                            Pending
                        </button>
                        <button class="segment__opt" type="button"
                                aria-pressed="false" data-pick="failed"
                                data-badge-filter="failed">
                            Failed
                        </button>
                        <button class="segment__opt" type="button"
                                aria-pressed="false" data-pick="reprint"
                                data-badge-filter="reprint">
                            Reprinted
                        </button>
                    </span>
                </div>

                <p class="bulkbar u-mt-5">
                    <span>
                        <b data-badge-shown>10 guests</b> shown &middot;
                        <span data-badge-filterlabel>all badge statuses</span>
                    </span>
                    <span class="bulkbar__actions">
                        <span class="badge badge--nodot badge--out">
                            <b data-badge-failedcount>2</b> need a retry
                        </span>
                    </span>
                </p>

