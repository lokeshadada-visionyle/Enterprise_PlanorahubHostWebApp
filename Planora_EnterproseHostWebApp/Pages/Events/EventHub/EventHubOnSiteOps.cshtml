                                <td><span class="badge badge--live" data-badge-badge>Printed</span></td>
                                <td class="u-right"><b data-badge-count>1</b></td>
                                <td class="u-muted"><span class="u-nowrap">09:41</span></td>
                                <td class="u-muted">VIP Counter</td>
                                <td class="u-muted">Seyi Lawal</td>
                                <td>
                                    <div class="rowactions">
