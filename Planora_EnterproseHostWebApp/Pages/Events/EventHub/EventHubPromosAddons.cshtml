@page
@model Planora_EnterproseHostWebApp.Pages.Events.EventHub.EventHubPromosAddonsModel
@{
    Layout = "_Layout";
    Layout = "_EventHubLayout";
    ViewData["PageName"] = "Event Hub";
    ViewData["PageDesc"] = "Tech Summit Africa 2025 &middot; Live";
}

<div data-view-panel="extras" data-role-only="admin finance viewer" hidden>

    <section class="lockcard" data-extras-locked hidden>
        <span class="tile tile--lg tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 20 6v6c0 4.8-3.3 9-8 10-4.7-1-8-5.2-8-10V6l8-3z" /></svg></span>
        <div class="lockcard__body">
            <h2 class="lockcard__title">
                No add-ons or promo codes on this event
            </h2>
            <p class="lockcard__text">
                Nothing was configured in <b>Add-ons &amp; Coupons</b> during creation, so
                there is nothing to sell alongside a ticket and no code to track.
            </p>
            <p class="lockcard__actions">
                <a class="btn btn--outline btn--sm" href="create-event/addons-coupons.html">
                    Configure add-ons &amp; coupons
                </a>
            </p>
        </div>
    </section>

    <div data-extras-live>
        <div class="hubhead">
            <div class="hubhead__body">
                <h2 class="hubhead__title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /></svg> Add-ons &amp; Promo Codes</h2>
                <p class="hubhead__text">
                    What sells alongside a ticket, by date and slot &mdash; and what your
                    codes are actually doing
                </p>
            </div>
            <div class="hubhead__actions">
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Add-on and promo report exported as CSV">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export report
                </button>
                <button class="btn btn--primary btn--sm" type="button"
                        data-addon-new data-modal-open="addonedit-modal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add an extra
                </button>
            </div>
        </div>

        <section class="grid grid--4 u-mb-6" aria-label="Add-on and promo totals">
            <article class="metric">
                <span class="tile tile--lg tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /></svg></span>
                <span>
                    <span class="metric__value">489</span>
                    <span class="metric__label">Add-ons sold</span>
                    <span class="metric__meta">Across 6 configured extras</span>
                </span>
            </article>
            <article class="metric">
                <span class="tile tile--lg tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v18M16.5 7.5A3.5 3.5 0 0 0 13 5h-2a3 3 0 0 0 0 6h2.5a3 3 0 0 1 0 6H11a3.5 3.5 0 0 1-3.5-2.5" /></svg></span>
                <span>
                    <span class="metric__value">&#8358;3,381,500</span>
                    <span class="metric__label">Add-on revenue</span>
                    <span class="metric__meta">On top of ticket sales</span>
                </span>
            </article>
            <article class="metric">
                <span class="tile tile--lg tile--info" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z" /><path d="M9 9v6" /></svg></span>
                <span>
                    <span class="metric__value">224</span>
                    <span class="metric__label">Promo codes used</span>
                    <span class="metric__meta">4 codes configured</span>
                </span>
            </article>
            <article class="metric">
                <span class="tile tile--lg tile--accent" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 5 5 19" /><circle cx="7.5" cy="7.5" r="2.5" /><circle cx="16.5" cy="16.5" r="2.5" /></svg></span>
                <span>
                    <span class="metric__value">&minus;&#8358;4,690,000</span>
                    <span class="metric__label">Discount given</span>
                    <span class="metric__meta">What the codes cost you</span>
                </span>
            </article>
        </section>

        <!-- ============ Add-ons, scoped by date and slot ============ -->
