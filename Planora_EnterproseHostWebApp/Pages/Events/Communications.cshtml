@page
@model Planora_EnterproseHostWebApp.Pages.Events.CommunicationsModel
@{
    Layout = "_Layout";
    ViewData["PageName"] = "Communications";
    ViewData["PageDesc"] = "Messages &amp; broadcasts";
}

<main class="shell__main" data-page-roles="admin manager">

    <div class="page__head">
        <div>
            <h1 class="page__title">Communications</h1>
            <p class="page__subtitle">Messages, polls, and announcements</p>
        </div>
        <div class="page__actions">
            <button class="btn btn--outline" type="button" data-modal-open="poll-modal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9.5" r="1.6" /><path d="M21 16l-5-5-9 9" /></svg> New Poll
            </button>
            <button class="btn btn--primary" type="button" data-modal-open="broadcast-modal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3z" /><path d="M10 13 21 3" /></svg> Compose
            </button>
        </div>
    </div>

    <section class="panel u-mb-6" aria-label="WhatsApp credit balance">
        <div class="credits">
            <span class="tile tile--lg tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8z" /></svg></span>
            <span class="credits__body">
                <span class="credits__label">WhatsApp Credits</span>
                <span class="credits__value">1,240</span>
            </span>
            <button class="btn btn--outline btn--sm" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Buy</button>
        </div>
    </section>

    <div class="tabs u-mb-6" role="tablist" aria-label="Communication types" data-viewswitch>
        <button class="tabs__tab" type="button" role="tab" aria-selected="true"
                data-view="broadcasts">
            Broadcasts
        </button>
        <button class="tabs__tab" type="button" role="tab" aria-selected="false"
                data-view="polls">
            Polls
        </button>
        <button class="tabs__tab" type="button" role="tab" aria-selected="false"
                data-view="posts">
            Posts
        </button>
    </div>

    <!-- Broadcasts -->
    <div data-view-panel="broadcasts">
        <section class="panel" aria-labelledby="history-title">
            <div class="panel__head">
                <h2 class="panel__title" id="history-title">Message History</h2>
                <p class="panel__meta">4 messages</p>
            </div>
            <div>
                <article class="msg">
                    <span class="msg__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3z" /><path d="M10 13 21 3" /></svg></span>
                    <span class="msg__body">
                        <span class="msg__title">Tech Summit &mdash; Day 1 Reminder</span>
                        <span class="msg__meta">WhatsApp+Email &middot; Aug 14, 9:00 AM</span>
                    </span>
                    <span class="msg__stats">
                        <span class="msg__stat">
                            <span class="msg__num">847</span>
                            <span class="msg__unit">sent</span>
                        </span>
                        <span class="msg__stat">
                            <span class="msg__num msg__num--opened">612</span>
                            <span class="msg__unit">opened</span>
                        </span>
                        <span class="msg__stat">
                            <span class="msg__num">72%</span>
                            <span class="msg__unit">rate</span>
                        </span>
                    </span>
                </article>
                <article class="msg">
                    <span class="msg__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3z" /><path d="M10 13 21 3" /></svg></span>
                    <span class="msg__body">
                        <span class="msg__title">Schedule change &mdash; Hall B update</span>
                        <span class="msg__meta">WhatsApp &middot; Aug 13, 2:30 PM</span>
                    </span>
                    <span class="msg__stats">
                        <span class="msg__stat">
                            <span class="msg__num">847</span>
                            <span class="msg__unit">sent</span>
                        </span>
                        <span class="msg__stat">
                            <span class="msg__num msg__num--opened">731</span>
                            <span class="msg__unit">opened</span>
                        </span>
                        <span class="msg__stat">
                            <span class="msg__num">86%</span>
                            <span class="msg__unit">rate</span>
                        </span>
                    </span>
                </article>
                <article class="msg">
                    <span class="msg__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3z" /><path d="M10 13 21 3" /></svg></span>
                    <span class="msg__body">
                        <span class="msg__title">Welcome onboarding message</span>
                        <span class="msg__meta">Email &middot; Aug 10, 10:00 AM</span>
                    </span>
                    <span class="msg__stats">
                        <span class="msg__stat">
                            <span class="msg__num">322</span>
                            <span class="msg__unit">sent</span>
                        </span>
                        <span class="msg__stat">
                            <span class="msg__num msg__num--opened">280</span>
                            <span class="msg__unit">opened</span>
                        </span>
                        <span class="msg__stat">
                            <span class="msg__num">87%</span>
                            <span class="msg__unit">rate</span>
                        </span>
                    </span>
                </article>
                <article class="msg">
                    <span class="msg__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3z" /><path d="M10 13 21 3" /></svg></span>
                    <span class="msg__body">
                        <span class="msg__title">Afrobeat Night ticket reminder</span>
                        <span class="msg__meta">WhatsApp+Email &middot; Sep 1, 9:00 AM</span>
                    </span>
                    <span class="badge badge--nodot badge--scheduled">Scheduled</span>
                </article>
            </div>
        </section>
    </div>

    <!-- Polls -->
    <div data-view-panel="polls" hidden>
        <section class="panel" aria-labelledby="polls-title">
            <div class="panel__head">
                <h2 class="panel__title" id="polls-title">Polls</h2>
                <p class="panel__meta">2 polls</p>
            </div>
            <div>
                <article class="poll">
                    <div class="poll__head">
                        <h3 class="poll__question">Which session are you most excited about?</h3>
                        <span class="poll__votes">512 votes &middot; closes today</span>
                        <span class="badge badge--live">Live</span>
                    </div>
                    <div class="pollbar">
                        <div class="pollbar__row">
                            <p class="pollbar__top">
                                <span>Keynote: Scaling in Africa</span>
                                <span class="pollbar__pct">46%</span>
                            </p>
                            <span class="meter"><span class="meter__fill" data-fill="46"></span></span>
                        </div>
                        <div class="pollbar__row">
                            <p class="pollbar__top">
                                <span>Fintech panel</span>
                                <span class="pollbar__pct">31%</span>
                            </p>
                            <span class="meter"><span class="meter__fill" data-fill="31"></span></span>
                        </div>
                        <div class="pollbar__row">
                            <p class="pollbar__top">
                                <span>Workshop: Design ops</span>
                                <span class="pollbar__pct">23%</span>
                            </p>
                            <span class="meter"><span class="meter__fill" data-fill="23"></span></span>
                        </div>
                    </div>
                </article>
                <article class="poll">
                    <div class="poll__head">
                        <h3 class="poll__question">How did you hear about Tech Summit?</h3>
                        <span class="poll__votes">408 votes &middot; closed</span>
                        <span class="badge badge--draft">Closed</span>
                    </div>
                    <div class="pollbar">
                        <div class="pollbar__row">
                            <p class="pollbar__top">
                                <span>Social media</span>
                                <span class="pollbar__pct">52%</span>
                            </p>
                            <span class="meter"><span class="meter__fill" data-fill="52"></span></span>
                        </div>
                        <div class="pollbar__row">
                            <p class="pollbar__top">
                                <span>A colleague</span>
                                <span class="pollbar__pct">28%</span>
                            </p>
                            <span class="meter"><span class="meter__fill" data-fill="28"></span></span>
                        </div>
                        <div class="pollbar__row">
                            <p class="pollbar__top">
                                <span>Newsletter</span>
                                <span class="pollbar__pct">20%</span>
                            </p>
                            <span class="meter"><span class="meter__fill" data-fill="20"></span></span>
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </div>

    <!-- Posts -->
    <div data-view-panel="posts" hidden>
        <section class="panel" aria-labelledby="posts-title">
            <div class="panel__head">
                <h2 class="panel__title" id="posts-title">Event Feed</h2>
                <p class="panel__meta">2 posts</p>
            </div>
            <div>
                <article class="post">
                    <div class="post__head">
                        <span class="avatar" aria-hidden="true">KA</span>
                        <span>
                            <span class="post__who">Kofi Asante</span>
                            <span class="post__when">2h ago</span>
                        </span>
                    </div>
                    <p class="post__text">Hall B has moved to the second floor &mdash; signage is up and staff are directing guests.</p>
                    <p class="post__stats"><span>312 views &middot; 18 reactions</span></p>
                </article>
                <article class="post">
                    <div class="post__head">
                        <span class="avatar" aria-hidden="true">KA</span>
                        <span>
                            <span class="post__who">Kofi Asante</span>
                            <span class="post__when">Yesterday</span>
                        </span>
                    </div>
                    <p class="post__text">Day 1 wrapped with 847 check-ins. Photos from the keynote are now in the gallery.</p>
                    <p class="post__stats"><span>689 views &middot; 74 reactions</span></p>
                </article>
            </div>
        </section>
    </div>

</main>
<div class="backdrop" data-backdrop></div>
<!-- ============================================================
       Create poll dialog
       ============================================================ -->
<div class="modal" id="poll-modal" role="dialog" aria-modal="true"
     aria-labelledby="poll-title" data-modal hidden>
    <div class="modal__dialog">
        <div class="modal__head">
            <h2 class="modal__title" id="poll-title">Create Poll</h2>
            <button class="iconbtn" type="button" data-modal-close>
                <span class="u-visually-hidden">Close</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>

        <form class="modal__body" id="poll-form" action="communications.html" method="get">
            <div class="formgrid">
                <div class="form__field">
                    <label class="field__label" for="poll-question">
                        Poll Question<span class="field__required" aria-hidden="true">*</span>
                        <span class="u-visually-hidden">(required)</span>
                    </label>
                    <input class="field__input" id="poll-question" name="poll-question" type="text"
                           placeholder="e.g. Which session are you most excited about?" required>
                </div>
            </div>

            <p class="subhead u-mt-5">
                Options
                <button class="subhead__action" type="button" data-repeat-add="poll-options">
                    + Add Option
                </button>
            </p>

            <div id="poll-options">
                <div class="optionrow" data-repeat-row>
                    <label class="u-visually-hidden" for="poll-option-1">Option 1</label>
                    <input class="field__input" id="poll-option-1" name="poll-option-1"
                           type="text" placeholder="Option 1">
                    <button class="line__remove" type="button" data-repeat-remove>
                        <span class="u-visually-hidden">Remove option 1</span>
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="optionrow" data-repeat-row>
                    <label class="u-visually-hidden" for="poll-option-2">Option 2</label>
                    <input class="field__input" id="poll-option-2" name="poll-option-2"
                           type="text" placeholder="Option 2">
                    <button class="line__remove" type="button" data-repeat-remove>
                        <span class="u-visually-hidden">Remove option 2</span>
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="optionrow" data-repeat-row>
                    <label class="u-visually-hidden" for="poll-option-3">Option 3</label>
                    <input class="field__input" id="poll-option-3" name="poll-option-3"
                           type="text" placeholder="Option 3">
                    <button class="line__remove" type="button" data-repeat-remove>
                        <span class="u-visually-hidden">Remove option 3</span>
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>

            <div class="formgrid u-mt-5">
                <div class="form__field">
                    <label class="field__label" for="poll-visible">Visible to</label>
                    <select class="field__select" id="poll-visible" name="poll-visible">
                        <option>All attendees</option>
                        <option>Checked-in attendees only</option>
                        <option>VIP tier only</option>
                        <option>Team members only</option>
                    </select>
                </div>
            </div>
        </form>

        <div class="modal__foot">
            <button class="btn btn--outline" type="button" data-modal-close>Cancel</button>
            <button class="btn btn--primary" type="submit" form="poll-form">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9.5" r="1.6" /><path d="M21 16l-5-5-9 9" /></svg> Publish Poll
            </button>
        </div>
    </div>
</div>
<!-- ============================================================
       New broadcast / post dialog
       ============================================================ -->
<div class="modal" id="broadcast-modal" role="dialog" aria-modal="true"
     aria-labelledby="broadcast-title" data-modal hidden>
    <div class="modal__dialog">
        <div class="modal__head">
            <h2 class="modal__title" id="broadcast-title">New Broadcast / Post</h2>
            <button class="iconbtn" type="button" data-modal-close>
                <span class="u-visually-hidden">Close</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>

        <form class="modal__body" id="broadcast-form" action="communications.html" method="get">
            <p class="field__label">Message Type</p>
            <div class="radiocards">
                <label class="radiocard">
                    <input type="radio" name="message-type" value="broadcast" checked>
                    <span class="radiocard__icon" aria-hidden="true">&#128227;</span>
                    <span>
                        <span class="radiocard__title">Broadcast</span>
                        <span class="radiocard__text">Send to registered attendees</span>
                    </span>
                </label>
                <label class="radiocard">
                    <input type="radio" name="message-type" value="post">
                    <span class="radiocard__icon" aria-hidden="true">&#128220;</span>
                    <span>
                        <span class="radiocard__title">Post</span>
                        <span class="radiocard__text">Publish to event feed</span>
                    </span>
                </label>
            </div>

            <p class="field__label u-mt-5">Channel</p>
            <div class="chiprow">
                <label class="chip">
                    <input type="radio" name="channel" value="whatsapp">
                    <span aria-hidden="true">&#128172;</span> WhatsApp
                </label>
                <label class="chip">
                    <input type="radio" name="channel" value="email">
                    <span aria-hidden="true">&#9993;</span> Email
                </label>
                <label class="chip">
                    <input type="radio" name="channel" value="both" checked>
                    Both
                </label>
            </div>

            <div class="formgrid u-mt-5">
                <div class="form__field">
                    <label class="field__label" for="recipients">Recipients</label>
                    <select class="field__select" id="recipients" name="recipients">
                        <option>All registered attendees (847)</option>
                        <option>Checked-in attendees (847)</option>
                        <option>Not yet checked in (153)</option>
                        <option>VIP tier only (100)</option>
                    </select>
                </div>
            </div>

            <div class="formgrid u-mt-5">
                <div class="form__field">
                    <label class="field__label" for="subject">Subject (Email only)</label>
                    <input class="field__input" id="subject" name="subject" type="text"
                           placeholder="e.g. Tech Summit Day 1 &mdash; Your Schedule">
                </div>
            </div>

            <div class="formgrid u-mt-5">
                <div class="form__field">
                    <label class="field__label" for="message">
                        Message<span class="field__required" aria-hidden="true">*</span>
                        <span class="u-visually-hidden">(required)</span>
                    </label>
                    <textarea class="field__input" id="message" name="message" rows="4"
                              placeholder="Write your message here..." required></textarea>
                    <span class="field__hint">
                        WhatsApp sends deduct from your credit balance &mdash; 1 credit per recipient.
                    </span>
                </div>
            </div>
        </form>

        <div class="modal__foot">
            <button class="btn btn--outline" type="button" data-modal-close>Cancel</button>
            <button class="btn btn--primary" type="submit" form="broadcast-form">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3z" /><path d="M10 13 21 3" /></svg> Send Now
            </button>
        </div>
    </div>
</div>