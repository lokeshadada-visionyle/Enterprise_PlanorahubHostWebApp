@page
@model Planora_EnterproseHostWebApp.Pages.Events.CheckInModel
@{
    Layout = "_Layout";
    ViewData["PageName"] = "Check-in";
    ViewData["PageDesc"] = "Tech Summit Africa 2025 &middot; Live";
}

<main class="shell__main" data-page-roles="admin manager">

    @if (!string.IsNullOrEmpty(Model.ApiError))
    {
        <div class="alert alert-danger mb-4" role="alert">
            @Model.ApiError
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success mb-4" role="alert">
            @Model.SuccessMessage
        </div>
    }

    <div class="page__head">
        <div>
            <h1 class="page__title">Check-in</h1>
            <p class="page__subtitle">
                @Model.DatesAndSlots.EventName &middot; <span data-scope-label>@(Model.DatesAndSlots.EventDates?.SelectMany(d => d.Slots).FirstOrDefault(s => s.SlotId == Model.SlotId)?.SessionName ?? "")</span>
            </p>
        </div>
        <div class="page__actions">
            <button class="btn btn--outline" type="button"
                    data-action="Attendance report downloaded">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Attendance report
            </button>
            <a class="btn btn--outline" href="event-hub.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9.5" cy="7.5" r="3.5" /><path d="M17 4.2a3.5 3.5 0 0 1 0 6.6M21 20v-1.5a4 4 0 0 0-3-3.8" /></svg> Door staff</a>
            <button class="btn btn--primary" type="button" data-ci-focus>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg> Find a guest
            </button>
        </div>
    </div>

    <div class="scopebar">
        <span class="scopebar__label">Day</span>
        <div class="scopebar__row" role="group" aria-label="Choose a day">
            @if (Model.DatesAndSlots.EventDates != null)
            {
                @foreach (var day in Model.DatesAndSlots.EventDates)
                {
                    @foreach (var slot in day.Slots)
                    {
                        bool isActive = slot.SlotId == Model.SlotId && day.EventDateId == Model.EventDateId;
                        <a class="scopetab" asp-page="/Events/CheckIn"
                           asp-route-eventId="@Model.EventId" asp-route-slotId="@slot.SlotId"
                           asp-route-eventDateId="@day.EventDateId"
                           aria-pressed="@(isActive ? "true" : "false")">
                            @day.SessionName &mdash; @slot.SessionName
                            <span class="scopetab__date">@day.Date</span>
                        </a>
                    }
                }
            }
        </div>
    </div>

    <p class="badgestrip">
        <span class="badgestrip__figures">
            <span class="badgestrip__figure">
                <b>@Model.Dashboard.TotalBadges</b><span>Badges printed</span>
            </span>
            <span class="badgestrip__figure">
                <b>@Model.Dashboard.PendingBadges</b><span>Pending</span>
            </span>
            <span class="badgestrip__figure badgestrip__figure--warn">
                <b>@Model.Dashboard.FailedBadges</b><span>Failed</span>
            </span>
            <span class="badgestrip__figure">
                <b>@Model.Dashboard.BadgesReprinted</b><span>Reprints</span>
            </span>
        </span>
        <span class="badgestrip__body">
            Badge printing is <b>on</b> for this event. A failed print never affects a
            check-in &mdash; staff retry from the counter.
        </span>
        <a class="btn btn--primary btn--sm" href="event-hub.html#onsite">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v3h6V3" /><path d="M9 12h6M9 16h4" /></svg> Badge activity
        </a>
    </p>

    <section class="grid grid--4 u-mt-6 u-mb-6" aria-label="Attendance totals">
        <article class="metric">
            <span class="tile tile--lg tile--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M17 20v-1a4 4 0 0 0-2.5-3.7M16 5.2a3 3 0 0 1 0 5.6" /></svg></span>
            <span>
                <span class="metric__value">@Model.Dashboard.Registered</span>
                <span class="metric__label">Registered</span>
            </span>
        </article>
        <article class="metric">
            <span class="tile tile--lg tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" /><circle cx="9" cy="7.5" r="3.5" /><path d="M16.5 11.5l2 2 3.5-3.5" /></svg></span>
            <span>
                <span class="metric__value" data-count="checkedin">@Model.Dashboard.TotalCheckIns</span>
                <span class="metric__label">Checked in</span>
            </span>
        </article>
        <article class="metric">
            <span class="tile tile--lg tile--info" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 2" /></svg></span>
            <span>
                <span class="metric__value" data-count="remaining">@Model.Dashboard.NotArrived</span>
                <span class="metric__label">Not arrived</span>
            </span>
        </article>
        <article class="metric">
            <span class="tile tile--lg tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12h4l2.5 7 5-14L17 12h4" /></svg></span>
            <span>
                <span class="metric__value">@Model.Dashboard.AttendancePer</span>
                <span class="metric__label">Attendance rate</span>
            </span>
        </article>
    </section>

    <div class="grid grid--main">
        <section class="panel" aria-labelledby="refpanel-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h2 class="panel__title" id="refpanel-title">Ticket Reference</h2>
                    <p class="panel__meta">
                        Type the reference from the guest&rsquo;s pass &mdash; the verdict comes
                        back before you let them through
                    </p>
                </div>
            </div>
            <div class="panel__body">
                <form method="post" asp-page-handler="ManualCheckIn">
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <input type="hidden" name="slotId" value="@Model.SlotId" />
                    <div class="form__field">
                        <label class="field__label" for="scan-ref">
                            Ticket reference
                        </label>
                        <div class="field__control field__control--with-action">
                            <input class="field__input field__input--ref" id="scan-ref"
                                   name="reference" type="text" autocomplete="off"
                                   placeholder="e.g. TSA-4821" required>
                            <button class="field__toggle" type="submit">
                                <span class="u-visually-hidden">Check in this reference</span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                            </button>
                        </div>
                        <span class="field__hint">
                            Type the guest&rsquo;s ticket reference and press check-in
                        </span>
                    </div>
                </form>

                <div class="verdict" data-verdict hidden>
                    <span class="verdict__mark" data-verdict-mark aria-hidden="true"></span>
                    <span class="verdict__body">
                        <span class="verdict__name" data-verdict-name></span>
                        <span class="verdict__meta" data-verdict-meta></span>
                        <span class="verdict__reason" data-verdict-reason></span>
                    </span>
                </div>

                <p class="notice notice--info notice--flat u-mt-5">
                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                    Every lookup is recorded against you in the scan log below, accepted or
                    refused &mdash; including the refusals, which are the only record you have
                    if a guest says they were turned away wrongly.
                </p>
            </div>
        </section>

        <section class="panel" aria-labelledby="doors-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h2 class="panel__title" id="doors-title">Doors</h2>
                    <p class="panel__meta">Who is on each entrance right now</p>
                </div>
            </div>
            <div class="panel__body">
                @if (Model.Dashboard.Halls != null && Model.Dashboard.Halls.Any())
                {
                    @foreach (var hall in Model.Dashboard.Halls)
                    {
                        bool isOpen = (hall.Status ?? "").ToLower() == "open";
                        <div class="doorrow">
                            <span class="tile @(isOpen ? "tile--info" : "tile--muted")" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M7 12h10" /></svg></span>
                            <span class="doorrow__body">
                                <span class="doorrow__name">@hall.HallName</span>
                                <span class="doorrow__meta">@hall.StaffName</span>
                            </span>
                            <span class="doorrow__count">
                                <b>@hall.TotalScans</b>
                                <span class="doorrow__unit">scans</span>
                            </span>
                            <span class="badge @(isOpen ? "badge--live" : "badge--draft")">@hall.Status</span>
                        </div>
                    }
                }
                else if (string.IsNullOrEmpty(Model.ApiError))
                {
                    <p class="u-muted">No doors configured for this slot.</p>
                }
                <p class="notice notice--info notice--flat u-mt-5">
                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><path d="M12 12h.01" /></svg>
                    Door staff sign in with the PIN issued in
                    <b><a class="textlink" href="event-hub.html">Event Hub</a></b>. Their scans
                    are attributed to them in the log below.
                </p>
            </div>
        </section>
    </div>

    <section class="panel u-mt-6" aria-labelledby="manual-title">
        <div class="panel__head panel__head--plain">
            <div>
                <h2 class="panel__title" id="manual-title">Check in by hand</h2>
                <p class="panel__meta">
                    For the guest whose QR will not read, or who arrived without their pass
                </p>
            </div>
        </div>
        <div class="panel__body">
            <!-- Find one guest fast — reference, name or email, all at once -->
            <div class="findbox">
                <div class="searchbox searchbox--lg">
                    <svg class="searchbox__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                    <label class="u-visually-hidden" for="ci-find">
                        Find a guest by ticket reference, name or email
                    </label>
                    <input class="searchbox__input" id="ci-find" name="ci-find" type="search"
                           placeholder="Ticket reference, guest name or email"
                           data-ci-find autocomplete="off">
                </div>
                <p class="findbox__hint">
                    Try <b>TSA-4824</b>, <b>Bayo</b> or <b>grace.mensah@partner.gh</b> &mdash;
                    matches appear as you type and can be checked in from here
                </p>
            </div>

            <div class="findresults" data-ci-results hidden></div>

            <p class="findnone" data-ci-none hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                <span>
                    Nothing matches that reference, name or email on this event.
                </span>
            </p>

            <div class="toolbar u-mt-5">
                <div class="toolbar__field">
                    <label class="u-visually-hidden" for="ci-day">Filter by date</label>
                    <select class="field__select" id="ci-day" name="ci-day" data-ci-filter="day">
                        <option value="">All dates</option>
                        <option value="day1">Day 1 &mdash; Opening Day</option>
                        <option value="day2">Day 2 &mdash; Workshops</option>
                        <option value="day3">Day 3 &mdash; Closing</option>
                    </select>
                </div>
                <div class="toolbar__field">
                    <label class="u-visually-hidden" for="ci-slot">Filter by time slot</label>
                    <select class="field__select" id="ci-slot" name="ci-slot"
                            data-ci-filter="slot">
                        <option value="">All time slots</option>
                    </select>
                </div>
                <form method="get" class="toolbar__field">
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <input type="hidden" name="slotId" value="@Model.SlotId" />
                    <input type="hidden" name="eventDateId" value="@Model.EventDateId" />
                    <label class="u-visually-hidden" for="ci-tier">Filter by tier</label>
                    <select class="field__select" id="ci-tier" name="ticketTypeId" onchange="this.form.submit()">
                        <option value="0" selected="@(Model.TicketTypeId == 0)">All tiers</option>
                        @if (Model.TicketTypes.TicketTypes != null)
                        {
                            @foreach (var tier in Model.TicketTypes.TicketTypes)
                            {
                                <option value="@tier.TicketTypeId" selected="@(tier.TicketTypeId == Model.TicketTypeId)">@tier.TypeName</option>
                            }
                        }
                    </select>
                </form>
                <button class="btn btn--quiet btn--sm" type="button" data-ci-clear>
                    Clear filters
                </button>
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Guest list exported as CSV">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export list
                </button>
            </div>

            <p class="bulkbar u-mt-5">
                <span>
                    <b>@(Model.GuestList.Guests?.Count ?? 0) guests</b> shown
                </span>
                <span class="bulkbar__actions" data-ci-inout>
                    <span class="badge badge--nodot badge--live">
                        <b data-ci-in>0</b> checked in
                    </span>
                    <span class="badge badge--nodot badge--role">
                        <b data-ci-out>0</b> still to arrive
                    </span>
                </span>
            </p>

            <div class="tablewrap u-mt-5">
                <table class="table table--narrow" id="manual-table">
                    <caption class="u-visually-hidden">
                        Guests with their reference, tier, date, slot, seat and check-in state
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Reference</th>
                            <th scope="col">Guest</th>
                            <th scope="col">Tier</th>
                            <th scope="col">Date</th>
                            <th scope="col">Time slot</th>
                            <th scope="col">Seat</th>
                            <th scope="col">State</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GuestList.Guests != null && Model.GuestList.Guests.Any())
                        {
                            @foreach (var guest in Model.GuestList.Guests)
                            {
                                bool isCheckedIn = (guest.Status ?? "").ToLower() == "checked-in" || (guest.Status ?? "").ToLower() == "checked in";
                                string initials = string.Concat((guest.GuestName ?? "").Split(' ').Where(p => p.Length > 0).Select(p => p[0])).ToUpper();

                                <tr data-guest-row data-ci-ref="@guest.TIcketReference">
                                    <td><span class="order__ref">@guest.TIcketReference</span></td>
                                    <td>
                                        <div class="cellstack">
                                            <span class="avatar" aria-hidden="true">@initials</span>
                                            <span class="cellstack__body">
                                                <span class="cellstack__name">@guest.GuestName</span>
                                                <span class="cellsub">@guest.GuestEmail</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td><span class="badge badge--nodot badge--role">@guest.TicketTypeName</span></td>
                                    <td class="u-muted"><span class="u-nowrap">@guest.Date</span></td>
                                    <td class="u-muted">@guest.SlotName</td>
                                    <td><span class="u-nowrap">@guest.SeatNo</span></td>
                                    <td>
                                        @if (isCheckedIn)
                                        {
                                            <span class="badge badge--live">@guest.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge--draft">@guest.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isCheckedIn)
                                        {
                                            <div class="rowactions"><span class="badge badge--nodot badge--live">Checked in</span></div>
                                        }
                                        else
                                        {
                                            <div class="rowactions">
                                                <form method="post" asp-page-handler="CheckInGuest">
                                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                                    <input type="hidden" name="slotId" value="@Model.SlotId" />
                                                    <input type="hidden" name="eventDateId" value="@Model.EventDateId" />
                                                    <input type="hidden" name="ticketTypeId" value="@Model.TicketTypeId" />
                                                    <input type="hidden" name="guestId" value="@guest.GuestId" />
                                                    <button class="btn btn--outline btn--sm" type="submit">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M7 12h10" /></svg> Check in
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else if (string.IsNullOrEmpty(Model.ApiError))
                        {
                            <tr>
                                <td colspan="8" class="u-muted">No guests match this date/slot.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="tablefilter__empty" data-ci-empty hidden>
                No guest matches those filters.
            </p>
        </div>
    </section>

    <!-- Seating layout and the scan log answer different questions, and a
             host wants one at a time. Stacked, reaching the log meant scrolling
             past fifty seats. -->
    <nav class="subtabs subtabs--inner u-mt-6" role="tablist"
         aria-label="Check-in views" data-pick-group id="citabs">
        <button class="subtabs__tab" type="button" role="tab" aria-selected="true"
                aria-pressed="true" data-pick="seats">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 3 3 5.5v15L9 18l6 3 6-2.5v-15L15 6 9 3zM9 3v15M15 6v15" /></svg> Seating Layout
        </button>
        <button class="subtabs__tab" type="button" role="tab" aria-selected="false"
                aria-pressed="false" data-pick="log">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 2" /></svg> Scan Log
        </button>
    </nav>

    <div data-pick-panel="seats" data-pick-owner="citabs">
        <!-- ============ Seating layout, read at the door ============ -->
        <section class="panel" aria-labelledby="ciseat-title">
            <div class="panel__head">
                <span class="tile tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 3 3 5.5v15L9 18l6 3 6-2.5v-15L15 6 9 3zM9 3v15M15 6v15" /></svg></span>
                <div>
                    <h2 class="panel__title" id="ciseat-title">Seating Layout</h2>
                    <p class="panel__meta">
                        Who is sitting where, and what is still free &mdash; for the date, slot and
                        tier you are working
                    </p>
                </div>
            </div>
            <div class="panel__body">
                <div class="toolbar">
                    <div class="toolbar__field">
                        <label class="u-visually-hidden" for="cis-day">Seating date</label>
                        <select class="field__select" id="cis-day" name="cis-day"
                                data-cis-filter="day">
                            <option value="">All dates</option>
                            <option value="day1">Day 1 &mdash; Opening Day</option>
                            <option value="day2">Day 2 &mdash; Workshops</option>
                            <option value="day3">Day 3 &mdash; Closing</option>
                        </select>
                    </div>
                    <div class="toolbar__field">
                        <label class="u-visually-hidden" for="cis-slot">Seating time slot</label>
                        <select class="field__select" id="cis-slot" name="cis-slot"
                                data-cis-filter="slot">
                            <option value="">All time slots</option>
                        </select>
                    </div>
                    <form method="get" class="toolbar__field">
                        <input type="hidden" name="eventId" value="@Model.EventId" />
                        <input type="hidden" name="slotId" value="@Model.SlotId" />
                        <input type="hidden" name="eventDateId" value="@Model.EventDateId" />
                        <label class="u-visually-hidden" for="cis-tier">Seating tier</label>
                        <select class="field__select" id="cis-tier" name="ticketTypeId" onchange="this.form.submit()">
                            <option value="0" selected="@(Model.TicketTypeId == 0)">All tiers</option>
                            @if (Model.TicketTypes.TicketTypes != null)
                            {
                                @foreach (var tier in Model.TicketTypes.TicketTypes)
                                {
                                    <option value="@tier.TicketTypeId" selected="@(tier.TicketTypeId == Model.TicketTypeId)">@tier.TypeName</option>
                                }
                            }
                        </select>
                    </form>
                </div>

                <p class="bulkbar u-mt-5">
                    <span>
                        <b data-cis-occupied>0</b> occupied &middot;
                        <b data-cis-held>0</b> assigned but not arrived &middot;
                        <b data-cis-free>0</b> free
                    </span>
                    <span class="bulkbar__actions">
                        <button class="btn btn--outline btn--sm" type="button"
                                data-action="Seating layout exported as a printable sheet">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export layout
                        </button>
                    </span>
                </p>

                <div class="ciblocks u-mt-5">
                    @if (Model.SeatingLayout.TicketTypes != null && Model.SeatingLayout.TicketTypes.Any())
                    {
                        @foreach (var tier in Model.SeatingLayout.TicketTypes)
                        {
                            <div class="ciblock" data-ci-tierblock="@tier.TypeName">
                                <p class="ciblock__head">
                                    <span class="ciblock__tier">@tier.TypeName</span>
                                    <span class="ciblock__meta">@tier.TotalSeats seats</span>
                                </p>
                                <div class="ciseats">
                                    @if (tier.Seats != null)
                                    {
                                        @foreach (var seat in tier.Seats)
                                        {
                                            string stateLower = (seat.Status ?? "").ToLower();
                                            string seatCss = stateLower switch
                                            {
                                                "in" => "ciseat ciseat--in",
                                                "checked-in" => "ciseat ciseat--in",
                                                "held" => "ciseat ciseat--held",
                                                "free" => "ciseat",
                                                _ => "ciseat"
                                            };
                                            string whoText = stateLower switch
                                            {
                                                "free" => "Available",
                                                "held" => $"{seat.GuestName} \u00b7 Assigned, not arrived",
                                                "in" => $"{seat.GuestName} \u00b7 Checked in",
                                                "checked-in" => $"{seat.GuestName} \u00b7 Checked in",
                                                _ => string.IsNullOrWhiteSpace(seat.GuestName) ? seat.Status : $"{seat.GuestName} \u00b7 {seat.Status}"
                                            };

                                            <button class="@seatCss" type="button"
                                                    data-ciseat="@seat.SeatNo" data-ci-tier="@tier.TypeName" data-ci-state="@stateLower">
                                                <span class="ciseat__id">@seat.SeatNo</span>
                                                <span class="ciseat__who">@whoText</span>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (string.IsNullOrEmpty(Model.ApiError))
                    {
                        <p class="u-muted">No seating layout configured for this slot.</p>
                    }
                </div>

                <p class="seatlegend">
                    <span><span class="seatkey" aria-hidden="true"></span> Free</span>
                    <span>
                        <span class="seatkey seatkey--reserved" aria-hidden="true"></span>
                        Assigned, not arrived
                    </span>
                    <span>
                        <span class="seatkey seatkey--checked" aria-hidden="true"></span>
                        Occupied &mdash; guest checked in
                    </span>
                    <span data-cis-scopelabel>All dates, all slots, all tiers</span>
                </p>
            </div>
        </section>
    </div>

    <div data-pick-panel="log" data-pick-owner="citabs" hidden>
        <section class="panel" aria-labelledby="scanlog-title">
            <div class="panel__head panel__head--plain">
                <div>
                    <h2 class="panel__title" id="scanlog-title">Scan log</h2>
                    <p class="panel__meta">
                        Every scan, accepted or refused, with the door and who was on it
                    </p>
                </div>
                <button class="btn btn--outline btn--sm" type="button"
                        data-action="Scan log exported as CSV">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export log
                </button>
            </div>
            <div class="panel__body">
                <div class="tablewrap">
                    <table class="table table--narrow">
                        <caption class="u-visually-hidden">
                            Scan log with time, guest, door, staff member and verdict
                        </caption>
                        <thead>
                            <tr>
                                <th scope="col">Time</th>
                                <th scope="col">Guest</th>
                                <th scope="col">Door</th>
                                <th scope="col">By</th>
                                <th scope="col">Verdict</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ScanLogs.Guests != null && Model.ScanLogs.Guests.Any())
                            {
                                @foreach (var log in Model.ScanLogs.Guests)
                                {
                                    string initials = string.Concat((log.GuestName ?? "").Split(' ').Where(p => p.Length > 0).Select(p => p[0])).ToUpper();
                                    string statusLower = (log.Status ?? "").ToLower();
                                    string verdictBadgeCss = statusLower switch
                                    {
                                        "checked in" => "badge--live",
                                        "already checked in" => "badge--paused",
                                        _ when statusLower.StartsWith("denied") => "badge--out",
                                        _ => "badge--default"
                                    };

                                    <tr>
                                        <td><span class="u-nowrap">@log.Time</span></td>
                                        <td>
                                            <div class="cellstack">
                                                <span class="avatar" aria-hidden="true">@initials</span>
                                                <span class="cellstack__body">
                                                    <span class="cellstack__name">@log.GuestName</span>
                                                    <span class="cellsub">@log.TicketTypeName &middot; Seat @log.SeatNo</span>
                                                </span>
                                            </div>
                                        </td>
                                        <td>@log.HallName</td>
                                        <td class="u-muted">@log.CheckInBy</td>
                                        <td><span class="badge @verdictBadgeCss">@log.Status</span></td>
                                        <td>
                                            <div class="rowactions">
                                                <button class="iconbtn" type="button"
                                                        data-action="Scan record for @log.GuestName opened">
                                                    <span class="u-visually-hidden">Scan record for @log.GuestName</span>
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.8-6.5 10-6.5S22 12 22 12s-3.8 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else if (string.IsNullOrEmpty(Model.ApiError))
                            {
                                <tr>
                                    <td colspan="6" class="u-muted">No scans recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="notice notice--warn notice--flat u-mt-5">
                    <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
                    A refused scan is kept, not discarded &mdash; it is the only record you have if
                    a guest says they were turned away wrongly.
                </p>
            </div>
        </section>
    </div>

</main>