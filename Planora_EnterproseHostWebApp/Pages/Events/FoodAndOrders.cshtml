@page
@model Planora_EnterproseHostWebApp.Pages.Events.FoodAndOrdersModel
@{
    Layout = "_Layout";
    ViewData["PageName"] = "Food &amp; Orders";
    ViewData["PageDesc"] = "Menu, orders &amp; counters";
}

<main class="shell__main" data-page-roles="admin manager">

    <div class="page__head">
        <div>
            <h1 class="page__title">Food Management</h1>
            <p class="page__subtitle">
                Menu, live orders &amp; counters &middot; allocated against the per-guest
                allowance, not sold
            </p>
        </div>
        <div class="page__actions">
            <span class="switchcard switchcard--bare">
                <span class="switchcard__title" id="ordering-label">Ready to order</span>
                <button class="switch switch--brand" type="button" role="switch"
                        aria-checked="true" aria-labelledby="ordering-label" data-switch
                        data-reveal-inverse="ordering-off"></button>
            </span>
            <button class="btn btn--outline" type="button"
                    data-action="Serving log opened &mdash; every serve, by whom, at which counter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M7 12h10" /></svg> Serving log
            </button>
            <button class="btn btn--primary" type="button" data-food-new
                    data-modal-open="fooditem-modal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Add item
            </button>
        </div>
    </div>

    <p class="notice notice--warn notice--flat" id="ordering-off" hidden>
        <svg class="notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4.5M12 16h.01" /></svg>
        Ordering is switched off. Guests can still see the menu, but nothing can be
        ordered until you switch it back on.
    </p>

    <section class="grid grid--4 u-mb-6" aria-label="Food totals">
        <article class="metric">
            <span class="tile tile--lg tile--brand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8zM17 9h1.5a2.5 2.5 0 0 1 0 5H17" /></svg></span>
            <span>
                <span class="metric__value">6</span>
                <span class="metric__label">Menu items</span>
            </span>
        </article>
        <article class="metric">
            <span class="tile tile--lg tile--info" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12h5l2 3h4l2-3h5" /><path d="M5.5 4h13l2.5 8v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6l2.5-8z" /></svg></span>
            <span>
                <span class="metric__value">5</span>
                <span class="metric__label">Open orders</span>
            </span>
        </article>
        <article class="metric">
            <span class="tile tile--lg tile--success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M7 12h10" /></svg></span>
            <span>
                <span class="metric__value">1,204</span>
                <span class="metric__label">Serves today</span>
            </span>
        </article>
        <article class="metric">
            <span class="tile tile--lg tile--accent" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12h4l2.5 7 5-14L17 12h4" /></svg></span>
            <span>
                <span class="metric__value">92%</span>
                <span class="metric__label">Of allowance used</span>
            </span>
        </article>
    </section>

    <div class="tabs u-mb-6" role="tablist" aria-label="Food sections" data-viewswitch>
        <button class="tabs__tab" type="button" role="tab" aria-selected="true"
                data-view="menu">
            Menu <span class="tabs__count">6</span>
        </button>
        <button class="tabs__tab" type="button" role="tab" aria-selected="false"
                data-view="orders">
            Live orders <span class="tabs__count">5</span>
        </button>
        <button class="tabs__tab" type="button" role="tab" aria-selected="false"
                data-view="counters">
            Counters &amp; staff
            <span class="tabs__count">4</span>
        </button>
    </div>

    <!-- Menu -->
    <div data-view-panel="menu">
        <div class="toolbar u-mb-5">
            <div class="searchbox">
                <svg class="searchbox__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                <label class="u-visually-hidden" for="food-search">Search the menu</label>
                <input class="searchbox__input" id="food-search" name="food-search"
                       type="search" placeholder="Search by item name"
                       data-tablefilter="food-table">
            </div>
            <div class="toolbar__field">
                <label class="u-visually-hidden" for="food-cat">Filter by category</label>
                <select class="field__select" id="food-cat" name="food-cat"
                        data-tablefilter-col="food-table">
                    <option value="">All categories</option>
                    <option>Starters</option>
                    <option>Soups</option>
                    <option>Rice &amp; Biryani</option>
                    <option>Breads</option>
                    <option>Main Course</option>
                    <option>Snacks</option>
                    <option>Sides</option>
                    <option>Desserts</option>
                    <option>Beverages</option>
                </select>
            </div>
            <button class="btn btn--outline btn--sm" type="button"
                    data-action="Menu exported as CSV">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" /></svg> Export menu
            </button>
        </div>

        <div class="tablewrap">
            <table class="table" id="food-table">
                <caption class="u-visually-hidden">
                    Menu items with dietary type, extra serves per guest, servings today and
                    availability
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Category</th>
                        <th scope="col">Extra serves / guest</th>
                        <th scope="col">Served</th>
                        <th scope="col">Availability</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-repeat-row data-food-row class="is-out">
                        <td>
                            <span class="cellstack__name">Jollof Rice</span>
                            <span class="cellsub">
                                <span class="diet diet--veg" aria-hidden="true"></span>
                                Veg
                            </span>
                        </td>
                        <td><span class="badge badge--nodot badge--neutral">Rice &amp; Biryani</span></td>
