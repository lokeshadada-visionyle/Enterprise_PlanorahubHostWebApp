<div class="modal" id="fooditem-modal" role="dialog" aria-modal="true"
     aria-labelledby="fooditem-title" data-modal hidden>
    <div class="modal__scrim" data-modal-close></div>
    <div class="modal__dialog">
        <div class="modal__head">
            <h2 class="modal__title" id="fooditem-title">
                <span data-food-heading>Add menu item</span>
            </h2>
            <button class="iconbtn" type="button" data-modal-close>
                <span class="u-visually-hidden">Close</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>

        <form class="modal__body" id="fooditem-form">
            <div class="formgrid formgrid--2">
                <div class="form__field">
                    <label class="field__label" for="fi-name">
                        Item name<span class="field__required" aria-hidden="true">*</span>
                        <span class="u-visually-hidden">(required)</span>
                    </label>
                    <input class="field__input" id="fi-name" name="fi-name" type="text"
                           placeholder="e.g. Jollof Rice" data-food-field="name" required>
                </div>
                <div class="form__field">
                    <label class="field__label" for="fi-cat">Category</label>
                    <select class="field__select" id="fi-cat" name="fi-cat" data-food-field="cat">
                        <option>Starters</option>
                        <option>Soups</option>
                        <option>Rice &amp; Biryani</option>
                        <option>Breads</option>
                        <option>Main Course</option>
                        <option>Snacks</option>
                        <option>Sides</option>
                        <option>Desserts</option>
                        <option>Beverages</option>
                    </select>
                </div>
            </div>

            <div class="formgrid formgrid--2 u-mt-5">
                <div class="form__field">
                    <label class="field__label" for="fi-diet">Dietary type</label>
                    <select class="field__select" id="fi-diet" name="fi-diet" data-food-field="diet">
                        <option value="veg">Veg</option>
                        <option value="nonveg">Non-veg</option>
                        <option value="vegan">Vegan</option>
                        <option value="egg">Egg</option>
                    </select>
                </div>
                <div class="form__field">
                    <label class="field__label" for="fi-extra">Extra serves allowed per guest</label>
                    <input class="field__input" id="fi-extra" name="fi-extra" type="text"
                           inputmode="numeric" value="1" data-food-field="extra">
                    <span class="field__hint">
                        On top of the base allowance set in the wizard. No item carries a price.
                    </span>
                </div>
            </div>

            <div class="form__field u-mt-5">
                <label class="field__label" for="fi-scope">Available in</label>
                <select class="field__select" id="fi-scope" name="fi-scope">
                    <option>Every day and slot</option>
                    <option>All slots on Day 1</option>
                    <option>All slots on Day 2</option>
                    <option>This slot only</option>
                </select>
            </div>
        </form>

        <div class="modal__foot">
            <button class="btn btn--outline" type="button" data-modal-close>Cancel</button>
            <button class="btn btn--primary" type="button" data-food-save data-modal-close>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" /></svg> <span data-food-cta>Add to menu</span>
            </button>
        </div>
    </div>
</div>